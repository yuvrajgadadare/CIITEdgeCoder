                                    →

                                </text>

                                <text x="340"
                                      y="215"
                                      text-anchor="middle"
                                      font-size="15"
                                      fill="#495057">

                                    import

                                </text>


                                <!-- MODULE B -->

                                <rect x="370"
                                      y="90"
                                      width="230"
                                      height="170"
                                      rx="14"
                                      fill="#ffffff"
                                      stroke="#198754"
                                      stroke-width="3" />

                                <text x="485"
