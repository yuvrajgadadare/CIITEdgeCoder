@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "JavaScript Modules";
}

<style>

    #javascript-modules-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-modules-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    #javascript-modules-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-modules-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    #javascript-modules-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-modules-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 14px;
    }

    /* CONCEPT */

    #javascript-modules-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    #javascript-modules-page .concept-box h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-modules-page .concept-box p {
        color: #495057;
        line-height: 1.8;
    }

    /* IMAGE */

    #javascript-modules-page .image-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 15px;
        margin: 25px 0;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    #javascript-modules-page .modules-visual {
        width: 100%;
        background: #f8f9fa;
        border-radius: 10px;
        overflow: hidden;
    }

    #javascript-modules-page .image-caption {
        color: #6c757d;
        font-size: 13px;
        margin-top: 12px;
        margin-bottom: 0;
    }

    /* DIAGRAM */

    #javascript-modules-page .diagram-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 25px;
        margin: 25px 0;
        text-align: center;
    }

    #javascript-modules-page .diagram-title {
        font-size: 21px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 22px;
    }

    #javascript-modules-page .diagram-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    #javascript-modules-page .diagram-item {
        background: #ffffff;
        border: 2px solid #6d3fc0;
        border-radius: 9px;
        padding: 16px 22px;
        font-weight: 600;
        color: #212529;
    }

    #javascript-modules-page .diagram-item.green {
        border-color: #198754;
    }

    #javascript-modules-page .diagram-item.main {
        background: #6d3fc0;
        color: #ffffff;
    }

    #javascript-modules-page .diagram-arrow {
        font-size: 25px;
        font-weight: 700;
        color: #6d3fc0;
    }

    /* CODE */

    #javascript-modules-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 22px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    #javascript-modules-page .code-box code {
        color: #f8f9fa;
    }

    /* TRY IT */

    #javascript-modules-page .try-it-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
        margin-bottom: 22px;
    }

    #javascript-modules-page .try-it-btn {
        background: #198754;
        border: 1px solid #198754;
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    #javascript-modules-page .try-it-btn:hover {
        background: #157347;
        border-color: #157347;
    }

    /* OUTPUT */

    #javascript-modules-page .output-box {
        background: #212529;
        color: #ffffff;
        border-left: 4px solid #198754;
        border-radius: 7px;
        padding: 18px;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 25px;
        font-weight: 700;
    }

    /* TABLE */

    #javascript-modules-page .comparison-wrapper {
        overflow-x: auto;
        margin: 25px 0;
    }

    #javascript-modules-page .comparison-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    #javascript-modules-page .comparison-table th,
    #javascript-modules-page .comparison-table td {
        border: 1px solid #dee2e6;
        padding: 14px;
        text-align: left;
    }

    #javascript-modules-page .comparison-table th {
        background: #5b21b6;
        color: #ffffff;
        font-weight: 700;
    }

    #javascript-modules-page .comparison-table td {
        background: #ffffff;
        color: #495057;
    }

    /* SUMMARY */

    #javascript-modules-page .summary-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
        margin-top: 30px;
    }

    #javascript-modules-page .summary-box h2 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-modules-page .summary-box p {
        color: #495057;
        line-height: 1.8;
    }

    /* NAVIGATION */

    #javascript-modules-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-top: 1px solid #dee2e6;
        margin-top: 35px;
        padding-top: 20px;
    }

    #javascript-modules-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    #javascript-modules-page .previous-btn {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #495057;
    }

    #javascript-modules-page .next-btn {
        background: #5b21b6;
        border: 1px solid #5b21b6;
        color: #ffffff;
    }

    #javascript-modules-page .previous-btn:hover {
        background: #e9ecef;
        color: #212529;
    }

    #javascript-modules-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
    }

    @@media (max-width: 768px) {

        #javascript-modules-page .content-section {
            padding: 20px;
        }

        #javascript-modules-page .page-title {
            font-size: 30px;
        }

        #javascript-modules-page .section-title {
            font-size: 23px;
        }

        #javascript-modules-page .bottom-navigation {
            flex-direction: column;
        }

        #javascript-modules-page .nav-btn {
            width: 100%;
            justify-content: center;
        }

        #javascript-modules-page .diagram-row {
            flex-direction: column;
        }

        #javascript-modules-page .diagram-arrow {
            transform: rotate(90deg);
        }
    }

</style>


<main id="javascript-modules-page">

    <div class="container-fluid">

        <div class="row g-4">

            <!-- =====================================================
                 LEFT SIDEBAR
                 ===================================================== -->

            <aside class="col-lg-3">

                @Html.Partial(
                    "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
                )

            </aside>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <section class="col-lg-9">

                <div class="content-section">


                    <!-- PAGE HEADER -->

                    <h1 class="page-title">
                        JavaScript Modules
                    </h1>

                    <p class="lead-text">

                        JavaScript Modules allow us to divide a large
                        JavaScript program into smaller, reusable and
                        manageable files.

                    </p>


                    <!-- INTRODUCTION -->

                    <h2 class="section-title">
                        What are JavaScript Modules?
                    </h2>

                    <p class="section-text">

                        A module is a separate JavaScript file that
                        contains related variables, functions, classes,
                        or other code.

                    </p>

                    <p class="section-text">

                        Modules help us organize our application and
                        reuse code between different JavaScript files.

                    </p>


                    <!-- SIMPLE DEFINITION -->

                    <div class="concept-box">

                        <h5>
                            Simple Definition
                        </h5>

                        <p class="mb-0">

                            JavaScript Modules allow us to
                            <strong>export</strong> code from one file
                            and <strong>import</strong> that code into
                            another file.

                        </p>

                    </div>


