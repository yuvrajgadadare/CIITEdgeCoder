</main>


<script>

    /* =========================================================
       CIIT JAVASCRIPT COMPILER
       ========================================================= */

    function openCompiler(code) {

        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );
    }


    /* =========================================================
       EXAMPLE 1
       ========================================================= */

    function tryModulesExample1() {

        const code =
            'function add(a, b) {\\n' +
            '    return a + b;\\n' +
            '}\\n' +
            '\\n' +
            'console.log("Export example");';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 2
       ========================================================= */

    function tryModulesExample2() {

        const code =
            'function add(a, b) {\\n' +
            '    return a + b;\\n' +
            '}\\n' +
            '\\n' +
            'let result = add(10, 20);\\n' +
            '\\n' +
            'console.log(result);';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 3
       ========================================================= */

    function tryModulesExample3() {

        const code =
            'const name = "Rahul";\\n' +
            '\\n' +
            'function greet() {\\n' +
            '    return "Hello " + name;\\n' +
            '}\\n' +
            '\\n' +
            'console.log(greet());';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 4
       ========================================================= */

    function tryModulesExample4() {

        const code =
            'function greet() {\\n' +
            '    return "Welcome to CIIT Training Institute";\\n' +
            '}\\n' +
            '\\n' +
            'console.log(greet());';

        openCompiler(code);
    }

</script>