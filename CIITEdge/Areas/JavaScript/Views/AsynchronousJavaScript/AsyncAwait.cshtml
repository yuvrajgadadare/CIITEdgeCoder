@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "Async and Await in JavaScript";
}

<style>

    #javascript-async-await-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-async-await-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    /* ==============================
       PAGE TITLE
       ============================== */

    #javascript-async-await-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-async-await-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    /* ==============================
       SECTION
       ============================== */

    #javascript-async-await-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-async-await-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 15px;
    }

    /* ==============================
       CONCEPT BOX
       ============================== */

    #javascript-async-await-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
        margin-top: 20px;
        margin-bottom: 30px;
    }

    #javascript-async-await-page .concept-box h5 {
        color: #5b21b6;
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-async-await-page .concept-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 10px;
    }

    #javascript-async-await-page .concept-box p:last-child {
        margin-bottom: 0;
    }

    /* ==============================
       ASYNC AWAIT DIAGRAM
       ============================== */

    #javascript-async-await-page .flow-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
        margin-top: 25px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    #javascript-async-await-page .flow-title {
        text-align: center;
        color: #5b21b6;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    #javascript-async-await-page .flow-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    #javascript-async-await-page .flow-box {
        min-width: 145px;
        padding: 18px 16px;
        text-align: center;
        background: #ffffff;
        border: 2px solid #7c3aed;
        border-radius: 10px;
        font-weight: 700;
        color: #212529;
    }

    #javascript-async-await-page .flow-box.highlight {
        background: #5b21b6;
        color: #ffffff;
        border-color: #5b21b6;
    }

    #javascript-async-await-page .flow-arrow {
        font-size: 25px;
        color: #7c3aed;
        font-weight: 700;
    }

    /* ==============================
       KEYWORD CARDS
       ============================== */

    #javascript-async-await-page .keyword-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 25px;
        margin-bottom: 30px;
    }

    #javascript-async-await-page .keyword-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
    }

    #javascript-async-await-page .keyword-card h4 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-async-await-page .keyword-card p {
        color: #495057;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* ==============================
       CODE BOX
       ============================== */

    #javascript-async-await-page .code-box {
        background: #212529;
        color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        overflow-x: auto;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* ==============================
       TRY IT - RIGHT SIDE
       ============================== */

    #javascript-async-await-page .try-it-wrapper {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 10px;
        margin-bottom: 20px;
    }

    #javascript-async-await-page .try-it-btn {
        background-color: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 6px;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    #javascript-async-await-page .try-it-btn:hover {
        background-color: #157347;
        border-color: #157347;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* ==============================
       OUTPUT
       ============================== */

    #javascript-async-await-page .output-box {
        background: #f8f9fa;
        border-left: 4px solid #198754;
        border-radius: 6px;
        padding: 14px 16px;
        margin-top: 5px;
        margin-bottom: 30px;
        color: #198754;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }

    /* ==============================
       NOTE BOX
       ============================== */

    #javascript-async-await-page .note-box {
        background: #fff8e1;
        border: 1px solid #ffe082;
        border-left: 5px solid #ffb300;
        border-radius: 8px;
        padding: 18px;
        margin-top: 20px;
        margin-bottom: 30px;
        color: #6d4c41;
        line-height: 1.7;
    }

    #javascript-async-await-page .note-box strong {
        color: #5d4037;
    }

    /* ==============================
       SUMMARY
       ============================== */

    #javascript-async-await-page .summary-box {
        background: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 8px;
        padding: 22px;
        margin-top: 30px;
    }

    #javascript-async-await-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-async-await-page .summary-box p {
        color: #075985;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* ==============================
       NAVIGATION
       ============================== */

    #javascript-async-await-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 40px;
        padding-top: 25px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-async-await-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

    #javascript-async-await-page .previous-btn {
        background-color: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    #javascript-async-await-page .previous-btn:hover {
        background-color: #e9ecef;
        color: #212529;
    }

    #javascript-async-await-page .next-btn {
        background-color: #5b21b6;
        color: #ffffff;
        border: 1px solid #5b21b6;
    }

    #javascript-async-await-page .next-btn:hover {
        background-color: #4c1d95;
        color: #ffffff;
    }

    /* ==============================
       RESPONSIVE
       ============================== */

    @@media (max-width: 768px) {

        #javascript-async-await-page .content-section {
            padding: 20px;
        }

        #javascript-async-await-page .page-title {
            font-size: 29px;
        }

        #javascript-async-await-page .keyword-grid {
            grid-template-columns: 1fr;
        }

        #javascript-async-await-page .flow-row {
            flex-direction: column;
        }

        #javascript-async-await-page .flow-arrow {
            transform: rotate(90deg);
        }

        #javascript-async-await-page .bottom-navigation {
            flex-direction: column;
        }

        #javascript-async-await-page .nav-btn {
            justify-content: center;
        }
    }

</style>


<main id="javascript-async-await-page">

    <div class="container-fluid">

        <div class="row g-4">

            <!-- =====================================================
                 LEFT SIDE - COURSE SYLLABUS
                 ===================================================== -->

            <aside class="col-lg-3">

                @Html.Partial(
                    "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
                )

            </aside>


            <!-- =====================================================
                 RIGHT SIDE - CONTENT
                 ===================================================== -->

            <section class="col-lg-9">

                <div class="content-section">

                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <h1 class="page-title">
                        Async and Await in JavaScript
                    </h1>

                    <p class="lead-text">
                        The <strong>async</strong> and <strong>await</strong>
                        keywords make Promise-based asynchronous JavaScript
                        easier to write, read, and understand.
                    </p>


                    <!-- =================================================
                         WHAT IS ASYNC/AWAIT?
                         ================================================= -->

                    <h2 class="section-title">
                        What are async and await?
                    </h2>

                    <p class="section-text">
                        JavaScript uses asynchronous programming to perform
                        time-consuming tasks without blocking the application.
                        Promises represent the result of an asynchronous
                        operation, while <strong>async</strong> and
                        <strong>await</strong> provide a cleaner way to work
                        with those Promises.
                    </p>

                    <div class="concept-box">

                        <h5>
                            Simple Definition
                        </h5>

                        <p>
                            <strong>async</strong> is used to declare an
                            asynchronous function.
                        </p>

                        <p>
                            <strong>await</strong> pauses the execution of an
                            async function until a Promise is completed.
                        </p>

                        <p>
                            Together, async and await make asynchronous code
                            look more like normal step-by-step code.
                        </p>

                    </div>


                    <!-- =================================================
                         ASYNC/AWAIT DIAGRAM
                         ================================================= -->

                    <div class="flow-card">

                        <div class="flow-title">
                            How async and await Work
                        </div>

                        <div class="flow-row">

                            <div class="flow-box highlight">
                                Start
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box">
                                async Function
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box">
                                await Promise
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box">
                                Result
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         KEYWORDS
                         ================================================= -->

                    <h2 class="section-title">
                        async vs await
                    </h2>

                    <div class="keyword-grid">

                        <div class="keyword-card">

                            <h4>
                                async
                            </h4>

                            <p>
                                The <strong>async</strong> keyword is placed
                                before a function. An async function returns
                                a Promise.
                            </p>

                        </div>


                        <div class="keyword-card">

                            <h4>
                                await
                            </h4>

                            <p>
                                The <strong>await</strong> keyword is used
                                inside an async function to wait for a
                                Promise to complete.
                            </p>

                        </div>

                    </div>


                    <!-- =================================================
                         IMPORTANT NOTE
                         ================================================= -->

                    <div class="note-box">

                        <strong>Important:</strong>
                        await is normally used inside an async function.
                        It makes Promise-based code easier to understand
                        because the code can be written in a sequential style.

                    </div>


                    <!-- =================================================
                         EXAMPLE 1
                         ================================================= -->

                    <h2 class="section-title">
                        Example 1: async Function
                    </h2>

                    <p class="section-text">
                        An async function automatically returns a Promise.
                    </p>

                    <pre class="code-box"><code>async function getMessage() {

    return "Hello from async function";

}

getMessage().then(function(result) {

    console.log(result);

});</code></pre>

                    <div class="try-it-wrapper">

                        <button type="button"
                                class="try-it-btn"
                                onclick="tryAsyncAwaitExample1()">

                            <span>▶</span>
                            <span>Try It</span>

                        </button>

                    </div>

                    <div class="output-box">
                        Hello from async function
                    </div>


                    <!-- =================================================
                         EXAMPLE 2
                         ================================================= -->

                    <h2 class="section-title">
                        Example 2: await with Promise
                    </h2>

                    <p class="section-text">
                        The await keyword waits for a Promise to complete
                        before continuing with the next statement.
                    </p>

                    <pre class="code-box"><code>function getData() {

    return Promise.resolve("Data received");

}

async function loadData() {

    const result = await getData();

    console.log(result);

}

loadData();</code></pre>

                    <div class="try-it-wrapper">

                        <button type="button"
                                class="try-it-btn"
                                onclick="tryAsyncAwaitExample2()">

                            <span>▶</span>
                            <span>Try It</span>

                        </button>

                    </div>

                    <div class="output-box">
                        Data received
                    </div>


                    <!-- =================================================
                         EXAMPLE 3
                         ================================================= -->

                    <h2 class="section-title">
                        Example 3: async/await with try-catch
                    </h2>

                    <p class="section-text">
                        async and await can also be used with
                        <strong>try-catch</strong> for error handling.
                    </p>

                    <pre class="code-box"><code>function getData() {

    return Promise.resolve("Data loaded successfully");

}

async function loadData() {

    try {

        const result = await getData();

        console.log(result);

    }
    catch (error) {

        console.log("Error:", error);

    }

}

loadData();</code></pre>

                    <div class="try-it-wrapper">

                        <button type="button"
                                class="try-it-btn"
                                onclick="tryAsyncAwaitExample3()">

                            <span>▶</span>
                            <span>Try It</span>

                        </button>

                    </div>

                    <div class="output-box">
                        Data loaded successfully
                    </div>


                    <!-- =================================================
                         WHY USE ASYNC/AWAIT
                         ================================================= -->

                    <h2 class="section-title">
                        Why Use async and await?
                    </h2>

                    <div class="concept-box">

                        <h5>
                            Important Benefits
                        </h5>

                        <p>
                            • Makes asynchronous code easier to read.
                        </p>

                        <p>
                            • Reduces complicated Promise chains.
                        </p>

                        <p>
                            • Makes asynchronous operations look sequential.
                        </p>

                        <p>
                            • Works naturally with try-catch error handling.
                        </p>

                        <p>
                            • Useful for API and network operations.
                        </p>

                    </div>


                    <!-- =================================================
                         REAL-WORLD FLOW
                         ================================================= -->

                    <h2 class="section-title">
                        Example 🌍🤓
                    </h2>

                    <p class="section-text">
                        In a real application, async and await are commonly
                        used when retrieving data from an API.
                    </p>

                    <div class="flow-card">

                        <div class="flow-title">
                            API Request Flow
                        </div>

                        <div class="flow-row">

                            <div class="flow-box">
                                User Action
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box">
                                API Request
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box highlight">
                                await
                            </div>

                            <div class="flow-arrow">
                                →
                            </div>

                            <div class="flow-box">
                                API Response
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         COMPILER NOTE
                         ================================================= -->

                    <div class="note-box">

                        <strong>Compiler Note:</strong>
                        The CIIT JavaScript compiler is console-based.
                        The Try It buttons below use compiler-safe code so
                        that the result is displayed immediately in the
                        compiler output window.

                    </div>


                    <!-- =================================================
                         SUMMARY
                         ================================================= -->

                    <div class="summary-box">

                        <h2 class="h4">
                            Summary
                        </h2>

                        <p>
                            The <strong>async</strong> keyword is used to
                            create an asynchronous function, while
                            <strong>await</strong> is used to wait for a
                            Promise inside that function. Together they make
                            asynchronous JavaScript easier to read and
                            maintain. They are commonly used with Promises,
                            API requests, and error handling with try-catch.
                        </p>

                    </div>


                    <!-- =================================================
                         NAVIGATION
                         ================================================= -->

                                     <div class="bottom-navigation">

                        <a href="@Url.Action("Promises", "AsynchronousJavaScript", new { area = "JavaScript" })"
                           class="nav-btn previous-btn">

                            <span>←</span>

                            <span>
                                Previous: Promises
                            </span>

                        </a>


                        <a href="@Url.Action("FetchAPI", "AsynchronousJavaScript", new { area = "JavaScript" })"
                           class="nav-btn next-btn">

                            <span>
                                Next: Fetch API
                            </span>

                            <span>→</span>

                        </a>

                    </div>

                </div>

            </section>

        </div>

    </div>

</main>


<script>

    /* =========================================================
       OPEN CIIT JAVASCRIPT COMPILER
       ========================================================= */

    function openCompiler(code) {

        var compilerUrl =
            "/JavaScriptCompiler/Index?code=" +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            "_blank"
        );

    }


    /* =========================================================
       EXAMPLE 1
       ASYNC FUNCTION
       Compiler-safe version
       ========================================================= */

    function tryAsyncAwaitExample1() {

        var code =
`function getMessage() {

    return "Hello from async function";

}

var result = getMessage();

console.log(result);`;

        openCompiler(code);

    }


    /* =========================================================
       EXAMPLE 2
       AWAIT CONCEPT
       Compiler-safe version
       ========================================================= */

    function tryAsyncAwaitExample2() {

        var code =
`function getData() {

    return "Data received";

}

var result = getData();

console.log(result);`;

        openCompiler(code);

    }


    /* =========================================================
       EXAMPLE 3
       ASYNC/AWAIT ERROR HANDLING
       Compiler-safe version
       ========================================================= */

    function tryAsyncAwaitExample3() {

        var code =
`function getData() {

    return "Data loaded successfully";

}

try {

    var result = getData();

    console.log(result);

}
catch (error) {

    console.log("Error:", error);

}`;

        openCompiler(code);

    }

</script>