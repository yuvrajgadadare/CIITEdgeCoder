@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "this Keyword";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    #javascript-this-keyword-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-this-keyword-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }


    /* =========================================================
       TITLE
       ========================================================= */

    #javascript-this-keyword-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-this-keyword-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }


    /* =========================================================
       SECTION
       ========================================================= */

    #javascript-this-keyword-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-this-keyword-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 14px;
    }


    /* =========================================================
       CONCEPT BOX
       ========================================================= */

    #javascript-this-keyword-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    #javascript-this-keyword-page .concept-box h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-this-keyword-page .concept-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 10px;
    }

    #javascript-this-keyword-page .concept-box p:last-child {
        margin-bottom: 0;
    }


    /* =========================================================
       ACTUAL THIS KEYWORD IMAGE
       ========================================================= */

    #javascript-this-keyword-page .image-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 15px;
        margin: 25px 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    #javascript-this-keyword-page .this-image {
        width: 100%;
        height: 380px;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        border-radius: 8px;
        background: #f8f9fa;
    }

    #javascript-this-keyword-page .image-caption {
        text-align: center;
        color: #6c757d;
        font-size: 13px;
        line-height: 1.6;
        margin: 12px 5px 0;
    }


    /* =========================================================
       KEY POINT CARDS
       ========================================================= */

    #javascript-this-keyword-page .point-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 7px rgba(0,0,0,0.04);
    }

    #javascript-this-keyword-page .point-card h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-this-keyword-page .point-card p {
        color: #6c757d;
        line-height: 1.7;
        margin-bottom: 0;
    }

    #javascript-this-keyword-page .point-label {
        display: inline-block;
        background: #f3ecff;
        color: #4c1d95;
        border: 1px solid #d8b4fe;
        border-radius: 6px;
        padding: 5px 9px;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
    }


    /* =========================================================
       DIAGRAM
       ========================================================= */

    #javascript-this-keyword-page .diagram-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 26px;
        margin: 28px 0;
    }

    #javascript-this-keyword-page .diagram-title {
        text-align: center;
        font-size: 18px;
        font-weight: 700;
        color: #5b21b6;
        margin-bottom: 25px;
    }

    #javascript-this-keyword-page .this-flow {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    #javascript-this-keyword-page .flow-box {
        background: #ffffff;
        border: 2px solid #d8dee9;
        border-radius: 9px;
        padding: 15px 18px;
        min-width: 145px;
        text-align: center;
        font-family: Consolas, Monaco, monospace;
        font-weight: 700;
        color: #212529;
    }

    #javascript-this-keyword-page .flow-box small {
        display: block;
        font-family: Arial, sans-serif;
        font-weight: 400;
        color: #6c757d;
        margin-top: 6px;
    }

    #javascript-this-keyword-page .this-highlight {
        background: #f3ecff;
        border-color: #7c3aed;
        color: #4c1d95;
    }

    #javascript-this-keyword-page .result-highlight {
        background: #ecfdf3;
        border-color: #198754;
        color: #157347;
    }

    #javascript-this-keyword-page .flow-arrow {
        color: #5b21b6;
        font-size: 24px;
        font-weight: 700;
    }

    #javascript-this-keyword-page .diagram-note {
        text-align: center;
        color: #6c757d;
        line-height: 1.7;
        margin-top: 20px;
        margin-bottom: 0;
    }


    /* =========================================================
       CODE
       ========================================================= */

    #javascript-this-keyword-page .code-section {
        margin-top: 15px;
        margin-bottom: 10px;
    }

    #javascript-this-keyword-page .code-box {
        background: #212529;
        color: #ffffff;
        border-radius: 8px;
        padding: 18px;
        overflow-x: auto;
        margin: 0;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }

    #javascript-this-keyword-page .code-box code {
        color: #ffffff;
    }


    /* =========================================================
       TRY IT
       ========================================================= */

    #javascript-this-keyword-page .try-it-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
        margin-bottom: 28px;
    }

    #javascript-this-keyword-page .try-it-btn {
        background-color: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 7px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        white-space: nowrap;
        min-width: 105px;
        transition: all 0.2s ease;
    }

    #javascript-this-keyword-page .try-it-btn:hover {
        background-color: #157347;
        border-color: #157347;
        transform: translateY(-1px);
    }


    /* =========================================================
       OUTPUT
       ========================================================= */

    #javascript-this-keyword-page .output-box {
        background: #f8f9fa;
        border-left: 4px solid #198754;
        border-radius: 7px;
        padding: 15px 17px;
        margin-top: 12px;
        color: #198754;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }


    /* =========================================================
       SUMMARY
       ========================================================= */

    #javascript-this-keyword-page .summary-box {
        background: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 10px;
        padding: 22px;
        margin-top: 32px;
    }

    #javascript-this-keyword-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-this-keyword-page .summary-box p {
        color: #075985;
        line-height: 1.8;
        margin-bottom: 0;
    }


    /* =========================================================
       BOTTOM NAVIGATION
       ========================================================= */

    #javascript-this-keyword-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-this-keyword-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    #javascript-this-keyword-page .previous-btn {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    #javascript-this-keyword-page .previous-btn:hover {
        background: #e9ecef;
        color: #212529;
        text-decoration: none;
    }

    #javascript-this-keyword-page .next-btn {
        background: #5b21b6;
        color: #ffffff;
        border: 1px solid #5b21b6;
    }

    #javascript-this-keyword-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
        text-decoration: none;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 992px) {

        #javascript-this-keyword-page .bottom-navigation {
            flex-direction: column;
            align-items: stretch;
        }

        #javascript-this-keyword-page .nav-btn {
            justify-content: center;
        }

    }

    @@media (max-width: 768px) {

        #javascript-this-keyword-page .content-section {
            padding: 24px;
        }

        #javascript-this-keyword-page .page-title {
            font-size: 30px;
        }

        #javascript-this-keyword-page .this-image {
            height: 270px;
        }

        #javascript-this-keyword-page .this-flow {
            flex-direction: column;
        }

        #javascript-this-keyword-page .flow-arrow {
            transform: rotate(90deg);
        }

    }

</style>


<main id="javascript-this-keyword-page" class="container">

    <div class="row g-4">


        <!-- =====================================================
             LEFT SIDE - JAVASCRIPT SYLLABUS
             ===================================================== -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
            )

        </aside>


        <!-- =====================================================
             RIGHT SIDE - CONTENT
             ===================================================== -->

        <section class="col-lg-9">

            <div class="content-section">


                <!-- =================================================
                     PAGE TITLE
                     ================================================= -->

                <h1 class="page-title">
                    this Keyword
                </h1>

                <p class="lead-text">
                    Learn how the JavaScript <strong>this</strong> keyword
                    refers to the object on which a method is called and
                    how it helps methods work with object properties.
                </p>


                <!-- =================================================
                     WHAT IS THIS?
                     ================================================= -->

                <h2 class="section-title">
                    What is the this Keyword?
                </h2>

                <p class="section-text">
                    The <strong>this</strong> keyword is a special JavaScript
                    keyword used inside functions and methods.
                </p>

                <p class="section-text">
                    When a regular function is called as an object method,
                    <strong>this</strong> refers to the object on which that
                    method was called. :chatgpt-content-reference{index="1"}
                </p>


                <!-- =================================================
                     CONCEPT BOX
                     ================================================= -->

                <div class="concept-box">

                    <h5>
                        Simple Rule
                    </h5>

                    <p>
                        When we write:
                        <strong>object.method()</strong>
                    </p>

                    <p>
                        Inside that regular method,
                        <strong>this</strong> refers to
                        <strong>object</strong>.
                    </p>

                </div>


                <!-- =================================================
                     ACTUAL THIS KEYWORD IMAGE
                     ================================================= -->

                <div class="image-card">

                    <img src="https://media2.dev.to/dynamic/image/width%3D800%2Cheight%3D%2Cfit%3Dscale-down%2Cgravity%3Dauto%2Cformat%3Dauto/https%3A/dev-to-uploads.s3.amazonaws.com/uploads/articles/x7grjudrlu7wy2017r4r.png"
                         alt="JavaScript this keyword inside object method"
                         class="this-image" />

                    <p class="image-caption">
                        The this keyword inside an object method refers to
                        the object on which that method is called.
                    </p>

                </div>


                <!-- =================================================
                     KEY POINTS
                     ================================================= -->

                <h2 class="section-title">
                    Understanding this
                </h2>

                <div class="row g-3">


                    <div class="col-md-4">

                        <div class="point-card">

                            <span class="point-label">
                                this
                            </span>

                            <h5>
                                Current Object
                            </h5>

                            <p>
                                Inside a regular object method,
                                this refers to the object used
                                to call that method.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="point-card">

                            <span class="point-label">
                                this.name
                            </span>

                            <h5>
                                Access Property
                            </h5>

                            <p>
                                We can use this to access properties
                                belonging to the current object.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="point-card">

                            <span class="point-label">
                                this.course
                            </span>

                            <h5>
                                Reusable Method
                            </h5>

                            <p>
                                The same method logic can work with
                                different objects and their data.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     DIAGRAM
                     ================================================= -->

                <div class="diagram-box">

                    <div class="diagram-title">
                        How this Works Inside an Object Method
                    </div>

                    <div class="this-flow">

                        <div class="flow-box">
                            learner
                            <small>Object</small>
                        </div>

                        <div class="flow-arrow">
                            →
                        </div>

                        <div class="flow-box">
                            greet()
                            <small>Method Call</small>
                        </div>

                        <div class="flow-arrow">
                            →
                        </div>

                        <div class="flow-box this-highlight">
                            this
                            <small>Refers to learner</small>
                        </div>

                        <div class="flow-arrow">
                            →
                        </div>

                        <div class="flow-box result-highlight">
                            this.name
                            <small>Object Property</small>
                        </div>

                    </div>

                    <p class="diagram-note">
                        In <strong>learner.greet()</strong>, the object before
                        the dot becomes the value of <strong>this</strong>
                        inside the regular method.
                    </p>

                </div>


                <!-- =================================================
                     EXAMPLE 1
                     ================================================= -->

                <h2 class="section-title">
                    Example 1: Accessing an Object Property
                </h2>

                <p class="section-text">
                    The <strong>this</strong> keyword can be used to access
                    a property of the current object.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let learner = {

    name: "Rahul",

    introduce: function () {
        console.log("My name is " + this.name);
    }

};

learner.introduce();</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runThisExample1()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: My name is Rahul
                </div>


                <!-- =================================================
                     EXAMPLE 2
                     ================================================= -->

                <h2 class="section-title">
                    Example 2: Accessing Multiple Properties
                </h2>

                <p class="section-text">
                    A method can use <strong>this</strong> to access
                    multiple properties of the same object.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = {

    title: "JavaScript",
    duration: "3 Months",

    showInfo: function () {
        console.log(this.title);
        console.log(this.duration);
    }

};

course.showInfo();</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runThisExample2()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: JavaScript<br />
                    Output: 3 Months
                </div>


                <!-- =================================================
                     EXAMPLE 3
                     ================================================= -->

                <h2 class="section-title">
                    Example 3: Same Method with Different Objects
                </h2>

                <p class="section-text">
                    The value of <strong>this</strong> depends on which
                    object calls the method. The same function can therefore
                    work with different objects.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>function showName() {
    console.log(this.name);
}

let trainer = {
    name: "Sneha",
    showName: showName
};

let developer = {
    name: "Vikram",
    showName: showName
};

trainer.showName();
developer.showName();</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runThisExample3()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: Sneha<br />
                    Output: Vikram
                </div>


                <!-- =================================================
                     EXAMPLE 4
                     ================================================= -->

                <h2 class="section-title">
                    Example 4: Using this to Calculate a Value
                </h2>

                <p class="section-text">
                    The <strong>this</strong> keyword can also be used
                    to perform calculations using values stored inside
                    the current object.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let product = {

    price: 500,
    quantity: 3,

    getTotal: function () {
        return this.price * this.quantity;
    }

};

console.log(product.getTotal());</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runThisExample4()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: 1500
                </div>


                <!-- =================================================
                     IMPORTANT NOTE
                     ================================================= -->

                <div class="concept-box">

                    <h5>
                        Important
                    </h5>

                    <p>
                        Do not think of <strong>this</strong> as always
                        meaning one fixed object. Its value depends on
                        how the function is called. :chatgpt-content-reference{index="2"}
                    </p>

                    <p>
                        For the object-method examples on this page,
                        remember this simple pattern:
                        <strong>object.method()</strong> →
                        <strong>this = object</strong>.
                    </p>

                </div>


                <!-- =================================================
                     SUMMARY
                     ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        The <strong>this</strong> keyword provides a way
                        for a regular object method to refer to the object
                        on which the method is called. It can be used to
                        access properties such as
                        <strong>this.name</strong>,
                        <strong>this.course</strong>, and
                        <strong>this.price</strong>. Its value depends on
                        how the function is invoked. :chatgpt-content-reference{index="3"}
                    </p>

                </div>


                <!-- =================================================
                     BOTTOM NAVIGATION
                     ================================================= -->

                <div class="bottom-navigation">

                    <a href="@Url.Action("ObjectMethods", "Objects", new { area = "JavaScript" })"
                       class="nav-btn previous-btn">

                        <span>
                            ←
                        </span>

                        <span>
                            Previous: Object Methods
                        </span>

                    </a>


                    <a href="@Url.Action("Destructuring", "Objects", new { area = "JavaScript" })"
                       class="nav-btn next-btn">

                        <span>
                            Next: Destructuring
                        </span>

                        <span>
                            →
                        </span>

                    </a>

                </div>

            </div>

        </section>

    </div>

</main>


<script>

    /* =========================================================
       COMPILER
       ========================================================= */

    function openCompiler(code) {

        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );

    }


    /* =========================================================
       EXAMPLE 1
       ========================================================= */

    function runThisExample1() {

        const code =
            'let learner = {\\n' +
            '\\n' +
            '    name: "Rahul",\\n' +
            '\\n' +
            '    introduce: function () {\\n' +
            '        console.log("My name is " + this.name);\\n' +
            '    }\\n' +
            '\\n' +
            '};\\n' +
            '\\n' +
            'learner.introduce();';

        openCompiler(code);

    }


    /* =========================================================
       EXAMPLE 2
       ========================================================= */

    function runThisExample2() {

        const code =
            'let course = {\\n' +
            '\\n' +
            '    title: "JavaScript",\\n' +
            '    duration: "3 Months",\\n' +
            '\\n' +
            '    showInfo: function () {\\n' +
            '        console.log(this.title);\\n' +
            '        console.log(this.duration);\\n' +
            '    }\\n' +
            '\\n' +
            '};\\n' +
            '\\n' +
            'course.showInfo();';

        openCompiler(code);

    }


    /* =========================================================
       EXAMPLE 3
       ========================================================= */

    function runThisExample3() {

        const code =
            'function showName() {\\n' +
            '    console.log(this.name);\\n' +
            '}\\n' +
            '\\n' +
            'let trainer = {\\n' +
            '    name: "Sneha",\\n' +
            '    showName: showName\\n' +
            '};\\n' +
            '\\n' +
            'let developer = {\\n' +
            '    name: "Vikram",\\n' +
            '    showName: showName\\n' +
            '};\\n' +
            '\\n' +
            'trainer.showName();\\n' +
            'developer.showName();';

        openCompiler(code);

    }


    /* =========================================================
       EXAMPLE 4
       ========================================================= */

    function runThisExample4() {

        const code =
            'let product = {\\n' +
            '\\n' +
            '    price: 500,\\n' +
            '    quantity: 3,\\n' +
            '\\n' +
            '    getTotal: function () {\\n' +
            '        return this.price * this.quantity;\\n' +
            '    }\\n' +
            '\\n' +
            '};\\n' +
            '\\n' +
            'console.log(product.getTotal());';

        openCompiler(code);

    }

</script>