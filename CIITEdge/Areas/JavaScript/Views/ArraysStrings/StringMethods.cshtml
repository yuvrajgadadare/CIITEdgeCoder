@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "String Methods";
}

<style>

    #javascript-string-methods-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

        #javascript-string-methods-page .content-section {
            background: #ffffff;
            border-radius: 12px;
            padding: 32px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        #javascript-string-methods-page .page-title {
            font-size: 36px;
            font-weight: 700;
            color: #212529;
            margin-bottom: 12px;
        }

        #javascript-string-methods-page .lead-text {
            color: #6c757d;
            font-size: 17px;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        #javascript-string-methods-page .section-title {
            font-size: 27px;
            font-weight: 700;
            color: #212529;
            margin-top: 32px;
            margin-bottom: 15px;
        }

        #javascript-string-methods-page .section-text {
            color: #495057;
            font-size: 16px;
            line-height: 1.85;
            margin-bottom: 14px;
        }

        /* =========================================================
           CONCEPT BOX
           ========================================================= */

        #javascript-string-methods-page .concept-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
        }

            #javascript-string-methods-page .concept-box h5 {
                color: #5b21b6;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #javascript-string-methods-page .concept-box p {
                color: #495057;
                line-height: 1.8;
                margin-bottom: 10px;
            }

                #javascript-string-methods-page .concept-box p:last-child {
                    margin-bottom: 0;
                }

        /* =========================================================
           IMAGE
           ========================================================= */

        #javascript-string-methods-page .image-card {
            background: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 15px;
            margin: 25px 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        #javascript-string-methods-page .methods-image {
            width: 100%;
            height: 360px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 8px;
        }

        #javascript-string-methods-page .image-caption {
            text-align: center;
            color: #6c757d;
            font-size: 13px;
            margin: 12px 5px 0;
        }

        /* =========================================================
           METHOD CARDS
           ========================================================= */

        #javascript-string-methods-page .method-card {
            height: 100%;
            background: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
        }

            #javascript-string-methods-page .method-card h5 {
                color: #5b21b6;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #javascript-string-methods-page .method-card p {
                color: #6c757d;
                line-height: 1.7;
                margin-bottom: 0;
            }

        #javascript-string-methods-page .method-name {
            display: inline-block;
            background: #f3ecff;
            color: #4c1d95;
            border: 1px solid #d8b4fe;
            border-radius: 6px;
            padding: 5px 9px;
            font-family: Consolas, Monaco, monospace;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        /* =========================================================
           DIAGRAM
           ========================================================= */

        #javascript-string-methods-page .diagram-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 25px;
            margin: 25px 0;
        }

        #javascript-string-methods-page .diagram-title {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            color: #5b21b6;
            margin-bottom: 24px;
        }

        #javascript-string-methods-page .method-flow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        #javascript-string-methods-page .string-box {
            background: #ffffff;
            border: 2px solid #d8dee9;
            border-radius: 9px;
            padding: 15px 18px;
            font-family: Consolas, Monaco, monospace;
            font-weight: 700;
            color: #212529;
            text-align: center;
            min-width: 190px;
        }

        #javascript-string-methods-page .method-arrow {
            font-size: 24px;
            font-weight: 700;
            color: #5b21b6;
        }

        #javascript-string-methods-page .method-highlight {
            background: #f3ecff;
            border: 2px solid #7c3aed;
            color: #4c1d95;
        }

        #javascript-string-methods-page .diagram-note {
            text-align: center;
            color: #6c757d;
            margin-top: 18px;
            margin-bottom: 0;
            line-height: 1.7;
        }

        /* =========================================================
           CODE
           ========================================================= */

        #javascript-string-methods-page .code-section {
            margin-top: 15px;
            margin-bottom: 10px;
        }

        #javascript-string-methods-page .code-box {
            background: #212529;
            color: #ffffff;
            border-radius: 8px;
            padding: 18px;
            overflow-x: auto;
            margin: 0;
            font-family: Consolas, Monaco, monospace;
            font-size: 14px;
            line-height: 1.8;
        }

            #javascript-string-methods-page .code-box code {
                color: #ffffff;
            }

        /* =========================================================
           TRY IT
           ========================================================= */

        #javascript-string-methods-page .try-it-wrapper {
            display: flex;
            justify-content: flex-end;
            margin-top: 10px;
            margin-bottom: 28px;
        }

        #javascript-string-methods-page .try-it-btn {
            background-color: #198754;
            color: #ffffff;
            border: 1px solid #198754;
            border-radius: 7px;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            white-space: nowrap;
            min-width: 105px;
            transition: all 0.2s ease;
        }

            #javascript-string-methods-page .try-it-btn:hover {
                background-color: #157347;
                border-color: #157347;
                transform: translateY(-1px);
            }

        /* =========================================================
           OUTPUT
           ========================================================= */

        #javascript-string-methods-page .output-box {
            background: #f8f9fa;
            border-left: 4px solid #198754;
            border-radius: 7px;
            padding: 15px 17px;
            margin-top: 12px;
            color: #198754;
            font-family: Consolas, Monaco, monospace;
            font-size: 14px;
            line-height: 1.8;
        }

        /* =========================================================
           SUMMARY
           ========================================================= */

        #javascript-string-methods-page .summary-box {
            background: #e0f7fa;
            border: 1px solid #90e0ef;
            border-radius: 10px;
            padding: 22px;
            margin-top: 32px;
        }

            #javascript-string-methods-page .summary-box h2 {
                color: #075985;
                font-weight: 700;
                margin-bottom: 12px;
            }

            #javascript-string-methods-page .summary-box p {
                color: #075985;
                line-height: 1.8;
                margin-bottom: 0;
            }

        /* =========================================================
           BOTTOM NAVIGATION
           ========================================================= */

        #javascript-string-methods-page .bottom-navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px solid #dee2e6;
        }

        #javascript-string-methods-page .nav-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 18px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        #javascript-string-methods-page .previous-btn {
            background: #f1f3f5;
            color: #495057;
            border: 1px solid #dee2e6;
        }

            #javascript-string-methods-page .previous-btn:hover {
                background: #e9ecef;
                color: #212529;
                text-decoration: none;
            }

        #javascript-string-methods-page .next-btn {
            background: #5b21b6;
            color: #ffffff;
            border: 1px solid #5b21b6;
        }

            #javascript-string-methods-page .next-btn:hover {
                background: #4c1d95;
                color: #ffffff;
                text-decoration: none;
            }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 992px) {

        #javascript-string-methods-page .bottom-navigation {
            flex-direction: column;
            align-items: stretch;
        }

        #javascript-string-methods-page .nav-btn {
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {

        #javascript-string-methods-page .content-section {
            padding: 24px;
        }

        #javascript-string-methods-page .page-title {
            font-size: 30px;
        }

        #javascript-string-methods-page .methods-image {
            height: 260px;
        }

        #javascript-string-methods-page .method-flow {
            flex-direction: column;
        }

        #javascript-string-methods-page .method-arrow {
            transform: rotate(90deg);
        }
    }

</style>


<main id="javascript-string-methods-page" class="container">

    <div class="row g-4">

        <!-- =====================================================
             LEFT SIDE - COURSE SYLLABUS
             ===================================================== -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
            )

        </aside>


        <!-- =====================================================
             RIGHT SIDE - CONTENT
             ===================================================== -->

        <section class="col-lg-9">

            <div class="content-section">

                <!-- PAGE TITLE -->

                <h1 class="page-title">
                    String Methods
                </h1>

                <p class="lead-text">
                    JavaScript provides built-in methods that make it easier
                    to work with and manipulate string values.
                </p>


                <!-- =================================================
                     WHAT ARE STRING METHODS?
                     ================================================= -->

                <h2 class="section-title">
                    What are String Methods?
                </h2>

                <p class="section-text">
                    String methods are built-in JavaScript functions that
                    help us perform common operations on strings.
                </p>

                <p class="section-text">
                    We can use string methods to change the case of text,
                    extract part of a string, replace text, search text,
                    and perform many other operations.
                </p>


                <!-- =================================================
                     CONCEPT BOX
                     ================================================= -->

                <div class="concept-box">

                    <h5>
                        Why Do We Use String Methods?
                    </h5>

                    <p>
                        String methods make text manipulation easier,
                        shorter, and easier to understand.
                    </p>

                    <p>
                        Common methods include
                        <strong>toUpperCase()</strong>,
                        <strong>toLowerCase()</strong>,
                        <strong>slice()</strong>, and
                        <strong>replace()</strong>.
                    </p>

                </div>


                <!-- =================================================
                     ACTUAL STRING METHODS IMAGE
                     ================================================= -->

                <div class="image-card">

                    <img src="https://miro.medium.com/v2/resize%3Afit%3A1400/1%2AyUhwb2kicg_5tDM5aP8HrA.png"
                         alt="JavaScript String slice method"
                         class="methods-image" />

                    <p class="image-caption">
                        JavaScript String Methods - Example of the slice() method
                    </p>

                </div>


                <!-- =================================================
                     METHOD CARDS
                     ================================================= -->

                <h2 class="section-title">
                    Common String Methods
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="method-card">

                            <span class="method-name">
                                toUpperCase()
                            </span>

                            <h5>
                                Convert to Uppercase
                            </h5>

                            <p>
                                Converts all characters in a string
                                into uppercase letters.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="method-card">

                            <span class="method-name">
                                toLowerCase()
                            </span>

                            <h5>
                                Convert to Lowercase
                            </h5>

                            <p>
                                Converts all characters in a string
                                into lowercase letters.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="method-card">

                            <span class="method-name">
                                slice()
                            </span>

                            <h5>
                                Extract String
                            </h5>

                            <p>
                                Extracts a part of a string using
                                start and end positions.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="method-card">

                            <span class="method-name">
                                replace()
                            </span>

                            <h5>
                                Replace Text
                            </h5>

                            <p>
                                Replaces matching text with another
                                value and returns a new string.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     DIAGRAM
                     ================================================= -->

                <h2 class="section-title">
                    How String Methods Work
                </h2>

                <div class="diagram-box">

                    <div class="diagram-title">
                        String Method Flow
                    </div>

                    <div class="method-flow">

                        <div class="string-box">
                            "javascript"
                        </div>

                        <div class="method-arrow">
                            →
                        </div>

                        <div class="string-box method-highlight">
                            toUpperCase()
                        </div>

                        <div class="method-arrow">
                            →
                        </div>

                        <div class="string-box">
                            "JAVASCRIPT"
                        </div>

                    </div>

                    <p class="diagram-note">
                        The <strong>toUpperCase()</strong> method returns
                        a new string with all letters converted to uppercase.
                    </p>

                </div>


                <!-- =================================================
                     EXAMPLE 1
                     ================================================= -->

                <h2 class="section-title">
                    Example 1: toUpperCase()
                </h2>

                <p class="section-text">
                    The <strong>toUpperCase()</strong> method converts
                    all characters of a string into uppercase.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = "JavaScript";

console.log(course.toUpperCase());</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringMethodExample1()">

                        <span>▶</span>

                        <span>
                            Try It
                        </span>

                    </button>

                </div>

                <div class="output-box">
                    Output: JAVASCRIPT
                </div>


                <!-- =================================================
                     EXAMPLE 2
                     ================================================= -->

                <h2 class="section-title">
                    Example 2: toLowerCase()
                </h2>

                <p class="section-text">
                    The <strong>toLowerCase()</strong> method converts
                    all characters of a string into lowercase.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let message = "WELCOME TO CIIT";

console.log(message.toLowerCase());</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringMethodExample2()">

                        <span>▶</span>

                        <span>
                            Try It
                        </span>

                    </button>

                </div>

                <div class="output-box">
                    Output: welcome to ciit
                </div>


                <!-- =================================================
                     EXAMPLE 3
                     ================================================= -->

                <h2 class="section-title">
                    Example 3: slice()
                </h2>

                <p class="section-text">
                    The <strong>slice()</strong> method extracts a part
                    of a string using starting and ending indexes.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = "JavaScript";

console.log(course.slice(0, 4));</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringMethodExample3()">

                        <span>▶</span>

                        <span>
                            Try It
                        </span>

                    </button>

                </div>

                <div class="output-box">
                    Output: Java
                </div>


                <!-- =================================================
                     EXAMPLE 4
                     ================================================= -->

                <h2 class="section-title">
                    Example 4: replace()
                </h2>

                <p class="section-text">
                    The <strong>replace()</strong> method replaces
                    matching text with another value.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let message = "Learn Java";

let updatedMessage =
    message.replace("Java", "JavaScript");

console.log(updatedMessage);</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringMethodExample4()">

                        <span>▶</span>

                        <span>
                            Try It
                        </span>

                    </button>

                </div>

                <div class="output-box">
                    Output: Learn JavaScript
                </div>


                <!-- =================================================
                     SUMMARY
                     ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        JavaScript string methods provide ready-to-use
                        operations for working with text. The
                        <strong>toUpperCase()</strong> method converts
                        text to uppercase,
                        <strong>toLowerCase()</strong> converts text
                        to lowercase,
                        <strong>slice()</strong> extracts part of a
                        string, and <strong>replace()</strong> replaces
                        matching text.
                    </p>

                </div>


                <!-- =================================================
     BOTTOM NAVIGATION
     ================================================= -->

                <div class="bottom-navigation">

                    <a href="@Url.Action("Strings", "ArraysStrings", new { area = "JavaScript" })"
                       class="nav-btn previous-btn">

                        <span>
                            ←
                        </span>

                        <span>
                            Previous: Strings
                        </span>

                    </a>


                   <a href="@Url.Action("Index", "Objects", new { area = "JavaScript" })"
   class="nav-btn next-btn">

    <span>
        Next: JavaScript Objects
    </span>

    <span>
        →
    </span>

</a>

                </div>
        </section>

    </div>

</main>


<script>

    function openCompiler(code) {

        /* Fix literal \n before sending code */
        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );

    }


    function runStringMethodExample1() {

        const code =
            'let course = "JavaScript";\\n' +
            '\\n' +
            'console.log(course.toUpperCase());';

        openCompiler(code);

    }


    function runStringMethodExample2() {

        const code =
            'let message = "WELCOME TO CIIT";\\n' +
            '\\n' +
            'console.log(message.toLowerCase());';

        openCompiler(code);

    }


    function runStringMethodExample3() {

        const code =
            'let course = "JavaScript";\\n' +
            '\\n' +
            'console.log(course.slice(0, 4));';

        openCompiler(code);

    }


    function runStringMethodExample4() {

        const code =
            'let message = "Learn Java";\\n' +
            '\\n' +
            'let updatedMessage =\\n' +
            '    message.replace("Java", "JavaScript");\\n' +
            '\\n' +
            'console.log(updatedMessage);';

        openCompiler(code);

    }

</script>