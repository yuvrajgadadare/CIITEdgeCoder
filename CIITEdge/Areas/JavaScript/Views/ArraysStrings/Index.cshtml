@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "Arrays & Strings";
}

<style>
    #javascript-arrays-strings-page {
        padding: 30px 0 50px;
    }

    #javascript-arrays-strings-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }

    #javascript-arrays-strings-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 15px;
    }

    #javascript-arrays-strings-page .lead-text {
        font-size: 17px;
        line-height: 1.8;
        color: #6c757d;
        margin-bottom: 30px;
    }

    #javascript-arrays-strings-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #javascript-arrays-strings-page .section-text {
        font-size: 16px;
        line-height: 1.85;
        color: #555;
    }

    /* =========================
       CONCEPT BOX
       ========================= */

    #javascript-arrays-strings-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    /* =========================
       IMAGE / VISUAL
       ========================= */

    #javascript-arrays-strings-page .image-card {
        background: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 15px;
        margin: 25px 0;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    #javascript-arrays-strings-page .arrays-strings-image {
        width: 100%;
        height: 300px;
        display: block;
        border-radius: 8px;
        background: #f8f9fa;
    }

    #javascript-arrays-strings-page .image-caption {
        margin: 12px 5px 0;
        text-align: center;
        color: #6c757d;
        font-size: 14px;
    }

    /* =========================
       PART CARDS
       ========================= */

    #javascript-arrays-strings-page .part-card {
        border: 1px solid #e1e5e9;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
        background: #ffffff;
    }

    #javascript-arrays-strings-page .part-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #6f42c1;
        color: #ffffff;
        font-weight: 700;
        margin-right: 10px;
    }

    /* =========================
       DIAGRAM
       ========================= */

    #javascript-arrays-strings-page .diagram-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 25px;
        margin: 25px 0;
        text-align: center;
    }

    #javascript-arrays-strings-page .diagram-title {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #212529;
    }

    #javascript-arrays-strings-page .data-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    #javascript-arrays-strings-page .diagram-item {
        background: #ffffff;
        border: 2px solid #6f42c1;
        border-radius: 10px;
        padding: 16px 20px;
        min-width: 155px;
        font-weight: 600;
    }

    #javascript-arrays-strings-page .diagram-highlight {
        background: #6f42c1;
        color: #ffffff;
    }

    #javascript-arrays-strings-page .diagram-arrow {
        font-size: 25px;
        font-weight: bold;
        color: #6f42c1;
    }

    /* =========================
       CODE BOX
       ========================= */

    #javascript-arrays-strings-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 22px;
        border-radius: 10px;
        margin: 18px 0 10px;
        overflow-x: auto;
    }

    #javascript-arrays-strings-page .code-box pre {
        margin: 0;
        color: #f8f9fa;
        font-size: 15px;
        line-height: 1.7;
    }

    /* =========================
       TRY IT
       ========================= */

    #javascript-arrays-strings-page .try-it-container {
        text-align: right;
        margin-top: 10px;
        margin-bottom: 30px;
    }

    #javascript-arrays-strings-page .try-it-btn {
        background: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 7px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        min-width: 105px;
    }

    #javascript-arrays-strings-page .try-it-btn:hover {
        background: #157347;
        border-color: #157347;
    }

    /* =========================
       OUTPUT
       ========================= */

    #javascript-arrays-strings-page .output-box {
        background: #f8f9fa;
        border-left: 4px solid #198754;
        border-radius: 7px;
        padding: 15px 18px;
        margin: 15px 0 25px;
        color: #198754;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }

    /* =========================
       NOTE
       ========================= */

    #javascript-arrays-strings-page .note-box {
        background: #fff8e1;
        border-left: 4px solid #ffc107;
        border-radius: 7px;
        padding: 18px;
        margin: 25px 0;
    }

    /* =========================
       SUMMARY
       ========================= */

    #javascript-arrays-strings-page .summary-box {
        background: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 10px;
        padding: 22px;
        margin-top: 32px;
    }

    #javascript-arrays-strings-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-arrays-strings-page .summary-box p {
        color: #075985;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* =========================
       NAVIGATION
       ========================= */

    #javascript-arrays-strings-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-arrays-strings-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    #javascript-arrays-strings-page .previous-btn {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    #javascript-arrays-strings-page .next-btn {
        background: #5b21b6;
        color: #ffffff;
        border: 1px solid #5b21b6;
    }

    #javascript-arrays-strings-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 768px) {

        #javascript-arrays-strings-page .content-section {
            padding: 24px;
        }

        #javascript-arrays-strings-page .page-title {
            font-size: 30px;
        }

        #javascript-arrays-strings-page .arrays-strings-image {
            height: 220px;
        }

        #javascript-arrays-strings-page .bottom-navigation {
            flex-direction: column;
            align-items: stretch;
        }

        #javascript-arrays-strings-page .nav-btn {
            justify-content: center;
        }
    }
</style>


<main id="javascript-arrays-strings-page" class="container">

    <div class="row g-4">

