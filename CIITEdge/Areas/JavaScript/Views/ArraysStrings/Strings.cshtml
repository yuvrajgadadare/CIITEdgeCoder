@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "Strings";
}

<style>

    #javascript-strings-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-strings-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    #javascript-strings-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-strings-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    #javascript-strings-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-strings-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 14px;
    }

    /* =========================
       CONCEPT BOX
       ========================= */

    #javascript-strings-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    #javascript-strings-page .concept-box h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-strings-page .concept-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 10px;
    }

    #javascript-strings-page .concept-box p:last-child {
        margin-bottom: 0;
    }

    /* =========================
       IMAGE
       ========================= */

    #javascript-strings-page .image-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 15px;
        margin: 25px 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    #javascript-strings-page .strings-image {
        width: 100%;
        height: 360px;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        border-radius: 8px;
    }

    #javascript-strings-page .image-caption {
        text-align: center;
        color: #6c757d;
        font-size: 13px;
        margin: 12px 5px 0;
    }

    /* =========================
       STRING FEATURES
       ========================= */

    #javascript-strings-page .feature-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #javascript-strings-page .feature-name {
        display: inline-block;
        background: #f3ecff;
        color: #4c1d95;
        border: 1px solid #d8b4fe;
        border-radius: 6px;
        padding: 5px 9px;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-strings-page .feature-card h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-strings-page .feature-card p {
        color: #6c757d;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* =========================
       DIAGRAM
       ========================= */

    #javascript-strings-page .diagram-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 25px;
        margin: 25px 0;
    }

    #javascript-strings-page .diagram-title {
        text-align: center;
        font-size: 18px;
        font-weight: 700;
        color: #5b21b6;
        margin-bottom: 24px;
    }

    #javascript-strings-page .string-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    #javascript-strings-page .character-box {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 2px solid #d8dee9;
        border-radius: 8px;
        font-family: Consolas, Monaco, monospace;
        font-size: 20px;
        font-weight: 700;
        color: #212529;
    }

    #javascript-strings-page .index-number {
        text-align: center;
        color: #6c757d;
        font-size: 13px;
        font-family: Consolas, Monaco, monospace;
        margin-top: 6px;
    }

    #javascript-strings-page .diagram-note {
        text-align: center;
        color: #6c757d;
        margin-top: 20px;
        margin-bottom: 0;
        line-height: 1.7;
    }

    /* =========================
       CODE
       ========================= */

    #javascript-strings-page .code-section {
        margin-top: 15px;
        margin-bottom: 10px;
    }

    #javascript-strings-page .code-box {
        background: #212529;
        color: #ffffff;
        border-radius: 8px;
        padding: 18px;
        overflow-x: auto;
        margin: 0;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }

    #javascript-strings-page .code-box code {
        color: #ffffff;
    }

    /* =========================
       TRY IT
       ========================= */

    #javascript-strings-page .try-it-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
        margin-bottom: 28px;
    }

    #javascript-strings-page .try-it-btn {
        background-color: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 7px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        white-space: nowrap;
        min-width: 105px;
        transition: all 0.2s ease;
    }

    #javascript-strings-page .try-it-btn:hover {
        background-color: #157347;
        border-color: #157347;
        transform: translateY(-1px);
    }

    /* =========================
       OUTPUT
       ========================= */

    #javascript-strings-page .output-box {
        background: #f8f9fa;
        border-left: 4px solid #198754;
        border-radius: 7px;
        padding: 15px 17px;
        margin-top: 12px;
        color: #198754;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.8;
    }

    /* =========================
       SUMMARY
       ========================= */

    #javascript-strings-page .summary-box {
        background: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 10px;
        padding: 22px;
        margin-top: 32px;
    }

    #javascript-strings-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-strings-page .summary-box p {
        color: #075985;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* =========================
       NAVIGATION
       ========================= */

    #javascript-strings-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-strings-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    #javascript-strings-page .previous-btn {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    #javascript-strings-page .previous-btn:hover {
        background: #e9ecef;
        color: #212529;
        text-decoration: none;
    }

    #javascript-strings-page .next-btn {
        background: #5b21b6;
        color: #ffffff;
        border: 1px solid #5b21b6;
    }

    #javascript-strings-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
        text-decoration: none;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 992px) {

        #javascript-strings-page .bottom-navigation {
            flex-direction: column;
            align-items: stretch;
        }

        #javascript-strings-page .nav-btn {
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {

        #javascript-strings-page .content-section {
            padding: 24px;
        }

        #javascript-strings-page .page-title {
            font-size: 30px;
        }

        #javascript-strings-page .strings-image {
            height: 260px;
        }

        #javascript-strings-page .string-flow {
            gap: 6px;
        }

        #javascript-strings-page .character-box {
            width: 45px;
            height: 45px;
        }
    }

</style>


<main id="javascript-strings-page" class="container">

    <div class="row g-4">

        <!-- LEFT SIDE - COURSE SYLLABUS -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
            )

        </aside>


        <!-- RIGHT SIDE - CONTENT -->

        <section class="col-lg-9">

            <div class="content-section">

                <!-- PAGE TITLE -->

                <h1 class="page-title">
                    Strings
                </h1>

                <p class="lead-text">
                    Strings are used to store and work with text in JavaScript.
                    They can contain letters, numbers, symbols, spaces, and
                    other characters.
                </p>


                <!-- WHAT IS A STRING -->

                <h2 class="section-title">
                    What is a String?
                </h2>

                <p class="section-text">
                    A string is a sequence of characters used to represent
                    text in JavaScript.
                </p>

                <p class="section-text">
                    Strings are written inside single quotes,
                    double quotes, or backticks.
                </p>


                <!-- CONCEPT BOX -->

                <div class="concept-box">

                    <h5>
                        String Example
                    </h5>

                    <p>
                        A string can contain a name, course name,
                        city, message, or any other text.
                    </p>

                    <p>
                        Example:
                        <strong>"JavaScript"</strong>
                    </p>

                </div>


                <!-- ACTUAL STRING IMAGE -->

                <div class="image-card">

                    <img src="https://spaceship.roadtocode.org/javascript/02/output-2.jpg"
                         alt="JavaScript String characters and indexes"
                         class="strings-image" />

                    <p class="image-caption">
                        A JavaScript string contains characters arranged
                        using zero-based index positions.
                    </p>

                </div>


                <!-- STRING FEATURES -->

                <h2 class="section-title">
                    Important String Concepts
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="feature-card">

                            <span class="feature-name">
                                String Value
                            </span>

                            <h5>
                                Store Text
                            </h5>

                            <p>
                                Strings are commonly used to store
                                text values such as names and messages.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="feature-card">

                            <span class="feature-name">
                                Index
                            </span>

                            <h5>
                                Access Characters
                            </h5>

                            <p>
                                Each character in a string has an index.
                                The first character starts at index 0.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="feature-card">

                            <span class="feature-name">
                                length
                            </span>

                            <h5>
                                Count Characters
                            </h5>

                            <p>
                                The length property tells us the length
                                of a string.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="feature-card">

                            <span class="feature-name">
                                +
                            </span>

                            <h5>
                                Combine Strings
                            </h5>

                            <p>
                                The plus operator can be used to combine
                                two or more strings.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- DIAGRAM -->

                <h2 class="section-title">
                    String Indexing
                </h2>

                <div class="diagram-box">

                    <div class="diagram-title">
                        Characters and Their Index Positions
                    </div>

                    <div class="string-flow">

                        <div>
                            <div class="character-box">
                                J
                            </div>
                            <div class="index-number">
                                0
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                a
                            </div>
                            <div class="index-number">
                                1
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                v
                            </div>
                            <div class="index-number">
                                2
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                a
                            </div>
                            <div class="index-number">
                                3
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                S
                            </div>
                            <div class="index-number">
                                4
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                c
                            </div>
                            <div class="index-number">
                                5
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                r
                            </div>
                            <div class="index-number">
                                6
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                i
                            </div>
                            <div class="index-number">
                                7
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                p
                            </div>
                            <div class="index-number">
                                8
                            </div>
                        </div>

                        <div>
                            <div class="character-box">
                                t
                            </div>
                            <div class="index-number">
                                9
                            </div>
                        </div>

                    </div>

                    <p class="diagram-note">
                        JavaScript uses zero-based indexing, so the first
                        character is at index 0.
                    </p>

                </div>


                <!-- EXAMPLE 1 -->

                <h2 class="section-title">
                    Example 1: Creating a String
                </h2>

                <p class="section-text">
                    We can create a string by assigning text inside
                    quotation marks to a variable.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = "JavaScript";

console.log(course);</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringExample1()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: JavaScript
                </div>


                <!-- EXAMPLE 2 -->

                <h2 class="section-title">
                    Example 2: Accessing a Character
                </h2>

                <p class="section-text">
                    We can access an individual character of a string
                    using its index position.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = "JavaScript";

console.log(course[0]);
console.log(course[4]);</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringExample2()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: J
                    <br />
                    S
                </div>


                <!-- EXAMPLE 3 -->

                <h2 class="section-title">
                    Example 3: Finding String Length
                </h2>

                <p class="section-text">
                    The <strong>length</strong> property returns the
                    length of a string.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let course = "JavaScript";

console.log(course.length);</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringExample3()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: 10
                </div>


                <!-- EXAMPLE 4 -->

                <h2 class="section-title">
                    Example 4: Combining Strings
                </h2>

                <p class="section-text">
                    The <strong>+</strong> operator can be used to
                    combine two strings.
                </p>

                <div class="code-section">

                    <pre class="code-box"><code>let firstName = "CIIT";
let course = "JavaScript";

let message = firstName + " " + course;

console.log(message);</code></pre>

                </div>

                <div class="try-it-wrapper">

                    <button type="button"
                            class="try-it-btn"
                            onclick="runStringExample4()">

                        ▶ Try It

                    </button>

                </div>

                <div class="output-box">
                    Output: CIIT JavaScript
                </div>


                <!-- SUMMARY -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        Strings are used to represent text in JavaScript.
                        Characters can be accessed using index positions,
                        the <strong>length</strong> property can be used
                        to find string length, and the
                        <strong>+</strong> operator can be used to combine
                        strings.
                    </p>

                </div>


                <!-- NAVIGATION -->

                <div class="bottom-navigation">

                    <a href="@Url.Action("ArrayMethods", "ArraysStrings", new { area = "JavaScript" })"
                       class="nav-btn previous-btn">

                        <span>
                            ←
                        </span>

                        <span>
                            Previous: Array Methods
                        </span>

                    </a>


                    <a href="@Url.Action("StringMethods", "ArraysStrings", new { area = "JavaScript" })"
                       class="nav-btn next-btn">

                        <span>
                            Next: String Methods
                        </span>

                        <span>
                            →
                        </span>

                    </a>

                </div>

            </div>

        </section>

    </div>

</main>


<script>

    /*
       IMPORTANT:
       Convert literal \\n into actual new lines
       before sending code to the JavaScript compiler.
    */

    function openCompiler(code) {

        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );
    }


    /* =========================
       EXAMPLE 1
       ========================= */

    function runStringExample1() {

        const code =
            'let course = "JavaScript";\\n' +
            'console.log(course);';

        openCompiler(code);
    }


    /* =========================
       EXAMPLE 2
       ========================= */

    function runStringExample2() {

        const code =
            'let course = "JavaScript";\\n' +
            'console.log(course[0]);\\n' +
            'console.log(course[4]);';

        openCompiler(code);
    }


    /* =========================
       EXAMPLE 3
       ========================= */

    function runStringExample3() {

        const code =
            'let course = "JavaScript";\\n' +
            'console.log(course.length);';

        openCompiler(code);
    }


    /* =========================
       EXAMPLE 4
       ========================= */

    function runStringExample4() {

        const code =
            'let firstName = "CIIT";\\n' +
            'let course = "JavaScript";\\n' +
            'let message = firstName + " " + course;\\n' +
            'console.log(message);';

        openCompiler(code);
    }

</script>