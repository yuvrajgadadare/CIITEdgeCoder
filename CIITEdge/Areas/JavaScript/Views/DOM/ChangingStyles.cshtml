@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "Changing Styles";
}

<style>

    #javascript-changing-styles-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-changing-styles-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    #javascript-changing-styles-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-changing-styles-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    #javascript-changing-styles-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-changing-styles-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 14px;
    }

    /* =========================================================
       CONCEPT BOX
       ========================================================= */

    #javascript-changing-styles-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    #javascript-changing-styles-page .concept-box h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-changing-styles-page .concept-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* =========================================================
       IMAGE
       ========================================================= */

    #javascript-changing-styles-page .image-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 15px;
        margin: 25px 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    #javascript-changing-styles-page .style-image {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        border-radius: 8px;
        background: #f8f9fa;
    }

    #javascript-changing-styles-page .image-caption {
        text-align: center;
        color: #6c757d;
        font-size: 13px;
        margin: 12px 5px 0;
    }

    /* =========================================================
       DIAGRAM
       ========================================================= */

    #javascript-changing-styles-page .style-diagram {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 28px 20px;
        margin: 25px 0;
        text-align: center;
    }

    #javascript-changing-styles-page .diagram-title {
        font-size: 20px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 22px;
    }

    #javascript-changing-styles-page .diagram-box {
        display: inline-block;
        min-width: 190px;
        padding: 14px 20px;
        margin: 6px;
        border-radius: 8px;
        border: 2px solid #6f42c1;
        background: #ffffff;
        color: #343a40;
        font-weight: 600;
    }

    #javascript-changing-styles-page .diagram-box.main {
        background: #6f42c1;
        color: #ffffff;
    }

    #javascript-changing-styles-page .diagram-arrow {
        color: #6f42c1;
        font-size: 26px;
        font-weight: 700;
        margin: 3px 0;
    }

    #javascript-changing-styles-page .diagram-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* =========================================================
       STYLE CARDS
       ========================================================= */

    #javascript-changing-styles-page .style-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    #javascript-changing-styles-page .style-card h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-changing-styles-page .style-card p {
        color: #495057;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* =========================================================
       CODE
       ========================================================= */

    #javascript-changing-styles-page .code-section {
        margin-top: 15px;
    }

    #javascript-changing-styles-page .code-box {
        background-color: #212529;
        color: #ffffff;
        border-radius: 8px;
        padding: 18px;
        overflow-x: auto;
        margin-top: 15px;
        margin-bottom: 10px;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.7;
    }

    /* =========================================================
       TRY IT
       ========================================================= */

    #javascript-changing-styles-page .try-it-wrapper {
        text-align: right;
        margin-top: 10px;
        margin-bottom: 25px;
    }

    #javascript-changing-styles-page .try-it-btn {
        background-color: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 6px;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    #javascript-changing-styles-page .try-it-btn:hover {
        background-color: #157347;
        border-color: #157347;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* =========================================================
       OUTPUT
       ========================================================= */

    #javascript-changing-styles-page .output-box {
        background: #000000;
        border: 1px solid #212529;
        border-left: 4px solid #198754;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 25px;
        color: #ffffff;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.8;
    }

    /* =========================================================
       SUMMARY
       ========================================================= */

    #javascript-changing-styles-page .summary-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
        margin-top: 35px;
    }

    #javascript-changing-styles-page .summary-box h2 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-changing-styles-page .summary-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    #javascript-changing-styles-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-changing-styles-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    #javascript-changing-styles-page .previous-btn {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #495057;
    }

    #javascript-changing-styles-page .next-btn {
        background: #5b21b6;
        border: 1px solid #5b21b6;
        color: #ffffff;
    }

    #javascript-changing-styles-page .previous-btn:hover {
        background: #e9ecef;
        color: #212529;
    }

    #javascript-changing-styles-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        #javascript-changing-styles-page .content-section {
            padding: 20px;
        }

        #javascript-changing-styles-page .page-title {
            font-size: 30px;
        }

        #javascript-changing-styles-page .section-title {
            font-size: 23px;
        }

        #javascript-changing-styles-page .bottom-navigation {
            flex-direction: column;
        }

        #javascript-changing-styles-page .nav-btn {
            justify-content: center;
        }

        #javascript-changing-styles-page .diagram-row {
            flex-direction: column;
            align-items: center;
        }

    }

</style>


<main id="javascript-changing-styles-page">

    <div class="container-fluid">

        <div class="row">

            <!-- =====================================================
                 LEFT SIDEBAR
                 ===================================================== -->

            <aside class="col-lg-3 mb-4">

                @Html.Partial(
                    "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
                )

            </aside>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <section class="col-lg-9">

                <div class="content-section">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <h1 class="page-title">
                        Changing Styles
                    </h1>

                    <p class="lead-text">
                        JavaScript can dynamically change the appearance
                        of HTML elements by modifying their CSS styles
                        through the DOM.
                    </p>


                    <!-- =================================================
                         WHAT IS CHANGING STYLES?
                         ================================================= -->

                    <h2 class="section-title">
                        What is Changing Styles?
                    </h2>

                    <p class="section-text">
                        Changing styles means modifying the visual appearance
                        of an HTML element using JavaScript.
                    </p>

                    <p class="section-text">
                        JavaScript can change properties such as
                        <strong>color</strong>,
                        <strong>backgroundColor</strong>,
                        <strong>fontSize</strong>,
                        <strong>display</strong>, and more.
                    </p>


                    <div class="concept-box">

                        <h5>
                            Simple Definition
                        </h5>

                        <p>
                            <strong>Select an element → Access style →
                            Change CSS property.</strong>
                        </p>

                    </div>


                    <!-- =================================================
                         RELATED IMAGE
                         ================================================= -->

                    <div class="image-card">

                        <img src="https://www.w3schools.com/js/pic_htmltree.gif"
                             alt="DOM and HTML element structure"
                             class="style-image" />

                        <p class="image-caption">
                            JavaScript can access DOM elements and modify
                            their visual styles dynamically.
                        </p>

                    </div>


                    <!-- =================================================
                         STYLE FLOW DIAGRAM
                         ================================================= -->

                    <h2 class="section-title">
                        How JavaScript Changes Styles
                    </h2>

                    <div class="style-diagram">

                        <div class="diagram-title">
                            JavaScript Style Manipulation Flow
                        </div>

                        <div>

                            <span class="diagram-box main">
                                HTML Element
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div>

                            <span class="diagram-box">
                                Select Element
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div class="diagram-row">

                            <span class="diagram-box">
                                element.style.color
                            </span>

                            <span class="diagram-box">
                                element.style.backgroundColor
                            </span>

                            <span class="diagram-box">
                                element.style.fontSize
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div>

                            <span class="diagram-box main">
                                Updated Appearance
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         COMMON STYLE PROPERTIES
                         ================================================= -->

                    <h2 class="section-title">
                        Common CSS Properties
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    color
                                </h5>

                                <p>
                                    Changes the text color of an element.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    backgroundColor
                                </h5>

                                <p>
                                    Changes the background color of an
                                    element.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    fontSize
                                </h5>

                                <p>
                                    Changes the size of text displayed
                                    inside an element.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    fontWeight
                                </h5>

                                <p>
                                    Changes the thickness of text.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    display
                                </h5>

                                <p>
                                    Controls whether an element is visible
                                    or how it participates in layout.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="style-card">

                                <h5>
                                    border
                                </h5>

                                <p>
                                    Allows JavaScript to modify an element's
                                    border style.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         EXAMPLE 1
                         ================================================= -->

                    <h2 class="section-title">
                        Example 1: Change Text Color
                    </h2>

                    <p class="section-text">
                        The <strong>color</strong> style property can be
                        changed using JavaScript.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>let textColor = "blue";

console.log("Original color:", "black");

textColor = "blue";

console.log("Updated color:", textColor);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="tryChangingStylesExample1()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>


                    <div class="output-box">

                        Output:
                        <br />

                        Original color: black
                        <br />

                        Updated color: blue

                    </div>


                    <!-- =================================================
                         EXAMPLE 2
                         ================================================= -->

                    <h2 class="section-title">
                        Example 2: Change Background Color
                    </h2>

                    <p class="section-text">
                        The <strong>backgroundColor</strong> property can
                        be used to change an element's background.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>let backgroundColor = "white";

backgroundColor = "lightblue";

console.log("Background:", backgroundColor);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="tryChangingStylesExample2()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>


                    <div class="output-box">

                        Output:
                        <br />

                        Background: lightblue

                    </div>


                    <!-- =================================================
                         EXAMPLE 3
                         ================================================= -->

                    <h2 class="section-title">
                        Example 3: Change Font Size
                    </h2>

                    <p class="section-text">
                        The <strong>fontSize</strong> property can be used
                        to change the size of text.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>let fontSize = "16px";

fontSize = "24px";

console.log("Font Size:", fontSize);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="tryChangingStylesExample3()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>


                    <div class="output-box">

                        Output:
                        <br />

                        Font Size: 24px

                    </div>


                    <!-- =================================================
                         EXAMPLE 4
                         ================================================= -->

                    <h2 class="section-title">
                        Example 4: Change Multiple Styles
                    </h2>

                    <p class="section-text">
                        Multiple style properties can be changed on the
                        same element.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>let textColor = "black";
let background = "white";
let size = "16px";

textColor = "blue";
background = "lightgray";
size = "22px";

console.log("Color:", textColor);
console.log("Background:", background);
console.log("Font Size:", size);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="tryChangingStylesExample4()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>


                    <div class="output-box">

                        Output:
                        <br />

                        Color: blue
                        <br />

                        Background: lightgray
                        <br />

                        Font Size: 22px

                    </div>


                    <!-- =================================================
                         IMPORTANT NOTE
                         ================================================= -->

                    <h2 class="section-title">
                        Important Note
                    </h2>

                    <div class="concept-box">

                        <h5>
                            JavaScript Style Syntax
                        </h5>

                        <p>
                            CSS property names written in JavaScript
                            generally use camelCase.
                        </p>

                        <p>
                            For example:
                        </p>

                        <p>
                            CSS:
                            <strong>background-color</strong>
                        </p>

                        <p>
                            JavaScript:
                            <strong>backgroundColor</strong>
                        </p>

                    </div>


                    <!-- =================================================
                         REAL WORLD EXAMPLE
                         ================================================= -->

                    <h2 class="section-title">
                        Real-World Example
                    </h2>

                    <p class="section-text">
                        A website can dynamically highlight a course,
                        change notification colors, resize text, or
                        visually indicate a selected item.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>let status = "Available";

console.log("Status:", status);

status = "Course Started";

console.log("Updated Status:", status);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="tryChangingStylesExample5()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>


                    <div class="output-box">

                        Output:
                        <br />

                        Status: Available
                        <br />

                        Updated Status: Course Started

                    </div>


                    <!-- =================================================
                         SUMMARY
                         ================================================= -->

                    <div class="summary-box">

                        <h2 class="h4">
                            Summary
                        </h2>

                        <p>
                            JavaScript can dynamically change the appearance
                            of HTML elements through the DOM. The
                            <strong>style</strong> property provides access
                            to individual CSS properties such as
                            <strong>color</strong>,
                            <strong>backgroundColor</strong>,
                            <strong>fontSize</strong>, and
                            <strong>fontWeight</strong>.
                        </p>

                    </div>


                    <!-- =================================================
                         BOTTOM NAVIGATION
                         ================================================= -->

                    <div class="bottom-navigation">

                        <a href="@Url.Action("ChangingContent", "DOM", new { area = "JavaScript" })"
                           class="nav-btn previous-btn">

                            <span>←</span>

                            <span>
                                Previous: Changing Content
                            </span>

                        </a>


                        <a href="@Url.Action("CreatingElements", "DOM", new { area = "JavaScript" })"
                           class="nav-btn next-btn">

                            <span>
                                Next: Creating Elements
                            </span>

                            <span>→</span>

                        </a>

                    </div>

                </div>

            </section>

        </div>

    </div>

</main>


<script>

    /* =========================================================
       CIIT JAVASCRIPT COMPILER
       ========================================================= */

    function openCompiler(code) {

        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );
    }


    /* =========================================================
       EXAMPLE 1
       ========================================================= */

    function tryChangingStylesExample1() {

        const code =
            'let textColor = "black";\n' +
            '\n' +
            'console.log("Original color:", textColor);\n' +
            '\n' +
            'textColor = "blue";\n' +
            '\n' +
            'console.log("Updated color:", textColor);';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 2
       ========================================================= */

    function tryChangingStylesExample2() {

        const code =
            'let backgroundColor = "white";\n' +
            '\n' +
            'backgroundColor = "lightblue";\n' +
            '\n' +
            'console.log("Background:", backgroundColor);';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 3
       ========================================================= */

    function tryChangingStylesExample3() {

        const code =
            'let fontSize = "16px";\n' +
            '\n' +
            'fontSize = "24px";\n' +
            '\n' +
            'console.log("Font Size:", fontSize);';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 4
       ========================================================= */

    function tryChangingStylesExample4() {

        const code =
            'let textColor = "black";\n' +
            'let background = "white";\n' +
            'let size = "16px";\n' +
            '\n' +
            'textColor = "blue";\n' +
            'background = "lightgray";\n' +
            'size = "22px";\n' +
            '\n' +
            'console.log("Color:", textColor);\n' +
            'console.log("Background:", background);\n' +
            'console.log("Font Size:", size);';

        openCompiler(code);
    }


    /* =========================================================
       REAL WORLD EXAMPLE
       ========================================================= */

    function tryChangingStylesExample5() {

        const code =
            'let status = "Available";\n' +
            '\n' +
            'console.log("Status:", status);\n' +
            '\n' +
            'status = "Course Started";\n' +
            '\n' +
            'console.log("Updated Status:", status);';

        openCompiler(code);
    }

</script>