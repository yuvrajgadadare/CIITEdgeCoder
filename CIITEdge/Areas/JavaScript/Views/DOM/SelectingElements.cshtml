@{
    Layout = "~/Areas/JavaScript/Views/Shared/JavaScriptLayout.cshtml";
    ViewData["Title"] = "Selecting Elements";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    #javascript-selecting-elements-page {
        padding-top: 30px;
        padding-bottom: 50px;
    }

    #javascript-selecting-elements-page .content-section {
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }


    /* =========================================================
       TITLES
       ========================================================= */

    #javascript-selecting-elements-page .page-title {
        font-size: 36px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 12px;
    }

    #javascript-selecting-elements-page .lead-text {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    #javascript-selecting-elements-page .section-title {
        font-size: 27px;
        font-weight: 700;
        color: #212529;
        margin-top: 32px;
        margin-bottom: 15px;
    }

    #javascript-selecting-elements-page .section-text {
        color: #495057;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 14px;
    }


    /* =========================================================
       CONCEPT BOX
       ========================================================= */

    #javascript-selecting-elements-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
    }

    #javascript-selecting-elements-page .concept-box h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #javascript-selecting-elements-page .concept-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 0;
    }


    /* =========================================================
       SELECTION METHODS
       ========================================================= */

    #javascript-selecting-elements-page .method-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    #javascript-selecting-elements-page .method-card h5 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-selecting-elements-page .method-card p {
        color: #495057;
        line-height: 1.7;
        margin-bottom: 0;
    }


    /* =========================================================
       DOM SELECTION DIAGRAM
       ========================================================= */

    #javascript-selecting-elements-page .selection-diagram {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 25px;
        margin: 25px 0;
        text-align: center;
    }

    #javascript-selecting-elements-page .diagram-title {
        font-size: 19px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 22px;
    }

    #javascript-selecting-elements-page .diagram-node {
        display: inline-block;
        min-width: 145px;
        padding: 11px 18px;
        margin: 5px;
        border-radius: 8px;
        background: #ffffff;
        border: 2px solid #6f42c1;
        color: #343a40;
        font-weight: 600;
    }

    #javascript-selecting-elements-page .diagram-node.root {
        background: #6f42c1;
        color: #ffffff;
    }

    #javascript-selecting-elements-page .diagram-node.selected {
        background: #e8f5e9;
        border-color: #198754;
        color: #146c43;
    }

    #javascript-selecting-elements-page .diagram-arrow {
        color: #6f42c1;
        font-size: 23px;
        font-weight: 700;
        margin: 4px 0;
    }

    #javascript-selecting-elements-page .diagram-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    #javascript-selecting-elements-page .diagram-caption {
        color: #6c757d;
        font-size: 13px;
        margin-top: 18px;
    }


    /* =========================================================
       CODE
       ========================================================= */

    #javascript-selecting-elements-page .code-section {
        margin-top: 15px;
    }

    #javascript-selecting-elements-page .code-box {
        background-color: #212529;
        color: #ffffff;
        border-radius: 8px;
        padding: 18px;
        overflow-x: auto;
        margin-top: 15px;
        margin-bottom: 10px;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       TRY IT BUTTON
       ========================================================= */

    #javascript-selecting-elements-page .try-it-wrapper {
        text-align: right;
        margin-top: 10px;
        margin-bottom: 25px;
    }

    #javascript-selecting-elements-page .try-it-btn {
        background-color: #198754;
        color: #ffffff;
        border: 1px solid #198754;
        border-radius: 6px;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    #javascript-selecting-elements-page .try-it-btn:hover {
        background-color: #157347;
        border-color: #157347;
        color: #ffffff;
        transform: translateY(-1px);
    }


    /* =========================================================
       OUTPUT
       ========================================================= */

    #javascript-selecting-elements-page .output-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-left: 4px solid #198754;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 25px;
        color: #343a40;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
    }


    /* =========================================================
       SUMMARY
       ========================================================= */

    #javascript-selecting-elements-page .summary-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 22px;
        margin-top: 35px;
    }

    #javascript-selecting-elements-page .summary-box h2 {
        color: #5b21b6;
        font-weight: 700;
        margin-bottom: 12px;
    }

    #javascript-selecting-elements-page .summary-box p {
        color: #495057;
        line-height: 1.8;
        margin-bottom: 0;
    }


    /* =========================================================
       BOTTOM NAVIGATION
       ========================================================= */

    #javascript-selecting-elements-page .bottom-navigation {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #dee2e6;
    }

    #javascript-selecting-elements-page .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    #javascript-selecting-elements-page .previous-btn {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #495057;
    }

    #javascript-selecting-elements-page .next-btn {
        background: #5b21b6;
        border: 1px solid #5b21b6;
        color: #ffffff;
    }

    #javascript-selecting-elements-page .previous-btn:hover {
        background: #e9ecef;
        color: #212529;
    }

    #javascript-selecting-elements-page .next-btn:hover {
        background: #4c1d95;
        color: #ffffff;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        #javascript-selecting-elements-page .content-section {
            padding: 20px;
        }

        #javascript-selecting-elements-page .page-title {
            font-size: 30px;
        }

        #javascript-selecting-elements-page .section-title {
            font-size: 23px;
        }

        #javascript-selecting-elements-page .bottom-navigation {
            flex-direction: column;
        }

        #javascript-selecting-elements-page .nav-btn {
            justify-content: center;
        }
    }

</style>


<main id="javascript-selecting-elements-page">

    <div class="container-fluid">

        <div class="row">

            <!-- =====================================================
                 LEFT SIDEBAR
                 ===================================================== -->

            <aside class="col-lg-3 mb-4">

                @Html.Partial(
                    "~/Areas/JavaScript/Views/Shared/JavaScriptTopics.cshtml"
                )

            </aside>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <section class="col-lg-9">

                <div class="content-section">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <h1 class="page-title">
                        Selecting Elements
                    </h1>

                    <p class="lead-text">
                        JavaScript can select HTML elements from a web page
                        using the DOM. Once an element is selected, JavaScript
                        can read its content, modify it, change its style,
                        or respond to user interactions.
                    </p>


                    <!-- =================================================
                         WHAT DOES SELECTING ELEMENTS MEAN?
                         ================================================= -->

                    <h2 class="section-title">
                        What does Selecting Elements mean?
                    </h2>

                    <p class="section-text">
                        Selecting an element means finding a particular HTML
                        element from the DOM so that JavaScript can work
                        with that element.
                    </p>

                    <div class="concept-box">

                        <h5>
                            Simple Definition
                        </h5>

                        <p>
                            JavaScript uses DOM methods such as
                            <strong>getElementById()</strong>,
                            <strong>getElementsByClassName()</strong>,
                            and <strong>querySelector()</strong>
                            to find HTML elements.
                        </p>

                    </div>


                    <!-- =================================================
                         SELECTION DIAGRAM
                         ================================================= -->

                    <h2 class="section-title">
                        How Element Selection Works
                    </h2>

                    <p class="section-text">
                        The browser creates a DOM tree from the HTML page.
                        JavaScript can use the <strong>document</strong>
                        object to select the required element.
                    </p>


                    <div class="selection-diagram">

                        <div class="diagram-title">
                            JavaScript DOM Element Selection
                        </div>

                        <div>

                            <span class="diagram-node root">
                                document
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div>

                            <span class="diagram-node">
                                html
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div class="diagram-row">

                            <span class="diagram-node">
                                &lt;h1 id="title"&gt;
                            </span>

                            <span class="diagram-node selected">
                                &lt;p class="message"&gt;
                            </span>

                            <span class="diagram-node">
                                &lt;button&gt;
                            </span>

                        </div>

                        <div class="diagram-arrow">
                            ↓
                        </div>

                        <div>

                            <span class="diagram-node selected">
                                Selected Element
                            </span>

                        </div>

                        <div class="diagram-caption">
                            JavaScript selects a required element from the DOM
                            tree and can then work with it.
                        </div>

                    </div>


                    <!-- =================================================
                         COMMON METHODS
                         ================================================= -->

                    <h2 class="section-title">
                        Common Element Selection Methods
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="method-card">

                                <h5>
                                    getElementById()
                                </h5>

                                <p>
                                    Selects a single element using its
                                    <strong>id</strong>.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="method-card">

                                <h5>
                                    getElementsByClassName()
                                </h5>

                                <p>
                                    Selects elements that have a particular
                                    <strong>class name</strong>.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="method-card">

                                <h5>
                                    querySelector()
                                </h5>

                                <p>
                                    Selects the first element that matches
                                    a CSS selector.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         EXAMPLE 1
                         ================================================= -->

                    <h2 class="section-title">
                        Example 1: getElementById()
                    </h2>

                    <p class="section-text">
                        The
                        <strong>getElementById()</strong>
                        method selects an HTML element using its
                        <strong>id</strong>.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>const heading =
    document.getElementById("title");

console.log(heading);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="runSelectingExample1()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>

                    <div class="output-box">

                        Output:
                        <br />
                        Selected element:
                        &lt;h1 id="title"&gt;JavaScript Tutorial&lt;/h1&gt;

                    </div>


                    <!-- =================================================
                         EXAMPLE 2
                         ================================================= -->

                    <h2 class="section-title">
                        Example 2: getElementsByClassName()
                    </h2>

                    <p class="section-text">
                        The
                        <strong>getElementsByClassName()</strong>
                        method selects elements using their
                        class name.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>const students =
    document.getElementsByClassName("student");

console.log(students);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="runSelectingExample2()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>

                    <div class="output-box">

                        Output:
                        <br />
                        Number of selected elements: 3
                        <br />
                        Students: Amit, Priya, Rahul

                    </div>


                    <!-- =================================================
                         EXAMPLE 3
                         ================================================= -->

                    <h2 class="section-title">
                        Example 3: querySelector()
                    </h2>

                    <p class="section-text">
                        The
                        <strong>querySelector()</strong>
                        method selects the first element that matches
                        a CSS selector.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>const message =
    document.querySelector(".message");

console.log(message);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="runSelectingExample3()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>

                    <div class="output-box">

                        Output:
                        <br />
                        Selected element:
                        &lt;p class="message"&gt;Welcome to CIIT Training Institute!&lt;/p&gt;

                    </div>


                    <!-- =================================================
                         EXAMPLE 4
                         ================================================= -->

                    <h2 class="section-title">
                        Example 4: querySelectorAll()
                    </h2>

                    <p class="section-text">
                        The
                        <strong>querySelectorAll()</strong>
                        method selects all elements that match a CSS
                        selector.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>const courses =
    document.querySelectorAll(".course");

console.log(courses.length);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="runSelectingExample4()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>

                    <div class="output-box">

                        Output:
                        <br />
                        Number of selected elements: 3

                    </div>


                    <!-- =================================================
                         IMPORTANT NOTE
                         ================================================= -->

                    <div class="concept-box">

                        <h5>
                            Important Note
                        </h5>

                        <p>
                            The examples above show actual DOM methods
                            used inside a browser. The CIIT JavaScript
                            Compiler is a console-based execution
                            environment, so the <strong>Try It</strong>
                            buttons send compiler-safe JavaScript
                            representations to the compiler while the
                            tutorial code demonstrates the real DOM API.
                        </p>

                    </div>


                    <!-- =================================================
                         REAL WORLD EXAMPLE
                         ================================================= -->

                    <h2 class="section-title">
                        Real-World Example
                    </h2>

                    <p class="section-text">
                        Suppose a training website contains multiple course
                        cards. JavaScript can select those course elements
                        and work with them.
                    </p>

                    <div class="code-section">

                        <pre class="code-box"><code>const courses =
    document.querySelectorAll(".course");

console.log("Courses Found:", courses.length);</code></pre>

                        <div class="try-it-wrapper">

                            <button type="button"
                                    class="try-it-btn"
                                    onclick="runSelectingRealWorldExample()">

                                <span>▶</span>

                                <span>
                                    Try It
                                </span>

                            </button>

                        </div>

                    </div>

                    <div class="output-box">

                        Output:
                        <br />
                        Courses Found: 3
                        <br />
                        CIIT Training Institute

                    </div>


                    <!-- =================================================
                         SUMMARY
                         ================================================= -->

                    <div class="summary-box">

                        <h2 class="h4">
                            Summary
                        </h2>

                        <p>
                            JavaScript can select HTML elements through the
                            DOM. <strong>getElementById()</strong> selects
                            an element by its ID,
                            <strong>getElementsByClassName()</strong> selects
                            elements by class name,
                            <strong>querySelector()</strong> selects the first
                            matching element, and
                            <strong>querySelectorAll()</strong> selects all
                            matching elements.
                        </p>

                    </div>


                    <!-- =================================================
                         BOTTOM NAVIGATION
                         ================================================= -->

                    <div class="bottom-navigation">

                        <a href="@Url.Action("Index", "DOM", new { area = "JavaScript" })"
                           class="nav-btn previous-btn">

                            <span>
                                ←
                            </span>

                            <span>
                                Previous: DOM Introduction
                            </span>

                        </a>


                        <a href="@Url.Action("ChangingContent", "DOM", new { area = "JavaScript" })"
                           class="nav-btn next-btn">

                            <span>
                                Next: Changing Content
                            </span>

                            <span>
                                →
                            </span>

                        </a>

                    </div>

                </div>

            </section>

        </div>

    </div>

</main>


<script>

    /* =========================================================
       COMPILER
       ========================================================= */

    function openCompiler(code) {

        // Convert literal \n into real new lines
        code = code.replace(/\\n/g, "\n");

        const compilerUrl =
            '/JavaScriptCompiler/Index?code=' +
            encodeURIComponent(code);

        window.open(
            compilerUrl,
            '_blank'
        );
    }


    /* =========================================================
       EXAMPLE 1 - getElementById()
       ========================================================= */

    function runSelectingExample1() {

        const code =
            'const heading = {\\n' +
            '    id: "title",\\n' +
            '    textContent: "JavaScript Tutorial"\\n' +
            '};\\n' +
            '\\n' +
            'console.log("Selected element:");\\n' +
            'console.log("<h1 id=\\"" + heading.id + "\\">" + heading.textContent + "</h1>");';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 2 - getElementsByClassName()
       ========================================================= */

    function runSelectingExample2() {

        const code =
            'const students = [\\n' +
            '    "Amit",\\n' +
            '    "Priya",\\n' +
            '    "Rahul"\\n' +
            '];\\n' +
            '\\n' +
            'console.log("Number of selected elements:", students.length);\\n' +
            'console.log("Students:", students.join(", "));';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 3 - querySelector()
       ========================================================= */

    function runSelectingExample3() {

        const code =
            'const message = {\\n' +
            '    selector: ".message",\\n' +
            '    textContent: "Welcome to CIIT Training Institute!"\\n' +
            '};\\n' +
            '\\n' +
            'console.log("Selected element:");\\n' +
            'console.log("<p class=\\"" + message.selector.substring(1) + "\\">" + message.textContent + "</p>");';

        openCompiler(code);
    }


    /* =========================================================
       EXAMPLE 4 - querySelectorAll()
       ========================================================= */

    function runSelectingExample4() {

        const code =
            'const courses = [\\n' +
            '    "JavaScript",\\n' +
            '    "Python",\\n' +
            '    ".NET"\\n' +
            '];\\n' +
            '\\n' +
            'console.log("Number of selected elements:", courses.length);';

        openCompiler(code);
    }


    /* =========================================================
       REAL WORLD EXAMPLE
       ========================================================= */

    function runSelectingRealWorldExample() {

        const code =
            'const courses = [\\n' +
            '    "JavaScript",\\n' +
            '    "Python",\\n' +
            '    ".NET"\\n' +
            '];\\n' +
            '\\n' +
            'console.log("Courses Found:", courses.length);\\n' +
            'console.log("CIIT Training Institute");';

        openCompiler(code);
    }

</script>