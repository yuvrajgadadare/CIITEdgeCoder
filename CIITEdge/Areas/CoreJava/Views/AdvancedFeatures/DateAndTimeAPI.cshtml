                        </button>

                    </h2>

                    <div id="dateQuestionSix"
                         class="accordion-collapse collapse"
                         data-bs-parent="#dateTimeQuestions">

                        <div class="accordion-body">

                            The modern API provides clearer types, immutable
                            values, better time-zone support, and a more
                            consistent design.

                        </div>

                    </div>

                </div>


                <!-- Q7 -->
                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
