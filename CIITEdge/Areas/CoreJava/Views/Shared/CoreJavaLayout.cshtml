<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport"content="width=device-width, initial-scale=1.0">
        <title>CIIT Institute | Learn Core Java Step-by-Step</title>
        <script type="importmap">

        </script>
        <link rel="stylesheet"href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet"href="~/css/site.css"asp-append-version="true" />
        <link rel="stylesheet"href="~/CIITEdge.styles.css"asp-append-version="true" />
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <style>
                :root {
                --brand-purple: #4c1d95;
                --brand-purple-dark: #2e1065;
                --syntax-bg: #0f172a;
            }

            .bg-brand-gradient {
                background: linear-gradient( 135deg, var(--brand-purple-dark) 0%, #312e81 100% );
            }

            .navbar-brand span {
                color: #c084fc;
                font-weight: 900;
                letter-spacing: 0.05em;
            }

            .code-block {
                background-color: var(--syntax-bg);
                color: #f1f5f9;
                padding: 1.5rem;
                border-radius: 0.5rem;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.875rem;
                line-height: 1.6;
                position: relative;
                overflow-x: auto;
            }

            .code-lang-tag {
                position: absolute;
                top: 0.5rem;
                right: 1rem;
                font-size: 0.75rem;
                color: #64748b;
                user-select: none;
            }

            .keyword {
                color: #c084fc;
            }

            .class-name {
                color: #34d399;
            }

            .method-name {
                color: #fbbf24;
            }

            .string-lit {
                color: #fef08a;
            }

            .editor-textarea {
                background-color: #1e1e1e !important;
                color: #d4d4d4 !important;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.9rem;
                resize: vertical;
            }

            .terminal-output {
                background-color: #000000;
                color: #f1f1f1;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.85rem;
                min-height: 100px;
                white-space: pre-wrap;
            }

            /*
             * Course syllabus styling is handled inside
             * CoreJavaTopics.cshtml so the syllabus card itself
             * can scroll independently from the page content.
             */
             </style>
             </head>
             <body>

    @Html.Partial("~/Views/Shared/Menus/MenusWithDropdown.cshtml")
    @Html.Partial("~/Views/Shared/Menus/ProgrammingMenus.cshtml")

<header class="bg-brand-gradient text-white text-center py-5"><div class="container py-4"><div class="row justify-content-center"><div class="col-lg-8"><h1 class="display-4 fw-extrabold mb-3">
                        Master Core Java Programming From Scratch

                    </h1><p class="lead text-purple-100 mb-4 opacity-75">
                        Clear, interactive, and structured coding lessons
                        designed for absolute beginners.

                    </p></div></div></div></header><!-- ===================================================== --><!-- MAIN --><!-- ===================================================== --><main id="tutorials"class="container py-4"><div class="row g-4"><!-- ================================================= --><!-- COURSE SYLLABUS --><!-- ================================================= --><aside class="col-lg-3">
                        @Html.Partial(
                    "~/Areas/CoreJava/Views/Shared/CoreJavaTopics.cshtml"                )

            </aside><!-- ================================================= --><!-- RIGHT CONTENT --><!-- ================================================= --><section class="col-lg-9">
                @RenderBody()

            </section></div></main><!-- ===================================================== --><!-- FOOTER --><!-- ===================================================== --><footer class="bg-dark mt-5 py-4" aria-hidden="true"></footer></body></html>
 