@{
    ViewData["Title"] = "Basic Language";
}

<div class="card border-0 shadow-sm">

    <div class="card-body p-4 p-lg-5">

        <!-- PAGE HEADER -->

        <div class="mb-4">

            <h2 class="fw-bold mb-3">
                Basic Java Language
            </h2>

            <p class="lead text-muted mb-0">
                Learn the fundamental building blocks of Java programming,
                including variables, data types, operators, conditions, and
                loops.
            </p>

        </div>


        <!-- OVERVIEW -->

        <section class="mb-5">

            <h3 class="fw-bold mb-3">
                Java Language Fundamentals
            </h3>

            <p>
                Before learning object-oriented programming and advanced Java
                concepts, you need to understand the basic syntax and language
                constructs used to write Java programs.
            </p>

            <p>
                These fundamentals include variables, primitive and reference
                data types, type conversion, operators, decision-making
                statements, and loops.
            </p>

        </section>


        <!-- TOPICS -->

        <section class="mb-5">

            <h3 class="fw-bold mb-4">
                Topics Covered
            </h3>

            <div class="row g-4">

                <!-- VARIABLES -->

                <div class="col-md-6">

                    <div class="card h-100 border">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                1. Variables & Data Types
                            </h5>

                            <p class="text-muted">
                                Learn how to declare variables and understand
                                Java's primitive and reference data types.
                            </p>

                            <a href="@Url.Action(
                                                               "VariablesAndDataTypes",
                                                               "BasicLanguage",
                                                               new { area = "CoreJava" }
                                                           )"
                               class="btn btn-sm btn-outline-primary">

                                Learn Variables & Data Types →

                            </a>

                        </div>

                    </div>

                </div>


                <!-- TYPE CONVERSION -->

                <div class="col-md-6">

                    <div class="card h-100 border">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                2. Type Conversion
                            </h5>

                            <p class="text-muted">
                                Understand widening, narrowing, casting, and
                                automatic type conversion in Java.
                            </p>

                            <a href="@Url.Action(
                                                               "TypeConversion",
                                                               "BasicLanguage",
                                                               new { area = "CoreJava" }
                                                           )"
                               class="btn btn-sm btn-outline-primary">

                                Learn Type Conversion →

                            </a>

                        </div>

                    </div>

                </div>


                <!-- OPERATORS -->

                <div class="col-md-6">

                    <div class="card h-100 border">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                3. Operators
                            </h5>

                            <p class="text-muted">
                                Learn arithmetic, relational, logical,
                                assignment, unary, bitwise, and conditional
                                operators.
                            </p>

                            <a href="@Url.Action(
                                                               "Operators",
                                                               "BasicLanguage",
                                                               new { area = "CoreJava" }
                                                           )"
                               class="btn btn-sm btn-outline-primary">

                                Learn Operators →

                            </a>

                        </div>

                    </div>

                </div>


                <!-- CONTROL FLOW -->

                <div class="col-md-6">

                    <div class="card h-100 border">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                4. Control Flow Statements
                            </h5>

                            <p class="text-muted">
                                Learn how Java controls program execution using
                                if, else, else-if, switch, and conditional
                                statements.
                            </p>

                            <a href="@Url.Action(
                                                               "ControlFlowStatements",
                                                               "BasicLanguage",
                                                               new { area = "CoreJava" }
                                                           )"
                               class="btn btn-sm btn-outline-primary">

                                Learn Control Flow →

                            </a>

                        </div>

                    </div>

                </div>


                <!-- LOOPS -->

                <div class="col-md-6">

                    <div class="card h-100 border">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                5. Loops
                            </h5>

                            <p class="text-muted">
                                Learn for, while, do-while, enhanced for loops,
                                and loop control statements.
                            </p>

                            <a href="@Url.Action(
                                                               "Loops",
                                                               "BasicLanguage",
                                                               new { area = "CoreJava" }
                                                           )"
                               class="btn btn-sm btn-outline-primary">

                                Learn Loops →

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- BASIC PROGRAM -->

        <section class="mb-5">

            <h3 class="fw-bold mb-3">
                Example: Java Fundamentals
            </h3>

            <p>
                The following example demonstrates variables, data types,
                operators, and a conditional statement together.
            </p>

            <div class="code-block">

                <div class="code-lang-tag">
                    Java
                </div>

                <pre class="mb-0"><code>public class Program {

    public static void main(String[] args) {

        int age = 22;

        double salary = 45000.50;

        boolean employed = true;

        if (employed &amp;&amp; age &gt;= 18) {

            System.out.println("Eligible");
        }
    }
}</code></pre>

            </div>
            <h4 class="fw-bold text-dark mb-3">
    Output
</h4>

<div class="code-block mb-4 shadow-sm">

    <div class="code-lang-tag">
        Output
    </div>

    <pre class="mb-0"><code>Eligible</code></pre>

</div>


        </section>


        <!-- FUNDAMENTAL FLOW -->

        <section class="mb-5">

            <h3 class="fw-bold mb-3">
                Basic Java Program Flow
            </h3>

            <div class="code-block">

                <div class="code-lang-tag">
                    Flow
                </div>

                <pre class="mb-0"><code>
                                         Variables
                                            ↓
                                        Data Types
                                            ↓
                                        Operators
                                            ↓
                                        Conditions
                                            ↓
                                          Loops
                                            ↓
                                         Methods
                                            ↓
                                Object-Oriented Programming</code></pre>

            </div>

        </section>


        <!-- QUICK REFERENCE -->

        <section class="mb-5">

            <h3 class="fw-bold mb-3">
                Quick Reference
            </h3>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>

                            <th>Concept</th>

                            <th>Example</th>

                            <th>Purpose</th>

                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>
                                Variable
                            </td>

                            <td>
                                <code>int age = 25;</code>
                            </td>

                            <td>
                                Stores a value.
                            </td>

                        </tr>

                        <tr>

                            <td>
                                Condition
                            </td>

                            <td>
                                <code>if (age &gt;= 18)</code>
                            </td>

                            <td>
                                Makes a decision.
                            </td>

                        </tr>

                        <tr>

                            <td>
                                Loop
                            </td>

                            <td>
                                <code>for (...)</code>
                            </td>

                            <td>
                                Repeats code.
                            </td>

                        </tr>

                        <tr>

                            <td>
                                Operator
                            </td>

                            <td>
                                <code>a + b</code>
                            </td>

                            <td>
                                Performs an operation.
                            </td>

                        </tr>

                        <tr>

                            <td>
                                Type Conversion
                            </td>

                            <td>
                                <code>(double) number</code>
                            </td>

                            <td>
                                Converts one type to another.
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </section>


        <!-- IMPORTANT -->

        <section class="mb-5">

            <div class="alert alert-info border-0">

                <h5 class="fw-bold">
                    Learning Tip
                </h5>

                <p class="mb-0">
                    Do not try to memorize Java syntax without practicing it.
                    Write small programs that combine variables, operators,
                    conditions, and loops. These concepts form the foundation
                    for almost every Java application.
                </p>

            </div>

        </section>


        <!-- SUMMARY -->

        <section class="mb-4">

            <div class="alert alert-primary border-0">

                <h5 class="fw-bold">
                    Summary
                </h5>

                <p class="mb-0">
                    Java fundamentals provide the foundation for writing
                    reliable programs. Once you understand variables, data
                    types, type conversion, operators, control flow, and
                    loops, you are ready to move toward methods and
                    object-oriented programming.
                </p>

            </div>

        </section>


        <!-- NAVIGATION -->

        <div class="d-flex justify-content-between border-top pt-4">

            <a href="@Url.Action(
                               "FirstProgram",
                               "Introduction",
                               new { area = "CoreJava" }
                           )"
               class="btn btn-outline-secondary px-4">

                ← Previous: Topic

            </a>


            <a href="@Url.Action(
                               "VariablesAndDataTypes",
                               "BasicLanguage",
                               new { area = "CoreJava" }
                           )"
               class="btn btn-primary px-4">

                Next: Topic

                <span class="ms-2">
                    →
                </span>

            </a>

        </div>

    </div>

</div>