        <!-- SUMMARY -->

        <section class="mb-4">

            <div class="alert alert-primary border-0">

                <h5 class="fw-bold">Summary</h5>

                <p class="mb-0">
                    Classes define the structure and behavior of Java
                    objects. Objects are instances created from classes.
                    Fields represent state, methods represent behavior,
                    and references allow programs to work with objects.
                </p>

            </div>

        </section>


