                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- SUMMARY -->

        <section class="mb-4">

            <div class="alert alert-primary border-0">

                <h5 class="fw-bold">Summary</h5>

                <p class="mb-0">
                    Encapsulation protects an object's internal state by
                    controlling access through a well-defined interface.
                    Private fields, getters, setters, validation, and
                    domain-specific methods are common techniques for
                    implementing encapsulation in Java.
                </p>

            </div>

        </section>


