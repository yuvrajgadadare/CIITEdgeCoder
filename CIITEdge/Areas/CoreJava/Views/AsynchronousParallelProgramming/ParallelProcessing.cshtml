        <div class="code-block mb-4">
            <span class="code-lang-tag">Java</span>
            <pre class="mb-0"><code>import java.util.Arrays;

int[] numbers = {
    9, 5, 2, 8, 1, 7, 3
};

Arrays.parallelSort(numbers);

System.out.println(
    Arrays.toString(numbers)
);</code></pre>
