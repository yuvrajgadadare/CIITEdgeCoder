        <!-- Start vs Run -->
        <h2 class="fw-bold mt-5">6. start() vs run()</h2>

        <div class="table-responsive mb-4">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>start()</th>
                        <th>run()</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Creates a new thread</td>
                        <td>Runs like a normal method</td>
                    </tr>
                    <tr>
                        <td>Execution can happen concurrently</td>
                        <td>No new thread is created</td>
                    </tr>
                    <tr>
                        <td>Preferred for starting a thread</td>
