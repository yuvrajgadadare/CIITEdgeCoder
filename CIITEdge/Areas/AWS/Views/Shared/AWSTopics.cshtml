@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string controller, string action) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<style>
/* =========================================================
   AWS SIDEBAR
   Same sizing, sticky position and individual scrolling as HTML.
   ========================================================= */
.ciit-syllabus-card{
    border:0;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
    position:sticky;
    top:90px;
    max-height:calc(100vh - 110px);
    overflow-y:auto;
    overflow-x:hidden;
}
.ciit-syllabus-header{
    background-color:#212529!important;
    color:#fff!important;
    padding:14px 18px!important;
    font-size:15px;
    font-weight:700;
    display:block!important;
    visibility:visible!important;
    position:sticky;
    top:0;
    z-index:10;
}
.ciit-syllabus-header span{color:#fff!important}
.module-title{
    background-color:#f8f9fa!important;
    font-weight:700!important;
    color:#212529!important;
    padding:12px 16px;
    border-bottom:1px solid #e9ecef;
}
.topic-link{
    display:block;
    padding:10px 16px 10px 28px;
    font-size:14px;
    color:#495057!important;
    text-decoration:none!important;
    border:0!important;
    border-bottom:1px solid #f1f1f1!important;
    background-color:#fff!important;
}
.topic-link:hover{
    background-color:#f1f3f5!important;
    color:#212529!important;
}
.topic-link.active,
.topic-link.active:hover,
.topic-link.active:focus{
    background-color:#fff!important;
    color:#495057!important;
    font-weight:400!important;
    border-top:0!important;
    border-left:0!important;
    border-right:0!important;
    border-bottom:2px solid #2563eb!important;
    box-shadow:none!important;
}
.ciit-syllabus-card::-webkit-scrollbar{width:6px}
.ciit-syllabus-card::-webkit-scrollbar-track{background:#f1f1f1}
.ciit-syllabus-card::-webkit-scrollbar-thumb{background:#c8c8c8;border-radius:10px}
.ciit-syllabus-card::-webkit-scrollbar-thumb:hover{background:#aaa}
@@media(max-width:991.98px){
    .ciit-syllabus-card{
        position:static;
        top:auto;
        height:auto;
        max-height:none;
        overflow:visible;
    }
    .ciit-syllabus-header{position:relative}
}
</style>
