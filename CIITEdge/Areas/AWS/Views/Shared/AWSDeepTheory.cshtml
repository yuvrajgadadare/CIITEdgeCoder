        title = "Start With the Cloud Mental Model";
        definition = "Cloud computing means using computing resources such as servers, storage, networking and databases on demand instead of owning and maintaining all physical infrastructure yourself. AWS provides these capabilities as managed services that you configure through a console, APIs or command-line tools.";
        why = "Before learning individual service names, understand the infrastructure layers: identity controls who can act, networking controls where traffic can travel, compute runs workloads, storage holds files, databases hold structured records, and monitoring tells you what is happening.";
        how = "A simple mental model is User → DNS/entry point → network → compute → database/storage → response, while IAM and security controls protect access and CloudWatch provides operational visibility.";
        example = "For a web application, a browser may reach an application through DNS and a load balancer, the application can run on EC2, structured records can live in RDS, files can live in S3, and CloudWatch can collect operational signals.";
    }
    else if (c == "Introduction" && a == "WhatIsAWS")
    {
        title = "What AWS Actually Provides";
        definition = "Amazon Web Services is a broad cloud platform containing services for compute, storage, databases, networking, identity, security, integration and monitoring. Each service has a focused responsibility rather than being one giant application server.";
        why = "This service-oriented approach lets teams choose only the infrastructure capabilities they need and scale them independently.";
        how = "You create a resource in an AWS Region, configure access and networking, use the resource through the console/API/CLI, monitor it, and remove it when the lab is complete.";
        example = "A company can run an API on EC2, store uploads in S3, keep relational data in RDS, and use CloudWatch for logs and metrics.";
    }
