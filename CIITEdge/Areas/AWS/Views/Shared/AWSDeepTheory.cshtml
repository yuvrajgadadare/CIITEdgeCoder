    string definition = "AWS services solve focused infrastructure problems. Learn the responsibility first, then the console steps.";
    string why = "Understanding the responsibility helps you choose the right service and avoid unnecessary complexity.";
    string how = "A useful mental model is: user/request → AWS service → resource → data/response → monitoring.";
    string example = "A production application normally combines several services, with each service responsible for one layer.";

    if (c == "Introduction" && a == "Index")
