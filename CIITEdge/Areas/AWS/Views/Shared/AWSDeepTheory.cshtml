    }
    else if (c == "ElasticLoadBalancing" && a == "HealthChecks")
    {
        title = "Load Balancer Health Checks";
        definition = "Health checks test whether registered targets are able to receive traffic according to configured criteria.";
        why = "A load balancer should avoid sending normal traffic to unhealthy targets.";
        how = "Configure protocol/path/port → load balancer probes target → healthy/unhealthy result → routing decision.";
        example = "If /health returns an error repeatedly, the target can be removed from normal routing until it recovers.";
    }
    else if (c == "ElasticLoadBalancing" && a == "ListenerAndRules")
    {
        title = "Listeners and Rules";
        definition = "A listener accepts connection requests on a configured protocol and port. Rules can determine how matching requests are routed.";
        why = "Listeners are the entry point into a load balancer's routing logic.";
        how = "Client request → listener → priority/rule evaluation → target group → backend response.";
        example = "An HTTPS listener on port 443 can route requests with a /api path to the API target group.";
    }
}

<div class="aws-deep">
    <h3 class="fw-bold mb-3">@title</h3>
    <p class="mb-3">@definition</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="aws-deep h-100">
                <h5 class="fw-bold">Why it matters</h5>
                <p class="mb-0">@why</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="aws-deep h-100">
                <h5 class="fw-bold">How it works</h5>
                <p class="mb-0">@how</p>
            </div>
        </div>
    </div>

    <div class="aws-example mt-3">
        <strong>Real-world example:</strong> @example
    </div>

    @if (c == "Introduction" && a == "Index")
    {
        <div class="aws-history mt-3">
            <h5 class="fw-bold">A short AWS history</h5>
            <p class="mb-2">AWS grew from Amazon's experience operating large-scale technology infrastructure. Amazon Web Services launched its first major infrastructure services in 2006, including Amazon S3 for object storage and Amazon EC2 for on-demand compute.</p>
            <p class="mb-0">The important lesson is not to memorize dates: cloud infrastructure separates responsibilities into services that can be provisioned on demand and combined into larger architectures.</p>
        </div>

        <div class="aws-diagram mt-3">
            <div class="text-center fw-bold mb-2">Infrastructure Mental Model</div>

            <div class="row text-center g-2">
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-white">
                        Identity<br />
                        <small>IAM</small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-white">
                        Network<br />
                        <small>VPC</small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-white">
                        Compute<br />
                        <small>EC2 / Lambda</small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-white">
                        Data<br />
                        <small>S3 / RDS</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>