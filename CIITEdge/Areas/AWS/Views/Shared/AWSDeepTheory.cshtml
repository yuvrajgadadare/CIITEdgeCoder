        how = "Secure the root identity → enable MFA → create appropriate IAM access → use only the permissions required for the task → monitor and review access.";
        example = "A developer can receive only the permissions required to work with EC2 and S3 instead of unrestricted account access.";
    }
    else if (c == "Introduction" && a == "RootVsIAM")
