@{
    var a=ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
@if(ViewContext.RouteData.Values["controller"]?.ToString()=="S3" && a=="S3Buckets"){
<div class="aws-example mt-4"><h4 class="fw-bold mb-3">Console Walkthrough — Create an S3 Bucket</h4><p>Use your own AWS account. The visuals below are illustrative console-style learning references. The live AWS Console can change over time.</p><div class="aws-step"><h5 class="fw-bold">① Open S3</h5><p>In the AWS Console search bar, type <strong>S3</strong> and open Amazon S3.</p><img class="aws-console-shot" src="~/images/aws/s3-console-search-annotated.svg" alt="Annotated AWS S3 console search screenshot"></div><div class="aws-step"><h5 class="fw-bold">② Choose Create bucket</h5><p>On the S3 Buckets page, select <strong>Create bucket</strong>.</p><img class="aws-console-shot" src="~/images/aws/s3-buckets-annotated.svg" alt="Annotated AWS S3 buckets page"></div><div class="aws-step"><h5 class="fw-bold">③ Fill the bucket configuration</h5><p>Enter a globally unique bucket name, choose the intended Region, keep Block Public Access enabled unless your use case explicitly requires public access, and review versioning/encryption settings.</p><img class="aws-console-shot" src="~/images/aws/aws-create-bucket-annotated.svg" alt="Annotated AWS S3 create bucket page"></div></div>
}
