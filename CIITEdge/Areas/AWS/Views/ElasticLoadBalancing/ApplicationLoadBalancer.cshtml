@{
    ViewData["Title"] = "Application Load Balancer (ALB)";
    Layout = "~/Areas/AWS/Views/Shared/AWSLayout.cshtml";
}

<div class="row g-4 aws-content">
    <div class="col-lg-3">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSTopics.cshtml")
    </div>
    <div class="col-lg-9">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSDeepTheory.cshtml")
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSContentStyles.cshtml")
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4 p-lg-5">
            <h3 class="fw-bold mb-3">Core Concept</h3>
            <p>ALB supports listener rules and path/host-based routing.</p>
            <p>Example: /api traffic can route to an API target group while /app traffic routes to a frontend target group.</p>
            <svg class="aws-diagram" viewBox="0 0 800 220"><rect x="30" y="75" width="150" height="70" rx="14" fill="#eef6ff" stroke="#0d6efd"/><text x="105" y="118" text-anchor="middle" font-weight="700">Clients</text><path d="M180 110H300" stroke="#212529" stroke-width="4"/><polygon points="300,110 285,102 285,118" fill="#212529"/><rect x="320" y="55" width="170" height="110" rx="14" fill="#fff3df" stroke="#0d6efd"/><text x="405" y="92" text-anchor="middle" font-weight="700">Load Balancer</text><text x="405" y="120" text-anchor="middle">Listener + Rules</text><text x="405" y="145" text-anchor="middle">Health Checks</text><path d="M490 95L610 70M490 125L610 150" stroke="#212529" stroke-width="4"/><rect x="630" y="40" width="135" height="55" rx="12" fill="#ecfdf5" stroke="#10b981"/><rect x="630" y="125" width="135" height="55" rx="12" fill="#ecfdf5" stroke="#10b981"/><text x="697" y="73" text-anchor="middle">Target 1</text><text x="697" y="158" text-anchor="middle">Target 2</text></svg>
            <h3 class="fw-bold mt-5 mb-3">What you should remember</h3>
            <div class="row g-3"><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">ALB supports listener rules and path/host-based routing.</p></div></div><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">Example: /api traffic can route to an API target group while /app traffic routes to a frontend target group.</p></div></div></div>
            <div class="aws-example mt-4"><h5 class="fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Real-world example</h5><p class="mb-2">Use a realistic cloud workload and focus on the responsibility of this AWS service.</p><div class="aws-code">User → AWS service → application → data / response</div><p class="text-muted mt-3 mb-0">Choose the service that matches the responsibility instead of forcing every workload into one resource.</p></div>
            <div class="aws-code mt-3"># Conceptual workflow
aws-service --resource example
# Verify configuration → test → monitor → clean up</div>
            <div class="aws-callout mt-4"><strong>Practice tip:</strong> Build the smallest possible lab, verify the result, then remove resources you no longer need.</div>
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSConsoleWalkthrough.cshtml")
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSMiniTest.cshtml")
            <div class="mt-4"><a class="btn btn-outline-secondary" href="@Url.Action("Introduction", "ElasticLoadBalancing", new { area = "AWS" })">← Previous</a><a class="btn btn-primary fw-semibold ms-2" href="@Url.Action("NetworkLoadBalancer", "ElasticLoadBalancing", new { area = "AWS" })">Next →</a></div>
        </div></div>
    </div>
</div>
