@{
    ViewData["Title"] = "AWS Account Setup";
    Layout = "~/Areas/AWS/Views/Shared/AWSLayout.cshtml";
}

<div class="row g-4 aws-content">
    <div class="col-lg-3">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSTopics.cshtml")
    </div>
    <div class="col-lg-9">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSDeepTheory.cshtml")
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSContentStyles.cshtml")
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4 p-lg-5">
            <h3 class="fw-bold mb-3">Core Concept</h3>
            <p>Create the account, secure the root user, enable MFA and use IAM identities for daily work.</p>
            <p>Set budgets or billing alerts and delete resources after practice.</p>
            <svg class="aws-diagram" viewBox="0 0 800 170"><rect x="60" y="45" width="190" height="80" rx="14" fill="#fff3df" stroke="#0d6efd"/><text x="155" y="92" text-anchor="middle" font-weight="700">AWS Service</text><path d="M250 85H360" stroke="#212529" stroke-width="4"/><polygon points="360,85 345,77 345,93" fill="#212529"/><rect x="380" y="35" width="320" height="100" rx="14" fill="#eef6ff" stroke="#0d6efd"/><text x="540" y="78" text-anchor="middle" font-weight="700">Production Architecture</text><text x="540" y="105" text-anchor="middle">Secure • Scalable • Observable</text></svg>
            <h3 class="fw-bold mt-5 mb-3">What you should remember</h3>
            <div class="row g-3"><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">Create the account, secure the root user, enable MFA and use IAM identities for daily work.</p></div></div><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">Set budgets or billing alerts and delete resources after practice.</p></div></div></div>
            <div class="aws-example mt-4"><h5 class="fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Real-world example</h5><p class="mb-2">Use a realistic cloud workload and focus on the responsibility of this AWS service.</p><div class="aws-code">User → AWS service → application → data / response</div><p class="text-muted mt-3 mb-0">Choose the service that matches the responsibility instead of forcing every workload into one resource.</p></div>
            <div class="aws-code mt-3"># Conceptual workflow
aws-service --resource example
# Verify configuration → test → monitor → clean up</div>
            <div class="aws-callout mt-4"><strong>Practice tip:</strong> Build the smallest possible lab, verify the result, then remove resources you no longer need.</div>
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSConsoleWalkthrough.cshtml")
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSMiniTest.cshtml")
            <div class="mt-4"><a class="btn btn-outline-secondary" href="@Url.Action("AWSFreeTier", "Introduction", new { area = "AWS" })">← Previous</a></div>
        </div></div>
    </div>
</div>
