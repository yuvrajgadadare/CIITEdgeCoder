@{
    ViewData["Title"] = "S3 Buckets";
    Layout = "~/Areas/AWS/Views/Shared/AWSLayout.cshtml";
}

<div class="row g-4 aws-content">
    <div class="col-lg-3">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSTopics.cshtml")
    </div>
    <div class="col-lg-9">
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSDeepTheory.cshtml")
        @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSContentStyles.cshtml")
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4 p-lg-5">
            <h3 class="fw-bold mb-3">Core Concept</h3>
            <p>Bucket names are globally unique within the AWS partition naming rules.</p>
            <p>Keep buckets private by default and grant only required access.</p>
            <svg class="aws-diagram" viewBox="0 0 800 210"><rect x="70" y="55" width="170" height="100" rx="14" fill="#fff3df" stroke="#0d6efd"/><text x="155" y="92" text-anchor="middle" font-weight="700">S3 Bucket</text><text x="155" y="120" text-anchor="middle">my-app-assets</text><path d="M240 105H360" stroke="#212529" stroke-width="4"/><polygon points="360,105 345,97 345,113" fill="#212529"/><rect x="380" y="35" width="340" height="140" rx="14" fill="#eef6ff" stroke="#0d6efd"/><text x="550" y="68" text-anchor="middle" font-weight="700">Objects</text><text x="550" y="98" text-anchor="middle">logo.png</text><text x="550" y="124" text-anchor="middle">invoice-1001.pdf</text><text x="550" y="150" text-anchor="middle">backup.zip</text></svg>
            <h3 class="fw-bold mt-5 mb-3">What you should remember</h3>
            <div class="row g-3"><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">Bucket names are globally unique within the AWS partition naming rules.</p></div></div><div class="col-md-6"><div class="aws-card p-4"><div class="icon mb-3"><i class="bi bi-check2-circle"></i></div><h5 class="fw-bold">Key idea</h5><p class="text-muted mb-0">Keep buckets private by default and grant only required access.</p></div></div></div>
            <div class="aws-example mt-4"><h5 class="fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Real-world example</h5><p class="mb-2">Use a realistic cloud workload and focus on the responsibility of this AWS service.</p><div class="aws-code">User → AWS service → application → data / response</div><p class="text-muted mt-3 mb-0">Choose the service that matches the responsibility instead of forcing every workload into one resource.</p></div>
            <div class="aws-code mt-3"># Conceptual workflow
aws-service --resource example
# Verify configuration → test → monitor → clean up</div>
            <div class="aws-callout mt-4"><strong>Practice tip:</strong> Build the smallest possible lab, verify the result, then remove resources you no longer need.</div>
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSConsoleWalkthrough.cshtml")
            @await Html.PartialAsync("~/Areas/AWS/Views/Shared/AWSMiniTest.cshtml")
            <div class="mt-4"><a class="btn btn-outline-secondary" href="@Url.Action("IntroductionToS3", "S3", new { area = "AWS" })">← Previous</a><a class="btn btn-primary fw-semibold ms-2" href="@Url.Action("S3Objects", "S3", new { area = "AWS" })">Next →</a></div>
        </div></div>
    </div>
</div>
