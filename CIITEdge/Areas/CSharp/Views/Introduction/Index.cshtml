</main>

<script>

    function tryItYourself() 
    {

        const codeElement = document.querySelector("#tutorialCode pre code"
        );

        if (!codeElement) {
            alert("Tutorial code not found.");
            return;
        }

        const code = codeElement.textContent;

        const form = document.createElement("form");

        form.method = "POST";
        form.action = '@Url.Action("Index", "CSharpCompiler", new { area = "" })';

        form.target = "_blank";

        const input = document.createElement("input");

        input.type = "hidden";
        input.name = "code";
        input.value = code;

        form.appendChild(input);

        document.body.appendChild(form);

        form.submit();

        document.body.removeChild(form);
    }
</script>