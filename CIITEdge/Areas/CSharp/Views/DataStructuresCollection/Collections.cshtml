                    <pre class="mb-0"><code>10
20
30
40
50</code></pre>
                </div>


                <!-- DICTIONARY -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    2. Dictionary&lt;TKey, TValue&gt;
                </h3>

                <p class="text-muted">
                    A Dictionary stores data in key-value pairs. Each key must be unique
                    and is used to access its corresponding value.
                </p>

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Creating a Dictionary
                </h4>

                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Dictionary<int, string> students =
    new Dictionary<int, string>();

students.Add(101, "Rahul");
students.Add(102, "Sneha");
students.Add(103, "Amit");

Console.WriteLine(students[102]);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>




                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Sneha</code></pre>
                </div>


