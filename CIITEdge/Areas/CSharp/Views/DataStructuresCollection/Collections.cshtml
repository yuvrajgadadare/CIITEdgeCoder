                <h4 class="fw-bold text-dark mt-5 mb-3">
                    Collection Comparison
                </h4>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Collection</th>
                                <th>Stores</th>
                                <th>Duplicates</th>
                                <th>Access</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
