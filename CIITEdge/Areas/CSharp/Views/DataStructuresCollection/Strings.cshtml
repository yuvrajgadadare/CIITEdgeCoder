@{
    Layout = "~/Areas/CSharp/Views/Shared/CSharpLayout.cshtml";
    ViewData["Title"] = "Strings";
}
<style>
.try-it-btn {

    background: #198754;

    color: #fff;

    border: none;

    border-radius: 5px;

    padding: 6px 12px;

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);

    transition: all 0.2s ease;

}
 
.try-it-btn:hover {

    background: #157347;

    color: #fff;

}
</style>

<main id="tutorials" class="container py-5">
    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">
            @Html.Partial("~/Areas/CSharp/Views/Shared/CSharpTopics.cshtml")
        </aside>

        <!-- RIGHT CONTENT -->
        <section class="col-lg-9">

            <!-- STRINGS -->
            <div class="card shadow-sm p-4 p-md-5 mb-4" id="strings">

                <h2 class="h1 fw-bold text-dark mt-1 mb-4">Strings in C#</h2>

                <p class="text-muted mb-4">
                    A string is a sequence of characters used to store and manipulate text.
                    Strings are one of the most commonly used data types in C# and .NET applications.
                </p>

                <div class="alert alert-info">
                    <strong>Simple Definition:</strong>
                    A string is used to store text such as names, addresses, email IDs,
                    messages, usernames, and descriptions.
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">Creating a String</h4>

                <p class="text-muted">
                    In C#, the <strong>string</strong> keyword is used to declare a string variable.
                    String values are written inside double quotation marks.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string name = "Rahul";

Console.WriteLine(name);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Rahul</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">String Declaration</h4>

                <p class="text-muted">
                    A string can first be declared and then assigned a value.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string firstName;

firstName = "Amit";

Console.WriteLine(firstName);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Amit</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">String Concatenation</h4>

                <p class="text-muted">
                    String concatenation means joining two or more strings together.
                    The <strong>+</strong> operator can be used for concatenation.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string firstName = "Rahul";
string lastName = "Patil";

string fullName = firstName + " " + lastName;

Console.WriteLine(fullName);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Rahul Patil</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">String Interpolation</h4>

                <p class="text-muted">
                    String interpolation provides a clean and readable way to insert
                    variables into a string. It uses the <strong>$</strong> symbol.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string name = "Sneha";
int age = 22;

Console.WriteLine($"My name is {name} and my age is {age}.");</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>My name is Sneha and my age is 22.</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">Accessing Characters</h4>

                <p class="text-muted">
                    Individual characters of a string can be accessed using an index.
                    String indexing starts from <strong>0</strong>.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;

class Program
{
    static void Main()
    {
        string name = "CIIT";

        Console.WriteLine("Character 1: " + name[0]);
        Console.WriteLine("Character 2: " + name[1]);
        Console.WriteLine("Character 3: " + name[2]);
        Console.WriteLine("Character 4: " + name[3]);
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>
                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Character 1: C
Character 2: I
Character 3: I
Character 4: T
</code></pre>
                </div>

                <div class="alert alert-warning">
                    <strong>Important:</strong>
                    String indexing starts from 0. In the string "CIIT",
                    C is at index 0 and T is at index 3.
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">String Length</h4>

                <p class="text-muted">
                    The <strong>Length</strong> property returns the total number
                    of characters in a string.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string text = "Hello";

Console.WriteLine(text.Length);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>
                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>5</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">ToUpper()</h4>

                <p class="text-muted">
                    The ToUpper() method converts all characters in a string to uppercase.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string text = "ciit training";

Console.WriteLine(text.ToUpper());</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>CIIT TRAINING</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">ToLower()</h4>

                <p class="text-muted">
                    The ToLower() method converts all characters in a string to lowercase.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string text = "CIIT TRAINING";

Console.WriteLine(text.ToLower());</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>ciit training</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">Trim()</h4>

                <p class="text-muted">
                    The Trim() method removes whitespace from the beginning
                    and end of a string.
                </p>



                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
string name = "   Rahul   ";

Console.WriteLine(name.Trim());</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Rahul</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">Contains()</h4>

                <p class="text-muted">
                    The Contains() method checks whether a specified value
                    exists inside a string. It returns true or false.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
string message = "Welcome to CIIT Training Institute";

Console.WriteLine(message.Contains("CIIT"));</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>True</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">StartsWith()</h4>

                <p class="text-muted">
                    The StartsWith() method checks whether a string starts
