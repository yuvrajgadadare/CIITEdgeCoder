        // Find only this example's code
        const codeElement = example.querySelector("pre code");
 
        if (!codeElement) {
            alert("Tutorial code not found.");
            return;
        }
 
        // Get exact code and preserve indentation/new lines
        const code = codeElement.textContent.trim();
 
        // Create temporary form
        const form = document.createElement("form");
 
        form.method = "POST";
 
        form.action =
            '@Url.Action("Index", "CSharpCompiler", new { area = "" })';
 
        // IMPORTANT: Open compiler in new tab
        form.target = "_blank";
 
        const input = document.createElement("input");
 
        input.type = "hidden";
