@{
    Layout = "~/Areas/CSharp/Views/Shared/CSharpLayout.cshtml";
}

<style>
    .try-it-btn {
        background: #198754;
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
        transition: all 0.2s ease;
    }

    .try-it-btn:hover {
        background: #157347;
        color: #fff;
    }

</style>

<main id="tutorials" class="container py-5">
    <div class="row g-4">

        <!-- Sidebar Navigation -->
        <aside class="col-lg-3">
            @Html.Partial("~/Areas/CSharp/Views/Shared/CSharpTopics.cshtml")
        </aside>

        <!-- Reading Content Area -->
        <section class="col-lg-9">

            <div class="card shadow-sm p-4 p-md-5 mb-4">

                <!-- ===================================================== -->
                <!-- PAGE HEADER -->
                <!-- ===================================================== -->

                <h2 class="h1 fw-bold text-dark mb-3">
                    Classes & Objects in C#
                </h2>

                <p class="text-muted mb-4">
                    <b>Classes and Objects</b> are fundamental concepts of
                    Object-Oriented Programming (OOP) in C#. A class defines
                    the structure and behavior of an object, while an object
                    is an actual instance created from that class.
                </p>

                <p class="text-muted mb-4">
                    In simple words, a <b>class</b> can be considered a blueprint,
                    and an <b>object</b> is a real instance created using that
                    blueprint.
                </p>

                <div class="alert alert-info border-0 shadow-sm mb-4">
                    <strong>Beginner Tip:</strong>
                    Think about a house blueprint. The blueprint describes how
                    the house should look, but the actual house is the real thing
                    built from that blueprint. In C#, the <b>class is the blueprint</b>
                    and the <b>object is the actual instance</b>.
                </div>


                <!-- ===================================================== -->
                <!-- WHAT IS A CLASS -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    What is a Class?
                </h3>

                <p class="text-muted mb-4">
                    A <b>class</b> is a user-defined type that groups related
                    data and behavior together. Data can be represented using
                    fields or properties, while behavior can be represented
                    using methods.
                </p>

                <p class="text-muted mb-4">
                    A class does not represent one specific object. Instead,
                    it defines what information an object should contain and
                    what operations that object can perform.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="keyword">class</span>
                    <span class="class-name">Student</span>
                    {<br>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">string</span> Name;<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">int</span> Age;<br><br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">void</span>
                    <span class="method-name">DisplayDetails</span>()<br>
                    &nbsp;&nbsp;&nbsp;&nbsp;{<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <span class="class-name">Console</span>.<span class="method-name">WriteLine</span>(
                    <span class="string-lit">$"Name: {Name}"</span>);<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <span class="class-name">Console</span>.<span class="method-name">WriteLine</span>(
                    <span class="string-lit">$"Age: {Age}"</span>);<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;}<br>
                    }
                </div>

                <p class="text-muted mb-4">
                    In this example, <b>Student</b> is a class. It contains
                    <b>Name</b> and <b>Age</b> as data members and
                    <b>DisplayDetails()</b> as a method.
                </p>


                <!-- ===================================================== -->
                <!-- WHAT IS OBJECT -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    What is an Object?
                </h3>

                <p class="text-muted mb-4">
                    An <b>object</b> is an instance of a class. When an object
                    is created, memory is allocated for that object and it can
                    store its own values for the data defined by the class.
                </p>

                <p class="text-muted mb-3">
                    An object is generally created using the <b>new</b> keyword.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="class-name">Student</span> student1 =
                    <span class="keyword">new</span>
                    <span class="class-name">Student</span>();
                </div>

                <p class="text-muted mb-4">
                    Here, <b>student1</b> is a reference variable that refers to
                    an object of the <b>Student</b> class.
                </p>


                <!-- ===================================================== -->
                <!-- CLASS VS OBJECT -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Class vs Object
                </h3>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Class</th>
                                <th>Object</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>
                                    A blueprint or definition.
                                </td>

                                <td>
                                    An actual instance of a class.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Defines data and behavior.
                                </td>

                                <td>
                                    Contains actual values and uses the
                                    defined behavior.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Does not represent one specific entity.
                                </td>

                                <td>
                                    Represents a specific entity.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Example: <b>Student</b>
                                </td>

                                <td>
                                    Example: <b>student1</b>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>


                <!-- ===================================================== -->
                <!-- BASIC CLASS SYNTAX -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Basic Class Syntax
                </h3>

                <p class="text-muted mb-3">
                    The general syntax for creating a class is:
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="keyword">class</span>
                    <span class="class-name">ClassName</span>
                    {<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="comment">// Fields</span><br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="comment">// Properties</span><br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="comment">// Methods</span><br>
                    }
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Part</th>
                                <th>Purpose</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td><b>class</b></td>
                                <td>
                                    Keyword used to declare a class.
                                </td>
                            </tr>

                            <tr>
                                <td><b>ClassName</b></td>
                                <td>
                                    Name of the class.
                                </td>
                            </tr>

                            <tr>
                                <td><b>Fields</b></td>
                                <td>
                                    Variables used to store data.
                                </td>
                            </tr>

                            <tr>
                                <td><b>Properties</b></td>
                                <td>
                                    Members commonly used to expose and
                                    control access to data.
                                </td>
                            </tr>

                            <tr>
                                <td><b>Methods</b></td>
                                <td>
                                    Define actions or behavior.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>


                <!-- ===================================================== -->
                <!-- FIELDS -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Fields in a Class
                </h3>

                <p class="text-muted mb-4">
                    A <b>field</b> is a variable declared inside a class.
                    Fields can store information related to an object.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="keyword">class</span>
                    <span class="class-name">Employee</span>
                    {<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">int</span> EmployeeId;<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">string</span> Name;<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">double</span> Salary;<br>
                    }
                </div>

                <p class="text-muted mb-4">
                    Here, <b>EmployeeId</b>, <b>Name</b>, and <b>Salary</b>
                    are fields of the <b>Employee</b> class.
                </p>


                <!-- ===================================================== -->
                <!-- PROPERTIES -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Properties in a Class
                </h3>

                <p class="text-muted mb-4">
                    Properties provide a controlled way to expose data from
                    a class. In modern C# applications, properties are commonly
                    preferred over public fields.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="keyword">class</span>
                    <span class="class-name">Student</span>
                    {<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">int</span> Id { get; set; }<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">string</span> Name { get; set; }<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">string</span> Course { get; set; }<br>
                    }
                </div>

                <p class="text-muted mb-4">
                    The <b>get</b> accessor is used to retrieve a value and the
                    <b>set</b> accessor is used to assign a value.
                </p>


                <!-- ===================================================== -->
                <!-- METHOD INSIDE CLASS -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Methods Inside a Class
                </h3>

                <p class="text-muted mb-4">
                    A class can contain methods that define the behavior of
                    its objects.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="keyword">class</span>
                    <span class="class-name">Student</span>
                    {<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">string</span> Name { get; set; }<br><br>

                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">public</span>
                    <span class="keyword">void</span>
                    <span class="method-name">Study</span>()<br>
                    &nbsp;&nbsp;&nbsp;&nbsp;{<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <span class="class-name">Console</span>.<span class="method-name">WriteLine</span>(
                    <span class="string-lit">$"{Name} is studying C#."</span>);<br>

                    &nbsp;&nbsp;&nbsp;&nbsp;}<br>
                    }
                </div>


                <!-- ===================================================== -->
                <!-- CREATING OBJECT -->
                <!-- ===================================================== -->

                <h3 class="h3 fw-bold text-dark mt-4 mb-3">
                    Creating an Object
                </h3>

                <p class="text-muted mb-3">
                    To create an object, use the class name followed by the
                    object variable and the <b>new</b> keyword.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>

                    <span class="class-name">Student</span> student =
                    <span class="keyword">new</span>
                    <span class="class-name">Student</span>();
                </div>

                <p class="text-muted mb-4">
                    This statement creates a new object of the
                    <b>Student</b> class.
                </p>


