                <!-- =====================================================
                     13. MONITOR
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Monitor
                </h3>

                <p class="text-muted mb-4">
                    The <strong>Monitor</strong> class provides synchronization
                    mechanisms for controlling access to shared resources.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static object lockObject = new object();

    static void PrintMessage()
    {
        Monitor.Enter(lockObject);

        try
        {
            Console.WriteLine("Thread entered critical section");
        }
        finally
        {
            Monitor.Exit(lockObject);
        }
    }

    static void Main()
    {
        Thread thread = new Thread(PrintMessage);

        thread.Start();
        thread.Join();
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
