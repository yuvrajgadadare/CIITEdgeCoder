@{
    Layout = "~/Areas/CSharp/Views/Shared/CSharpLayout.cshtml";
    ViewData["Title"] = "Multithreading";
}
<style>
.try-it-btn {

    background: #198754;

    color: #fff;

    border: none;

    border-radius: 5px;

    padding: 6px 12px;

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);

    transition: all 0.2s ease;

}
 
.try-it-btn:hover {

    background: #157347;

    color: #fff;

}
</style>

<main id="tutorials" class="container py-5">
    <div class="row g-4">

        <!-- =========================================================
             LEFT SIDEBAR
             ========================================================= -->
        <aside class="col-lg-3">
            @Html.Partial("~/Areas/CSharp/Views/Shared/CSharpTopics.cshtml")
        </aside>


        <!-- =========================================================
             MAIN CONTENT
             ========================================================= -->
        <section class="col-lg-9">

            <div class="card shadow-sm p-4 p-md-5 mb-4">

                <!-- PAGE TITLE -->
                <h2 class="h1 fw-bold text-dark mt-1 mb-4">
                    Multithreading
                </h2>

                <p class="text-muted mb-4">
                    Multithreading is a programming technique in which an application
                    uses multiple threads to perform different pieces of work.
                    A thread is an independent path of execution inside a process.
                </p>

                <div class="alert alert-info mb-4">
                    <strong>Key Idea:</strong>
                    A multithreaded application can have multiple threads working
                    independently or cooperatively within the same process.
                </div>


                <!-- =====================================================
                     1. WHAT IS A THREAD?
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-4 mb-3">
                    What is a Thread?
                </h3>

                <p class="text-muted mb-4">
                    A <strong>thread</strong> is the smallest sequence of programmed
                    instructions that can be managed independently by the operating
                    system and runtime.
                </p>

                <p class="text-muted mb-4">
                    When a C# application starts, it has at least one thread called
                    the <strong>main thread</strong>. Additional threads can be created
                    when an application needs concurrent execution.
                </p>

                <div class="alert alert-success mb-4">
                    <strong>Simple Example:</strong>
                    Think of a software application as an office. Instead of one
                    employee doing every task, multiple employees can work on
                    different tasks. Each employee represents a thread.
                </div>


                <!-- =====================================================
                     2. PROCESS VS THREAD
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Process vs Thread
                </h3>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Thread</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>An executing application</td>
                                <td>An execution path inside a process</td>
                            </tr>
                            <tr>
                                <td>Has its own memory space</td>
                                <td>Shares process resources</td>
                            </tr>
                            <tr>
                                <td>Generally heavier</td>
                                <td>Generally lighter than a process</td>
                            </tr>
                            <tr>
                                <td>Can contain multiple threads</td>
                                <td>Belongs to a process</td>
                            </tr>
                        </tbody>
                    </table>
                </div>


                <!-- =====================================================
                     3. SINGLE THREAD
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Single Thread Execution
                </h3>

                <p class="text-muted mb-4">
                    In a simple program, statements normally execute one after
                    another on the main thread.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
class Program
{
    static void Main()
    {
        Console.WriteLine("Task 1");
        Console.WriteLine("Task 2");
        Console.WriteLine("Task 3");
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Output
                </h4>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">Output</div>
                    <pre class="mb-0"><code>Task 1
Task 2
Task 3</code></pre>
                </div>

                <p class="text-muted mb-4">
                    The statements execute sequentially on the same execution path.
                </p>


                <!-- =====================================================
                     4. CREATING A THREAD
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Creating a Thread in C#
                </h3>

                <p class="text-muted mb-4">
                    C# provides the <strong>Thread</strong> class in the
                    <strong>System.Threading</strong> namespace for creating and
                    controlling threads.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static void PrintMessage()
    {
        Console.WriteLine("Running on a separate thread");
    }

    static void Main()
    {
        Thread thread = new Thread(PrintMessage);

        thread.Start();

        Console.WriteLine("Main thread is running");
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <p class="text-muted mb-4">
                    The <code>Thread</code> object is created with a method that
                    contains the work. Calling <code>Start()</code> begins execution
                    of that thread.
                </p>

                <div class="alert alert-warning mb-4">
                    <strong>Note:</strong>
                    The order of the two output lines is not guaranteed because the
                    operating system decides when each thread gets execution time.
                </div>


                <!-- =====================================================
                     5. THREAD START
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Thread.Start()
                </h3>

                <p class="text-muted mb-4">
                    The <strong>Start()</strong> method begins execution of the
                    thread.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>
                    <pre class="mb-0"><code>Thread thread = new Thread(PrintMessage);

thread.Start();</code></pre>
                </div>

                <p class="text-muted mb-4">
                    Creating a Thread object does not start its execution.
                    <code>Start()</code> is required to begin the thread.
                </p>


                <!-- =====================================================
                     6. THREAD SLEEP
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Thread.Sleep()
                </h3>

                <p class="text-muted mb-4">
                    <strong>Thread.Sleep()</strong> pauses the current thread for
                    the specified amount of time.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static void Main()
    {
        Console.WriteLine("Start");

        Thread.Sleep(2000);

        Console.WriteLine("End");
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Output
                </h4>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">Output</div>
                    <pre class="mb-0"><code>Start
End</code></pre>
                </div>

                <p class="text-muted mb-4">
                    The current thread pauses for approximately two seconds before
                    executing the next statement.
                </p>


                <!-- =====================================================
                     7. THREAD JOIN
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Thread.Join()
                </h3>

                <p class="text-muted mb-4">
                    The <strong>Join()</strong> method makes the calling thread wait
                    until another thread has completed.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static void Worker()
    {
        for (int i = 1; i &lt;= 3; i++)
        {
            Console.WriteLine("Worker: " + i);
            Thread.Sleep(500);
        }
    }

    static void Main()
    {
        Thread thread = new Thread(Worker);

        thread.Start();

        thread.Join();

        Console.WriteLine("Worker thread completed");
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Output
                </h4>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">Output</div>
                    <pre class="mb-0"><code>Worker: 1
Worker: 2
Worker: 3
Worker thread completed</code></pre>
                </div>


                <!-- =====================================================
                     8. THREAD LIFECYCLE AND STATES
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Thread Lifecycle and States
                </h3>

                <p class="text-muted mb-4">
                    During its lifetime, a thread moves through different execution
                    states. The following diagram shows the basic flow of a thread
                    from creation to completion.
                </p>


                <!-- =====================================================
                     THREAD LIFECYCLE DIAGRAM
                     ===================================================== -->
                <div class="thread-lifecycle-wrapper mb-4">

                    <div class="thread-state-card state-new">
                        <div class="state-title">
                            New / Unstarted
                        </div>
                        <div class="state-description">
                            Thread object is created
                        </div>
                    </div>

                    <div class="thread-arrow">
                        <span>Thread.Start()</span>
                        <strong>↓</strong>
                    </div>

                    <div class="thread-state-card state-ready">
                        <div class="state-title">
                            Runnable / Ready
                        </div>
                        <div class="state-description">
                            Waiting for CPU scheduling
                        </div>
                    </div>

                    <div class="thread-arrow">
                        <span>CPU Scheduler</span>
                        <strong>↓</strong>
                    </div>

                    <div class="thread-state-card state-running">
                        <div class="state-title">
                            Running
                        </div>
                        <div class="state-description">
                            Thread is executing
                        </div>
                    </div>

                    <div class="thread-flow-row">

                        <div class="thread-side-flow left-flow">
                            <div class="flow-label">
                                Thread.Sleep()
                            </div>
                            <div class="flow-label">
                                Monitor.Wait()
                            </div>
                            <div class="flow-label">
                                TargetThread.Join()
                            </div>
                            <div class="flow-arrow">
                                ↓
                            </div>
                        </div>

                        <div class="thread-state-card state-waiting">
                            <div class="state-title">
                                WaitSleepJoin / Blocked
                            </div>
                            <div class="state-description">
                                Waiting, sleeping or blocked
                            </div>
                        </div>

                        <div class="thread-side-flow right-flow">

                            <div class="flow-label">
                                Sleep time ends
                            </div>

                            <div class="flow-label">
                                Object.Pulse()
                            </div>

                            <div class="flow-label">
                                Other thread finishes
                            </div>

                            <div class="flow-arrow">
                                ↑
                            </div>

                        </div>

                    </div>

                    <div class="thread-return-arrow">
                        ↑
                        <span>Returns to Ready</span>
                    </div>

                    <div class="thread-completion-arrow">
                        <span>
                            Task finishes / Unhandled exception
                        </span>
                        <strong>↓</strong>
                    </div>

                    <div class="thread-state-card state-stopped">
                        <div class="state-title">
                            Stopped / Dead
                        </div>
                        <div class="state-description">
                            Thread execution has ended
                        </div>
                    </div>

                </div>


                <!-- =====================================================
                     THREAD LIFECYCLE DIAGRAM STYLES
                     ===================================================== -->
                <style>
                                    .thread-lifecycle-wrapper {
                                        background: #f8f9fa;
                                        border: 1px solid #dee2e6;
                                        border-radius: 12px;
                                        padding: 30px 20px;
                                        overflow: hidden;
                                    }

                                    .thread-state-card {
                                        width: 260px;
                                        max-width: 100%;
                                        margin: 0 auto;
                                        border-radius: 10px;
                                        padding: 16px 20px;
                                        text-align: center;
                                        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
                                    }

                                    .state-title {
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #212529;
                                    }

                                    .state-description {
                                        font-size: 14px;
                                        margin-top: 5px;
                                        color: #6c757d;
                                    }

                                    .state-new {
                                        background: #e9ecef;
                                        border: 2px solid #adb5bd;
                                    }

                                    .state-ready {
                                        background: #fff3cd;
                                        border: 2px solid #ffc107;
                                    }

                                    .state-running {
                                        background: #d1e7dd;
                                        border: 2px solid #198754;
                                    }

                                    .state-waiting {
                                        background: #cfe2ff;
                                        border: 2px solid #0d6efd;
                                    }

                                    .state-stopped {
                                        background: #f8d7da;
                                        border: 2px solid #dc3545;
                                    }

                                    .thread-arrow {
                                        text-align: center;
                                        padding: 10px 0;
                                        color: #495057;
                                    }

                                        .thread-arrow span {
                                            display: block;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }

                                        .thread-arrow strong {
                                            display: block;
                                            font-size: 25px;
                                            line-height: 1;
                                        }

                                    .thread-flow-row {
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        gap: 20px;
                                        margin-top: 20px;
                                    }

                                    .thread-side-flow {
                                        width: 180px;
                                        text-align: center;
                                    }

                                    .flow-label {
                                        background: #ffffff;
                                        border: 1px solid #ced4da;
                                        border-radius: 6px;
                                        padding: 7px 8px;
                                        margin-bottom: 8px;
                                        font-size: 13px;
                                        color: #495057;
                                    }

                                    .flow-arrow {
                                        font-size: 25px;
                                        font-weight: 700;
                                        color: #495057;
                                    }

                                    .thread-return-arrow {
                                        text-align: center;
                                        margin-top: 15px;
                                        color: #0d6efd;
                                        font-size: 22px;
                                        font-weight: 700;
                                    }

                                        .thread-return-arrow span {
                                            display: inline-block;
                                            margin-left: 8px;
                                            font-size: 13px;
                                            vertical-align: middle;
                                        }

                                    .thread-completion-arrow {
                                        text-align: center;
                                        padding: 20px 0 10px;
                                        color: #495057;
                                    }

                                        .thread-completion-arrow span {
                                            display: block;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }

                                        .thread-completion-arrow strong {
                                            display: block;
                                            font-size: 25px;
                                            line-height: 1;
                                        }

                                    @@media (max-width: 768px) {
                                        .thread-flow-row {
                                            flex-direction: column;
                                        }

                                        .thread-side-flow {
                                            width: 100%;
                                            max-width: 260px;
                                        }

                                        .left-flow {
                                            order: 2;
                                        }

                                        .thread-state-card.state-waiting {
                                            order: 1;
                                        }

                                        .right-flow {
                                            order: 3;
                                        }
                                    }
                </style>


                <p class="text-muted mb-4">
                    The lifecycle can be understood as a sequence of states. A thread
                    is created first, started using <code>Start()</code>, scheduled
                    for execution, and then may temporarily wait before becoming
                    ready to run again.
                </p>

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Important Thread States
                </h4>

                <ul class="text-muted mb-4">
                    <li>
                        <strong>Unstarted:</strong>
                        Thread object is created but Start() has not been called.
                    </li>

                    <li>
                        <strong>Runnable / Ready:</strong>
                        Thread is ready to execute and is waiting for CPU scheduling.
                    </li>

                    <li>
                        <strong>Running:</strong>
                        Thread is currently executing its instructions.
                    </li>

                    <li>
                        <strong>WaitSleepJoin:</strong>
                        Thread is waiting, sleeping, or joining another thread.
                    </li>

                    <li>
                        <strong>Stopped:</strong>
                        Thread has completed execution.
                    </li>
                </ul>

                <div class="alert alert-info mb-4">
                    <strong>Remember:</strong>
                    A thread can move between runnable, running and waiting states
                    during its lifetime. The exact scheduling order is controlled
                    by the operating system and .NET runtime.
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Checking Thread State in C#
                </h4>


<div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static void Work()
    {
        Thread.Sleep(1000);
    }

    static void Main()
    {
        Thread thread = new Thread(Work);

        Console.WriteLine(thread.ThreadState);

        thread.Start();

        Console.WriteLine(thread.ThreadState);

        thread.Join();

        Console.WriteLine(thread.ThreadState);
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <p class="text-muted mb-4">
                    Thread states can change quickly during execution, so the exact
                    state observed at a particular moment depends on timing.
                </p>


                <!-- =====================================================
                     9. THREAD ID
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Thread ID
                </h3>

                <p class="text-muted mb-4">
                    Each thread has a managed thread identifier that can be useful
                    while debugging or tracing concurrent execution.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static void ShowThread()
    {
        Console.WriteLine(
            "Worker Thread ID: " +
            Thread.CurrentThread.ManagedThreadId);
    }

    static void Main()
    {
        Console.WriteLine(
            "Main Thread ID: " +
            Thread.CurrentThread.ManagedThreadId);

        Thread thread = new Thread(ShowThread);

        thread.Start();
        thread.Join();
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>
                <p class="text-muted mb-4">
                    The actual numeric IDs can be different each time the program
                    runs.
                </p>


                <!-- =====================================================
                     10. MULTIPLE THREADS
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Example: Multiple Threads
                </h3>

                <p class="text-muted mb-4">
                    An application can create multiple threads, with each thread
                    performing a separate piece of work.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
using System.Threading;

class Program
{
    static void TaskOne()
    {
        for (int i = 1; i &lt;= 5; i++)
        {
            Console.WriteLine("Task One: " + i);
            Thread.Sleep(300);
        }
    }

    static void TaskTwo()
    {
        for (int i = 1; i &lt;= 5; i++)
        {
            Console.WriteLine("Task Two: " + i);
            Thread.Sleep(300);
        }
    }

    static void Main()
    {
        Thread thread1 = new Thread(TaskOne);
        Thread thread2 = new Thread(TaskTwo);

        thread1.Start();
        thread2.Start();

        thread1.Join();
        thread2.Join();

        Console.WriteLine("Both tasks completed");
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>




                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Possible Output
                </h4>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">Output</div>
                    <pre class="mb-0"><code>Task One: 1
Task Two: 1
Task One: 2
Task Two: 2
Task Two: 3
Task One: 3
Task One: 4
Task Two: 4
Task One: 5
Task Two: 5
Both tasks completed</code></pre>
                </div>

                <div class="alert alert-warning mb-4">
                    <strong>Important:</strong>
                    The exact order of output may change between executions because
                    thread scheduling is controlled by the runtime and operating system.
                </div>


                <!-- =====================================================
                     11. SHARED DATA PROBLEM
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Shared Data and Race Conditions
                </h3>

                <p class="text-muted mb-4">
                    Multiple threads can access the same data. If two or more threads
                    modify shared data at the same time, the final result may become
                    unpredictable.
                </p>

                <p class="text-muted mb-4">
                    This situation is commonly known as a
                    <strong>race condition</strong>.
                </p>



                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.Threading;

class Program
{
    static int counter = 0;

    static void Increment()
    {
        for (int i = 0; i &lt; 10000; i++)
        {
            counter++;
        }
    }

    static void Main()
    {
        Thread thread1 = new Thread(Increment);
        Thread thread2 = new Thread(Increment);

        thread1.Start();
        thread2.Start();

        thread1.Join();
        thread2.Join();

        Console.WriteLine("Counter = " + counter);
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <p class="text-muted mb-4">
                    It may be tempting to expect exactly 20000, but unsynchronized
                    concurrent updates can produce an unexpected result.
                </p>


                <!-- =====================================================
                     12. LOCK
                     ===================================================== -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Synchronization Using lock
                </h3>

                <p class="text-muted mb-4">
                    C# provides the <strong>lock</strong> statement to protect a
                    critical section so that only one thread at a time can execute
                    that section for the same lock object.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
using System.Threading;

class Program
{
    static int counter = 0;
    static object lockObject = new object();

    static void Increment()
    {
        for (int i = 0; i &lt; 10000; i++)
        {
            lock (lockObject)
            {
                counter++;
            }
        }
    }

    static void Main()
    {
        Thread thread1 = new Thread(Increment);
        Thread thread2 = new Thread(Increment);

        thread1.Start();
        thread2.Start();

        thread1.Join();
        thread2.Join();

        Console.WriteLine("Counter = " + counter);
    }
}</code></pre>
 
