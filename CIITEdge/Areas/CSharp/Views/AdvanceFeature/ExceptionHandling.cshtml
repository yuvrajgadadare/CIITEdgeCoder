                <!-- ================= EXTENSION METHODS ================= -->

                <section id="extension-methods">

                    <h2 class="h2 fw-bold text-dark mt-5 mb-4">
                        4. Extension Methods
                    </h2>

                    <p class="text-muted">
                        Extension methods allow developers to add new methods
                        to an existing type without modifying the original type
                        or creating a derived class.
                    </p>


                    <h4 class="fw-bold text-dark mt-4 mb-3">
                        Extension Method Syntax
                    </h4>

                    <p class="text-muted">
                        An extension method is defined inside a static class.
                        The first parameter uses the <strong>this</strong> keyword.
                    </p>

                    <div class="code-block mb-4 shadow-sm">
                        <div class="code-lang-tag">C#</div>
                        <pre class="mb-0"><code>public static class StringExtensions
{
    public static bool IsLong(this string text)
    {
        return text.Length &gt; 5;
    }
}</code></pre>
                    </div>


                    <h4 class="fw-bold text-dark mt-4 mb-3">
                        Extension Method Example
                    </h4>


                    <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
public static class StringExtensions
{
    public static bool IsLong(this string text)
    {
        return text.Length &gt; 5;
    }
}

class Program
{
    static void Main()
    {
        string name = "Rahul";

        Console.WriteLine(name.IsLong());
    }
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
