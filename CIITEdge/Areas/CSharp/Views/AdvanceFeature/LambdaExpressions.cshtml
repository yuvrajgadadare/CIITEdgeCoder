                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>
                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>10
20
30
40
50</code></pre>
                </div>


                <!-- FILTER -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda for Filtering Data
                </h3>

                <p class="text-muted">
                    Lambda expressions are frequently used to filter collection data.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; numbers =
    new List&lt;int&gt; { 10, 15, 20, 25, 30 };

var result = numbers.Where(number =&gt; number &gt; 20);

foreach (int number in result)
{
    Console.WriteLine(number);
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>25
30</code></pre>
                </div>


                <!-- FIND -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda with Find()
                </h3>

                <p class="text-muted">
                    The Find() method can use a lambda expression to find
                    the first element that satisfies a condition.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; numbers =
    new List&lt;int&gt; { 10, 20, 30, 40 };

int result = numbers.Find(number =&gt; number &gt; 25);

Console.WriteLine(result);</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>30</code></pre>
                </div>


                <!-- SORT -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda with Sort()
                </h3>

                <p class="text-muted">
                    Lambda expressions can also be used to define custom sorting logic.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; numbers =
    new List&lt;int&gt; { 50, 20, 40, 10, 30 };

numbers.Sort((a, b) =&gt; a.CompareTo(b));

foreach (int number in numbers)
{
    Console.WriteLine(number);
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>10
20
30
40
50</code></pre>
                </div>


                <!-- LINQ -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expressions with LINQ
                </h3>

                <p class="text-muted">
                    One of the most important uses of lambda expressions is with LINQ.
                    LINQ methods such as Where(), Select(), OrderBy(), and Any()
                    commonly accept lambda expressions.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; marks =
    new List&lt;int&gt; { 45, 70, 85, 90, 35 };

var passedMarks =
    marks.Where(mark =&gt; mark &gt;= 50);

foreach (int mark in passedMarks)
{
    Console.WriteLine(mark);
}</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
