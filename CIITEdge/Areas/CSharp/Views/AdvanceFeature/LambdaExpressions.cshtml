@{
    Layout = "~/Areas/CSharp/Views/Shared/CSharpLayout.cshtml";
    ViewData["Title"] = "Lambda Expressions";
}

<style>
.try-it-btn {

    background: #198754;

    color: #fff;

    border: none;

    border-radius: 5px;

    padding: 6px 12px;

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);

    transition: all 0.2s ease;

}
 
.try-it-btn:hover {

    background: #157347;

    color: #fff;

}
</style>

<main id="tutorials" class="container py-5">
    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">
            @Html.Partial("~/Areas/CSharp/Views/Shared/CSharpTopics.cshtml")
        </aside>

        <!-- RIGHT CONTENT -->
        <section class="col-lg-9">

            <div class="card shadow-sm p-4 p-md-5 mb-4">

                <h2 class="h1 fw-bold text-dark mt-1 mb-4">
                    Lambda Expressions
                </h2>

                <p class="text-muted mb-4">
                    Lambda Expressions are a concise way of writing anonymous functions
                    in C#. They are commonly used with delegates, collections, LINQ,
                    filtering, sorting, and event handling.
                </p>

                <div class="alert alert-info">
                    <strong>Simple Definition:</strong>
                    A lambda expression is a short way to write a method or function
                    without explicitly declaring a separate method.
                </div>


                <!-- WHAT IS LAMBDA -->

                <h3 class="fw-bold text-dark mt-4 mb-3">
                    What is a Lambda Expression?
                </h3>

                <p class="text-muted">
                    A lambda expression allows us to write a small function directly
                    where it is required. Lambda expressions are especially useful
                    when the function is short and does not need a separate method.
                </p>

                <p class="text-muted">
                    Lambda expressions use the <strong>=&gt;</strong> operator,
                    which is commonly read as "goes to".
                </p>


                <!-- SYNTAX -->

                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Lambda Expression Syntax
                </h4>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>
                    <pre class="mb-0"><code>(parameters) =&gt; expression</code></pre>
                </div>


                <h4 class="fw-bold text-dark mt-4 mb-3">
                    Simple Lambda Example
                </h4>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Func&lt;int, int&gt; square =
    number =&gt; number * number;

Console.WriteLine(square(5));</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>25</code></pre>
                </div>


                <!-- PARAMETERS -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expression with Parameters
                </h3>

                <p class="text-muted">
                    A lambda expression can accept one or more parameters.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Func&lt;int, int, int&gt; add =
    (a, b) =&gt; a + b;

Console.WriteLine(add(10, 20));</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>

                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>30</code></pre>
                </div>


                <!-- NO PARAMETER -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expression without Parameters
                </h3>

                <p class="text-muted">
                    A lambda expression can also be created without parameters.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Action message = () =&gt;
{
    Console.WriteLine("WelCome to CIIT Training Institute 👨‍🏫❤️...!");
};

message();</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>WelCome to CIIT Training Institute 👨‍🏫❤️...!</code></pre>
                </div>
                    

                <!-- MULTIPLE STATEMENTS -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expression with Multiple Statements
                </h3>

                <p class="text-muted">
                    When a lambda contains multiple statements, curly braces are used.
                    A return statement can be used when the lambda returns a value.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Func&lt;int, int&gt; calculate = number =&gt;
{
    int result = number * 2;
    return result;
};

Console.WriteLine(calculate(10));</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>20</code></pre>
                </div>


                <!-- ACTION -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expression with Action
                </h3>

                <p class="text-muted">
                    Action is a built-in delegate used when a lambda expression
                    does not return a value.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Action&lt;string&gt; greet =
    name =&gt; Console.WriteLine("Hello " + name);

greet("Rahul");</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>


                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>Hello Rahul</code></pre>
                </div>


                <!-- FUNC -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda Expression with Func
                </h3>

                <p class="text-muted">
                    Func is a built-in delegate used when a lambda expression
                    returns a value.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
Func&lt;int, int&gt; cube =
    number =&gt; number * number * number;

Console.WriteLine(cube(3));</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
                class="try-it-btn"
                onclick="tryItYourself(this)">
<i class="bi bi-play-fill me-1"></i>
            Try It
</button>
</div>
 
</div>



                <h5 class="fw-bold">Output</h5>

                <div class="code-block mb-4 shadow-sm">
                    <pre class="mb-0"><code>27</code></pre>
                </div>


                <!-- LIST -->

                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Lambda with List
                </h3>

                <p class="text-muted">
                    Lambda expressions are commonly used with collections such as List.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; numbers =
    new List&lt;int&gt; { 10, 20, 30, 40, 50 };

numbers.ForEach(number =&gt;
{
    Console.WriteLine(number);
});</code></pre>
 
    </div>
 
    <div class="text-end mt-2 mb-3">
<button type="button"
