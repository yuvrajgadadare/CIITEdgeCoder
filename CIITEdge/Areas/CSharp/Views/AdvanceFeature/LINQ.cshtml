            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
List&lt;int&gt; marks =
    new List&lt;int&gt; { 35, 55, 65, 40, 80 };

var passed =
    marks.Where(mark =&gt; mark &gt;= 50);

foreach (int mark in passed)
{
