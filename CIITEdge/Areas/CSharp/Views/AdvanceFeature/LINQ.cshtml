                <p class="text-muted">
                    GroupBy() groups elements according to a specified key.
                    It is useful when data needs to be categorized.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
class Student
{
    public string Name { get; set; }
    public string Course { get; set; }
}

List&lt;Student&gt; students = new List&lt;Student&gt;
{
    new Student { Name = "Rahul", Course = "C#" },
    new Student { Name = "Sneha", Course = "Java" },
    new Student { Name = "Amit", Course = "C#" }
};

var groups =
    students.GroupBy(student =&gt; student.Course);

foreach (var group in groups)
{
    Console.WriteLine(group.Key);

    foreach (var student in group)
    {
        Console.WriteLine(student.Name);
    }
}</code></pre>
 
    </div>
 
