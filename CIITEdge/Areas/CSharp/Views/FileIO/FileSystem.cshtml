                     FILE.COPY
                     ================================================= -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Copying a File
                </h3>

                <p class="text-muted mb-4">
                    The <code>File.Copy()</code> method creates a copy of an
                    existing file at another location.
                </p>


                <div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.IO;

class Program
{
    static void Main()
    {
        string source = "student.txt";
        string destination = "student-copy.txt";

        File.Copy(source, destination, true);

        Console.WriteLine("File copied successfully✅");
    }
}</code></pre>
 
    </div>
                <div class="text-end mt-2 mb-3">         
<button type="button" class="try-it-btn"  onclick="tryItYourself(this)"> 
