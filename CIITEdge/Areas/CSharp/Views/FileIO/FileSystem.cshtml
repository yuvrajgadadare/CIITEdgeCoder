                    Use exception handling when file operations are expected
                    to interact with external resources.
                </p>


<div class="try-it-example">
 
    <div class="code-block shadow-sm">
 
        <div class="code-lang-tag">
            C#
</div>
 
        <pre class="mb-0"><code>using System;
 
using System.IO;

class Program
{
    static void Main()
    {
        try
        {
            string content =
                File.ReadAllText("missing.txt");

            Console.WriteLine(content);
        }
        catch (FileNotFoundException)
        {
            Console.WriteLine("File was not found.");
        }
        catch (IOException)
        {
            Console.WriteLine("File operation failed.");
        }
    }
}</code></pre>
 
