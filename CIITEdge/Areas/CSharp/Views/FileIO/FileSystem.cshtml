                     FILEINFO
                     ================================================= -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    FileInfo Class
                </h3>

                <p class="text-muted mb-4">
                    <code>FileInfo</code> provides instance-based operations
                    and information about a specific file.
                </p>

                <p class="text-muted mb-4">
                    It can be useful when an application performs multiple
                    operations on the same file.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>
                    <pre class="mb-0"><code>using System;
using System.IO;

class Program
{
    static void Main()
    {
        FileInfo file = new FileInfo("student.txt");

        Console.WriteLine("File Name: " + file.Name);
        Console.WriteLine("Extension: " + file.Extension);
        Console.WriteLine("Full Path: " + file.FullName);
        Console.WriteLine("Size: " + file.Length + " bytes");
    }
}</code></pre>
