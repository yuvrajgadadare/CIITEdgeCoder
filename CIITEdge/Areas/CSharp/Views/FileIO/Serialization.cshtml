                <!-- =================================================
                     JSON PROPERTY NAME
                     ================================================= -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Controlling JSON Property Names
                </h3>

                <p class="text-muted mb-4">
                    Sometimes the JSON property name needs to be different
                    from the C# property name. The
                    <code>JsonPropertyName</code> attribute can be used for
                    this purpose.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>
                    <pre class="mb-0"><code>using System;
using System.Text.Json.Serialization;

public class Student
{
    [JsonPropertyName("student_id")]
    public int Id { get; set; }

    [JsonPropertyName("student_name")]
    public string Name { get; set; }

    public string Course { get; set; }
}</code></pre>
                </div>

                <p class="text-muted mb-4">
                    The resulting JSON can use
                    <code>student_id</code> and
                    <code>student_name</code> instead of the C# property names.
                </p>


                <!-- =================================================
                     IGNORE PROPERTY
                     ================================================= -->
                <h3 class="fw-bold text-dark mt-5 mb-3">
                    Ignoring a Property
                </h3>

                <p class="text-muted mb-4">
                    The <code>JsonIgnore</code> attribute can be used when a
                    property should not be included in serialized JSON.
                </p>

                <div class="code-block mb-4 shadow-sm">
                    <div class="code-lang-tag">C#</div>
                    <pre class="mb-0"><code>using System.Text.Json.Serialization;

public class Student
{
    public int Id { get; set; }

    public string Name { get; set; }

    public string Course { get; set; }

    [JsonIgnore]
    public string Password { get; set; }
}</code></pre>
                </div>

                <div class="alert alert-warning mb-4">
                    <strong>Important:</strong>
                    Sensitive information such as passwords should not be
                    exposed through serialized API responses.
                </div>


