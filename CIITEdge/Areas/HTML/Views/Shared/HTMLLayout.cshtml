<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CIIT Institute | Learn HTML Step-by-Step</title>

    <script type="importmap"></script>


    <!-- ===================================================== -->
    <!-- BOOTSTRAP -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ===================================================== -->
    <!-- SITE CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- ===================================================== -->
    <!-- PROJECT CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/CIITEdge.styles.css"
          asp-append-version="true" />


    <!-- ===================================================== -->
    <!-- BOOTSTRAP JS -->
    <!-- ===================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <style>

            /* ===================================================== */
            /* SAME THEME AS C# / CORE JAVA / PYTHON */
            /* ===================================================== */

            :root {
                --brand-purple: #4c1d95;
                --brand-purple-dark: #2e1065;
                --syntax-bg: #0f172a;
            }


            /* ===================================================== */
            /* HERO GRADIENT */
            /* ===================================================== */

            .bg-brand-gradient {
                background: linear-gradient( 135deg, var(--brand-purple-dark) 0%, #312e81 100% );
            }


            /* ===================================================== */
            /* NAVBAR BRAND */
            /* ===================================================== */

            .navbar-brand span {
                color: #c084fc;
                font-weight: 900;
                letter-spacing: 0.05em;
            }


            /* ===================================================== */
            /* CODE BLOCK */
            /* ===================================================== */

            .code-block {
                background-color: var(--syntax-bg);
                color: #f1f5f9;
                padding: 1.5rem;
                border-radius: 0.5rem;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.875rem;
                line-height: 1.6;
                position: relative;
                overflow-x: auto;
            }


            /* ===================================================== */
            /* CODE LANGUAGE TAG */
            /* ===================================================== */

            .code-lang-tag {
                position: absolute;
                top: 0.5rem;
                right: 1rem;
                font-size: 0.75rem;
                color: #64748b;
                user-select: none;
            }


            /* ===================================================== */
            /* CODE COLORS */
            /* ===================================================== */

            .keyword {
                color: #c084fc;
            }

            .class-name {
                color: #34d399;
            }

            .method-name {
                color: #fbbf24;
            }

            .string-lit {
                color: #fef08a;
            }


            /* ===================================================== */
            /* CODE EDITOR */
            /* ===================================================== */

            .editor-textarea {
                background-color: #1e1e1e !important;
                color: #d4d4d4 !important;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.9rem;
                resize: vertical;
            }


            /* ===================================================== */
            /* TERMINAL OUTPUT */
            /* ===================================================== */

            .terminal-output {
                background-color: #000000;
                color: #f1f1f1;
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.85rem;
                min-height: 100px;
                white-space: pre-wrap;
            }


            /* ===================================================== */
            /* HTML SIDEBAR */
            /* ===================================================== */

            .html-sidebar {
                position: sticky;
                top: 90px;
            }

                .html-sidebar .card {
                    border-radius: 0.5rem;
                    overflow: hidden;
                }

                .html-sidebar .module-title {
                    font-weight: 700;
                    background-color: #ffffff;
                    color: #212529;
                }

                .html-sidebar .topic-link {
                    padding-left: 2rem;
                    font-size: 0.92rem;
                    text-decoration: none;
                    color: #495057;
                    font-weight: 400;
                    background-color: #ffffff;
                    border-top: 0;
                    border-left: 0;
                    border-right: 0;
                    border-bottom: 1px solid #e5e7eb;
                }

                    .html-sidebar .topic-link:hover {
                        background-color: #ffffff;
                        color: #495057;
                    }

                    .html-sidebar .topic-link.active {
                        background-color: #ffffff !important;
                        color: #495057 !important;
                        font-weight: 400 !important;
                        border-top: 0;
                        border-left: 0;
                        border-right: 0;
                        border-bottom: 2px solid #2563eb !important;
                    }


            /* ===================================================== */
            /* TRY IT BUTTON */
            /* ===================================================== */

            .try-it-container {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 15px;
}

.try-it-btn {
    background-color: #04AA6D;
    color: #ffffff;
    border: none;
    padding: 6px 14px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.try-it-btn:hover {
    background-color: #038c5a;
    color: #ffffff;
}

.try-it-btn:active {
    transform: scale(0.97);
}

            /* ===================================================== */
            /* MOBILE */
            /* ===================================================== */

            @@media (max-width: 991.98px) {

                .html-sidebar {
                    position: static;
                }

                .try-it-container {
                    justify-content: flex-end;
                }
            }

    </style>

</head>


<body class="bg-light text-dark">


    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->
    @Html.Partial("~/Views/Shared/Menus/MenusWithDropdown.cshtml")

    @Html.Partial("~/Views/Shared/Menus/ProgrammingMenus.cshtml")


    <!-- ===================================================== -->
    <!-- HTML HERO SECTION -->
    <!-- ===================================================== -->

    <header class="bg-brand-gradient text-white text-center py-5">

        <div class="container py-4">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <h1 class="display-4 fw-extrabold mb-3">
                        Master HTML From Scratch
                    </h1>

                    <p class="lead text-purple-100 mb-4 opacity-75">
                        Clear, interactive, and structured HTML lessons
                        designed for beginners.
                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main id="tutorials"
          class="container py-1">

        @RenderBody()

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="bg-dark text-muted text-center py-4 border-top border-secondary mt-5">
    </footer>


    <!-- ===================================================== -->
<!-- TRY IT FUNCTION -->
<!-- ===================================================== -->



<script>

    function tryHTML(button) {

        // Get ALL code blocks on the page
        var codeBlocks =
            document.querySelectorAll("pre code");

        var nearestCode = null;

        // Find the LAST code block that appears
        // BEFORE this Try It button
        for (var i = 0; i < codeBlocks.length; i++) {

            var position =
                codeBlocks[i].compareDocumentPosition(button);

            // Code block is before the button
            if (position & Node.DOCUMENT_POSITION_FOLLOWING) {

                nearestCode = codeBlocks[i];
            }
        }

        // No code found
        if (!nearestCode) {

            alert("HTML code block not found.");
            return;
        }

        // Get actual HTML source code
        var code =
            nearestCode.textContent.trim();

        if (!code) {

            alert("No HTML code found.");
            return;
        }

        // Convert code to UTF-8 Base64
        var encodedCode =
            btoa(
                unescape(
                    encodeURIComponent(code)
                )
            );

        // Make Base64 URL safe
        encodedCode =
            encodedCode
                .replace(/\+/g, "-")
                .replace(/\//g, "_")
                .replace(/=+$/, "");

        // Open compiler in NEW TAB
        var compilerUrl =
            "/CodeRunner/HtmlRunner?code="
            + encodeURIComponent(encodedCode);

        window.open(
            compilerUrl,
            "_blank"
        );
    }

</script>
</body>

</html>