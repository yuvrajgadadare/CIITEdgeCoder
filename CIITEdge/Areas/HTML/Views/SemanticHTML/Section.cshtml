            <h2>16. section vs div</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;section&gt;</code></td>
                            <td>Groups related content around a meaningful theme.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;div&gt;</code></td>
                            <td>Generic container without specific semantic meaning.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>17. section vs article</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;section&gt;</code></td>
                            <td>Groups related content within a larger document.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;article&gt;</code></td>
                            <td>Represents content that can stand independently.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

