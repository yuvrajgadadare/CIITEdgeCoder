@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Semantic Elements";
}

<style>
    .content-section {
        line-height: 1.8;
    }

    .content-section h2 {
        color: #212529 !important;
        font-weight: 700;
        margin-top: 24px;
        margin-bottom: 14px;
    }

    .content-section h3 {
        color: #374151;
        font-weight: 600;
        margin-top: 22px;
        margin-bottom: 12px;
    }

    .content-section p {
        color: #4b5563;
    }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

    pre code {
        background: transparent !important;
        color: #fff !important;
    }

    .info-box {
        background: #f3f4ff;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 6px;
        margin: 18px 0;
    }

    .demo-box {
        border: 1px solid #dee2e6;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .semantic-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-bottom: 15px;
        background: #fff;
    }

    .semantic-card code {
        font-weight: 600;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<main id="main-content" class="container py-5">
    <div class="row g-4">

        <!-- Left Sidebar -->
        <div class="col-lg-3">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 content-section">

            <h1 class="fw-bold mb-3">HTML Semantic Elements</h1>

            <p>
                Semantic elements are HTML elements that clearly describe the meaning
                and role of the content they contain. They help developers create a
                structured and meaningful web page.
            </p>

            <div class="info-box">
                <strong>Key Point:</strong>
                Common semantic elements include
                <code>&lt;header&gt;</code>,
                <code>&lt;nav&gt;</code>,
                <code>&lt;main&gt;</code>,
                <code>&lt;section&gt;</code>,
                <code>&lt;article&gt;</code>,
                <code>&lt;aside&gt;</code>,
                and
                <code>&lt;footer&gt;</code>.
            </div>

            <h2>1. What are Semantic Elements?</h2>

            <p>
                Semantic elements tell the browser, developers, and assistive technologies
                what a particular part of the document represents.
            </p>

            <pre><code>&lt;header&gt;
    Website Header
&lt;/header&gt;

&lt;main&gt;
    Main Content
&lt;/main&gt;

&lt;footer&gt;
    Website Footer
&lt;/footer&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <p>
                The element names themselves communicate the purpose of each area.
            </p>

            <h2>2. Common Semantic Elements</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                            <th>Typical Content</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;header&gt;</code></td>
                            <td>Introductory or header content</td>
                            <td>Logo, title, introductory content</td>
                        </tr>
                        <tr>
                            <td><code>&lt;nav&gt;</code></td>
                            <td>Navigation area</td>
                            <td>Navigation links</td>
                        </tr>
                        <tr>
                            <td><code>&lt;main&gt;</code></td>
                            <td>Primary page content</td>
                            <td>Main content of the document</td>
                        </tr>
                        <tr>
                            <td><code>&lt;section&gt;</code></td>
                            <td>Thematic content grouping</td>
                            <td>A chapter, topic, or related group of content</td>
                        </tr>
                        <tr>
                            <td><code>&lt;article&gt;</code></td>
                            <td>Independent content</td>
                            <td>Blog post, news article, forum post</td>
                        </tr>
                        <tr>
                            <td><code>&lt;aside&gt;</code></td>
                            <td>Related secondary content</td>
                            <td>Sidebar, related links, additional information</td>
                        </tr>
                        <tr>
                            <td><code>&lt;footer&gt;</code></td>
                            <td>Footer information</td>
                            <td>Copyright, contact information, links</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>3. header Element</h2>

            <p>
                The <code>&lt;header&gt;</code> element represents introductory content
                for a page or a particular section.
            </p>

            <pre><code>&lt;header&gt;
    &lt;h1&gt;CIIT Training Institute&lt;/h1&gt;
    &lt;p&gt;Technology Training and Learning&lt;/p&gt;
&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="demo-box">
                <header>
                    <h3 class="mb-2">CIIT Training Institute</h3>
                    <p class="mb-0">
                        Technology Training and Learning
                    </p>
                </header>
            </div>

            <h2>4. nav Element</h2>

            <p>
                The <code>&lt;nav&gt;</code> element identifies a section containing
                important navigation links.
            </p>

            <pre><code>&lt;nav&gt;
    &lt;a href="/home"&gt;Home&lt;/a&gt;
    &lt;a href="/courses"&gt;Courses&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;
&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="demo-box">
                <nav>
                    <a href="#" class="me-3">Home</a>
                    <a href="#" class="me-3">Courses</a>
                    <a href="#">Contact</a>
                </nav>
            </div>

            <h2>5. main Element</h2>

            <p>
                The <code>&lt;main&gt;</code> element contains the primary content
                of the document.
            </p>

            <pre><code>&lt;main&gt;

    &lt;h1&gt;HTML Tutorial&lt;/h1&gt;

    &lt;p&gt;
        Learn HTML from beginner to advanced concepts.
    &lt;/p&gt;

&lt;/main&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="info-box">
                <strong>Important:</strong>
                The main content should be the central content of the page, excluding
                repeated navigation, headers, and other supporting content.
            </div>

            <h2>6. section Element</h2>

            <p>
                The <code>&lt;section&gt;</code> element groups related content around
                a specific theme or topic.
            </p>

            <pre><code>&lt;section&gt;

    &lt;h2&gt;HTML Forms&lt;/h2&gt;

    &lt;p&gt;
        Learn how to create forms using HTML.
    &lt;/p&gt;

&lt;/section&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>7. article Element</h2>

            <p>
                The <code>&lt;article&gt;</code> element represents self-contained content
                that can be understood independently.
            </p>

            <p>
                Examples include blog posts, news articles, product reviews, and forum posts.
            </p>

            <pre><code>&lt;article&gt;

    &lt;h2&gt;Introduction to HTML&lt;/h2&gt;

    &lt;p&gt;
        HTML is used to structure web pages.
    &lt;/p&gt;

&lt;/article&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>8. aside Element</h2>

            <p>
                The <code>&lt;aside&gt;</code> element represents content that is related
                to the surrounding content but is not part of its main flow.
            </p>

            <pre><code>&lt;aside&gt;

    &lt;h3&gt;Related Topics&lt;/h3&gt;

    &lt;ul&gt;
        &lt;li&gt;CSS&lt;/li&gt;
        &lt;li&gt;JavaScript&lt;/li&gt;
    &lt;/ul&gt;

&lt;/aside&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>9. footer Element</h2>

            <p>
                The <code>&lt;footer&gt;</code> element contains footer information
                for a page or a section.
            </p>

            <pre><code>&lt;footer&gt;
    &lt;p&gt;
        &copy; 2026 CIIT Training Institute
    &lt;/p&gt;
&lt;/footer&gt;</code></pre>

            <h2>10. figure Element</h2>

            <p>
                The <code>&lt;figure&gt;</code> element represents self-contained content,
                such as an image, diagram, code example, or illustration.
            </p>

            <pre><code>&lt;figure&gt;

    &lt;img src="html.png"
         alt="HTML Document Structure"&gt;

&lt;/figure&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>11. figcaption Element</h2>

            <p>
                The <code>&lt;figcaption&gt;</code> element provides a caption or description
                for a <code>&lt;figure&gt;</code>.
            </p>

            <pre><code>&lt;figure&gt;

    &lt;img src="html.png"
         alt="HTML Document Structure"&gt;

    &lt;figcaption&gt;
        HTML Document Structure
    &lt;/figcaption&gt;

&lt;/figure&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>12. time Element</h2>

            <p>
                The <code>&lt;time&gt;</code> element represents a specific time or date.
            </p>

            <pre><code>&lt;p&gt;
    Course starts on
    &lt;time datetime="2026-10-01"&gt;
        October 1, 2026
    &lt;/time&gt;.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>13. mark Element</h2>

            <p>
                The <code>&lt;mark&gt;</code> element highlights text that is relevant
                or important in a particular context.
            </p>

            <pre><code>&lt;p&gt;
    Learn &lt;mark&gt;HTML&lt;/mark&gt; for web development.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>
            <div class="demo-box">
                <p class="mb-0">
                    Learn <mark>HTML</mark> for web development.
                </p>
            </div>

            <h2>14. address Element</h2>

            <p>
                The <code>&lt;address&gt;</code> element provides contact information
                for the author or owner of the content.
            </p>

            <pre><code>&lt;address&gt;
    Email:
    training@example.com
&lt;/address&gt;</code></pre>

            <h2>15. Details and Summary</h2>

            <p>
                The <code>&lt;details&gt;</code> element creates a disclosure area that
                the user can open or close. The <code>&lt;summary&gt;</code> element
                provides the visible label.
            </p>

            <pre><code>&lt;details&gt;

    &lt;summary&gt;
        What is HTML?
    &lt;/summary&gt;

    &lt;p&gt;
        HTML is the standard markup language for web pages.
    &lt;/p&gt;

&lt;/details&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h3>Output</h3>

            <div class="demo-box">
                <details>
                    <summary class="fw-semibold">
                        What is HTML?
                    </summary>

                    <p class="mt-2 mb-0">
                        HTML is the standard markup language used to structure web pages.
                    </p>
                </details>
            </div>

            <h2>16. Semantic Elements with Headings</h2>

            <p>
                Semantic sections are often easier to understand when they include
                appropriate headings.
            </p>

            <pre><code>&lt;section&gt;

    &lt;h2&gt;Our Courses&lt;/h2&gt;

    &lt;article&gt;

        &lt;h3&gt;.NET Full Stack&lt;/h3&gt;

        &lt;p&gt;
            Learn C#, .NET, SQL, Web API and frontend technologies.
        &lt;/p&gt;

    &lt;/article&gt;

&lt;/section&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>17. Nested Semantic Elements</h2>

            <p>
                Semantic elements can be nested to create a meaningful document hierarchy.
            </p>

            <pre><code>&lt;main&gt;

    &lt;section&gt;

        &lt;h2&gt;Latest Courses&lt;/h2&gt;

        &lt;article&gt;
            &lt;h3&gt;HTML Course&lt;/h3&gt;
            &lt;p&gt;
                Learn HTML fundamentals.
            &lt;/p&gt;
        &lt;/article&gt;

        &lt;article&gt;
            &lt;h3&gt;CSS Course&lt;/h3&gt;
            &lt;p&gt;
                Learn CSS fundamentals.
            &lt;/p&gt;
        &lt;/article&gt;

    &lt;/section&gt;

    &lt;aside&gt;
        Related Learning Resources
    &lt;/aside&gt;

&lt;/main&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>18. Complete Semantic Structure</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;

&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;title&gt;Semantic HTML&lt;/title&gt;
&lt;/head&gt;

&lt;body&gt;

    &lt;header&gt;
        &lt;h1&gt;My Learning Website&lt;/h1&gt;
    &lt;/header&gt;

    &lt;nav&gt;
        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;
    &lt;/nav&gt;

    &lt;main&gt;

        &lt;section&gt;

            &lt;h2&gt;Courses&lt;/h2&gt;

            &lt;article&gt;

                &lt;h3&gt;HTML Course&lt;/h3&gt;

                &lt;p&gt;
                    Learn HTML from basic to advanced concepts.
                &lt;/p&gt;

            &lt;/article&gt;

        &lt;/section&gt;

        &lt;aside&gt;

            &lt;h3&gt;Related Topics&lt;/h3&gt;

            &lt;p&gt;
                CSS and JavaScript
            &lt;/p&gt;

        &lt;/aside&gt;

    &lt;/main&gt;

    &lt;footer&gt;

        &lt;p&gt;
            &copy; 2026 My Learning Website
        &lt;/p&gt;

    &lt;/footer&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>19. Semantic and Non-Semantic Comparison</h2>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="semantic-card">
                        <h3 class="mt-0">Semantic</h3>

                        <pre><code>&lt;header&gt;
    Header
&lt;/header&gt;

&lt;nav&gt;
    Navigation
&lt;/nav&gt;

&lt;main&gt;
    Main Content
&lt;/main&gt;

&lt;footer&gt;
    Footer
&lt;/footer&gt;</code></pre>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="semantic-card">
                        <h3 class="mt-0">Non-Semantic</h3>

                        <pre><code>&lt;div&gt;
    Header
&lt;/div&gt;

&lt;div&gt;
    Navigation
&lt;/div&gt;

&lt;div&gt;
    Main Content
&lt;/div&gt;

&lt;div&gt;
    Footer
&lt;/div&gt;</code></pre>
                    </div>
                </div>

            </div>

            <h2>20. Advantages of Semantic Elements</h2>

            <ul>
                <li>Make the document structure easier to understand.</li>
                <li>Improve HTML readability.</li>
                <li>Make the code easier to maintain.</li>
                <li>Provide clearer structural information to assistive technologies.</li>
                <li>Help organize large web pages into meaningful areas.</li>
                <li>Support a more logical document structure.</li>
            </ul>

            <h2>21. Common Mistakes</h2>

            <h3>Mistake 1: Using div for every element</h3>

            <pre><code>&lt;div&gt;Header&lt;/div&gt;
&lt;div&gt;Navigation&lt;/div&gt;
&lt;div&gt;Main Content&lt;/div&gt;
&lt;div&gt;Footer&lt;/div&gt;</code></pre>

            <p>
                Prefer meaningful semantic elements when the role of the content is known.
            </p>

            <h3>Mistake 2: Misusing section</h3>

            <p>
                A <code>&lt;section&gt;</code> should represent a meaningful thematic grouping.
                It should not automatically replace every <code>&lt;div&gt;</code>.
            </p>

            <h3>Mistake 3: Misusing main</h3>

            <p>
                The <code>&lt;main&gt;</code> element should identify the page's primary content.
            </p>

            <h2>22. Best Practices</h2>

            <ul>
                <li>Choose semantic elements according to the purpose of the content.</li>
                <li>Use one primary <code>&lt;main&gt;</code> area for the page content.</li>
                <li>Use <code>&lt;nav&gt;</code> for important navigation blocks.</li>
                <li>Use <code>&lt;section&gt;</code> for meaningful topic groups.</li>
                <li>Use <code>&lt;article&gt;</code> for independent content.</li>
                <li>Use <code>&lt;aside&gt;</code> for related secondary content.</li>
                <li>Use <code>&lt;header&gt;</code> and <code>&lt;footer&gt;</code> where appropriate.</li>
                <li>Do not select semantic elements only for their default visual appearance.</li>
            </ul>

            <h2>23. Practice Example</h2>

            <p>
                Create a semantic page containing a header, navigation, main content,
                two articles, an aside, and a footer.
            </p>

            <pre><code>&lt;header&gt;
    &lt;h1&gt;Learning Portal&lt;/h1&gt;
&lt;/header&gt;

&lt;nav&gt;
    &lt;a href="#"&gt;Home&lt;/a&gt;
    &lt;a href="#"&gt;Courses&lt;/a&gt;
    &lt;a href="#"&gt;Contact&lt;/a&gt;
&lt;/nav&gt;

&lt;main&gt;

    &lt;section&gt;

        &lt;h2&gt;Popular Courses&lt;/h2&gt;

        &lt;article&gt;
            &lt;h3&gt;HTML&lt;/h3&gt;
            &lt;p&gt;
                Learn HTML fundamentals.
            &lt;/p&gt;
        &lt;/article&gt;

        &lt;article&gt;
            &lt;h3&gt;CSS&lt;/h3&gt;
            &lt;p&gt;
                Learn CSS fundamentals.
            &lt;/p&gt;
        &lt;/article&gt;

    &lt;/section&gt;

    &lt;aside&gt;
        &lt;h3&gt;Related Topics&lt;/h3&gt;
        &lt;p&gt;
            JavaScript and Web Development
        &lt;/p&gt;
    &lt;/aside&gt;

&lt;/main&gt;

&lt;footer&gt;
    &lt;p&gt;
        &copy; 2026 Learning Portal
    &lt;/p&gt;
&lt;/footer&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">
                    Semantic HTML elements describe the purpose of page content.
                    Important elements include <code>&lt;header&gt;</code>,
                    <code>&lt;nav&gt;</code>, <code>&lt;main&gt;</code>,
                    <code>&lt;section&gt;</code>, <code>&lt;article&gt;</code>,
                    <code>&lt;aside&gt;</code>, and <code>&lt;footer&gt;</code>.
                    Using these elements creates a clearer, more meaningful,
                    and easier-to-maintain HTML structure.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Index", "SemanticHTML", new { area = "HTML" })">
                    ← Previous: Semantic HTML
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Header", "SemanticHTML", new { area = "HTML" })">
                    Next: Header →
                </a>
            </div>

        </div>
    </div>
</main>