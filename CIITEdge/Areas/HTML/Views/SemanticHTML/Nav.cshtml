@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Nav Element";
}

<style>
    .content-section {
        line-height: 1.8;
    }

    .content-section h2 {
        color: #212529 !important;
        font-weight: 700;
        margin-top: 24px;
        margin-bottom: 14px;
    }

    .content-section h3 {
        color: #374151;
        font-weight: 600;
        margin-top: 22px;
        margin-bottom: 12px;
    }

    .content-section p {
        color: #4b5563;
    }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

    pre code {
        background: transparent !important;
        color: #fff !important;
    }

    .info-box {
        background: #f3f4ff;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 6px;
        margin: 18px 0;
    }

    .demo-box {
        border: 1px solid #dee2e6;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .demo-nav {
        padding: 14px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    .demo-nav a {
        margin-right: 20px;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<main id="main-content" class="container py-5">
    <div class="row g-4">

        <!-- Left Sidebar -->
        <div class="col-lg-3">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 content-section">

            <h1 class="fw-bold mb-3">HTML Nav Element</h1>

            <p>
                The HTML <code>&lt;nav&gt;</code> element represents a section of a page
                that contains important navigation links. It helps organize links used
                to move between pages or different parts of a website.
            </p>

            <div class="info-box">
                <strong>Key Point:</strong>
                Use <code>&lt;nav&gt;</code> for major navigation areas such as
                main menus, course menus, documentation navigation, or other
                important groups of navigation links.
            </div>

            <h2>1. What is the nav Element?</h2>

            <p>
                The <code>&lt;nav&gt;</code> element is a semantic HTML element used
                to identify a block of navigation links.
            </p>

            <pre><code>&lt;nav&gt;

    &lt;a href="/home"&gt;Home&lt;/a&gt;
    &lt;a href="/courses"&gt;Courses&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <nav class="demo-nav">
                    <a href="#">Home</a>
                    <a href="#">Courses</a>
                    <a href="#">Contact</a>
                </nav>
            </div>

            <h2>2. Purpose of the nav Element</h2>

            <p>
                The <code>&lt;nav&gt;</code> element tells the browser and assistive
                technologies that the enclosed links form a navigation area.
            </p>

            <p>
                Common examples include:
            </p>

            <ul>
                <li>Main website navigation</li>
                <li>Course navigation</li>
                <li>Documentation navigation</li>
                <li>Navigation between major sections</li>
                <li>Other important link collections</li>
            </ul>

            <h2>3. Basic Navigation Menu</h2>

            <pre><code>&lt;nav&gt;

    &lt;a href="/home"&gt;Home&lt;/a&gt;
    &lt;a href="/about"&gt;About&lt;/a&gt;
    &lt;a href="/services"&gt;Services&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <nav class="demo-nav">
                    <a href="#">Home</a>
                    <a href="#">About</a>
                    <a href="#">Services</a>
                    <a href="#">Contact</a>
                </nav>
            </div>

            <h2>4. nav with ul and li</h2>

            <p>
                A navigation menu is often structured using an unordered list
                containing list items and links.
            </p>

            <pre><code>&lt;nav&gt;

    &lt;ul&gt;

        &lt;li&gt;
            &lt;a href="/home"&gt;Home&lt;/a&gt;
        &lt;/li&gt;

        &lt;li&gt;
            &lt;a href="/courses"&gt;Courses&lt;/a&gt;
        &lt;/li&gt;

        &lt;li&gt;
            &lt;a href="/contact"&gt;Contact&lt;/a&gt;
        &lt;/li&gt;

    &lt;/ul&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>5. nav with Header</h2>

            <p>
                A common website structure places the main navigation inside the page header.
            </p>

            <pre><code>&lt;header&gt;

    &lt;h1&gt;Learning Portal&lt;/h1&gt;

    &lt;nav&gt;

        &lt;a href="/home"&gt;Home&lt;/a&gt;
        &lt;a href="/courses"&gt;Courses&lt;/a&gt;
        &lt;a href="/about"&gt;About&lt;/a&gt;
        &lt;a href="/contact"&gt;Contact&lt;/a&gt;

    &lt;/nav&gt;

&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>6. nav with a Main Website Menu</h2>

            <pre><code>&lt;nav&gt;

    &lt;a href="/"&gt;Home&lt;/a&gt;
    &lt;a href="/html"&gt;HTML&lt;/a&gt;
    &lt;a href="/css"&gt;CSS&lt;/a&gt;
    &lt;a href="/javascript"&gt;JavaScript&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div> 
                <h3>Output</h3>

            <div class="demo-box">
                <nav class="demo-nav">
                    <a href="#">Home</a>
                    <a href="#">HTML</a>
                    <a href="#">CSS</a>
                    <a href="#">JavaScript</a>
                    <a href="#">Contact</a>
                </nav>
            </div>

            <h2>7. Navigation with Buttons and Links</h2>

            <p>
                A navigation area generally contains links that move the user to another
                page or location. Buttons are normally used for actions rather than navigation.
            </p>

            <pre><code>&lt;nav&gt;

    &lt;a href="/home"&gt;Home&lt;/a&gt;
    &lt;a href="/courses"&gt;Courses&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="info-box">
                <strong>Remember:</strong>
                Use an anchor element when the main purpose is to navigate somewhere.
                Use a button when the main purpose is to perform an action.
            </div>

            <h2>8. Navigation Using an Unordered List</h2>

            <pre><code>&lt;nav&gt;

    &lt;ul&gt;

        &lt;li&gt;
            &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;/li&gt;

        &lt;li&gt;
            &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;/li&gt;

        &lt;li&gt;
            &lt;a href="#"&gt;Tutorials&lt;/a&gt;
        &lt;/li&gt;

        &lt;li&gt;
            &lt;a href="#"&gt;Contact&lt;/a&gt;
        &lt;/li&gt;

    &lt;/ul&gt;

&lt;/nav&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>9. Styling Navigation with CSS</h2>

            <p>
                CSS can be used to display navigation links horizontally and control
                spacing, colors, borders, and other visual properties.
            </p>

            <pre><code>&lt;nav class="menu"&gt;

    &lt;a href="#"&gt;Home&lt;/a&gt;
    &lt;a href="#"&gt;Courses&lt;/a&gt;
    &lt;a href="#"&gt;About&lt;/a&gt;
    &lt;a href="#"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;

&lt;style&gt;

    .menu {
        display: flex;
        gap: 20px;
    }

&lt;/style&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>10. Vertical Navigation</h2>

            <p>
                Navigation links can also be displayed vertically using CSS.
            </p>

            <pre><code>&lt;nav class="side-menu"&gt;

    &lt;a href="#"&gt;HTML&lt;/a&gt;
    &lt;a href="#"&gt;CSS&lt;/a&gt;
    &lt;a href="#"&gt;JavaScript&lt;/a&gt;

&lt;/nav&gt;

&lt;style&gt;

    .side-menu {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

&lt;/style&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>11. Multiple nav Elements</h2>

            <p>
                A page can contain more than one <code>&lt;nav&gt;</code> element when
                there are different meaningful navigation regions.
            </p>

            <pre><code>&lt;header&gt;

    &lt;nav&gt;

        &lt;a href="/"&gt;Home&lt;/a&gt;
        &lt;a href="/courses"&gt;Courses&lt;/a&gt;

    &lt;/nav&gt;

&lt;/header&gt;

&lt;main&gt;

    &lt;nav&gt;

        &lt;a href="#html"&gt;HTML&lt;/a&gt;
        &lt;a href="#css"&gt;CSS&lt;/a&gt;
        &lt;a href="#javascript"&gt;JavaScript&lt;/a&gt;

    &lt;/nav&gt;

&lt;/main&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="info-box">
                Each navigation region should have a meaningful purpose.
                Avoid adding <code>&lt;nav&gt;</code> to every small group of links.
            </div>

            <h2>12. Navigation with Headings</h2>

            <p>
                A navigation region can have a heading when that makes the structure
                clearer for users.
            </p>

            <pre><code>&lt;nav aria-label="Main Navigation"&gt;

    &lt;a href="/"&gt;Home&lt;/a&gt;
    &lt;a href="/courses"&gt;Courses&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>13. aria-label with nav</h2>

            <p>
                When a page contains multiple navigation regions, an
                <code>aria-label</code> can be used to provide a descriptive name
                for a navigation area.
            </p>

            <pre><code>&lt;nav aria-label="Main Navigation"&gt;

    &lt;a href="/"&gt;Home&lt;/a&gt;
    &lt;a href="/courses"&gt;Courses&lt;/a&gt;
    &lt;a href="/contact"&gt;Contact&lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>14. Navigation for a Course Website</h2>

            <p>
                A training or course website can use navigation to organize its courses.
            </p>

            <pre><code>&lt;nav aria-label="Course Navigation"&gt;

    &lt;a href="/html"&gt;HTML&lt;/a&gt;
    &lt;a href="/css"&gt;CSS&lt;/a&gt;
    &lt;a href="/javascript"&gt;JavaScript&lt;/a&gt;
    &lt;a href="/python"&gt;Python&lt;/a&gt;
    &lt;a href="/dotnet"&gt;.NET&lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>15. Navigation with Internal Page Links</h2>

            <p>
                The <code>&lt;nav&gt;</code> element can also contain links that navigate
                to different sections of the same page.
            </p>

            <pre><code>&lt;nav&gt;

    &lt;a href="#introduction"&gt;
        Introduction
    &lt;/a&gt;

    &lt;a href="#forms"&gt;
        Forms
    &lt;/a&gt;

    &lt;a href="#tables"&gt;
        Tables
    &lt;/a&gt;

&lt;/nav&gt;

&lt;section id="introduction"&gt;
    Introduction Content
&lt;/section&gt;

&lt;section id="forms"&gt;
    Forms Content
&lt;/section&gt;

&lt;section id="tables"&gt;
    Tables Content
&lt;/section&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>16. Navigation and Accessibility</h2>

            <p>
                Semantic navigation helps assistive technologies understand that a group
                of links is intended for navigation.
            </p>

            <p>
                Descriptive labels can be especially useful when a page contains
                multiple navigation regions.
            </p>

            <pre><code>&lt;nav aria-label="Main Navigation"&gt;
    ...
&lt;/nav&gt;

&lt;nav aria-label="Course Navigation"&gt;
    ...
&lt;/nav&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>17. Navigation Inside a Sidebar</h2>

            <p>
                A sidebar can contain its own navigation area.
            </p>

            <pre><code>&lt;aside&gt;

    &lt;nav aria-label="Tutorial Navigation"&gt;

        &lt;a href="/html"&gt;HTML&lt;/a&gt;
        &lt;a href="/css"&gt;CSS&lt;/a&gt;
        &lt;a href="/javascript"&gt;JavaScript&lt;/a&gt;

    &lt;/nav&gt;

&lt;/aside&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>18. Complete Page with nav</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;

&lt;head&gt;

    &lt;meta charset="UTF-8"&gt;

    &lt;title&gt;
        Learning Portal
    &lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;header&gt;

        &lt;h1&gt;
            Learning Portal
        &lt;/h1&gt;

        &lt;nav aria-label="Main Navigation"&gt;

            &lt;a href="/"&gt;Home&lt;/a&gt;
            &lt;a href="/courses"&gt;Courses&lt;/a&gt;
            &lt;a href="/tutorials"&gt;Tutorials&lt;/a&gt;
            &lt;a href="/contact"&gt;Contact&lt;/a&gt;

        &lt;/nav&gt;

    &lt;/header&gt;

    &lt;main&gt;

        &lt;h2&gt;
            Welcome
        &lt;/h2&gt;

        &lt;p&gt;
            Learn web development step by step.
        &lt;/p&gt;

    &lt;/main&gt;

    &lt;footer&gt;

        &lt;p&gt;
            &copy; 2026 Learning Portal
        &lt;/p&gt;

    &lt;/footer&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>19. nav vs div</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;nav&gt;</code></td>
                            <td>Represents an important navigation region.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;div&gt;</code></td>
                            <td>Generic container with no specific semantic meaning.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>20. Common Mistakes</h2>

            <h3>Mistake 1: Using nav for every group of links</h3>

            <p>
                Not every collection of links needs to be inside a
                <code>&lt;nav&gt;</code>. Use it for important navigation areas.
            </p>

            <h3>Mistake 2: Using buttons for normal page navigation</h3>

            <pre><code>&lt;button&gt;Go to Courses&lt;/button&gt;</code></pre>

            <p>
                When the purpose is to navigate to another page, an anchor is generally
                more appropriate:
            </p>

            <pre><code>&lt;a href="/courses"&gt;
    Go to Courses
&lt;/a&gt;</code></pre>

            <h3>Mistake 3: Missing meaningful link text</h3>

            <pre><code>&lt;a href="/courses"&gt;
    Click Here
&lt;/a&gt;</code></pre>

            <p>
                Prefer descriptive link text that communicates where the link goes.
            </p>

            <h2>21. Best Practices</h2>

            <ul>
                <li>Use <code>&lt;nav&gt;</code> for major navigation areas.</li>
                <li>Use anchor elements for navigation to URLs or page sections.</li>
                <li>Use descriptive link text.</li>
                <li>Use <code>aria-label</code> when multiple navigation regions need clear names.</li>
                <li>Do not use <code>&lt;nav&gt;</code> for every small group of links.</li>
                <li>Keep navigation structure simple and easy to understand.</li>
            </ul>

            <h2>22. Practice Example</h2>

            <p>
                Create a website navigation containing Home, Courses, Tutorials,
                About, and Contact links.
            </p>

            <pre><code>&lt;nav aria-label="Main Navigation"&gt;

    &lt;a href="/"&gt;
        Home
    &lt;/a&gt;

    &lt;a href="/courses"&gt;
        Courses
    &lt;/a&gt;

    &lt;a href="/tutorials"&gt;
        Tutorials
    &lt;/a&gt;

    &lt;a href="/about"&gt;
        About
    &lt;/a&gt;

    &lt;a href="/contact"&gt;
        Contact
    &lt;/a&gt;

&lt;/nav&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">
                    The HTML <code>&lt;nav&gt;</code> element represents an important
                    navigation area containing links. It is commonly used for website
                    menus, course navigation, documentation navigation, and internal
                    page navigation. Use descriptive links and meaningful labels,
                    especially when a page contains multiple navigation regions.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Header", "SemanticHTML", new { area = "HTML" })">
                    ← Previous: Header
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Main", "SemanticHTML", new { area = "HTML" })">
                    Next: Main →
                </a>
            </div>

        </div>
    </div>
</main>