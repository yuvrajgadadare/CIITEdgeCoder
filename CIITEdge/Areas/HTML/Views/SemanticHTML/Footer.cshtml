@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Footer Element";
}

<style>
    .content-section {
        line-height: 1.8;
    }

    .content-section h2 {
        color: #212529 !important;
        font-weight: 700;
        margin-top: 24px;
        margin-bottom: 14px;
    }

    .content-section h3 {
        color: #374151;
        font-weight: 600;
        margin-top: 20px;
        margin-bottom: 12px;
    }

    .content-section p {
        color: #4b5563;
    }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

    pre code {
        background: transparent !important;
        color: #fff !important;
    }

    .info-box {
        background: #f3f4ff;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 6px;
        margin: 18px 0;
    }

    .demo-box {
        border: 1px solid #dee2e6;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .footer-demo {
        background: #f8f9fa;
        border-top: 2px solid #dee2e6;
        padding: 20px;
        text-align: center;
        border-radius: 6px;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<main id="main-content" class="container py-5">
    <div class="row g-4">

        <!-- Left Sidebar -->
        <div class="col-lg-3">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 content-section">

            <h1 class="fw-bold mb-3">HTML Footer Element</h1>

            <p>
                The HTML <code>&lt;footer&gt;</code> element represents footer information
                for a webpage, section, or article.
            </p>

            <p>
                It commonly contains copyright information, contact details, related links,
                author information, or other supporting content.
            </p>

            <div class="info-box">
                <strong>Easy Way to Remember:</strong>
                The <code>&lt;footer&gt;</code> is the supporting information at the
                bottom of a page or a specific content area.
            </div>

            <h2>1. What is the footer Element?</h2>

            <p>
                The <code>&lt;footer&gt;</code> element is a semantic HTML element
                used for footer-related content.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;p&gt;
        &copy; 2026 My Website
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <footer class="footer-demo">
                    <p class="mb-0">
                        &copy; 2026 My Website
                    </p>
                </footer>
            </div>

            <h2>2. What is Usually Placed in a Footer?</h2>

            <p>
                A footer can contain different types of supporting information.
            </p>

            <ul>
                <li>Copyright information</li>
                <li>Contact information</li>
                <li>Author information</li>
                <li>Privacy and Terms links</li>
                <li>Related links</li>
                <li>Company information</li>
                <li>Social media links</li>
            </ul>

            <h2>3. Basic Footer Example</h2>

            <pre><code>&lt;footer&gt;

    &lt;p&gt;
        &copy; 2026 CIIT Training Institute
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>4. Footer with Contact Information</h2>

            <p>
                A footer can contain contact information for the website or organization.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;h3&gt;Contact Us&lt;/h3&gt;

    &lt;p&gt;
        Email: training@example.com
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>5. Footer with Navigation Links</h2>

            <p>
                Important supporting links can also be placed in the footer.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;nav&gt;

        &lt;a href="/about"&gt;About&lt;/a&gt;
        &lt;a href="/contact"&gt;Contact&lt;/a&gt;
        &lt;a href="/privacy"&gt;Privacy Policy&lt;/a&gt;

    &lt;/nav&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="info-box">
                <strong>Note:</strong>
                A footer can contain a <code>&lt;nav&gt;</code> when the links form
                a meaningful navigation area.
            </div>

            <h2>6. Footer for a Complete Web Page</h2>

            <p>
                A common page structure places the footer after the main content.
            </p>

            <pre><code>&lt;header&gt;

    &lt;h1&gt;
        Learning Portal
    &lt;/h1&gt;

&lt;/header&gt;

&lt;nav&gt;

    &lt;a href="#"&gt;Home&lt;/a&gt;
    &lt;a href="#"&gt;Courses&lt;/a&gt;

&lt;/nav&gt;

&lt;main&gt;

    &lt;h2&gt;
        HTML Course
    &lt;/h2&gt;

    &lt;p&gt;
        Learn HTML step by step.
    &lt;/p&gt;

&lt;/main&gt;

&lt;footer&gt;

    &lt;p&gt;
        &copy; 2026 Learning Portal
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>7. Footer Inside an Article</h2>

            <p>
                A footer does not have to belong only to the entire webpage.
                It can also belong to a specific article.
            </p>

            <pre><code>&lt;article&gt;

    &lt;h2&gt;
        Introduction to HTML
    &lt;/h2&gt;

    &lt;p&gt;
        HTML is used to structure web pages.
    &lt;/p&gt;

    &lt;footer&gt;

        &lt;p&gt;
            Author: Web Development Team
        &lt;/p&gt;

    &lt;/footer&gt;

&lt;/article&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>8. Footer Inside a Section</h2>

            <p>
                A section can also have its own footer for information related
                specifically to that section.
            </p>

            <pre><code>&lt;section&gt;

    &lt;h2&gt;
        HTML Course
    &lt;/h2&gt;

    &lt;p&gt;
        Learn HTML fundamentals.
    &lt;/p&gt;

    &lt;footer&gt;

        &lt;p&gt;
            Updated October 2026
        &lt;/p&gt;

    &lt;/footer&gt;

&lt;/section&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>9. Footer vs Bottom of the Page</h2>

            <p>
                A footer often appears at the bottom of a webpage, but the
                <code>&lt;footer&gt;</code> element is not simply a styling container.
            </p>

            <p>
                It identifies content that is related to the footer of the
                page or a specific section.
            </p>

            <h2>10. Footer vs div</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;footer&gt;</code></td>
                            <td>Semantic element for footer-related content.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;div&gt;</code></td>
                            <td>Generic container without specific semantic meaning.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>11. Footer vs Header</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;header&gt;</code></td>
                            <td>Introduces a page or section.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;footer&gt;</code></td>
                            <td>Provides supporting or closing information.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>12. Footer with Copyright</h2>

            <p>
                Copyright information is one of the most common footer contents.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;p&gt;
        &copy; 2026 Learning Portal. All rights reserved.
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>13. Footer with Multiple Links</h2>

            <pre><code>&lt;footer&gt;

    &lt;nav&gt;

        &lt;a href="/about"&gt;
            About
        &lt;/a&gt;

        &lt;a href="/contact"&gt;
            Contact
        &lt;/a&gt;

        &lt;a href="/privacy"&gt;
            Privacy
        &lt;/a&gt;

        &lt;a href="/terms"&gt;
            Terms
        &lt;/a&gt;

    &lt;/nav&gt;

    &lt;p&gt;
        &copy; 2026 Learning Portal
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>14. Footer with Address</h2>

            <p>
                Contact information can be represented using the
                <code>&lt;address&gt;</code> element when appropriate.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;address&gt;

        Email:
        training@example.com

    &lt;/address&gt;

&lt;/footer&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>15. Footer with Social Links</h2>

            <p>
                A footer may also contain links to social media or other external resources.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;p&gt;
        Follow us:
    &lt;/p&gt;

    &lt;a href="#"&gt;
        LinkedIn
    &lt;/a&gt;

    &lt;a href="#"&gt;
        Instagram
    &lt;/a&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>16. Footer for a Course Website</h2>

            <pre><code>&lt;footer&gt;

    &lt;h3&gt;
        CIIT Training Institute
    &lt;/h3&gt;

    &lt;p&gt;
        Technology Training and Learning
    &lt;/p&gt;

    &lt;nav&gt;

        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;
        &lt;a href="#"&gt;Privacy Policy&lt;/a&gt;

    &lt;/nav&gt;

    &lt;p&gt;
        &copy; 2026 CIIT Training Institute
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>17. Multiple Footer Elements</h2>

            <p>
                A page can have a footer for the webpage and separate footer
                elements inside articles or sections.
            </p>

            <pre><code>&lt;main&gt;

    &lt;article&gt;

        &lt;h2&gt;
            HTML Basics
        &lt;/h2&gt;

        &lt;p&gt;
            Learn HTML fundamentals.
        &lt;/p&gt;

        &lt;footer&gt;
            Updated October 2026
        &lt;/footer&gt;

    &lt;/article&gt;

&lt;/main&gt;

&lt;footer&gt;

    &lt;p&gt;
        &copy; 2026 Learning Portal
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="info-box">
                <strong>Important:</strong>
                A footer can describe the containing page, section, or article.
                Its meaning depends on where it is placed.
            </div>

            <h2>18. Footer and Accessibility</h2>

            <p>
                Semantic footer elements help describe the document structure.
                Users and assistive technologies can better understand that
                the content belongs to the footer area of a page or section.
            </p>

            <h2>19. Complete Semantic Page Example</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;

&lt;head&gt;

    &lt;meta charset="UTF-8"&gt;

    &lt;title&gt;
        Learning Portal
    &lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;header&gt;

        &lt;h1&gt;
            Learning Portal
        &lt;/h1&gt;

    &lt;/header&gt;

    &lt;nav&gt;

        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;

    &lt;/nav&gt;

    &lt;main&gt;

        &lt;section&gt;

            &lt;h2&gt;
                HTML Course
            &lt;/h2&gt;

            &lt;p&gt;
                Learn HTML from basic to advanced concepts.
            &lt;/p&gt;

        &lt;/section&gt;

    &lt;/main&gt;

    &lt;footer&gt;

        &lt;nav&gt;

            &lt;a href="#"&gt;About&lt;/a&gt;
            &lt;a href="#"&gt;Privacy&lt;/a&gt;
            &lt;a href="#"&gt;Contact&lt;/a&gt;

        &lt;/nav&gt;

        &lt;p&gt;
            &copy; 2026 Learning Portal
        &lt;/p&gt;

    &lt;/footer&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>20. Common Mistakes</h2>

            <h3>Mistake 1: Using footer only for visual styling</h3>

            <p>
                The <code>&lt;footer&gt;</code> element should be used when the
                content represents footer-related information.
            </p>

            <h3>Mistake 2: Putting the main content inside footer</h3>

            <p>
                The main topic of the page belongs in <code>&lt;main&gt;</code>,
                <code>&lt;section&gt;</code>, or another suitable element.
            </p>

            <h3>Mistake 3: Assuming footer must always be the last element</h3>

            <p>
                A footer can belong to an article or section, so its position
                depends on the content structure.
            </p>

            <h2>21. Best Practices</h2>

            <ul>
                <li>Use <code>&lt;footer&gt;</code> for supporting or closing information.</li>
                <li>Use it for copyright, contact, author, and related links.</li>
                <li>Keep footer information relevant to its containing content.</li>
                <li>Use <code>&lt;nav&gt;</code> inside the footer when it contains meaningful navigation links.</li>
                <li>Use <code>&lt;footer&gt;</code> inside an article or section when the information belongs specifically to that content.</li>
            </ul>

            <h2>22. Practice Example</h2>

            <p>
                Create a footer for a training website containing the company name,
                navigation links, contact information, and copyright text.
            </p>

            <pre><code>&lt;footer&gt;

    &lt;h2&gt;
        CIIT Training Institute
    &lt;/h2&gt;

    &lt;p&gt;
        Technology Training and Learning
    &lt;/p&gt;

    &lt;nav&gt;

        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;About&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;

    &lt;/nav&gt;

    &lt;p&gt;
        &copy; 2026 CIIT Training Institute
    &lt;/p&gt;

&lt;/footer&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">
                    The HTML <code>&lt;footer&gt;</code> element represents supporting
                    information for a webpage, section, or article. It is commonly used
                    for copyright information, contact details, author information,
                    related links, and supporting navigation. The footer is semantic,
                    so its purpose comes from the content it contains rather than
                    simply its visual position.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Aside", "SemanticHTML", new { area = "HTML" })">
                    ← Previous: Aside
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("HTMLPageLayout", "SemanticHTML", new { area = "HTML" })">
                    Next: HTML Page Layout →
                </a>
            </div>

        </div>
    </div>
</main>