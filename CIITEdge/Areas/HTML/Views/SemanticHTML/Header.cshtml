@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Header Element";
}

<style>
    .content-section {
        line-height: 1.8;
    }

    .content-section h2 {
        color: #212529 !important;
        font-weight: 700;
        margin-top: 24px;
        margin-bottom: 14px;
    }

    .content-section h3 {
        color: #374151;
        font-weight: 600;
        margin-top: 22px;
        margin-bottom: 12px;
    }

    .content-section p {
        color: #4b5563;
    }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

    pre code {
        background: transparent !important;
        color: #fff !important;
    }

    .info-box {
        background: #f3f4ff;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 6px;
        margin: 18px 0;
    }

    .demo-box {
        border: 1px solid #dee2e6;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .demo-header {
        border: 1px solid #dee2e6;
        padding: 20px;
        border-radius: 8px;
        background: #f8f9fa;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<main id="main-content" class="container py-5">
    <div class="row g-4">

        <!-- Left Sidebar -->
        <div class="col-lg-3">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 content-section">

            <h1 class="fw-bold mb-3">HTML Header Element</h1>

            <p>
                The HTML <code>&lt;header&gt;</code> element represents introductory
                content for a page or a specific section. It commonly contains headings,
                logos, navigation-related content, introductory text, or other
                information related to the beginning of a content area.
            </p>

            <div class="info-box">
                <strong>Key Point:</strong>
                The <code>&lt;header&gt;</code> element is a semantic element.
                It describes the role of the content instead of simply acting as a
                generic container.
            </div>

            <h2>1. What is the header Element?</h2>

            <p>
                The <code>&lt;header&gt;</code> element defines introductory content
                for a document, page, section, or article.
            </p>

            <pre><code>&lt;header&gt;
    &lt;h1&gt;My Website&lt;/h1&gt;
    &lt;p&gt;Welcome to my website&lt;/p&gt;
&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <header class="demo-header">
                    <h3 class="mt-0">My Website</h3>
                    <p class="mb-0">Welcome to my website</p>
                </header>
            </div>

            <h2>2. Purpose of the header Element</h2>

            <p>
                The main purpose of <code>&lt;header&gt;</code> is to identify
                introductory or navigational content associated with a page or section.
            </p>

            <p>
                A header may contain:
            </p>

            <ul>
                <li>A heading</li>
                <li>Logo or branding</li>
                <li>Introductory text</li>
                <li>Navigation links</li>
                <li>Search controls</li>
                <li>Other introductory content</li>
            </ul>

            <h2>3. Basic Header Example</h2>

            <pre><code>&lt;header&gt;

    &lt;h1&gt;CIIT Training Institute&lt;/h1&gt;

    &lt;p&gt;
        Technology Training and Learning
    &lt;/p&gt;

&lt;/header&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <header class="demo-header">
                    <h3 class="mt-0">CIIT Training Institute</h3>

                    <p class="mb-0">
                        Technology Training and Learning
                    </p>
                </header>
            </div>

            <h2>4. Header with Navigation</h2>

            <p>
                A page header can contain a navigation area.
                In that case, the navigation itself should normally be represented
                using the <code>&lt;nav&gt;</code> element.
            </p>

            <pre><code>&lt;header&gt;

    &lt;h1&gt;Learning Portal&lt;/h1&gt;

    &lt;nav&gt;
        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;
    &lt;/nav&gt;

&lt;/header&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>5. Header with Logo</h2>

            <p>
                A header can contain a logo or branding information.
            </p>

            <pre><code>&lt;header&gt;

    &lt;img src="logo.png"
         alt="Company Logo"&gt;

    &lt;h1&gt;My Company&lt;/h1&gt;

&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="info-box">
                Use meaningful alternative text with images so that the purpose
                of the image can be understood when necessary.
            </div>

            <h2>6. Header for a Web Page</h2>

            <p>
                A complete page can have a top-level header introducing the website.
            </p>

            <pre><code>&lt;body&gt;

    &lt;header&gt;

        &lt;h1&gt;My Learning Website&lt;/h1&gt;

        &lt;p&gt;
            Learn web development step by step.
        &lt;/p&gt;

    &lt;/header&gt;

    &lt;main&gt;
        Main Content
    &lt;/main&gt;

&lt;/body&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>7. Header inside an Article</h2>

            <p>
                A <code>&lt;header&gt;</code> can also be used inside an
                <code>&lt;article&gt;</code> to introduce that article.
            </p>

            <pre><code>&lt;article&gt;

    &lt;header&gt;

        &lt;h2&gt;Introduction to HTML&lt;/h2&gt;

        &lt;p&gt;
            Published on October 1, 2026
        &lt;/p&gt;

    &lt;/header&gt;

    &lt;p&gt;
        HTML is used to structure web pages.
    &lt;/p&gt;

&lt;/article&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h3>Output</h3>

            <div class="demo-box">
                <article>
                    <header class="demo-header">
                        <h3 class="mt-0">Introduction to HTML</h3>
                        <p class="mb-0">
                            Published on October 1, 2026
                        </p>
                    </header>

                    <p class="mt-3 mb-0">
                        HTML is used to structure web pages.
                    </p>
                </article>
            </div>

            <h2>8. Header inside a Section</h2>

            <p>
                A section can have its own header when the section needs introductory
                or heading-related content.
            </p>

            <pre><code>&lt;section&gt;

    &lt;header&gt;

        &lt;h2&gt;HTML Forms&lt;/h2&gt;

        &lt;p&gt;
            Learn how to create HTML forms.
        &lt;/p&gt;

    &lt;/header&gt;

    &lt;form&gt;
        ...
    &lt;/form&gt;

&lt;/section&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>9. Header with Multiple Elements</h2>

            <p>
                A header may contain several related elements.
            </p>

            <pre><code>&lt;header&gt;

    &lt;img src="logo.png"
         alt="Learning Portal Logo"&gt;

    &lt;h1&gt;Learning Portal&lt;/h1&gt;

    &lt;p&gt;
        Learn HTML, CSS and JavaScript.
    &lt;/p&gt;

    &lt;nav&gt;
        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;
    &lt;/nav&gt;

&lt;/header&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>10. Header vs Heading</h2>

            <p>
                The <code>&lt;header&gt;</code> element and heading elements such as
                <code>&lt;h1&gt;</code> and <code>&lt;h2&gt;</code> are different.
            </p>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Element</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>&lt;header&gt;</code></td>
                            <td>Groups introductory content for a page or section.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;h1&gt;</code></td>
                            <td>Represents a heading.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;h2&gt;</code></td>
                            <td>Represents a lower-level heading.</td>
                        </tr>
                        <tr>
                            <td><code>&lt;h3&gt;</code></td>
                            <td>Represents another heading level.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>11. Header vs div</h2>

            <p>
                A <code>&lt;div&gt;</code> is a generic container, while
                <code>&lt;header&gt;</code> communicates that the content is
                introductory or header-related.
            </p>

            <pre><code>&lt;!-- Generic container --&gt;

&lt;div&gt;
    Website Header
&lt;/div&gt;


&lt;!-- Semantic container --&gt;

&lt;header&gt;
    Website Header
&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="info-box">
                Semantic elements should be selected based on the meaning and role
                of the content, not simply because of how the content looks.
            </div>

            <h2>12. Complete Website Header Example</h2>

            <pre><code>&lt;header&gt;

    &lt;div&gt;

        &lt;h1&gt;CIIT Training Institute&lt;/h1&gt;

        &lt;p&gt;
            Learn industry-ready technical skills.
        &lt;/p&gt;

    &lt;/div&gt;

    &lt;nav&gt;

        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;About&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;

    &lt;/nav&gt;

&lt;/header&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>13. Header for a Blog Article</h2>

            <pre><code>&lt;article&gt;

    &lt;header&gt;

        &lt;h1&gt;
            Learn HTML From Scratch
        &lt;/h1&gt;

        &lt;p&gt;
            Author: Training Team
        &lt;/p&gt;

        &lt;p&gt;
            Published:
            &lt;time datetime="2026-10-01"&gt;
                October 1, 2026
            &lt;/time&gt;
        &lt;/p&gt;

    &lt;/header&gt;

    &lt;p&gt;
        HTML provides the structure of a web page.
    &lt;/p&gt;

&lt;/article&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>14. Header for a Course Section</h2>

            <pre><code>&lt;section&gt;

    &lt;header&gt;

        &lt;h2&gt;.NET Full Stack Development&lt;/h2&gt;

        &lt;p&gt;
            Learn C#, .NET, SQL, Web API and frontend technologies.
        &lt;/p&gt;

    &lt;/header&gt;

    &lt;p&gt;
        Course content starts here.
    &lt;/p&gt;

&lt;/section&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>15. Can a Header Contain a Header?</h2>

            <p>
                The page structure should remain meaningful and should avoid unnecessary
                nesting of the same structural elements.
            </p>

            <p>
                Instead of unnecessarily placing one header directly inside another,
                use headers where they represent distinct page or section introductions.
            </p>

            <h2>16. Header and Accessibility</h2>

            <p>
                Semantic page structure helps assistive technologies understand the role
                of different content areas.
            </p>

            <p>
                A header can provide a clear introductory region for a page or section,
                especially when used together with appropriate headings and navigation.
            </p>

            <h2>17. Multiple Header Elements</h2>

            <p>
                A document can have more than one <code>&lt;header&gt;</code> when
                different sections or articles have their own introductory content.
            </p>

            <pre><code>&lt;header&gt;
    &lt;h1&gt;Learning Portal&lt;/h1&gt;
&lt;/header&gt;

&lt;main&gt;

    &lt;article&gt;

        &lt;header&gt;
            &lt;h2&gt;HTML Basics&lt;/h2&gt;
        &lt;/header&gt;

        &lt;p&gt;
            Learn the basics of HTML.
        &lt;/p&gt;

    &lt;/article&gt;

    &lt;article&gt;

        &lt;header&gt;
            &lt;h2&gt;HTML Forms&lt;/h2&gt;
        &lt;/header&gt;

        &lt;p&gt;
            Learn how to create forms.
        &lt;/p&gt;

    &lt;/article&gt;

&lt;/main&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2>18. Common Mistakes</h2>

            <h3>Mistake 1: Using header only for visual styling</h3>

            <p>
                The <code>&lt;header&gt;</code> element should be chosen because
                the content is introductory or header-related, not only because
                the area appears at the top of a page.
            </p>

            <h3>Mistake 2: Confusing header with h1</h3>

            <p>
                A header is a structural container, while an
                <code>&lt;h1&gt;</code> is a heading.
            </p>

            <h3>Mistake 3: Using div when a semantic element clearly fits</h3>

            <p>
                When content represents a page or section header,
                <code>&lt;header&gt;</code> can communicate the purpose more clearly.
            </p>

            <h2>19. Best Practices</h2>

            <ul>
                <li>Use <code>&lt;header&gt;</code> for introductory content.</li>
                <li>Use headings inside the header when appropriate.</li>
                <li>Use <code>&lt;nav&gt;</code> for navigation links.</li>
                <li>Use different headers for independent articles or sections when needed.</li>
                <li>Keep the header content relevant to the page or section.</li>
                <li>Do not use <code>&lt;header&gt;</code> only for styling purposes.</li>
            </ul>

            <h2>20. Practice Example</h2>

            <p>
                Create a website header containing a logo, website title,
                description, and navigation links.
            </p>

            <pre><code>&lt;header&gt;

    &lt;img src="logo.png"
         alt="Learning Portal Logo"&gt;

    &lt;h1&gt;Learning Portal&lt;/h1&gt;

    &lt;p&gt;
        Learn web development step by step.
    &lt;/p&gt;

    &lt;nav&gt;

        &lt;a href="#"&gt;Home&lt;/a&gt;
        &lt;a href="#"&gt;Courses&lt;/a&gt;
        &lt;a href="#"&gt;Tutorials&lt;/a&gt;
        &lt;a href="#"&gt;Contact&lt;/a&gt;

    &lt;/nav&gt;

&lt;/header&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">
                    The HTML <code>&lt;header&gt;</code> element represents introductory
                    content for a page or section. It can contain headings, logos,
                    introductory text, and navigation. A header is a semantic structural
                    element and is different from heading elements such as
                    <code>&lt;h1&gt;</code>, <code>&lt;h2&gt;</code>, and
                    <code>&lt;h3&gt;</code>.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("SemanticElements", "SemanticHTML", new { area = "HTML" })">
                    ← Previous: Semantic Elements
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Nav", "SemanticHTML", new { area = "HTML" })">
                    Next: Nav →
                </a>
            </div>

        </div>
    </div>
</main>