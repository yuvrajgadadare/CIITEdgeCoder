@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Main Element";
}

<style>
    .content-section {
        line-height: 1.8;
    }

    .content-section h2 {
        color: #212529 !important;
        font-weight: 700;
        margin-top: 24px;
        margin-bottom: 14px;
    }

    .content-section h3 {
        color: #374151;
        font-weight: 600;
        margin-top: 22px;
        margin-bottom: 12px;
    }

    .content-section p {
        color: #4b5563;
    }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
