@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Tags";
}

<style>

    #html-tags-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-tags-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-tags-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-tags-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-tags-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-tags-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-tags-page .table-responsive {
        margin-top: 15px;
    }

    #html-tags-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-tags-page .table td {
        vertical-align: middle;
    }

    #html-tags-page code {
        color: #6f42c1;
    }

</style>


<main id="html-tags-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Tags
                </h1>

                <p class="lead">
                    Learn the most commonly used HTML tags, their syntax,
                    purpose, examples, and expected results.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What are HTML Tags?
                </h2>

                <p>
                    HTML tags are special keywords enclosed inside angle brackets
                    that are used to define HTML elements.
                </p>

                <p>
                    Tags tell the browser what type of content an element
                    represents, such as a heading, paragraph, link, image,
                    list, table, or form.
                </p>

                <div class="alert alert-info">

                    <strong>Basic Example:</strong>

                    <pre class="mb-0 mt-3"><code>&lt;p&gt;Hello World&lt;/p&gt;</code></pre>

                </div>

            </div>


            <!-- TAG STRUCTURE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Basic Tag Structure
                </h2>

                <pre><code>&lt;tagname&gt;Content&lt;/tagname&gt;</code></pre>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Part</th>
                                <th>Example</th>
                                <th>Purpose</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Opening Tag
                                </td>

                                <td>
                                    <code>&lt;p&gt;</code>
                                </td>

                                <td>
                                    Starts the HTML element.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Content
                                </td>

                                <td>
                                    <code>Hello World</code>
                                </td>

                                <td>
                                    The actual content of the element.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Closing Tag
                                </td>

                                <td>
                                    <code>&lt;/p&gt;</code>
                                </td>

                                <td>
                                    Ends the HTML element.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- TAG TYPES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Types of HTML Tags
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Paired Tags
                            </h5>

                            <p>
                                These normally have an opening tag and
                                a closing tag.
                            </p>

                            <pre class="mb-0"><code>&lt;p&gt;
    Hello
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Void Elements
                            </h5>

                            <p>
                                These do not contain content and do not require
                                a separate closing tag.
                            </p>

                            <pre class="mb-0"><code>&lt;br&gt;
&lt;hr&gt;
&lt;img&gt;</code></pre>

                        </div>

                    </div>

                </div>

            </div>


            <!-- DOCUMENT TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Document Structure Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;!DOCTYPE html&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;!DOCTYPE html&gt;</code>
                                </td>

                                <td>
                                    Declares the document as HTML.
                                </td>

                                <td>
                                    Helps the browser use standards mode.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;html&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;html&gt;...&lt;/html&gt;</code>
                                </td>

                                <td>
                                    Root element of the document.
                                </td>

                                <td>
                                    Contains the complete HTML document.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;head&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;head&gt;...&lt;/head&gt;</code>
                                </td>

                                <td>
                                    Contains metadata and resource information.
                                </td>

                                <td>
                                    Usually not visible as normal page content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;title&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;title&gt;My Page&lt;/title&gt;</code>
                                </td>

                                <td>
                                    Defines the document title.
                                </td>

                                <td>
                                    Appears in the browser tab.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;body&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;body&gt;...&lt;/body&gt;</code>
                                </td>

                                <td>
                                    Contains the visible page content.
                                </td>

                                <td>
                                    Displays the main web page content.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- TEXT TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Text and Heading Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;h1&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h1&gt;Main Heading&lt;/h1&gt;</code>
                                </td>

                                <td>
                                    Creates the highest-level heading.
                                </td>

                                <td>
                                    Large main heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h2&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h2&gt;Section&lt;/h2&gt;</code>
                                </td>

                                <td>
                                    Creates a second-level heading.
                                </td>

                                <td>
                                    Section heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h3&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h3&gt;Subsection&lt;/h3&gt;</code>
                                </td>

                                <td>
                                    Creates a third-level heading.
                                </td>

                                <td>
                                    Subsection heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h4&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h4&gt;Topic&lt;/h4&gt;</code>
                                </td>

                                <td>
                                    Creates a fourth-level heading.
                                </td>

                                <td>
                                    Lower-level heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h5&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h5&gt;Subtopic&lt;/h5&gt;</code>
                                </td>

                                <td>
                                    Creates a fifth-level heading.
                                </td>

                                <td>
                                    Smaller heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h6&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h6&gt;Note&lt;/h6&gt;</code>
                                </td>

                                <td>
                                    Creates the lowest heading level.
                                </td>

                                <td>
                                    Smallest heading level.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;p&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;p&gt;Hello&lt;/p&gt;</code>
                                </td>

                                <td>
                                    Creates a paragraph.
                                </td>

                                <td>
                                    Displays paragraph text.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;br&gt;</code>
                                </td>

                                <td>
                                    <code>Hello&lt;br&gt;World</code>
                                </td>

                                <td>
                                    Inserts a line break.
                                </td>

                                <td>
                                    Text moves to a new line.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;hr&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;hr&gt;</code>
                                </td>

                                <td>
                                    Creates a thematic break.
                                </td>

                                <td>
                                    Browser commonly displays a horizontal line.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- FORMATTING TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Text Formatting Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;strong&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;strong&gt;Important&lt;/strong&gt;</code>
                                </td>

                                <td>
                                    Gives strong importance to content.
                                </td>

                                <td>
                                    <strong>Important</strong>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;em&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;em&gt;Important&lt;/em&gt;</code>
                                </td>

                                <td>
                                    Gives emphasis to content.
                                </td>

                                <td>
                                    <em>Important</em>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;b&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;b&gt;Bold Text&lt;/b&gt;</code>
                                </td>

                                <td>
                                    Presents text in bold.
                                </td>

                                <td>
                                    <strong>Bold Text</strong>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;i&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;i&gt;Italic Text&lt;/i&gt;</code>
                                </td>

                                <td>
                                    Presents text in an italic style.
                                </td>

                                <td>
                                    <em>Italic Text</em>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;mark&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;mark&gt;Highlighted&lt;/mark&gt;</code>
                                </td>

                                <td>
                                    Highlights text.
                                </td>

                                <td>
                                    <mark>Highlighted</mark>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;small&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;small&gt;Small Text&lt;/small&gt;</code>
                                </td>

                                <td>
                                    Represents side comments or small print.
                                </td>

                                <td>
                                    <small>Small Text</small>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- LINK AND IMAGE TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Links and Image Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;a&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;a href="#"&gt;Learn More&lt;/a&gt;</code>
                                </td>

                                <td>
                                    Creates a hyperlink.
                                </td>

                                <td>
                                    <a href="#">Learn More</a>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;img&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;img src="image.jpg" alt="Image"&gt;</code>
                                </td>

                                <td>
                                    Displays an image.
                                </td>

                                <td>
                                    Displays the specified image resource.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;figure&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;figure&gt;...&lt;/figure&gt;</code>
                                </td>

                                <td>
                                    Represents self-contained content.
                                </td>

                                <td>
                                    Groups image or media content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;figcaption&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;figcaption&gt;Caption&lt;/figcaption&gt;</code>
                                </td>

                                <td>
                                    Defines a caption for a figure.
                                </td>

                                <td>
                                    Displays the figure caption.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- LIST TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    List Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;ul&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;ul&gt;...&lt;/ul&gt;</code>
                                </td>

                                <td>
                                    Creates an unordered list.
                                </td>

                                <td>
                                    Usually displays bullet points.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;ol&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;ol&gt;...&lt;/ol&gt;</code>
                                </td>

                                <td>
                                    Creates an ordered list.
                                </td>

                                <td>
                                    Usually displays numbered items.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;li&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;li&gt;Item&lt;/li&gt;</code>
                                </td>

                                <td>
                                    Defines a list item.
                                </td>

                                <td>
                                    Displays one item inside a list.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;dl&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;dl&gt;...&lt;/dl&gt;</code>
                                </td>

                                <td>
                                    Creates a description list.
                                </td>

                                <td>
                                    Groups terms and their descriptions.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;dt&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;dt&gt;HTML&lt;/dt&gt;</code>
                                </td>

                                <td>
                                    Defines a term in a description list.
                                </td>

                                <td>
                                    Displays the term.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;dd&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;dd&gt;Markup Language&lt;/dd&gt;</code>
                                </td>

                                <td>
                                    Defines the description of a term.
                                </td>

                                <td>
                                    Displays the term description.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- TABLE TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Table Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;table&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;table&gt;...&lt;/table&gt;</code>
                                </td>

                                <td>
                                    Creates a table.
                                </td>

                                <td>
                                    Displays table structure.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;tr&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;tr&gt;...&lt;/tr&gt;</code>
                                </td>

                                <td>
                                    Defines a table row.
                                </td>

                                <td>
                                    Creates one table row.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;th&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;th&gt;Name&lt;/th&gt;</code>
                                </td>

                                <td>
                                    Defines a table header cell.
                                </td>

                                <td>
                                    Displays header content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;td&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;td&gt;John&lt;/td&gt;</code>
                                </td>

                                <td>
                                    Defines a table data cell.
                                </td>

                                <td>
                                    Displays data inside the table.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;thead&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;thead&gt;...&lt;/thead&gt;</code>
                                </td>

                                <td>
                                    Groups table header rows.
                                </td>

                                <td>
                                    Represents the header section.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;tbody&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;tbody&gt;...&lt;/tbody&gt;</code>
                                </td>

                                <td>
                                    Groups table body rows.
                                </td>

                                <td>
                                    Represents the main data section.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- FORM TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Form Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;form&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;form&gt;...&lt;/form&gt;</code>
                                </td>

                                <td>
                                    Creates a form.
                                </td>

                                <td>
                                    Groups form controls.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;label&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;label&gt;Name&lt;/label&gt;</code>
                                </td>

                                <td>
                                    Defines a label for a form control.
                                </td>

                                <td>
                                    Displays descriptive label text.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;input&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;input type="text"&gt;</code>
                                </td>

                                <td>
                                    Creates an input control.
                                </td>

                                <td>
                                    Displays an input field.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;textarea&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;textarea&gt;...&lt;/textarea&gt;</code>
                                </td>

                                <td>
                                    Creates a multi-line text input.
                                </td>

                                <td>
                                    Displays a text area.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;select&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;select&gt;...&lt;/select&gt;</code>
                                </td>

                                <td>
                                    Creates a selection control.
                                </td>

                                <td>
                                    Displays a drop-down list.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;option&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;option&gt;Java&lt;/option&gt;</code>
                                </td>

                                <td>
                                    Defines an option inside a select.
                                </td>

                                <td>
                                    Displays one selectable option.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;button&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;button&gt;Submit&lt;/button&gt;</code>
                                </td>

                                <td>
                                    Creates a button.
                                </td>

                                <td>
                                    Displays a clickable button.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- CONTAINER TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Container and Semantic Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;div&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;div&gt;Content&lt;/div&gt;</code>
                                </td>

                                <td>
                                    Generic block container.
                                </td>

                                <td>
                                    Groups block-level content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;span&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;span&gt;Text&lt;/span&gt;</code>
                                </td>

                                <td>
                                    Generic inline container.
                                </td>

                                <td>
                                    Groups inline content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;header&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;header&gt;...&lt;/header&gt;</code>
                                </td>

                                <td>
                                    Represents introductory content.
                                </td>

                                <td>
                                    Defines a header section.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;nav&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;nav&gt;...&lt;/nav&gt;</code>
                                </td>

                                <td>
                                    Represents navigation links.
                                </td>

                                <td>
                                    Defines a navigation area.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;main&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;main&gt;...&lt;/main&gt;</code>
                                </td>

                                <td>
                                    Represents the main page content.
                                </td>

                                <td>
                                    Defines the main content area.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;section&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;section&gt;...&lt;/section&gt;</code>
                                </td>

                                <td>
                                    Represents a thematic section.
                                </td>

                                <td>
                                    Groups related content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;article&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;article&gt;...&lt;/article&gt;</code>
                                </td>

                                <td>
                                    Represents self-contained content.
                                </td>

                                <td>
                                    Defines independent content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;aside&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;aside&gt;...&lt;/aside&gt;</code>
                                </td>

                                <td>
                                    Represents related side content.
                                </td>

                                <td>
                                    Defines supplementary content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;footer&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;footer&gt;...&lt;/footer&gt;</code>
                                </td>

                                <td>
                                    Represents footer content.
                                </td>

                                <td>
                                    Defines a footer section.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- MEDIA TAGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Media Tags
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Tag</th>
                                <th>Syntax</th>
                                <th>Explanation</th>
                                <th>Output / Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;audio&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;audio controls&gt;...&lt;/audio&gt;</code>
                                </td>

                                <td>
                                    Embeds audio content.
                                </td>

                                <td>
                                    Displays an audio player when a valid source is supplied.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;video&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;video controls&gt;...&lt;/video&gt;</code>
                                </td>

                                <td>
                                    Embeds video content.
                                </td>

                                <td>
                                    Displays a video player when a valid source is supplied.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;iframe&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;iframe src="..."&gt;&lt;/iframe&gt;</code>
                                </td>

                                <td>
                                    Embeds another resource or document.
                                </td>

                                <td>
                                    Displays the embedded resource when permitted.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


