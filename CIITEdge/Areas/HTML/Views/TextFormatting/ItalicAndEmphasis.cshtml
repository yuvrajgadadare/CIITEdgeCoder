@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "Italic and Emphasis";
}

<style>

    #html-italic-emphasis-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-italic-emphasis-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-italic-emphasis-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-italic-emphasis-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-italic-emphasis-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-italic-emphasis-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-italic-emphasis-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-italic-emphasis-page .table td {
        vertical-align: middle;
    }

</style>


<main id="html-italic-emphasis-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    Italic and Emphasis
                </h1>

                <p class="lead">
                    Learn the difference between the
                    <code>&lt;i&gt;</code> and <code>&lt;em&gt;</code>
                    elements and understand when to use each one.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Introduction
                </h2>

                <p>
                    HTML provides the <code>&lt;i&gt;</code> and
                    <code>&lt;em&gt;</code> elements for text that is
                    commonly displayed in an italic style.
                </p>

                <p>
                    Although both can appear visually similar, they communicate
                    different meanings.
                </p>

                <div class="alert alert-info">

                    <strong>Remember:</strong>

                    <code>&lt;i&gt;</code> is used for text in an alternate
                    voice or mood, while <code>&lt;em&gt;</code> indicates
                    emphasis.

                </div>

            </div>


            <!-- I ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;i&gt; Element
                </h2>

                <p>
                    The <code>&lt;i&gt;</code> element represents text in
                    an alternate voice or mood, such as a technical term,
                    foreign word, phrase, or other text that is conventionally
                    displayed in italic style.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;i&gt;Text&lt;/i&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    This is an &lt;i&gt;italic word&lt;/i&gt;.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">
                        This is an <i>italic word</i>.
                    </p>

                </div>

            </div>


            <!-- I USE CASES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Uses of &lt;i&gt;
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Technical Term
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    The term &lt;i&gt;frontend&lt;/i&gt;
    is commonly used in web development.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Foreign Word
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    The word &lt;i&gt;bonjour&lt;/i&gt;
    is French.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Phrase
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    The phrase &lt;i&gt;carpe diem&lt;/i&gt;
    is widely known.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Alternate Voice
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    The word &lt;i&gt;HTML&lt;/i&gt;
    appears in italic style.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>

                </div>

            </div>


            <!-- EM ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;em&gt; Element
                </h2>

                <p>
                    The <code>&lt;em&gt;</code> element indicates emphasis.
                    The exact meaning of the sentence can change when a
                    different word is emphasized.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;em&gt;Important Word&lt;/em&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    You &lt;em&gt;must&lt;/em&gt; practice HTML.
&lt;/p&gt;</code></pre>

                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        You <em>must</em> practice HTML.
                    </p>

                </div>

            </div>


            <!-- EMPHASIS CHANGES MEANING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    How Emphasis Can Change Meaning
                </h2>

                <p>
                    The position of emphasis in a sentence can affect which
                    word receives the strongest focus.
                </p>

                <div class="concept-box">

                    <p>
                        You <em>must</em> practice HTML.
                    </p>

                    <p>
                        <em>You</em> must practice HTML.
                    </p>

                    <p class="mb-0">
                        You must practice <em>HTML</em>.
                    </p>

                </div>

                <div class="alert alert-secondary mt-3">
                    The emphasized word receives additional stress or focus
                    within the sentence.
                </div>

            </div>


            <!-- I VS EM -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    &lt;i&gt; vs &lt;em&gt;
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Feature</th>
                                <th>&lt;i&gt;</th>
                                <th>&lt;em&gt;</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Main Purpose
                                </td>

                                <td>
                                    Represents an alternate voice or mood.
                                </td>

                                <td>
                                    Adds emphasis to content.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Semantic Meaning
                                </td>

                                <td>
                                    Represents a special type or alternate voice.
                                </td>

                                <td>
                                    Indicates emphasis.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Common Browser Appearance
                                </td>

                                <td>
                                    Italic text.
                                </td>

                                <td>
                                    Italic text.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Typical Usage
                                </td>

                                <td>
                                    Terms, phrases, foreign words, alternate voice.
                                </td>

                                <td>
                                    Words that need emphasis in a sentence.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- VISUAL COMPARISON -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Visual Comparison
                </h2>

                <div class="concept-box">

                    <p>
                        Using <code>&lt;i&gt;</code>:
                        <i>This is italic text.</i>
                    </p>

                    <p class="mb-0">
                        Using <code>&lt;em&gt;</code>:
                        <em>This text is emphasized.</em>
                    </p>

                </div>

                <div class="alert alert-warning mt-3">

                    Both may look similar visually, but the semantic
                    meaning of the elements is different.

                </div>

            </div>


            <!-- I WITH OTHER ELEMENTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Combining &lt;i&gt; with Other Elements
                </h2>

                <pre><code>&lt;p&gt;
    Learn
    &lt;strong&gt;
        &lt;i&gt;HTML&lt;/i&gt;
    &lt;/strong&gt;
    step-by-step.
&lt;/p&gt;</code></pre>



<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        Learn
                        <strong>
                            <i>HTML</i>
                        </strong>
                        step-by-step.

                    </p>

                </div>

            </div>


            <!-- EM WITH OTHER ELEMENTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Combining &lt;em&gt; with Other Elements
                </h2>

                <pre><code>&lt;p&gt;
    You
    &lt;strong&gt;
        &lt;em&gt;must&lt;/em&gt;
    &lt;/strong&gt;
    practice regularly.
&lt;/p&gt;</code></pre>



<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        You
                        <strong>
                            <em>must</em>
                        </strong>
                        practice regularly.

                    </p>

                </div>

            </div>


            <!-- CSS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using CSS for Visual Italic Style
                </h2>

                <p>
                    CSS can make text visually italic without changing
                    its HTML semantics.
                </p>

                <pre><code>&lt;p class="italic-text"&gt;
    HTML Course
&lt;/p&gt;

&lt;style&gt;

    .italic-text {
        font-style: italic;
    }

&lt;/style&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0"
                       style="font-style: italic;">

                        HTML Course

                    </p>

                </div>

                <p class="mt-3">
                    Use CSS when italic appearance is purely a visual
                    design requirement.
                </p>

            </div>


            <!-- ACCESSIBILITY -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Accessibility and Semantics
                </h2>

                <p>
                    Semantic HTML helps browsers and assistive technologies
                    understand why certain text has special meaning.
                </p>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                &lt;i&gt;
                            </h5>

                            <p class="mb-0">
                                Use for text that represents an alternate
                                voice, mood, term, phrase, or similar distinction.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                &lt;em&gt;
                            </h5>

                            <p class="mb-0">
                                Use when the text should receive emphasis
                                within the sentence.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- REAL WORLD EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Real-World Example
                </h2>

                <pre><code>&lt;h2&gt;
    HTML Course
&lt;/h2&gt;

&lt;p&gt;
    The term &lt;i&gt;frontend&lt;/i&gt;
    is commonly used in web development.
&lt;/p&gt;

&lt;p&gt;
    You &lt;em&gt;must&lt;/em&gt;
    practice HTML regularly.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <h3>
                        HTML Course
                    </h3>

                    <p>
                        The term <i>frontend</i>
                        is commonly used in web development.
                    </p>

                    <p class="mb-0">
                        You <em>must</em>
                        practice HTML regularly.
                    </p>

                </div>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;em&gt;</code> only because the result
                        looks italic.
                    </li>

                    <li class="mb-2">
                        Using <code>&lt;i&gt;</code> when the content actually
                        needs emphasis.
                    </li>

                    <li class="mb-2">
                        Using HTML only for visual styling when CSS is sufficient.
                    </li>

                    <li>
                        Adding unnecessary nested formatting elements.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Write a technical term using <code>&lt;i&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Write a foreign word using <code>&lt;i&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Emphasize an important word using <code>&lt;em&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create a sentence where changing the emphasized word
                        changes the focus.
                    </li>

                    <li>
                        Compare <code>&lt;i&gt;</code> and
                        <code>&lt;em&gt;</code> in the browser.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>&lt;i&gt;</code> element represents text in an
                    alternate voice, mood, term, or phrase, while the
                    <code>&lt;em&gt;</code> element communicates emphasis.
                    Both are commonly rendered in italic style, but their
                    semantic purposes are different.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("BoldAndStrong", "TextFormatting", new { area = "HTML" })">

                    ← Previous: Bold and Strong

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("UnderlineAndHighlight", "TextFormatting", new { area = "HTML" })">

                    Next: Underline and Highlight →

                </a>

            </div>


        </section>

    </div>

</main>