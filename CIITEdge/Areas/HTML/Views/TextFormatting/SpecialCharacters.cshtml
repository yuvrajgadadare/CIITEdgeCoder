@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Special Characters";
}

<style>

    #html-special-characters-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-special-characters-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-special-characters-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-special-characters-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-special-characters-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-special-characters-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-special-characters-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-special-characters-page .table td {
        vertical-align: middle;
    }

    #html-special-characters-page .character-box {
        font-size: 28px;
        font-weight: 700;
        color: #4c1d95;
        text-align: center;
        padding: 12px;
    }

</style>


<main id="html-special-characters-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Special Characters
                </h1>

                <p class="lead">
                    Learn how to display reserved characters, symbols,
                    spaces, currency signs, and other special characters
                    correctly in HTML.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What are HTML Special Characters?
                </h2>

                <p>
                    Some characters have a special meaning in HTML.
                    For example, the less-than sign
                    <code>&lt;</code> is used to begin an HTML tag.
                </p>

                <p>
                    When you need to display such characters as normal text,
                    HTML character references can be used.
                </p>

                <div class="alert alert-info">

                    <strong>Example:</strong>

                    To display:

                    <strong>&lt;</strong>

                    in normal page text, you can write:

                    <code>&amp;lt;</code>

                </div>

            </div>


            <!-- CHARACTER REFERENCES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Character References
                </h2>

                <p>
                    Special characters can be represented using character
                    references. A character reference commonly starts with
                    <code>&amp;</code> and ends with <code>;</code>.
                </p>

                <pre><code>&amp;lt;
&amp;gt;
&amp;amp;
&amp;quot;
&amp;copy;</code></pre>

                <p>
                    The browser interprets these references and displays the
                    corresponding characters.
                </p>

            </div>


            <!-- LESS THAN -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Less Than Symbol
                </h2>

                <p>
                    The less-than symbol is written as:
                </p>

                <pre><code>&amp;lt;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &lt;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    5 &amp;lt; 10
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        5 &lt; 10
                    </p>

                </div>

            </div>


            <!-- GREATER THAN -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Greater Than Symbol
                </h2>

                <p>
                    The greater-than symbol can be written as:
                </p>

                <pre><code>&amp;gt;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &gt;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    10 &amp;gt; 5
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        10 &gt; 5
                    </p>

                </div>

            </div>


            <!-- AMPERSAND -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Ampersand Symbol
                </h2>

                <p>
                    The ampersand symbol is represented using:
                </p>

                <pre><code>&amp;amp;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &amp;
                    </div>

                </div>

            </div>


            <!-- QUOTATION MARK -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Quotation Mark
                </h2>

                <p>
                    The double quotation mark can be represented using:
                </p>

                <pre><code>&amp;quot;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &quot;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    He said &amp;quot;Hello&amp;quot;.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        He said &quot;Hello&quot;.
                    </p>

                </div>

            </div>


            <!-- NON-BREAKING SPACE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Non-Breaking Space
                </h2>

                <p>
                    The <code>&amp;nbsp;</code> character reference represents
                    a non-breaking space.
                </p>

                <pre><code>&amp;nbsp;</code></pre>

                <p>
                    It creates a space that the browser does not normally
                    collapse with adjacent spaces and keeps the words together
                    across a line break.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    CIIT&amp;nbsp;Institute
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        CIIT&nbsp;Institute
                    </p>

                </div>

            </div>


            <!-- COPYRIGHT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Copyright Symbol
                </h2>

                <pre><code>&amp;copy;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &copy;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    &amp;copy; CIIT Institute
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        &copy; CIIT Institute
                    </p>

                </div>

            </div>


            <!-- REGISTERED -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Registered Trademark Symbol
                </h2>

                <pre><code>&amp;reg;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &reg;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    CIIT&amp;reg;
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        CIIT&reg;
                    </p>

                </div>

            </div>


            <!-- TRADEMARK -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Trademark Symbol
                </h2>

                <pre><code>&amp;trade;</code></pre>

                <div class="example-box">

                    <div class="character-box">
                        &trade;
                    </div>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    CIIT&amp;trade;
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        CIIT&trade;
                    </p>

                </div>

            </div>


            <!-- CURRENCY SYMBOLS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Currency Symbols
                </h2>

                <p>
                    HTML can display a wide range of currency symbols using
                    character references or Unicode characters.
                </p>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Symbol</th>
                                <th>Reference</th>
                                <th>Output</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Rupee
                                </td>

                                <td>
                                    <code>&amp;#8377;</code>
                                </td>

                                <td>
                                    ₹
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Dollar
                                </td>

                                <td>
                                    <code>&amp;dollar;</code>
                                </td>

                                <td>
                                    $
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Euro
                                </td>

                                <td>
                                    <code>&amp;euro;</code>
                                </td>

                                <td>
                                    €
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Pound
                                </td>

                                <td>
                                    <code>&amp;pound;</code>
                                </td>

                                <td>
                                    £
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Yen
                                </td>

                                <td>
                                    <code>&amp;yen;</code>
                                </td>

                                <td>
                                    ¥
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- MATHEMATICAL SYMBOLS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Mathematical Symbols
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Symbol</th>
                                <th>Reference</th>
                                <th>Output</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Less Than
                                </td>

                                <td>
                                    <code>&amp;lt;</code>
                                </td>

                                <td>
                                    &lt;
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Greater Than
                                </td>

                                <td>
                                    <code>&amp;gt;</code>
                                </td>

                                <td>
                                    &gt;
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Plus/Minus
                                </td>

                                <td>
                                    <code>&amp;plusmn;</code>
                                </td>

                                <td>
                                    ±
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Multiplication
                                </td>

                                <td>
                                    <code>&amp;times;</code>
                                </td>

                                <td>
                                    ×
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Division
                                </td>

                                <td>
                                    <code>&amp;divide;</code>
                                </td>

                                <td>
                                    ÷
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Not Equal
                                </td>

                                <td>
                                    <code>&amp;ne;</code>
                                </td>

                                <td>
                                    ≠
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Less Than or Equal
                                </td>

                                <td>
                                    <code>&amp;le;</code>
                                </td>

                                <td>
                                    ≤
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Greater Than or Equal
                                </td>

                                <td>
                                    <code>&amp;ge;</code>
                                </td>

                                <td>
                                    ≥
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ARROWS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Arrow Symbols
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Symbol</th>
                                <th>Reference</th>
                                <th>Output</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Left Arrow
                                </td>

                                <td>
                                    <code>&amp;larr;</code>
                                </td>

                                <td>
                                    ←
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Right Arrow
                                </td>

                                <td>
                                    <code>&amp;rarr;</code>
                                </td>

                                <td>
                                    →
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Up Arrow
                                </td>

                                <td>
                                    <code>&amp;uarr;</code>
                                </td>

                                <td>
                                    ↑
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Down Arrow
                                </td>

                                <td>
                                    <code>&amp;darr;</code>
                                </td>

                                <td>
                                    ↓
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Left-Right Arrow
                                </td>

                                <td>
                                    <code>&amp;harr;</code>
                                </td>

                                <td>
                                    ↔
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- OTHER COMMON SYMBOLS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Other Common Special Characters
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Character</th>
                                <th>Reference</th>
                                <th>Result</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Cent
                                </td>

                                <td>
                                    <code>&amp;cent;</code>
                                </td>

                                <td>
                                    ¢
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Section
                                </td>

                                <td>
                                    <code>&amp;sect;</code>
                                </td>

                                <td>
                                    §
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Degree
                                </td>

                                <td>
                                    <code>&amp;deg;</code>
                                </td>

                                <td>
                                    °
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Paragraph
                                </td>

                                <td>
                                    <code>&amp;para;</code>
                                </td>

                                <td>
                                    ¶
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Bullet
                                </td>

                                <td>
                                    <code>&amp;bull;</code>
                                </td>

                                <td>
                                    •
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Middle Dot
                                </td>

                                <td>
                                    <code>&amp;middot;</code>
                                </td>

                                <td>
                                    ·
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- NUMERIC CHARACTER REFERENCES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Numeric Character References
                </h2>

                <p>
                    Characters can also be represented using numeric character
                    references.
                </p>

                <pre><code>&amp;#169;
&amp;#174;
&amp;#8377;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-2">
                        &#169; Copyright
                    </p>

                    <p class="mb-2">
                        &#174; Registered
                    </p>

                    <p class="mb-0">
                        &#8377; Indian Rupee
                    </p>

                </div>

            </div>


            <!-- HEX REFERENCES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Hexadecimal Character References
                </h2>

                <p>
                    Unicode characters can also be represented using hexadecimal
                    numeric references.
                </p>

                <pre><code>&amp;#x20AC;</code></pre>
                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        &#x20AC;
                    </p>

                </div>

                <p class="mt-3">
                    The example above represents the Euro symbol.
                </p>

            </div>


            <!-- HTML SOURCE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example in an HTML Page
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;
        Special Characters
    &lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;p&gt;
        5 &amp;lt; 10
    &lt;/p&gt;

    &lt;p&gt;
        CIIT &amp;copy; Institute
    &lt;/p&gt;

    &lt;p&gt;
        Price: &amp;#8377;4500
    &lt;/p&gt;

    &lt;p&gt;
        HTML &amp;rarr; CSS &amp;rarr; JavaScript
    &lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p>
                        5 &lt; 10
                    </p>

                    <p>
                        CIIT &copy; Institute
                    </p>

                    <p>
                        Price: &#8377;4500
                    </p>

                    <p class="mb-0">
                        HTML &rarr; CSS &rarr; JavaScript
                    </p>

                </div>

            </div>


            <!-- IMPORTANT RULES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Important Rules
                </h2>

                <ul>

                    <li class="mb-2">
                        Character references normally begin with
                        <code>&amp;</code>.
                    </li>

                    <li class="mb-2">
                        Named references usually end with <code>;</code>.
                    </li>

                    <li class="mb-2">
                        Use character references when a character could be
                        interpreted as HTML markup.
                    </li>

                    <li class="mb-2">
                        Numeric character references can represent Unicode
                        characters.
                    </li>

                    <li>
                        Always choose the correct character reference for
                        the character you want to display.
                    </li>

                </ul>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Writing <code>&lt;</code> directly when it should be
                        interpreted as text.
                    </li>

                    <li class="mb-2">
                        Forgetting the semicolon at the end of a named
                        character reference.
                    </li>

                    <li class="mb-2">
                        Using an incorrect character reference.
                    </li>

                    <li>
                        Confusing HTML character references with CSS
                        escape sequences or programming-language escapes.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Display <code>&lt;</code> and <code>&gt;</code>
                        as normal text.
                    </li>

                    <li class="mb-2">
                        Display an ampersand using <code>&amp;amp;</code>.
                    </li>

                    <li class="mb-2">
                        Display a copyright symbol.
                    </li>

                    <li class="mb-2">
                        Display the Indian Rupee symbol.
                    </li>

                    <li class="mb-2">
                        Display a right arrow.
                    </li>

                    <li>
                        Create a small HTML page containing at least
                        five different special characters.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML character references are used to display special
                    characters and symbols safely in HTML. Common examples
                    include <code>&amp;lt;</code>, <code>&amp;gt;</code>,
                    <code>&amp;amp;</code>, <code>&amp;copy;</code>,
                    <code>&amp;reg;</code>, and <code>&amp;nbsp;</code>.
                    Numeric and hexadecimal references can also be used
                    to represent Unicode characters.
                </p>

