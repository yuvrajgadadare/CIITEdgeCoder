@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "Bold and Strong";
}

<style>

    #html-bold-strong-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-bold-strong-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-bold-strong-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-bold-strong-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-bold-strong-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-bold-strong-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-bold-strong-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-bold-strong-page .table td {
        vertical-align: middle;
    }

</style>


<main id="html-bold-strong-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    Bold and Strong
                </h1>

                <p class="lead">
                    Learn the difference between the
                    <code>&lt;b&gt;</code> and <code>&lt;strong&gt;</code>
                    elements and understand when to use each one.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Introduction
                </h2>

                <p>
                    HTML provides two commonly used elements for displaying
                    text with a bold appearance:
                    <code>&lt;b&gt;</code> and <code>&lt;strong&gt;</code>.
                </p>

                <p>
                    Although both elements are commonly rendered with bold
                    text by browsers, they have different meanings.
                </p>

                <div class="alert alert-info">

                    <strong>Remember:</strong>

                    <code>&lt;b&gt;</code> is generally used to draw attention
                    to text, while <code>&lt;strong&gt;</code> indicates that
                    the text has strong importance.

                </div>

            </div>


            <!-- B TAG -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;b&gt; Element
                </h2>

                <p>
                    The <code>&lt;b&gt;</code> element is used to draw the
                    reader's attention to text without implying extra
                    importance or emphasis.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;b&gt;Text&lt;/b&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    Learn &lt;b&gt;HTML&lt;/b&gt; step-by-step.
&lt;/p&gt;</code></pre>


                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        Learn <b>HTML</b> step-by-step.
                    </p>

                </div>

            </div>


            <!-- STRONG TAG -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;strong&gt; Element
                </h2>

                <p>
                    The <code>&lt;strong&gt;</code> element indicates that
                    its content has strong importance, seriousness, or urgency.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;strong&gt;Important Text&lt;/strong&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    &lt;strong&gt;Important:&lt;/strong&gt;
    Save your work before closing the application.
&lt;/p&gt;</code></pre>



                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        <strong>Important:</strong>

                        Save your work before closing the application.

                    </p>

                </div>

            </div>


            <!-- SIDE BY SIDE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    &lt;b&gt; vs &lt;strong&gt;
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Feature</th>
                                <th>&lt;b&gt;</th>
                                <th>&lt;strong&gt;</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Main Purpose
                                </td>

                                <td>
                                    Draws attention to text.
                                </td>

                                <td>
                                    Indicates strong importance.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Semantic Meaning
                                </td>

                                <td>
                                    Does not normally add importance.
                                </td>

                                <td>
                                    Adds semantic importance.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Common Browser Appearance
                                </td>

                                <td>
                                    Bold text.
                                </td>

                                <td>
                                    Bold text.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Typical Usage
                                </td>

                                <td>
                                    Keywords, labels, names, visually
                                    prominent text.
                                </td>

                                <td>
                                    Warnings, important notices, critical text.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- B EXAMPLES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Examples of &lt;b&gt;
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Keyword
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    Learn &lt;b&gt;HTML&lt;/b&gt;.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Product Name
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    Product:
    &lt;b&gt;CIIT Course&lt;/b&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Label
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    Name:
    &lt;b&gt;Student&lt;/b&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Important Term
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    Topic:
    &lt;b&gt;HTML Elements&lt;/b&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>

                </div>

            </div>


            <!-- STRONG EXAMPLES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Examples of &lt;strong&gt;
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Warning
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    &lt;strong&gt;Warning:&lt;/strong&gt;
    Do not share your password.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Important Instruction
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    &lt;strong&gt;Important:&lt;/strong&gt;
    Submit the form before closing.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Urgent Information
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    &lt;strong&gt;Urgent:&lt;/strong&gt;
    Contact support immediately.
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Important Result
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    Result:
    &lt;strong&gt;Pass&lt;/strong&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>

                </div>

            </div>


            <!-- VISUAL OUTPUT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Visual Comparison
                </h2>

                <div class="concept-box">

                    <p>
                        Using <code>&lt;b&gt;</code>:
                        <b>This text is bold.</b>
                    </p>

                    <p class="mb-0">
                        Using <code>&lt;strong&gt;</code>:
                        <strong>This text is strongly important.</strong>
                    </p>

                </div>

                <div class="alert alert-secondary mt-3">

                    Both may look visually similar in a browser,
                    but their semantic meanings are different.

                </div>

            </div>


            <!-- NESTING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Nesting &lt;b&gt; and &lt;strong&gt;
                </h2>

                <p>
                    Formatting elements can be nested when the structure
                    and meaning make sense.
                </p>

                <pre><code>&lt;p&gt;

    This is
    &lt;strong&gt;
        &lt;b&gt;very important&lt;/b&gt;
    &lt;/strong&gt;

    information.

&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        This is
                        <strong>
                            <b>very important</b>
                        </strong>
                        information.

                    </p>

                </div>

                <div class="alert alert-warning mt-3">

                    <strong>Note:</strong>

                    Do not add unnecessary nesting. Use the simplest
                    structure that correctly communicates the intended meaning.

                </div>

            </div>


            <!-- USING CSS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using CSS Instead of &lt;b&gt;
                </h2>

                <p>
                    CSS can make text visually bold without changing
                    the semantic meaning of the HTML.
                </p>

                <pre><code>&lt;p class="custom-text"&gt;
    HTML Course
&lt;/p&gt;

&lt;style&gt;

    .custom-text {
        font-weight: bold;
    }

&lt;/style&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="custom-text mb-0"
                       style="font-weight: bold;">

                        HTML Course

                    </p>

                </div>

                <p class="mt-3">
                    This approach is useful when bold appearance is purely
                    a visual design requirement.
                </p>

            </div>


            <!-- ACCESSIBILITY -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Accessibility and Meaning
                </h2>

                <p>
                    Semantic HTML helps browsers, assistive technologies,
                    and other software understand the meaning of content.
                </p>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                &lt;b&gt;
                            </h5>

                            <p class="mb-0">
                                Use when the text needs attention or visual
                                distinction without expressing strong importance.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                &lt;strong&gt;
                            </h5>

                            <p class="mb-0">
                                Use when the content itself has strong importance,
                                seriousness, or urgency.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- REAL WORLD EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example 👀🤓
                </h2>

                <pre><code>&lt;h2&gt;
    Course Registration
&lt;/h2&gt;

&lt;p&gt;
    Course:
    &lt;b&gt;.NET Full Stack Development&lt;/b&gt;
&lt;/p&gt;

&lt;p&gt;
    &lt;strong&gt;Important:&lt;/strong&gt;
    Please complete your registration before the deadline.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <h3>
                        Course Registration
                    </h3>

                    <p>
                        Course:
                        <b>.NET Full Stack Development</b>
                    </p>

                    <p class="mb-0">

                        <strong>Important:</strong>

                        Please complete your registration before the deadline.

                    </p>

                </div>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;strong&gt;</code> everywhere just
                        because it appears bold.
                    </li>

                    <li class="mb-2">
                        Using <code>&lt;b&gt;</code> when the content actually
                        carries strong semantic importance.
                    </li>

                    <li class="mb-2">
                        Using HTML elements only for visual styling when
                        CSS would be more appropriate.
                    </li>

                    <li>
                        Adding unnecessary nested formatting elements.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a paragraph with a bold keyword using
                        <code>&lt;b&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create a warning message using
                        <code>&lt;strong&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create a course title using <code>&lt;b&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create an important instruction using
                        <code>&lt;strong&gt;</code>.
                    </li>

                    <li>
                        Compare both elements in the browser and understand
                        their different purposes.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>&lt;b&gt;</code> element draws attention to text
                    without adding special semantic importance, while the
                    <code>&lt;strong&gt;</code> element indicates strong
                    importance. Both are commonly displayed as bold text,
                    but <code>&lt;strong&gt;</code> carries semantic meaning.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("TextFormatting", "TextFormatting", new { area = "HTML" })">

                    ← Previous: Text Formatting

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("ItalicAndEmphasis", "TextFormatting", new { area = "HTML" })">

                    Next: Italic and Emphasis →

                </a>

            </div>


        </section>

    </div>

</main>