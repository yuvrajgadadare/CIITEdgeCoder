@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "Text Formatting";
}

<style>

    #html-text-formatting-topic-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-text-formatting-topic-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-text-formatting-topic-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-text-formatting-topic-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-text-formatting-topic-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-text-formatting-topic-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-text-formatting-topic-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-text-formatting-topic-page .table td {
        vertical-align: middle;
    }

</style>


<main id="html-text-formatting-topic-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    Text Formatting
                </h1>

                <p class="lead">
                    Learn the basic HTML elements used to format text,
                    emphasize important information, and improve the
                    presentation and meaning of text content.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Introduction to Text Formatting
                </h2>

                <p>
                    HTML provides several elements that can be used to
                    communicate the meaning or presentation of text.
                </p>

                <p>
                    Some elements mainly affect how text appears, while
                    semantic elements communicate the importance or emphasis
                    of the content.
                </p>

                <div class="alert alert-info">

                    <strong>Common Text Formatting Elements:</strong>

                    <div class="mt-2">

                        <code>&lt;b&gt;</code>,
                        <code>&lt;strong&gt;</code>,
                        <code>&lt;i&gt;</code>,
                        <code>&lt;em&gt;</code>,
                        <code>&lt;mark&gt;</code>,
                        <code>&lt;small&gt;</code>,
                        <code>&lt;del&gt;</code>,
                        <code>&lt;ins&gt;</code>,
                        <code>&lt;sub&gt;</code>,
                        <code>&lt;sup&gt;</code>

                    </div>

                </div>

            </div>


            <!-- QUICK COMPARISON -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Text Formatting Elements
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Element
                                </th>

                                <th>
                                    Purpose
                                </th>

                                <th>
                                    Example
                                </th>

                                <th>
                                    Result
                                </th>

                            </tr>

                        </thead>

                        <tbody>


                            <tr>

                                <td>
                                    <code>&lt;b&gt;</code>
                                </td>

                                <td>
                                    Draws attention to text.
                                </td>

                                <td>
                                    <code>&lt;b&gt;HTML&lt;/b&gt;</code>
                                </td>

                                <td>
                                    <b>HTML</b>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>&lt;strong&gt;</code>
                                </td>

                                <td>
                                    Indicates strong importance.
                                </td>

                                <td>
                                    <code>&lt;strong&gt;Important&lt;/strong&gt;</code>
                                </td>

                                <td>
                                    <strong>Important</strong>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>&lt;i&gt;</code>
                                </td>

                                <td>
                                    Represents an alternate voice or mood.
                                </td>

                                <td>
                                    <code>&lt;i&gt;HTML&lt;/i&gt;</code>
                                </td>

                                <td>
                                    <i>HTML</i>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>&lt;em&gt;</code>
                                </td>

                                <td>
                                    Adds emphasis.
                                </td>

                                <td>
                                    <code>&lt;em&gt;Must&lt;/em&gt;</code>
                                </td>

                                <td>
                                    <em>Must</em>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>&lt;mark&gt;</code>
                                </td>

                                <td>
                                    Highlights relevant text.
                                </td>

                                <td>
                                    <code>&lt;mark&gt;HTML&lt;/mark&gt;</code>
                                </td>

                                <td>
                                    <mark>HTML</mark>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>&lt;small&gt;</code>
                                </td>

                                <td>
                                    Represents smaller text.
                                </td>

                                <td>
                                    <code>&lt;small&gt;Note&lt;/small&gt;</code>
                                </td>

                                <td>
                                    <small>Note</small>
                                </td>

                            </tr>


                        </tbody>

                    </table>

                </div>

            </div>


            <!-- BOLD AND STRONG -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Bold and Strong Text
                </h2>

                <p>
                    The <code>&lt;b&gt;</code> element draws attention to
                    text without adding semantic importance.
                </p>

                <pre><code>&lt;p&gt;
    Learn &lt;b&gt;HTML&lt;/b&gt; today.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        Learn <b>HTML</b> today.
                    </p>

                </div>

                <p class="mt-4">
                    The <code>&lt;strong&gt;</code> element indicates
                    strong importance.
                </p>

                <pre><code>&lt;p&gt;
    &lt;strong&gt;Important:&lt;/strong&gt;
    Save your work.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>


                <div class="example-box">

                    <p class="mb-0">
                        <strong>Important:</strong>
                        Save your work.
                    </p>

                </div>

            </div>


            <!-- ITALIC AND EMPHASIS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Italic and Emphasis
                </h2>

                <p>
                    The <code>&lt;i&gt;</code> element represents text in
                    an alternate voice or mood.
                </p>

                <pre><code>&lt;p&gt;
    This is &lt;i&gt;italic text&lt;/i&gt;.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p>
                        This is <i>italic text</i>.
                    </p>

                </div>

                <p class="mt-4">
                    The <code>&lt;em&gt;</code> element adds emphasis.
                </p>

                <pre><code>&lt;p&gt;
    You &lt;em&gt;must&lt;/em&gt; practice HTML.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        You <em>must</em> practice HTML.
                    </p>

                </div>

            </div>


            <!-- HIGHLIGHT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Highlighting Text
                </h2>

                <p>
                    The <code>&lt;mark&gt;</code> element is used to highlight
                    text that is relevant to the current context.
                </p>

                <pre><code>&lt;p&gt;
    Learn &lt;mark&gt;HTML&lt;/mark&gt; step-by-step.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">
                        Learn <mark>HTML</mark> step-by-step.
                    </p>

                </div>

            </div>


            <!-- SMALL TEXT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Small Text
                </h2>

                <p>
                    The <code>&lt;small&gt;</code> element represents
                    side comments or fine print.
                </p>

                <pre><code>&lt;p&gt;
    HTML Course
    &lt;small&gt;Terms and conditions apply.&lt;/small&gt;
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        HTML Course

                        <small>
                            Terms and conditions apply.
                        </small>

                    </p>

                </div>

            </div>


            <!-- DELETED AND INSERTED -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Deleted and Inserted Text
                </h2>

                <p>
                    The <code>&lt;del&gt;</code> element represents deleted
                    content, while <code>&lt;ins&gt;</code> represents
                    inserted content.
                </p>

                <pre><code>&lt;p&gt;
    Original Price:
    &lt;del&gt;₹5000&lt;/del&gt;
&lt;/p&gt;

&lt;p&gt;
    New Price:
    &lt;ins&gt;₹4500&lt;/ins&gt;
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p>
                        Original Price:
                        <del>₹5000</del>
                    </p>

                    <p class="mb-0">
                        New Price:
                        <ins>₹4500</ins>
                    </p>

                </div>

            </div>


            <!-- SUBSCRIPT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Subscript
                </h2>

                <p>
                    The <code>&lt;sub&gt;</code> element displays text
                    slightly below the normal text line.
                </p>

                <pre><code>&lt;p&gt;
    H&lt;sub&gt;2&lt;/sub&gt;O
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        H<sub>2</sub>O
                    </p>

                </div>

            </div>


            <!-- SUPERSCRIPT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Superscript
                </h2>

                <p>
                    The <code>&lt;sup&gt;</code> element displays text
                    slightly above the normal text line.
                </p>

                <pre><code>&lt;p&gt;
    x&lt;sup&gt;2&lt;/sup&gt;
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">
                        x<sup>2</sup>
                    </p>

                </div>

            </div>


            <!-- SEMANTIC IMPORTANCE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Semantic Importance
                </h2>

                <div class="concept-box">

                    <div class="row g-3">


                        <div class="col-md-6">

                            <div class="info-card">

                                <h5>
                                    &lt;b&gt;
                                </h5>

                                <p class="mb-0">
                                    Draws attention to text without
                                    expressing special importance.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-card">

                                <h5>
                                    &lt;strong&gt;
                                </h5>

                                <p class="mb-0">
                                    Communicates strong importance.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-card">

                                <h5>
                                    &lt;i&gt;
                                </h5>

                                <p class="mb-0">
                                    Represents text in an alternate voice
                                    or mood.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-card">

                                <h5>
                                    &lt;em&gt;
                                </h5>

                                <p class="mb-0">
                                    Communicates emphasis.
                                </p>

                            </div>

                        </div>


                    </div>

                </div>

            </div>


            <!-- COMBINING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Combining Formatting Elements
                </h2>

                <p>
                    Multiple formatting elements can be combined when required.
                </p>

                <pre><code>&lt;p&gt;
    This is
    &lt;strong&gt;
        &lt;mark&gt;very important&lt;/mark&gt;
    &lt;/strong&gt;
    information.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        This is

                        <strong>
                            <mark>very important</mark>
                        </strong>

                        information.

                    </p>

                </div>

            </div>


            <!-- REAL WORLD EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example 🤓
                </h2>

                <pre><code>&lt;h2&gt;
    Course Offer
&lt;/h2&gt;

&lt;p&gt;
    Learn &lt;strong&gt;HTML&lt;/strong&gt;
    and &lt;em&gt;web development&lt;/em&gt;.
&lt;/p&gt;

&lt;p&gt;
    Old Fee:
    &lt;del&gt;₹5000&lt;/del&gt;
&lt;/p&gt;

&lt;p&gt;
    Current Fee:
    &lt;ins&gt;₹4500&lt;/ins&gt;
&lt;/p&gt;

&lt;p&gt;
    H&lt;sub&gt;2&lt;/sub&gt;O
&lt;/p&gt;

&lt;p&gt;
    x&lt;sup&gt;2&lt;/sup&gt;
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <h3>
                        Course Offer
                    </h3>

                    <p>
                        Learn <strong>HTML</strong>
                        and <em>web development</em>.
                    </p>

                    <p>
                        Old Fee:
                        <del>₹5000</del>
                    </p>

                    <p>
                        Current Fee:
                        <ins>₹4500</ins>
                    </p>

                    <p>
                        H<sub>2</sub>O
                    </p>

                    <p class="mb-0">
                        x<sup>2</sup>
                    </p>

                </div>

            </div>


            <!-- IMPORTANT POINTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Important Points
                </h2>

                <ul>

                    <li class="mb-2">
                        Use <code>&lt;b&gt;</code> to draw attention to text.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;strong&gt;</code> for strong importance.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;i&gt;</code> for alternate voice or mood.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;em&gt;</code> for emphasis.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;mark&gt;</code> to highlight text.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;del&gt;</code> for deleted content.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;ins&gt;</code> for inserted content.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;sub&gt;</code> for subscript.
                    </li>

                    <li>
                        Use <code>&lt;sup&gt;</code> for superscript.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Write a sentence using <code>&lt;b&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Write an important message using
                        <code>&lt;strong&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Add an emphasized word using <code>&lt;em&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Highlight a keyword using <code>&lt;mark&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Show an old value using <code>&lt;del&gt;</code>
                        and a new value using <code>&lt;ins&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Write H<sub>2</sub>O using <code>&lt;sub&gt;</code>.
                    </li>

                    <li>
                        Write x<sup>2</sup> using <code>&lt;sup&gt;</code>.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML text formatting elements are used to emphasize,
                    highlight, or represent different types of text content.
                    Semantic elements such as <code>&lt;strong&gt;</code> and
                    <code>&lt;em&gt;</code> communicate meaning, while
                    elements such as <code>&lt;mark&gt;</code>,
                    <code>&lt;del&gt;</code>, <code>&lt;ins&gt;</code>,
                    <code>&lt;sub&gt;</code>, and <code>&lt;sup&gt;</code>
                    represent specific text situations.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("Index", "TextFormatting", new { area = "HTML" })">

                    ← Previous: Text Formatting

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("BoldAndStrong", "TextFormatting", new { area = "HTML" })">

                    Next: Bold and Strong →

                </a>

            </div>


        </section>

    </div>

</main>