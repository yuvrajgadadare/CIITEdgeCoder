@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Quotations";
}

<style>

    #html-quotations-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-quotations-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-quotations-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-quotations-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-quotations-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-quotations-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-quotations-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-quotations-page .table td {
        vertical-align: middle;
    }

    #html-quotations-page blockquote {
        border-left: 5px solid #6f42c1;
        padding: 15px 20px;
        margin: 15px 0;
        background: #f8f9fa;
    }

</style>


<main id="html-quotations-page"
      class="container py-5">

    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">

            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Quotations
                </h1>

                <p class="lead">
                    Learn how to represent short quotations, long quotations,
                    and quoted titles or references using HTML elements.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Introduction to HTML Quotations
                </h2>

                <p>
                    HTML provides specific elements for marking quoted content.
                    These elements help communicate the structure and meaning
                    of quotation content.
                </p>

                <div class="alert alert-info">

                    <strong>Common Quotation Elements:</strong>

                    <div class="mt-2">

                        <code>&lt;q&gt;</code> -
                        short inline quotation

                        <br />

                        <code>&lt;blockquote&gt;</code> -
                        longer quotation

                        <br />

                        <code>&lt;cite&gt;</code> -
                        title or reference to a creative work

                    </div>

                </div>

            </div>


            <!-- Q ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;q&gt; Element
                </h2>

                <p>
                    The <code>&lt;q&gt;</code> element is used for a short
                    inline quotation.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;q&gt;Quoted text&lt;/q&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p&gt;
    The instructor said
    &lt;q&gt;Practice HTML every day.&lt;/q&gt;
&lt;/p&gt;</code></pre>

                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>>

                <div class="example-box">

                    <p class="mb-0">

                        The instructor said
                        <q>Practice HTML every day.</q>

                    </p>

                </div>

            </div>


            <!-- BLOCKQUOTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;blockquote&gt; Element
                </h2>

                <p>
                    The <code>&lt;blockquote&gt;</code> element is used for
                    longer quotations that are separated from the surrounding
                    content.
                </p>

                <h3 class="h5 fw-bold mt-4">
                    Syntax
                </h3>

                <pre><code>&lt;blockquote&gt;
    Quoted content goes here.
&lt;/blockquote&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;blockquote&gt;
    Learning to write programs expands
    your ability to solve problems.
&lt;/blockquote&gt;</code></pre>

                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <blockquote>
                        Learning to write programs expands
                        your ability to solve problems.
                    </blockquote>

                </div>

            </div>


            <!-- Q VS BLOCKQUOTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    &lt;q&gt; vs &lt;blockquote&gt;
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Element</th>
                                <th>Purpose</th>
                                <th>Typical Usage</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;q&gt;</code>
                                </td>

                                <td>
                                    Represents a short inline quotation.
                                </td>

                                <td>
                                    A sentence or short phrase inside a paragraph.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;blockquote&gt;</code>
                                </td>

                                <td>
                                    Represents a longer quotation.
                                </td>

                                <td>
                                    A separate quotation block.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- CITE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;cite&gt; Element
                </h2>

                <p>
                    The <code>&lt;cite&gt;</code> element is used to identify
                    the title of a creative work or a reference to a source.
                </p>

                <pre><code>&lt;p&gt;
    I am reading
    &lt;cite&gt;The Web Development Guide&lt;/cite&gt;.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        I am reading
                        <cite>The Web Development Guide</cite>.

                    </p>

                </div>

            </div>


            <!-- BLOCKQUOTE + CITE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using &lt;blockquote&gt; with &lt;cite&gt;
                </h2>

                <pre><code>&lt;blockquote&gt;

    Learning is a continuous process.

    &lt;cite&gt;
        Web Development Guide
    &lt;/cite&gt;

&lt;/blockquote&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <blockquote>

                        Learning is a continuous process.

                        <div class="mt-2">
                            <cite>Web Development Guide</cite>
                        </div>

                    </blockquote>

                </div>

            </div>


            <!-- QUOTE SOURCE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The cite Attribute
                </h2>

                <p>
                    The <code>cite</code> attribute can provide a URL that
                    identifies the source of quoted information.
                </p>

                <pre><code>&lt;blockquote cite="https://example.com/source"&gt;

    Quoted information goes here.

&lt;/blockquote&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="alert alert-warning">

                    <strong>Important:</strong>

                    The <code>cite</code> attribute identifies the source
                    programmatically; it does not automatically display
                    the source URL to the user.

                </div>

            </div>


            <!-- SHORT QUOTE EXAMPLES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Short Quotation Examples
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Example 1
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    She said
    &lt;q&gt;Learn HTML first.&lt;/q&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Example 2
                            </h5>

                            <pre class="mb-0"><code>&lt;p&gt;
    The teacher said
    &lt;q&gt;Practice regularly.&lt;/q&gt;
&lt;/p&gt;</code></pre>

                        </div>

                    </div>

                </div>

            </div>


            <!-- LONG QUOTATION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Long Quotation Example
                </h2>

                <pre><code>&lt;blockquote&gt;

    HTML provides the structure of a web page.
    CSS controls its visual presentation.
    JavaScript can add interaction and behavior.

&lt;/blockquote&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <blockquote>

                        HTML provides the structure of a web page.
                        CSS controls its visual presentation.
                        JavaScript can add interaction and behavior.

                    </blockquote>

                </div>

            </div>


            <!-- NESTING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Quotations Inside Paragraphs
                </h2>

                <pre><code>&lt;p&gt;

    Our instructor said
    &lt;q&gt;HTML is the foundation of web development.&lt;/q&gt;

    We followed the advice.

&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        Our instructor said
                        <q>HTML is the foundation of web development.</q>

                        We followed the advice.

                    </p>

                </div>

            </div>


            <!-- CSS STYLING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Styling Quotations with CSS
                </h2>

                <p>
                    CSS can be used to control the appearance of quotation
                    blocks without changing their semantic meaning.
                </p>

                <pre><code>&lt;blockquote class="custom-quote"&gt;
    Learn something new every day.
&lt;/blockquote&gt;

&lt;style&gt;

    .custom-quote {
        border-left: 4px solid blue;
        padding-left: 15px;
        font-style: italic;
    }

&lt;/style&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <blockquote style="border-left: 4px solid #2563eb;
                        padding-left: 15px;
                        font-style: italic;">

                        Learn something new every day.

                    </blockquote>

                </div>

            </div>


            <!-- REAL WORLD EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example 🤓🌍
                </h2>

                <pre><code>&lt;h2&gt;
    Student Feedback
&lt;/h2&gt;

&lt;blockquote&gt;

    The HTML course helped me understand
    the fundamentals of web development.

    &lt;cite&gt;
        Student Feedback
    &lt;/cite&gt;

&lt;/blockquote&gt;

&lt;p&gt;

    The instructor said
    &lt;q&gt;Practice by building projects.&lt;/q&gt;

&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <h3>
                        Student Feedback
                    </h3>

                    <blockquote>

                        The HTML course helped me understand
                        the fundamentals of web development.

                        <div class="mt-2">
                            <cite>Student Feedback</cite>
                        </div>

                    </blockquote>

                    <p class="mb-0">

                        The instructor said
                        <q>Practice by building projects.</q>

                    </p>

                </div>

            </div>


            <!-- IMPORTANT POINTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Important Points
                </h2>

                <ul>

                    <li class="mb-2">
                        Use <code>&lt;q&gt;</code> for short inline quotations.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;blockquote&gt;</code> for longer quotations.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;cite&gt;</code> for the title of a
                        creative work or source reference.
                    </li>

                    <li class="mb-2">
                        The <code>cite</code> attribute can identify the source
                        of quoted information.
                    </li>

                    <li>
                        Use CSS when you need to change the visual appearance
                        of quotation elements.
                    </li>

                </ul>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;blockquote&gt;</code> for every
                        short sentence.
                    </li>

                    <li class="mb-2">
                        Using quotation elements only for visual indentation.
                    </li>

                    <li class="mb-2">
                        Forgetting to identify the source when the source
                        information is available.
                    </li>

                    <li>
                        Using quotation tags where normal text formatting
                        would be more appropriate.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a short quotation using <code>&lt;q&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create a long quotation using
                        <code>&lt;blockquote&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Add a source title using <code>&lt;cite&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Add a <code>cite</code> attribute to a blockquote.
                    </li>

                    <li>
                        Use CSS to style your blockquote.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML provides quotation elements to give quoted content
                    appropriate structure and meaning. Use
                    <code>&lt;q&gt;</code> for short inline quotations,
                    <code>&lt;blockquote&gt;</code> for longer quotations,
                    and <code>&lt;cite&gt;</code> for titles or references
                    to creative works. CSS can be used to style quotation
                    elements without changing their semantic purpose.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("SubscriptAndSuperscript", "TextFormatting", new { area = "HTML" })">

                    ← Previous: Subscript and Superscript

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Abbreviations", "TextFormatting", new { area = "HTML" })">

                    Next: Abbreviations →

                </a>

            </div>


        </section>

    </div>

</main>