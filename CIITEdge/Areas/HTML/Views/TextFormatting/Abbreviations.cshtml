@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Abbreviations";
}

<style>

    #html-abbreviations-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-abbreviations-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-abbreviations-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-abbreviations-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-abbreviations-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-abbreviations-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-abbreviations-page .table th {
        background: #f8f9fa;
        vertical-align: middle;
    }

    #html-abbreviations-page .table td {
        vertical-align: middle;
    }

</style>


<main id="html-abbreviations-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Abbreviations
                </h1>

                <p class="lead">
                    Learn how to represent abbreviations and acronyms in HTML
                    using the <code>&lt;abbr&gt;</code> element.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is an Abbreviation?
                </h2>

                <p>
                    An abbreviation is a shortened form of a word or phrase.
                    HTML provides the <code>&lt;abbr&gt;</code> element to
                    identify an abbreviation or acronym in a document.
                </p>

                <div class="alert alert-info">

                    <strong>Basic Syntax:</strong>

                    <pre class="mb-0 mt-3"><code>&lt;abbr title="Full Form"&gt;Short Form&lt;/abbr&gt;</code></pre>

                </div>

            </div>


            <!-- ABBR ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The &lt;abbr&gt; Element
                </h2>

                <p>
                    The <code>&lt;abbr&gt;</code> element represents an
                    abbreviation or acronym.
                </p>

                <pre><code>&lt;p&gt;
    Learn &lt;abbr title="HyperText Markup Language"&gt;HTML&lt;/abbr&gt;.
&lt;/p&gt;</code></pre>

                <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        Learn
                        <abbr title="HyperText Markup Language">
                            HTML
                        </abbr>.

                    </p>

                </div>

            </div>


            <!-- TITLE ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using the title Attribute
                </h2>

                <p>
                    The <code>title</code> attribute can provide the expanded
                    form or additional information about the abbreviation.
                </p>

                <pre><code>&lt;abbr title="Cascading Style Sheets"&gt;
    CSS
&lt;/abbr&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        <abbr title="Cascading Style Sheets">
                            CSS
                        </abbr>

                    </p>

                </div>

                <div class="alert alert-success mt-3">

                    <strong>Tip:</strong>

                    Hover over the abbreviation in the browser to see the
                    title information in browsers that provide that behavior.

                </div>

            </div>


            <!-- COMMON EXAMPLES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Abbreviation Examples
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>
                                <th>Abbreviation</th>
                                <th>Full Form</th>
                                <th>HTML Example</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    HTML
                                </td>

                                <td>
                                    HyperText Markup Language
                                </td>

                                <td>
                                    <code>
                                        &lt;abbr title="HyperText Markup Language"&gt;HTML&lt;/abbr&gt;
                                    </code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    CSS
                                </td>

                                <td>
                                    Cascading Style Sheets
                                </td>

                                <td>
                                    <code>
                                        &lt;abbr title="Cascading Style Sheets"&gt;CSS&lt;/abbr&gt;
                                    </code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    HTTP
                                </td>

                                <td>
                                    HyperText Transfer Protocol
                                </td>

                                <td>
                                    <code>
                                        &lt;abbr title="HyperText Transfer Protocol"&gt;HTTP&lt;/abbr&gt;
                                    </code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    API
                                </td>

                                <td>
                                    Application Programming Interface
                                </td>

                                <td>
                                    <code>
                                        &lt;abbr title="Application Programming Interface"&gt;API&lt;/abbr&gt;
                                    </code>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ACRONYMS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Abbreviations and Acronyms
                </h2>

                <p>
                    Acronyms are commonly written using the same
                    <code>&lt;abbr&gt;</code> element in modern HTML.
                </p>

                <pre><code>&lt;p&gt;
    &lt;abbr title="Application Programming Interface"&gt;
        API
    &lt;/abbr&gt;
    allows applications to communicate with services.
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        <abbr title="Application Programming Interface">
                            API
                        </abbr>

                        allows applications to communicate with services.

                    </p>

                </div>

            </div>


            <!-- WHY USE ABBR -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Why Use &lt;abbr&gt;?
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Meaning
                            </h5>

                            <p class="mb-0">
                                Identifies shortened words or phrases
                                within the HTML document.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Readability
                            </h5>

                            <p class="mb-0">
                                The full form can be associated with the
                                abbreviation for better understanding.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Semantics
                            </h5>

                            <p class="mb-0">
                                Adds semantic meaning to the document instead
                                of treating the abbreviation as ordinary text.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Maintainability
                            </h5>

                            <p class="mb-0">
                                Makes the source code clearer about what
                                a shortened term represents.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ABBR INSIDE PARAGRAPH -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Abbreviations Inside a Paragraph
                </h2>

                <pre><code>&lt;p&gt;

    &lt;abbr title="HyperText Markup Language"&gt;
        HTML
    &lt;/abbr&gt;

    is used to structure web pages.

&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        <abbr title="HyperText Markup Language">
                            HTML
                        </abbr>

                        is used to structure web pages.

                    </p>

                </div>

            </div>


            <!-- MULTIPLE ABBREVIATIONS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Multiple Abbreviations
                </h2>

                <pre><code>&lt;p&gt;

    &lt;abbr title="HyperText Markup Language"&gt;
        HTML
    &lt;/abbr&gt;

    works with

    &lt;abbr title="Cascading Style Sheets"&gt;
        CSS
    &lt;/abbr&gt;

    and

    &lt;abbr title="JavaScript"&gt;
        JS
    &lt;/abbr&gt;.

&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        <abbr title="HyperText Markup Language">
                            HTML
                        </abbr>

                        works with

                        <abbr title="Cascading Style Sheets">
                            CSS
                        </abbr>

                        and

                        <abbr title="JavaScript">
                            JS
                        </abbr>.

                    </p>

                </div>

            </div>


            <!-- ACCESSIBILITY -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Accessibility Considerations
                </h2>

                <p>
                    Meaningful markup can help users and assistive technologies
                    understand the purpose of content.
                </p>

                <div class="alert alert-warning">

                    <strong>Best Practice:</strong>

                    When an abbreviation may not be familiar to the audience,
                    provide its full form or explanation.

                </div>

            </div>


            <!-- NESTING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Combining &lt;abbr&gt; with Other Elements
                </h2>

                <pre><code>&lt;p&gt;

    Learn

    &lt;strong&gt;
        &lt;abbr title="HyperText Markup Language"&gt;
            HTML
        &lt;/abbr&gt;
    &lt;/strong&gt;

    step-by-step.

&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">

                        Learn

                        <strong>
                            <abbr title="HyperText Markup Language">
                                HTML
                            </abbr>
                        </strong>

                        step-by-step.

                    </p>

                </div>

            </div>


            <!-- REAL WORLD EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example 🤓👨‍🏫
                </h2>

                <pre><code>&lt;h2&gt;
    Web Development
&lt;/h2&gt;

&lt;p&gt;

    &lt;abbr title="HyperText Markup Language"&gt;
        HTML
    &lt;/abbr&gt;

    defines structure.

&lt;/p&gt;

&lt;p&gt;

    &lt;abbr title="Cascading Style Sheets"&gt;
        CSS
    &lt;/abbr&gt;

    controls presentation.

&lt;/p&gt;

&lt;p&gt;

    &lt;abbr title="Application Programming Interface"&gt;
        API
    &lt;/abbr&gt;

    allows software systems to communicate.

&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <h3>
                        Web Development
                    </h3>

                    <p>
                        <abbr title="HyperText Markup Language">
                            HTML
                        </abbr>
                        defines structure.
                    </p>

                    <p>
                        <abbr title="Cascading Style Sheets">
                            CSS
                        </abbr>
                        controls presentation.
                    </p>

                    <p class="mb-0">
                        <abbr title="Application Programming Interface">
                            API
                        </abbr>
                        allows software systems to communicate.
                    </p>

                </div>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;abbr&gt;</code> without providing
                        useful explanatory information when the abbreviation
                        is unfamiliar.
                    </li>

                    <li class="mb-2">
                        Using an incorrect or unclear full form.
                    </li>

                    <li class="mb-2">
                        Assuming every shortened word requires an abbreviation
                        element.
                    </li>

                    <li>
                        Using the element only for visual styling instead of
                        providing meaningful semantic information.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create an abbreviation for HTML.
                    </li>

                    <li class="mb-2">
                        Create an abbreviation for CSS.
                    </li>

                    <li class="mb-2">
                        Create an abbreviation for API.
                    </li>

                    <li class="mb-2">
                        Add the full form using the <code>title</code> attribute.
                    </li>

                    <li>
                        Create one paragraph containing three abbreviations.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>&lt;abbr&gt;</code> element is used to identify
                    abbreviations and acronyms in HTML. The
                    <code>title</code> attribute can provide the expanded form
                    or additional information about the abbreviation.
                    Meaningful use of the element helps give the document
                    clearer semantic structure.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("Quotations", "TextFormatting", new { area = "HTML" })">

                    ← Previous: Quotations

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("SpecialCharacters", "TextFormatting", new { area = "HTML" })">

                    Next: Special Characters →

                </a>

            </div>


        </section>

    </div>

</main>