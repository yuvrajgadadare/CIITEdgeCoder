            &lt;ul&gt;
                &lt;li&gt;C#&lt;/li&gt;
                &lt;li&gt;.NET&lt;/li&gt;
                &lt;li&gt;SQL&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/li&gt;

    &lt;/ul&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

