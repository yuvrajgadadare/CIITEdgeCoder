@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Unordered Lists";
}

<style>
    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .example-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-top: 15px;
        background-color: #f8f9fa;
    }

    .output-box {
        border-left: 4px solid #0d6efd;
        background-color: #f8f9fa;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    .note-box {
        border-left: 4px solid #ffc107;
        background-color: #fff8e1;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    table th,
    table td {
        vertical-align: middle;
    }
</style>

<main id="main" class="container py-5">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <h1 class="display-5 fw-bold mb-3">HTML Unordered Lists</h1>

            <p class="lead">
                Unordered lists are used to display a collection of related items
                where the order of the items is not important.
            </p>

            <hr class="my-4" />

            <h2 class="h3 fw-bold">1. What is an Unordered List?</h2>

            <p>
                An unordered list is created using the <code>&lt;ul&gt;</code> element.
                Each item inside the list is created using the <code>&lt;li&gt;</code>
                element.
            </p>

            <pre><code>&lt;ul&gt;
    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;
&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Output:</strong>

                <ul class="mt-2 mb-0">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">2. The ul Element</h2>

            <p>
                The <code>&lt;ul&gt;</code> element defines the unordered list.
                It acts as the container for all list items.
            </p>

            <pre><code>&lt;ul&gt;

    &lt;li&gt;Item 1&lt;/li&gt;
    &lt;li&gt;Item 2&lt;/li&gt;
    &lt;li&gt;Item 3&lt;/li&gt;

&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">3. The li Element</h2>

            <p>
                The <code>&lt;li&gt;</code> element represents an individual
                item in the list.
            </p>

            <pre><code>&lt;ul&gt;
    &lt;li&gt;Apple&lt;/li&gt;
    &lt;li&gt;Banana&lt;/li&gt;
    &lt;li&gt;Orange&lt;/li&gt;
&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Output:</strong>

                <ul class="mt-2 mb-0">
                    <li>Apple</li>
                    <li>Banana</li>
                    <li>Orange</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">4. Default Bullet Style</h2>

            <p>
                By default, browsers usually display unordered list items
                using a filled circular bullet.
            </p>

            <pre><code>&lt;ul&gt;
    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;
&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Default Result:</strong>

                <ul class="mt-2 mb-0">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">5. Unordered List with Text</h2>

            <p>
                List items can contain normal text.
            </p>

            <pre><code>&lt;ul&gt;
    &lt;li&gt;Learn HTML&lt;/li&gt;
    &lt;li&gt;Learn CSS&lt;/li&gt;
    &lt;li&gt;Learn JavaScript&lt;/li&gt;
&lt;/ul&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">6. Unordered List with Links</h2>

            <p>
                Each list item can contain a hyperlink.
                This is commonly used to create navigation menus.
            </p>

            <pre><code>&lt;ul&gt;

    &lt;li&gt;
        &lt;a href="index.html"&gt;Home&lt;/a&gt;
    &lt;/li&gt;

    &lt;li&gt;
        &lt;a href="courses.html"&gt;Courses&lt;/a&gt;
    &lt;/li&gt;

    &lt;li&gt;
        &lt;a href="contact.html"&gt;Contact&lt;/a&gt;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Example:</strong>

                <ul class="mt-2 mb-0">
                    <li><a href="#">Home</a></li>
                    <li><a href="#">Courses</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">7. Unordered List with Images</h2>

            <p>
                A list item can contain an image along with text.
            </p>

            <pre><code>&lt;ul&gt;

    &lt;li&gt;
        &lt;img src="html.png"
             alt="HTML"
             width="30"&gt;
        HTML
    &lt;/li&gt;

    &lt;li&gt;
        &lt;img src="css.png"
             alt="CSS"
             width="30"&gt;
        CSS
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">8. Change Bullet Style Using CSS</h2>

            <p>
                CSS can be used to change the appearance of unordered list markers.
            </p>

            <pre><code>&lt;ul style="list-style-type: square;"&gt;

    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;

&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">9. Common Bullet Styles</h2>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Style</th>
                        <th>CSS Value</th>
                        <th>Typical Appearance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Disc</td>
                        <td><code>disc</code></td>
                        <td>Filled circle</td>
                    </tr>
                    <tr>
                        <td>Circle</td>
                        <td><code>circle</code></td>
                        <td>Open circle</td>
                    </tr>
                    <tr>
                        <td>Square</td>
                        <td><code>square</code></td>
                        <td>Square marker</td>
                    </tr>
                    <tr>
                        <td>None</td>
                        <td><code>none</code></td>
                        <td>No marker</td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h3 fw-bold mt-5">10. Disc Style</h2>

            <pre><code>&lt;ul style="list-style-type: disc;"&gt;
    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;
&lt;/ul&gt;</code></pre>

