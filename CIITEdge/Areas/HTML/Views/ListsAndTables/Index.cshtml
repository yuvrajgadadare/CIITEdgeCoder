@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Lists and Tables";
}

<style>
    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .example-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-top: 15px;
        background-color: #f8f9fa;
    }

    .output-box {
        border-left: 4px solid #0d6efd;
        background-color: #f8f9fa;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    .note-box {
        border-left: 4px solid #ffc107;
        background-color: #fff8e1;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    table th,
    table td {
        vertical-align: middle;
    }
</style>

<main id="main" class="container py-5">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <h1 class="display-5 fw-bold mb-3">HTML Lists and Tables</h1>

            <p class="lead">
                HTML lists are used to organize related items, while HTML tables
                are used to present structured data in rows and columns.
            </p>

            <hr class="my-4" />

            <h2 class="h3 fw-bold">1. Introduction to HTML Lists</h2>

            <p>
                Lists are useful when multiple related items need to be displayed
                in an organized format.
            </p>

            <p>
                HTML provides three main types of lists:
            </p>

            <ul>
                <li>Unordered Lists</li>
                <li>Ordered Lists</li>
                <li>Description Lists</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">2. Unordered List</h2>

            <p>
                An unordered list displays items using bullets.
                It is created using the <code>&lt;ul&gt;</code> element
                with <code>&lt;li&gt;</code> list items.
            </p>

            <pre><code>&lt;ul&gt;
    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;
&lt;/ul&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Output:</strong>
                <ul class="mt-2 mb-0">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">3. Ordered List</h2>

            <p>
                An ordered list displays items in a numbered sequence.
                It is created using the <code>&lt;ol&gt;</code> element.
            </p>

            <pre><code>&lt;ol&gt;
    &lt;li&gt;HTML&lt;/li&gt;
    &lt;li&gt;CSS&lt;/li&gt;
    &lt;li&gt;JavaScript&lt;/li&gt;
&lt;/ol&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <strong>Output:</strong>
                <ol class="mt-2 mb-0">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ol>
            </div>

            <h2 class="h3 fw-bold mt-5">4. Description List</h2>

            <p>
                A description list is used for terms and their descriptions.
                It uses <code>&lt;dl&gt;</code>, <code>&lt;dt&gt;</code>,
                and <code>&lt;dd&gt;</code>.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;HyperText Markup Language&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Cascading Style Sheets&lt;/dd&gt;

&lt;/dl&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">5. Nested Lists</h2>

            <p>
                A list can contain another list inside one of its list items.
                This is called a nested list.
            </p>

            <pre><code>&lt;ul&gt;

    &lt;li&gt;
        Frontend
        &lt;ul&gt;
            &lt;li&gt;HTML&lt;/li&gt;
            &lt;li&gt;CSS&lt;/li&gt;
            &lt;li&gt;JavaScript&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;

    &lt;li&gt;
        Backend
        &lt;ul&gt;
            &lt;li&gt;C#&lt;/li&gt;
            &lt;li&gt;.NET&lt;/li&gt;
            &lt;li&gt;SQL&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;

&lt;/ul&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">6. Introduction to HTML Tables</h2>

            <p>
                HTML tables are used to display structured data in rows and columns.
            </p>

            <p>
                A basic table uses:
            </p>

            <ul>
                <li><code>&lt;table&gt;</code> for the table.</li>
                <li><code>&lt;tr&gt;</code> for a table row.</li>
                <li><code>&lt;th&gt;</code> for a header cell.</li>
                <li><code>&lt;td&gt;</code> for a data cell.</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">7. Basic HTML Table</h2>

            <pre><code>&lt;table&gt;

    &lt;tr&gt;
        &lt;th&gt;Name&lt;/th&gt;
        &lt;th&gt;Course&lt;/th&gt;
        &lt;th&gt;Duration&lt;/th&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;Samadhan&lt;/td&gt;
        &lt;td&gt;HTML&lt;/td&gt;
        &lt;td&gt;2 Months&lt;/td&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;Pradnya&lt;/td&gt;
        &lt;td&gt;CSS&lt;/td&gt;
        &lt;td&gt;2 Months&lt;/td&gt;
    &lt;/tr&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>


                <table class="table table-bordered mt-3 mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Course</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Samadhan</td>
                            <td>HTML</td>
                            <td>2 Months</td>
                        </tr>
                        <tr>
                            <td>Pradnya</td>
                            <td>CSS</td>
                            <td>2 Months</td>
                        </tr>
                    </tbody>
                </table>

            <h2 class="h3 fw-bold mt-5">8. Table Rows</h2>

            <p>
                The <code>&lt;tr&gt;</code> element creates a table row.
            </p>

            <pre><code>&lt;tr&gt;
    &lt;td&gt;Sam&lt;/td&gt;
    &lt;td&gt;21&lt;/td&gt;
&lt;/tr&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">9. Table Headers</h2>

            <p>
                The <code>&lt;th&gt;</code> element creates a header cell.
                Header cells usually identify the data in each column.
            </p>

            <pre><code>&lt;tr&gt;
    &lt;th&gt;Student Name&lt;/th&gt;
    &lt;th&gt;Course&lt;/th&gt;
    &lt;th&gt;Marks&lt;/th&gt;
&lt;/tr&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">10. Table Data Cells</h2>

            <p>
                The <code>&lt;td&gt;</code> element is used for normal table data.
            </p>

            <pre><code>&lt;tr&gt;
    &lt;td&gt;John&lt;/td&gt;
    &lt;td&gt;HTML&lt;/td&gt;
    &lt;td&gt;85&lt;/td&gt;
&lt;/tr&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">11. Table Border</h2>

            <p>
                CSS is commonly used to add borders to tables and their cells.
            </p>

            <pre><code>&lt;style&gt;
    table,
    th,
    td {
        border: 1px solid black;
        border-collapse: collapse;
    }
&lt;/style&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">12. Table Caption</h2>

            <p>
                The <code>&lt;caption&gt;</code> element provides a title
                or description for a table.
            </p>

            <pre><code>&lt;table&gt;

    &lt;caption&gt;Student Details&lt;/caption&gt;

    &lt;tr&gt;
        &lt;th&gt;Name&lt;/th&gt;
        &lt;th&gt;Course&lt;/th&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;John&lt;/td&gt;
        &lt;td&gt;HTML&lt;/td&gt;
    &lt;/tr&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">13. thead, tbody and tfoot</h2>

            <p>
                Larger tables can be structured using
                <code>&lt;thead&gt;</code>, <code>&lt;tbody&gt;</code>,
                and <code>&lt;tfoot&gt;</code>.
            </p>

            <pre><code>&lt;table&gt;

    &lt;thead&gt;
        &lt;tr&gt;
            &lt;th&gt;Product&lt;/th&gt;
            &lt;th&gt;Price&lt;/th&gt;
        &lt;/tr&gt;
    &lt;/thead&gt;

    &lt;tbody&gt;
        &lt;tr&gt;
            &lt;td&gt;Laptop&lt;/td&gt;
            &lt;td&gt;50000&lt;/td&gt;
        &lt;/tr&gt;

        &lt;tr&gt;
            &lt;td&gt;Mouse&lt;/td&gt;
            &lt;td&gt;1000&lt;/td&gt;
        &lt;/tr&gt;
    &lt;/tbody&gt;

    &lt;tfoot&gt;
        &lt;tr&gt;
            &lt;td&gt;Total&lt;/td&gt;
            &lt;td&gt;51000&lt;/td&gt;
        &lt;/tr&gt;
    &lt;/tfoot&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">14. Colspan</h2>

            <p>
                The <code>colspan</code> attribute allows a cell to span
                across multiple columns.
            </p>

            <pre><code>&lt;table&gt;

    &lt;tr&gt;
        &lt;th colspan="2"&gt;
            Student Information
        &lt;/th&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;John&lt;/td&gt;
        &lt;td&gt;HTML&lt;/td&gt;
    &lt;/tr&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">15. Rowspan</h2>

            <p>
                The <code>rowspan</code> attribute allows a cell to span
                across multiple rows.
            </p>

            <pre><code>&lt;table&gt;

    &lt;tr&gt;
        &lt;th rowspan="2"&gt;Course&lt;/th&gt;
        &lt;td&gt;HTML&lt;/td&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;CSS&lt;/td&gt;
    &lt;/tr&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">16. Styling HTML Tables with CSS</h2>

            <pre><code>&lt;style&gt;

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th,
    td {
        border: 1px solid #000;
        padding: 10px;
        text-align: left;
    }

    th {
        background-color: #f2f2f2;
    }

&lt;/style&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">17. Difference Between Lists and Tables</h2>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Lists</th>
                        <th>Tables</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Used for related items.</td>
                        <td>Used for structured data.</td>
                    </tr>
                    <tr>
                        <td>Displayed vertically or hierarchically.</td>
                        <td>Displayed in rows and columns.</td>
                    </tr>
                    <tr>
                        <td>Uses elements such as <code>&lt;ul&gt;</code> and <code>&lt;ol&gt;</code>.</td>
                        <td>Uses elements such as <code>&lt;table&gt;</code>, <code>&lt;tr&gt;</code>, and <code>&lt;td&gt;</code>.</td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h3 fw-bold mt-5">18. Common Uses of Lists</h2>

            <div class="example-box">
                <ul class="mb-0">
                    <li>Navigation menus</li>
                    <li>Course topics</li>
                    <li>Product features</li>
                    <li>Steps in a process</li>
                    <li>Shopping lists</li>
                    <li>Categories</li>
                    <li>Requirements</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">19. Common Uses of Tables</h2>

            <div class="example-box">
                <ul class="mb-0">
                    <li>Student records</li>
                    <li>Product prices</li>
                    <li>Employee details</li>
                    <li>Course schedules</li>
                    <li>Financial data</li>
                    <li>Reports</li>
                    <li>Comparison data</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">20. Complete Lists Example</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;

&lt;head&gt;
    &lt;title&gt;HTML Lists&lt;/title&gt;
&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Programming Courses&lt;/h1&gt;

    &lt;h2&gt;Unordered List&lt;/h2&gt;

    &lt;ul&gt;
        &lt;li&gt;HTML&lt;/li&gt;
        &lt;li&gt;CSS&lt;/li&gt;
        &lt;li&gt;JavaScript&lt;/li&gt;
    &lt;/ul&gt;

    &lt;h2&gt;Ordered List&lt;/h2&gt;

    &lt;ol&gt;
        &lt;li&gt;Learn HTML&lt;/li&gt;
        &lt;li&gt;Learn CSS&lt;/li&gt;
        &lt;li&gt;Learn JavaScript&lt;/li&gt;
    &lt;/ol&gt;

    &lt;h2&gt;Description List&lt;/h2&gt;

    &lt;dl&gt;
        &lt;dt&gt;HTML&lt;/dt&gt;
        &lt;dd&gt;Structure of a webpage&lt;/dd&gt;

        &lt;dt&gt;CSS&lt;/dt&gt;
        &lt;dd&gt;Styling of a webpage&lt;/dd&gt;
    &lt;/dl&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">21. Complete Table Example</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;Student Table&lt;/title&gt;

    &lt;style&gt;

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid black;
            padding: 10px;
        }

        th {
            background-color: #f2f2f2;
        }

    &lt;/style&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Student Details&lt;/h1&gt;

    &lt;table&gt;

        &lt;caption&gt;Student Information&lt;/caption&gt;

        &lt;thead&gt;
            &lt;tr&gt;
                &lt;th&gt;Name&lt;/th&gt;
                &lt;th&gt;Course&lt;/th&gt;
                &lt;th&gt;Marks&lt;/th&gt;
            &lt;/tr&gt;
        &lt;/thead&gt;

        &lt;tbody&gt;

            &lt;tr&gt;
                &lt;td&gt;John&lt;/td&gt;
                &lt;td&gt;HTML&lt;/td&gt;
                &lt;td&gt;85&lt;/td&gt;
            &lt;/tr&gt;

            &lt;tr&gt;
                &lt;td&gt;David&lt;/td&gt;
                &lt;td&gt;CSS&lt;/td&gt;
                &lt;td&gt;90&lt;/td&gt;
            &lt;/tr&gt;

        &lt;/tbody&gt;

        &lt;tfoot&gt;
            &lt;tr&gt;
                &lt;td colspan="2"&gt;Average&lt;/td&gt;
                &lt;td&gt;87.5&lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tfoot&gt;

    &lt;/table&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">22. Best Practices</h2>

            <ul>
                <li>Use lists for lists of related items.</li>
                <li>Use tables for actual tabular data.</li>
                <li>Use meaningful table headers.</li>
                <li>Use <code>&lt;thead&gt;</code>, <code>&lt;tbody&gt;</code>, and <code>&lt;tfoot&gt;</code> for structured tables.</li>
                <li>Use CSS to style tables instead of relying on outdated HTML presentation attributes.</li>
                <li>Keep tables readable on smaller screens.</li>
                <li>Do not use tables for general webpage layout.</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">23. Common Mistakes</h2>

            <ul>
                <li>Using tables for page layout instead of tabular data.</li>
                <li>Forgetting to close list or table elements.</li>
                <li>Mixing table cells incorrectly between rows.</li>
                <li>Using <code>colspan</code> or <code>rowspan</code> incorrectly.</li>
                <li>Using unclear table headers.</li>
                <li>Creating tables that are difficult to read on small screens.</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">24. Practice Task</h2>

            <div class="example-box">
                <p><strong>Create an HTML page containing:</strong></p>

                <ol>
                    <li>An unordered list of programming languages.</li>
                    <li>An ordered list of learning steps.</li>
                    <li>A description list of HTML terms.</li>
                    <li>A nested list of frontend and backend technologies.</li>
                    <li>A student details table.</li>
                    <li>A table with headers.</li>
                    <li>A table using <code>colspan</code>.</li>
                    <li>A table using <code>rowspan</code>.</li>
                    <li>A table with <code>thead</code>, <code>tbody</code>, and <code>tfoot</code>.</li>
                </ol>
            </div>

            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>

                <p class="mb-0">
                    HTML lists organize related items using unordered, ordered,
                    and description lists. HTML tables organize structured data
                    into rows and columns using elements such as
                    <code>&lt;table&gt;</code>, <code>&lt;tr&gt;</code>,
                    <code>&lt;th&gt;</code>, and <code>&lt;td&gt;</code>.
                    Advanced table structures can use <code>thead</code>,
                    <code>tbody</code>, <code>tfoot</code>, <code>colspan</code>,
                    and <code>rowspan</code>.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("Iframes", "LinksAndMedia", new { area = "HTML" })">
                    ← Previous: Iframes
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("UnorderedLists", "ListsAndTables", new { area = "HTML" })">
                    Next: Unordered Lists →
                </a>

            </div>

        </div>
    </div>
</main>