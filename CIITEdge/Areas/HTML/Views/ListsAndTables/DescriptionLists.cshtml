@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Description Lists";
}

<style>
    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .example-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-top: 15px;
        background-color: #f8f9fa;
    }

    .output-box {
        border-left: 4px solid #0d6efd;
        background-color: #f8f9fa;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    .note-box {
        border-left: 4px solid #ffc107;
        background-color: #fff8e1;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    table th,
    table td {
        vertical-align: middle;
    }

    dt {
        font-weight: 700;
        margin-top: 12px;
    }

    dd {
        margin-left: 25px;
        margin-bottom: 10px;
    }
</style>

<main id="main" class="container py-5">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <h1 class="display-5 fw-bold mb-3">HTML Description Lists</h1>

            <p class="lead">
                Description lists are used to display terms together with their
                descriptions, definitions, or related information.
            </p>

            <hr class="my-4" />

            <h2 class="h3 fw-bold">1. What is a Description List?</h2>

            <p>
                A description list is a specialized HTML list used when each
                item has a term and a corresponding description.
            </p>

            <p>
                A description list uses three main HTML elements:
            </p>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Element</th>
                        <th>Purpose</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>&lt;dl&gt;</code></td>
                        <td>Defines the description list.</td>
                    </tr>
                    <tr>
                        <td><code>&lt;dt&gt;</code></td>
                        <td>Defines a term or name.</td>
                    </tr>
                    <tr>
                        <td><code>&lt;dd&gt;</code></td>
                        <td>Defines the description or value for the term.</td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h3 fw-bold mt-5">2. Basic Syntax</h2>

            <p>
                The basic structure of a description list is:
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;HyperText Markup Language&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Cascading Style Sheets&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">

                <dl class="mt-3 mb-0">
                    <dt>HTML</dt>
                    <dd>HyperText Markup Language</dd>

                    <dt>CSS</dt>
                    <dd>Cascading Style Sheets</dd>
                </dl>
            </div>

            <h2 class="h3 fw-bold mt-5">3. The dl Element</h2>

            <p>
                The <code>&lt;dl&gt;</code> element acts as the container
                for the complete description list.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;Term 1&lt;/dt&gt;
    &lt;dd&gt;Description of Term 1&lt;/dd&gt;

    &lt;dt&gt;Term 2&lt;/dt&gt;
    &lt;dd&gt;Description of Term 2&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">4. The dt Element</h2>

            <p>
                The <code>&lt;dt&gt;</code> element represents the term,
                name, or item being described.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;JavaScript&lt;/dt&gt;
    &lt;dd&gt;A programming language used for web development.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">5. The dd Element</h2>

            <p>
                The <code>&lt;dd&gt;</code> element provides the description,
                explanation, or value associated with a term.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;Used to structure web pages.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">6. Multiple Terms</h2>

            <p>
                Multiple <code>&lt;dt&gt;</code> elements can share the same
                description.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dt&gt;HyperText Markup Language&lt;/dt&gt;

    &lt;dd&gt;
        A markup language used to structure web content.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                <dl class="mt-3 mb-0">
                    <dt>HTML</dt>
                    <dt>HyperText Markup Language</dt>
                    <dd>A markup language used to structure web content.</dd>
                </dl>
            </div>

            <h2 class="h3 fw-bold mt-5">7. Multiple Descriptions</h2>

            <p>
                A single term can have more than one description.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;

    &lt;dd&gt;
        HyperText Markup Language.
    &lt;/dd&gt;

    &lt;dd&gt;
        Used to structure content on webpages.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">

                <dl class="mt-3 mb-0">
                    <dt>HTML</dt>
                    <dd>HyperText Markup Language.</dd>
                    <dd>Used to structure content on webpages.</dd>
                </dl>
            </div>

            <h2 class="h3 fw-bold mt-5">8. Multiple Terms and Descriptions</h2>

            <p>
                A description list can contain multiple terms and multiple
                descriptions.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;Structures web content.&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Styles web content.&lt;/dd&gt;

    &lt;dt&gt;JavaScript&lt;/dt&gt;
    &lt;dd&gt;Adds behavior and interactivity.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">9. Description List for Programming Terms</h2>

            <pre><code>&lt;h2&gt;Web Technologies&lt;/h2&gt;

&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;Defines the structure of webpages.&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Controls presentation and visual styling.&lt;/dd&gt;

    &lt;dt&gt;JavaScript&lt;/dt&gt;
    &lt;dd&gt;Adds logic and interactivity to webpages.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                <h5 class="fw-bold">Web Technologies</h5>

                <dl class="mb-0">
                    <dt>HTML</dt>
                    <dd>Defines the structure of webpages.</dd>

                    <dt>CSS</dt>
                    <dd>Controls presentation and visual styling.</dd>

                    <dt>JavaScript</dt>
                    <dd>Adds logic and interactivity to webpages.</dd>
                </dl>
            </div>

            <h2 class="h3 fw-bold mt-5">10. Description List for a Glossary</h2>

            <p>
                Description lists are useful for creating glossaries of technical terms.
            </p>

            <pre><code>&lt;h2&gt;HTML Glossary&lt;/h2&gt;

&lt;dl&gt;

    &lt;dt&gt;Element&lt;/dt&gt;
    &lt;dd&gt;A complete HTML building block.&lt;/dd&gt;

    &lt;dt&gt;Attribute&lt;/dt&gt;
    &lt;dd&gt;Provides additional information about an element.&lt;/dd&gt;

    &lt;dt&gt;Tag&lt;/dt&gt;
    &lt;dd&gt;Markup syntax used to define an HTML element.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">11. Description List for FAQs</h2>

            <p>
                A description list can also represent question-and-answer style content.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;What is HTML?&lt;/dt&gt;
    &lt;dd&gt;
        HTML is the markup language used to structure web content.
    &lt;/dd&gt;

    &lt;dt&gt;What is CSS?&lt;/dt&gt;
    &lt;dd&gt;
        CSS is used to style HTML content.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">12. Description List for Product Information</h2>

            <p>
                Description lists can display product specifications
                and property-value information.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;Product&lt;/dt&gt;
    &lt;dd&gt;Laptop&lt;/dd&gt;

    &lt;dt&gt;Processor&lt;/dt&gt;
    &lt;dd&gt;Intel Core i7&lt;/dd&gt;

    &lt;dt&gt;Memory&lt;/dt&gt;
    &lt;dd&gt;16 GB&lt;/dd&gt;

    &lt;dt&gt;Storage&lt;/dt&gt;
    &lt;dd&gt;512 GB SSD&lt;/dd&gt;

&lt;/dl&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                <dl class="mt-3 mb-0">
                    <dt>Product</dt>
                    <dd>Laptop</dd>

                    <dt>Processor</dt>
                    <dd>Intel Core i7</dd>

                    <dt>Memory</dt>
                    <dd>16 GB</dd>

                    <dt>Storage</dt>
                    <dd>512 GB SSD</dd>
                </dl>
            </div>

            <h2 class="h3 fw-bold mt-5">13. Description List with Links</h2>

            <p>
                Terms or descriptions can contain hyperlinks.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;
        &lt;a href="html.html"&gt;HTML&lt;/a&gt;
    &lt;/dt&gt;

    &lt;dd&gt;
        HyperText Markup Language used to structure web content.
    &lt;/dd&gt;

    &lt;dt&gt;
        &lt;a href="css.html"&gt;CSS&lt;/a&gt;
    &lt;/dt&gt;

    &lt;dd&gt;
        Cascading Style Sheets used to style web content.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">14. Description List with Emphasis</h2>

            <p>
                Normal inline HTML elements can be used inside
                <code>&lt;dt&gt;</code> and <code>&lt;dd&gt;</code>.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;
        &lt;strong&gt;HTML&lt;/strong&gt;
    &lt;/dt&gt;

    &lt;dd&gt;
        A &lt;em&gt;markup language&lt;/em&gt; for structuring web pages.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">15. Description List with Code</h2>

            <p>
                Technical documentation can use code elements inside
                description lists.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;
        &lt;code&gt;&amp;lt;p&amp;gt;&lt;/code&gt;
    &lt;/dt&gt;

    &lt;dd&gt;
        Defines a paragraph.
    &lt;/dd&gt;

    &lt;dt&gt;
        &lt;code&gt;&amp;lt;h1&amp;gt;&lt;/code&gt;
    &lt;/dt&gt;

    &lt;dd&gt;
        Defines a level-one heading.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">16. Styling Description Lists</h2>

            <p>
                CSS can be used to control spacing, typography, colors,
                borders, and layout.
            </p>

            <pre><code>&lt;style&gt;

    .glossary dt {
        font-weight: bold;
        margin-top: 15px;
    }

    .glossary dd {
        margin-left: 25px;
        margin-bottom: 10px;
    }

&lt;/style&gt;

&lt;dl class="glossary"&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;HyperText Markup Language&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Cascading Style Sheets&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">17. Description List with Background Styling</h2>

            <pre><code>&lt;style&gt;

    .technology-list {
        background-color: #f8f9fa;
        padding: 20px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    .technology-list dt {
        font-weight: bold;
    }

    .technology-list dd {
        margin-left: 20px;
        margin-bottom: 15px;
    }

&lt;/style&gt;

&lt;dl class="technology-list"&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dd&gt;Webpage structure.&lt;/dd&gt;

    &lt;dt&gt;CSS&lt;/dt&gt;
    &lt;dd&gt;Webpage styling.&lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">18. Description List with Nested Content</h2>

            <p>
                A description can contain more complex content, including lists.
            </p>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;Frontend Development&lt;/dt&gt;

    &lt;dd&gt;

        &lt;p&gt;
            Technologies used to build the user interface:
        &lt;/p&gt;

        &lt;ul&gt;
            &lt;li&gt;HTML&lt;/li&gt;
            &lt;li&gt;CSS&lt;/li&gt;
            &lt;li&gt;JavaScript&lt;/li&gt;
        &lt;/ul&gt;

    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">19. Description List with Multiple Terms</h2>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;
    &lt;dt&gt;HyperText Markup Language&lt;/dt&gt;

    &lt;dd&gt;
        A markup language used to structure webpages.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">20. Description List with Multiple Descriptions</h2>

            <pre><code>&lt;dl&gt;

    &lt;dt&gt;HTML&lt;/dt&gt;

    &lt;dd&gt;
        HyperText Markup Language.
    &lt;/dd&gt;

    &lt;dd&gt;
        Used for creating the structure of web pages.
    &lt;/dd&gt;

&lt;/dl&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">21. Description List vs Other Lists</h2>

            <table class="table table-bordered table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>List Type</th>
                        <th>Element</th>
                        <th>Typical Use</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Unordered List</td>
                        <td><code>&lt;ul&gt;</code></td>
                        <td>Related items where order is not important.</td>
                    </tr>
                    <tr>
                        <td>Ordered List</td>
                        <td><code>&lt;ol&gt;</code></td>
                        <td>Items where sequence is important.</td>
                    </tr>
                    <tr>
                        <td>Description List</td>
                        <td><code>&lt;dl&gt;</code></td>
                        <td>Terms and their descriptions.</td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h3 fw-bold mt-5">22. Practical Uses of Description Lists</h2>

            <div class="example-box">
                <ul class="mb-0">
                    <li>Glossaries</li>
                    <li>Technical documentation</li>
                    <li>Frequently asked questions</li>
                    <li>Product specifications</li>
                    <li>Metadata and properties</li>
                    <li>Definitions</li>
                    <li>Key-value information</li>
                </ul>
            </div>

            <h2 class="h3 fw-bold mt-5">23. Accessibility Considerations</h2>

            <p>
                Description lists have semantic meaning, so they should be used
                when the content actually represents terms and their descriptions.
            </p>

            <ul>
                <li>Use meaningful terms inside <code>&lt;dt&gt;</code>.</li>
                <li>Place the corresponding information inside <code>&lt;dd&gt;</code>.</li>
                <li>Keep the relationship between terms and descriptions clear.</li>
                <li>Do not use description lists only for visual indentation.</li>
                <li>Use appropriate headings when the list is part of a larger section.</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">24. Common Mistakes</h2>

            <ul>
                <li>Using <code>&lt;dl&gt;</code> as a general-purpose unordered list.</li>
                <li>Using <code>&lt;dt&gt;</code> without a meaningful term.</li>
                <li>Using <code>&lt;dd&gt;</code> without a related description.</li>
                <li>Using description lists only for layout or spacing.</li>
                <li>Creating confusing relationships between terms and descriptions.</li>
            </ul>

            <h2 class="h3 fw-bold mt-5">25. Complete Glossary Example</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;HTML Glossary&lt;/title&gt;

    &lt;style&gt;

        .glossary {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }

        .glossary dt {
            font-weight: bold;
            margin-top: 15px;
        }

        .glossary dd {
            margin-left: 25px;
            margin-bottom: 12px;
        }

    &lt;/style&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Web Development Glossary&lt;/h1&gt;

    &lt;dl class="glossary"&gt;

        &lt;dt&gt;HTML&lt;/dt&gt;
        &lt;dd&gt;
            HyperText Markup Language used to structure webpages.
        &lt;/dd&gt;

        &lt;dt&gt;CSS&lt;/dt&gt;
        &lt;dd&gt;
            Cascading Style Sheets used to style webpages.
        &lt;/dd&gt;

        &lt;dt&gt;JavaScript&lt;/dt&gt;
        &lt;dd&gt;
            A programming language used to add interactivity.
        &lt;/dd&gt;

        &lt;dt&gt;Browser&lt;/dt&gt;
        &lt;dd&gt;
            Software used to access and display web content.
        &lt;/dd&gt;

    &lt;/dl&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">26. Practice Task</h2>

            <div class="example-box">
                <p><strong>Create an HTML page containing:</strong></p>

                <ol>
                    <li>A description list of HTML terms.</li>
                    <li>A description list of CSS terms.</li>
                    <li>A product specification description list.</li>
                    <li>A FAQ-style description list.</li>
                    <li>A description list with multiple descriptions.</li>
                    <li>A description list containing a nested unordered list.</li>
                    <li>A styled description list using CSS.</li>
                </ol>
            </div>

            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>

                <p class="mb-0">
                    Description lists are created using the
                    <code>&lt;dl&gt;</code> element with
                    <code>&lt;dt&gt;</code> for terms and
                    <code>&lt;dd&gt;</code> for descriptions. They are useful for
                    glossaries, technical documentation, FAQs, product
                    specifications, definitions, and other term-description
                    relationships. A term can have multiple descriptions, and
                    multiple terms can share a description.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("OrderedLists", "ListsAndTables", new { area = "HTML" })">
                    ← Previous: Ordered Lists
                </a>

                <a class="btn btn-primary"
