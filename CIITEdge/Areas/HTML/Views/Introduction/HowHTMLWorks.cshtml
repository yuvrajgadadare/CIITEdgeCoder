@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "How HTML Works";
}

<style>

    #html-how-it-works-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-how-it-works-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-how-it-works-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-how-it-works-page .diagram-box {
        background: #ffffff;
        border: 2px solid #6f42c1;
        border-radius: 10px;
        padding: 18px;
        text-align: center;
        height: 100%;
    }

        #html-how-it-works-page .diagram-box h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 8px;
        }

        #html-how-it-works-page .diagram-box p {
            margin-bottom: 0;
            font-size: 14px;
            color: #495057;
        }

    #html-how-it-works-page .diagram-arrow {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #6f42c1;
        padding: 8px 0;
    }

    #html-how-it-works-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #html-how-it-works-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-how-it-works-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

</style>


<main id="html-how-it-works-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    How HTML Works
                </h1>

                <p class="lead">
                    Understand how an HTML document is read by a web browser
                    and converted into a visible web page.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    How Does HTML Work?
                </h2>

                <p>
                    HTML works by providing a structured document that a web
                    browser can read and interpret.
                </p>

                <p>
                    When you open an HTML file in a browser, the browser reads
                    the HTML elements and uses them to build the structure of
                    the page that the user sees.
                </p>

                <div class="alert alert-info">

                    <strong>Simple Flow:</strong>

                    HTML Document → Browser → Document Structure → Rendered Web Page

                </div>

            </div>


            <!-- BASIC FLOW -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Working Flow
                </h2>

                <div class="concept-box">

                    <div class="diagram-box">

                        <h5>
                            1. HTML Document
                        </h5>

                        <p>
                            Contains HTML elements, tags, attributes, and content.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            2. Web Browser
                        </h5>

                        <p>
                            Reads and interprets the HTML document.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            3. Document Structure
                        </h5>

                        <p>
                            The browser builds the structure represented by
                            the HTML elements.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            4. Rendered Web Page
                        </h5>

                        <p>
                            The final page is displayed to the user.
                        </p>

                    </div>

                </div>

            </div>


            <!-- HTML FILE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 1: Create an HTML File
                </h2>

                <p>
                    HTML code is normally written inside a file using the
                    <code>.html</code> extension.
                </p>

                <pre><code>index.html</code></pre>

                <p>
                    The HTML file contains the structure and content of the
                    web page.
                </p>

            </div>


            <!-- WRITE HTML -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 2: Write HTML Code
                </h2>

                <p>
                    Developers write HTML elements to define the structure
                    of the web page.
                </p>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;My First Page&lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Welcome to CIIT Institute ❤️📩..!&lt;/h1&gt;

    &lt;p&gt;Learn HTML step-by-step.&lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>
            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <!-- OPEN IN BROWSER -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 3: Open the HTML File
                </h2>

                <p>
                    The HTML file can be opened in a modern web browser such
                    as Google Chrome, Microsoft Edge, Mozilla Firefox,
                    or Safari.
                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Local HTML File
                            </h5>

                            <p class="mb-0">
                                An HTML file can be opened directly from the
                                computer using a web browser.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Web Server
                            </h5>

                            <p class="mb-0">
                                HTML files can also be served through a web
                                server and accessed using a web address.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- BROWSER READS HTML -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 4: Browser Reads HTML
                </h2>

                <p>
                    The browser reads the HTML source code and identifies
                    the different elements present in the document.
                </p>

                <pre><code>&lt;h1&gt;Hello World&lt;/h1&gt;

&lt;p&gt;Welcome to HTML.&lt;/p&gt;</code></pre>

                <p>
                    The browser recognizes the
                    <code>&lt;h1&gt;</code> as a heading and
                    <code>&lt;p&gt;</code> as a paragraph.
                </p>

            </div>


            <!-- BROWSER BUILDS STRUCTURE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 5: Browser Builds the Page Structure
                </h2>

                <p>
                    The browser processes the HTML elements and builds an
                    internal representation of the document.
                </p>

                <div class="concept-box">

                    <div class="alert alert-primary mb-3">

                        <strong>
                            HTML Document
                        </strong>

                        <div class="mt-2">
                            &lt;html&gt;
                        </div>

                    </div>


                    <div class="alert alert-secondary mb-3">

                        <strong>
                            Head Section
                        </strong>

                        <div class="mt-2">
                            &lt;head&gt; ... &lt;/head&gt;
                        </div>

                    </div>


                    <div class="alert alert-success mb-0">

                        <strong>
                            Body Section
                        </strong>

                        <div class="mt-2">
                            &lt;body&gt; ... &lt;/body&gt;
                        </div>

                    </div>

                </div>

            </div>


            <!-- RENDERED PAGE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Step 6: Browser Renders the Web Page
                </h2>

                <p>
                    After processing the HTML, the browser renders the
                    document as a visible web page.
                </p>

                <div class="example-box">

                    <h2 class="mb-3">
                        Hello World
                    </h2>

                    <p class="mb-0">
                        Welcome to HTML.
                    </p>

                </div>

            </div>


            <!-- SIMPLE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Simple Example
                </h2>

                <pre><code>&lt;h1&gt;CIIT Institute&lt;/h1&gt;

&lt;p&gt;Learn Web Development.&lt;/p&gt;

&lt;a href="#"&gt;Learn More&lt;/a&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <h3 class="h5 fw-bold mt-4">
                    Browser Result
                </h3>

                <div class="example-box">

                    <h2>
                        CIIT Institute
                    </h2>

                    <p>
                        Learn Web Development.
                    </p>

                    <a href="#">
                        Learn More
                    </a>

                </div>

            </div>


            <!-- HTML ELEMENTS WORKING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    How HTML Elements Are Processed
                </h2>

                <div class="row g-3">


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Tag
                            </h5>

                            <p class="mb-0">
                                The browser identifies the HTML tag and
                                understands what type of element it represents.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Content
                            </h5>

                            <p class="mb-0">
                                The browser reads the content contained inside
                                the element.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Structure
                            </h5>

                            <p class="mb-0">
                                The browser places the element into the
                                structure of the web page.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HTML WITH CSS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML and CSS Working Together
                </h2>

                <p>
                    HTML defines the structure of the page, while CSS can be
                    used to control how that structure looks.
                </p>

                <pre><code>&lt;h1&gt;Welcome&lt;/h1&gt;

&lt;style&gt;

    h1 {
        color: blue;
    }

&lt;/style&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <div class="example-box">

                    <h2 style="color: blue;">
                        Welcome
                    </h2>

                </div>

            </div>


            <!-- HTML WITH JAVASCRIPT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML and JavaScript Working Together
                </h2>

                <p>
                    JavaScript can interact with HTML elements and add
                    behavior or interaction to the page.
                </p>

                <pre><code>&lt;button id="btn"&gt;
    Click Me
&lt;/button&gt;

&lt;script&gt;

    document.getElementById("btn")
        .addEventListener("click", function () {

            alert("Button Clicked!");

        });

&lt;/script&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <p style="margin-top: 0;">
    In this example, HTML creates the button and JavaScript adds the click behavior.
</p>
            </div>


            <!-- IMPORTANT POINTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Important Points
                </h2>

                <ul>

                    <li class="mb-2">
                        HTML files normally use the <code>.html</code> extension.
                    </li>

                    <li class="mb-2">
                        A browser reads and interprets HTML documents.
                    </li>

                    <li class="mb-2">
                        HTML elements define the structure of the page.
                    </li>

                    <li class="mb-2">
                        CSS can be used to style HTML content.
                    </li>

                    <li>
                        JavaScript can add interaction and dynamic behavior.
                    </li>

                </ul>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a file named <code>index.html</code>.
                    </li>

                    <li class="mb-2">
                        Add one heading.
                    </li>

                    <li class="mb-2">
                        Add one paragraph.
                    </li>

                    <li class="mb-2">
                        Open the file in a browser.
                    </li>

                    <li class="mb-2">
                        Change the heading text and refresh the browser.
                    </li>

                    <li>
                        Observe how the browser displays the updated content.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML works by providing structured content inside an HTML
                    document. A web browser reads the HTML elements, processes
                    their structure, and renders the result as a visible web page.
                    HTML provides structure, while CSS can provide styling and
                    JavaScript can provide interaction and behavior.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("HTMLDocumentStructure", "Introduction", new { area = "HTML" })">

                    ← Previous: HTML Document Structure

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("HTMLvsCSSvsJavaScript", "Introduction", new { area = "HTML" })">

                    Next: HTML vs CSS vs JavaScript →

                </a>

            </div>


        </section>

    </div>

</main>