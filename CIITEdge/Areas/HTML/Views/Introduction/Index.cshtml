@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "Introduction to HTML";
}

<style>

    /* =========================================================
           HTML INTRODUCTION PAGE
           ========================================================= */

    #html-introduction-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-introduction-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }


    /* =========================================================
           CONCEPT BOX
           ========================================================= */

    #html-introduction-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }


    /* =========================================================
           DIAGRAM BOX
           ========================================================= */

    #html-introduction-page .diagram-box {
        background: #ffffff;
        border: 2px solid #6f42c1;
        border-radius: 10px;
        padding: 18px;
        text-align: center;
        height: 100%;
    }

        #html-introduction-page .diagram-box h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 8px;
        }

        #html-introduction-page .diagram-box p {
            margin-bottom: 0;
            font-size: 14px;
            color: #495057;
        }


    /* =========================================================
           DIAGRAM ARROW
           ========================================================= */

    #html-introduction-page .diagram-arrow {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #6f42c1;
        padding: 8px 0;
    }


    /* =========================================================
           INFO CARD
           ========================================================= */

    #html-introduction-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

        #html-introduction-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }


    /* =========================================================
           EXAMPLE BOX
           ========================================================= */

    #html-introduction-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

</style>


<main id="html-introduction-page"
      class="container py-5">

    <div class="row g-4">


        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9">


            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h1 class="fw-bold">
                    Introduction to HTML
                </h1>

                <p class="lead">
                    Learn the fundamentals of HTML and understand how HTML
                    provides the structure for modern web pages.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- WHAT IS HTML -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is HTML?
                </h2>

                <p>
                    HTML stands for
                    <strong>HyperText Markup Language</strong>.
                    It is the standard markup language used to create
                    and structure content on web pages.
                </p>

                <p>
                    HTML defines the structure of a web page using
                    elements and tags. These elements can represent
                    headings, paragraphs, links, images, lists, tables,
                    forms, media, and many other types of content.
                </p>

                <p>
                    HTML is a markup language rather than a programming
                    language. Its main purpose is to describe the structure
                    and meaning of content on a web page.
                </p>

                <div class="alert alert-info">

                    <strong>Simple Definition:</strong>

                    HTML is used to structure the content of a web page.

                </div>

            </div>


            <!-- ================================================= -->
            <!-- WHY LEARN HTML -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Why Learn HTML?
                </h2>

                <p>
                    HTML is one of the fundamental technologies of web
                    development. It provides the basic structure on which
                    CSS and JavaScript are commonly applied.
                </p>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Web Page Structure
                            </h5>

                            <p class="mb-0">
                                HTML organizes content into headings,
                                paragraphs, sections, links, images,
                                lists, tables, and forms.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Foundation of Web Development
                            </h5>

                            <p class="mb-0">
                                HTML provides the structural foundation
                                for websites and web applications.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Easy to Understand
                            </h5>

                            <p class="mb-0">
                                HTML uses readable tags and a structured
                                document format that beginners can learn.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Works with CSS and JavaScript
                            </h5>

                            <p class="mb-0">
                                HTML can be combined with CSS for styling
                                and JavaScript for behavior and interaction.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FIRST HTML PROGRAM -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Your First HTML Document
                </h2>

                <p>
                    A simple HTML document can contain a document type
                    declaration, an HTML root element, a head section,
                    a title, and a body section.
                </p>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;
    &lt;title&gt;My First Web Page&lt;/title&gt;
&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Hello Student !&lt;/h1&gt;

    &lt;p&gt;Welcome to Ciit Training Institute ❤️👀...!&lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>
            <div class="try-it-container">
                <button class="try-it-btn" onclick="tryHTML(this)">
                    Try It
                </button>
            </div>

            <!-- ================================================= -->
            <!-- EXPECTED OUTPUT -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Expected Output
                </h2>

                <div class="example-box">

                    <h2 class="mb-3">
                        Hello Student !
                    </h2>

                    <p class="mb-0">
                        Welcome to Ciit Training Institute ❤️👀...!
                    </p>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- HTML DOCUMENT STRUCTURE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Basic HTML Document Structure
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>
                                    Element
                                </th>

                                <th>
                                    Purpose
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;!DOCTYPE html&gt;</code>
                                </td>

                                <td>
                                    Declares that the document is an HTML document.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;html&gt;</code>
                                </td>

                                <td>
                                    Represents the root element of the document.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;head&gt;</code>
                                </td>

                                <td>
                                    Contains metadata and document information.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;title&gt;</code>
                                </td>

                                <td>
                                    Defines the title shown in the browser tab.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;body&gt;</code>
                                </td>

                                <td>
                                    Contains the visible content of the web page.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- HOW HTML WORKS -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    How HTML Works
                </h2>

                <p>
                    When an HTML document is opened in a web browser,
                    the browser reads the HTML elements and creates
                    the structure of the web page.
                </p>

                <div class="concept-box">


                    <div class="diagram-box">

                        <h5>
                            HTML Document
                        </h5>

                        <p>
                            Contains HTML elements and content.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            Browser
                        </h5>

                        <p>
                            Reads and interprets the HTML document.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            Document Structure
                        </h5>

                        <p>
                            The browser builds the structure of the page.
                        </p>

                    </div>


                    <div class="diagram-arrow">
                        ↓
                    </div>


                    <div class="diagram-box">

                        <h5>
                            Rendered Web Page
                        </h5>

                        <p>
                            The user sees the resulting web page.
                        </p>

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- HTML ELEMENTS -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Elements
                </h2>

                <p>
                    HTML documents are made up of elements. Many HTML
                    elements have an opening tag, content, and a closing tag.
                </p>

                <pre><code>&lt;p&gt;This is a paragraph.&lt;/p&gt;</code></pre>

                <p class="mt-3">
                    In this example:
                </p>

                <ul>

                    <li class="mb-2">
                        <code>&lt;p&gt;</code> is the opening tag.
                    </li>

                    <li class="mb-2">
                        <strong>This is a paragraph.</strong>
                        is the element content.
                    </li>

                    <li class="mb-2">
                        <code>&lt;/p&gt;</code> is the closing tag.
                    </li>

                </ul>

            </div>


            <!-- ================================================= -->
            <!-- HTML TAG STRUCTURE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Basic HTML Tag Structure
                </h2>

                <pre><code>&lt;tagname&gt;Content&lt;/tagname&gt;</code></pre>

                <p class="mt-3">
                    For example:
                </p>

                <pre><code>&lt;h1&gt;Welcome to HTML&lt;/h1&gt;</code></pre>

                <p class="mt-3">
                    The opening tag identifies the start of the element
                    and the closing tag identifies the end of the element.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- COMMON ELEMENTS -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common HTML Elements
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Element
                                </th>

                                <th>
                                    Example
                                </th>

                                <th>
                                    Purpose
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;h1&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;h1&gt;Title&lt;/h1&gt;</code>
                                </td>

                                <td>
                                    Creates a heading.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;p&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;p&gt;Text&lt;/p&gt;</code>
                                </td>

                                <td>
                                    Creates a paragraph.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;a&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;a href="..."&gt;Link&lt;/a&gt;</code>
                                </td>

                                <td>
                                    Creates a hyperlink.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;img&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;img src="..." alt="..."&gt;</code>
                                </td>

                                <td>
                                    Displays an image.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;ul&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;ul&gt;...&lt;/ul&gt;</code>
                                </td>

                                <td>
                                    Creates an unordered list.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;table&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;table&gt;...&lt;/table&gt;</code>
                                </td>

                                <td>
                                    Creates a table.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;form&gt;</code>
                                </td>

                                <td>
                                    <code>&lt;form&gt;...&lt;/form&gt;</code>
                                </td>

                                <td>
                                    Creates a form.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- HTML CSS JAVASCRIPT -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML, CSS and JavaScript
                </h2>

                <p>
                    These three technologies are commonly used together
                    in web development.
                </p>

                <div class="row g-3">


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                HTML
                            </h5>

                            <p class="mb-0">
                                Defines the structure and content
                                of the page.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                CSS
                            </h5>

                            <p class="mb-0">
                                Controls styling, colors, spacing,
                                layout, and presentation.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                JavaScript
                            </h5>

                            <p class="mb-0">
                                Adds interaction, behavior,
                                and dynamic functionality.
                            </p>

                        </div>

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- HTML FILE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML File Extension
                </h2>

                <p>
                    HTML files are commonly saved with the
                    <code>.html</code> extension.
                </p>

                <pre><code>index.html</code></pre>

            </div>


            <!-- ================================================= -->
            <!-- WHERE HTML IS USED -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Where HTML is Used
                </h2>

                <ul>

                    <li class="mb-2">
                        Websites
                    </li>

                    <li class="mb-2">
                        Web applications
                    </li>

                    <li class="mb-2">
                        Landing pages
                    </li>

                    <li class="mb-2">
                        Online forms
                    </li>

                    <li class="mb-2">
                        Documentation pages
                    </li>

                    <li class="mb-2">
                        Content and template pages
                    </li>

                </ul>

            </div>


            <!-- ================================================= -->
            <!-- PRACTICE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a file named
                        <code>index.html</code>.
                    </li>

                    <li class="mb-2">
                        Add a title inside the
                        <code>&lt;title&gt;</code> element.
                    </li>

                    <li class="mb-2">
                        Add an <code>&lt;h1&gt;</code> heading.
                    </li>

                    <li class="mb-2">
                        Add two paragraphs using
                        <code>&lt;p&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Open the file in a browser and observe
                        the result.
                    </li>

                </ol>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML stands for HyperText Markup Language and is used
                    to structure content on web pages. HTML documents are
                    created using elements and tags such as headings,
                    paragraphs, links, images, lists, tables, and forms.
                    HTML provides the basic structure of a web page and
                    commonly works together with CSS and JavaScript.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="d-flex justify-content-end mt-4">

                <a class="btn btn-primary"
                   href="@Url.Action("HTMLDocumentStructure", "Introduction", new { area = "HTML" })">

                    Next: HTML Document Structure →

                </a>

            </div>

        </section>

    </div>

</main>