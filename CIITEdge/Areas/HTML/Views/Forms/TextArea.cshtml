        rows="6"
        cols="50"
        placeholder="Enter your message"
        required&gt;
    &lt;/textarea&gt;

    &lt;br&gt;&lt;br&gt;

    &lt;button type="submit"&gt;
        Send Message
    &lt;/button&gt;

&lt;/form&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
