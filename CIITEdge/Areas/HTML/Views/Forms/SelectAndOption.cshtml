@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Select and Option";
}

<style>
    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .example-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-top: 15px;
        background-color: #f8f9fa;
    }

    .output-box {
        border-left: 4px solid #0d6efd;
        background-color: #f8f9fa;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    .note-box {
        border-left: 4px solid #ffc107;
        background-color: #fff8e1;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    table th,
    table td {
        vertical-align: middle;
    }

    .form-demo {
        background-color: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
        margin-top: 15px;
    }
</style>

<main id="main" class="container py-5">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <h1 class="display-5 fw-bold mb-3">HTML Select and Option</h1>

            <p class="lead">
                The HTML <code>&lt;select&gt;</code> element creates a dropdown
                control, while the <code>&lt;option&gt;</code> element defines
                the available choices inside that dropdown.
            </p>

            <hr class="my-4" />

            <h2 class="h3 fw-bold">1. What is a Select Element?</h2>

            <p>
                The <code>&lt;select&gt;</code> element creates a dropdown list
                from which users can choose an option.
            </p>

            <pre><code>&lt;select&gt;
    &lt;option&gt;HTML&lt;/option&gt;
    &lt;option&gt;CSS&lt;/option&gt;
    &lt;option&gt;JavaScript&lt;/option&gt;
&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">

                    <select class="form-select">
                        <option>HTML</option>
                        <option>CSS</option>
                        <option>JavaScript</option>
                    </select>
            </div>

            <h2 class="h3 fw-bold mt-5">2. The select Element</h2>

            <p>
                The <code>&lt;select&gt;</code> element acts as the container
                for the dropdown choices.
            </p>

            <pre><code>&lt;select name="course"&gt;

    &lt;!-- Options go here --&gt;

&lt;/select&gt;</code></pre>

            <h2 class="h3 fw-bold mt-5">3. The option Element</h2>

            <p>
                Each choice in a dropdown is created using the
                <code>&lt;option&gt;</code> element.
            </p>

            <pre><code>&lt;option&gt;
    HTML
&lt;/option&gt;</code></pre>

            <h2 class="h3 fw-bold mt-5">4. Basic Select Example</h2>

            <pre><code>&lt;label for="course"&gt;
    Select Course:
&lt;/label&gt;

&lt;select id="course"
        name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

            <div class="example-box">
                    <label for="demoCourse"
                           class="form-label">
                        Select Course:
                    </label>

                    <select id="demoCourse"
                            class="form-select">
                        <option value="html">HTML</option>
                        <option value="css">CSS</option>
                        <option value="javascript">JavaScript</option>
                    </select>
                </div>

            <h2 class="h3 fw-bold mt-5">5. name Attribute</h2>

            <p>
                The <code>name</code> attribute identifies the select control
                when its value is submitted with a form.
            </p>

            <pre><code>&lt;select name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">6. value Attribute of option</h2>

            <p>
                The <code>value</code> attribute specifies the value that is
                submitted when the option is selected.
            </p>

            <pre><code>&lt;option value="html"&gt;
    HTML
&lt;/option&gt;</code></pre>

            <p>
                The visible text and submitted value can be different.
            </p>

            <pre><code>&lt;option value="dotnet"&gt;
    .NET Full Stack Development
&lt;/option&gt;</code></pre>

            <h2 class="h3 fw-bold mt-5">7. Visible Text vs Value</h2>

            <pre><code>&lt;select name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="dotnet"&gt;
        .NET Full Stack Development
    &lt;/option&gt;

&lt;/select&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <div class="note-box">
                <strong>Important:</strong>
                The user sees the option text, while the submitted form data
                uses the option's <code>value</code>.
            </div>

            <h2 class="h3 fw-bold mt-5">8. selected Attribute</h2>

            <p>
                The <code>selected</code> attribute makes an option selected
                by default.
            </p>

            <pre><code>&lt;select name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"
            selected&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                    <select class="form-select">
                        <option value="html">HTML</option>
                        <option value="css" selected>CSS</option>
                        <option value="javascript">JavaScript</option>
                    </select>
            </div>

            <h2 class="h3 fw-bold mt-5">9. Disabled Option</h2>

            <p>
                The <code>disabled</code> attribute prevents an option from
                being selected.
            </p>

            <pre><code>&lt;option value=""
        disabled&gt;
    Select Course
&lt;/option&gt;</code></pre>

            <h2 class="h3 fw-bold mt-5">10. Placeholder-Style Select</h2>

            <p>
                A disabled option can be used as an initial prompt.
            </p>

            <pre><code>&lt;select name="course"
        required&gt;

    &lt;option value=""
            disabled
            selected&gt;
        Select a course
    &lt;/option&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                    <select class="form-select"
                            required>
                        <option value=""
                                disabled
                                selected>
                            Select a course
                        </option>
                        <option value="html">HTML</option>
                        <option value="css">CSS</option>
                        <option value="javascript">JavaScript</option>
                    </select>
                </div>

            <h2 class="h3 fw-bold mt-5">11. required Attribute</h2>

            <p>
                The <code>required</code> attribute indicates that the user
                must select a valid option before submission.
            </p>

            <pre><code>&lt;select name="course"
        required&gt;

    &lt;option value=""
            disabled
            selected&gt;
        Select Course
    &lt;/option&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">12. Multiple Attribute</h2>

            <p>
                The <code>multiple</code> attribute allows users to select
                more than one option.
            </p>

            <pre><code>&lt;select name="skills"
        multiple&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                    <label class="form-label">
                        Select Skills:
                    </label>

                    <select class="form-select"
                            multiple
                            size="4">
                        <option>HTML</option>
                        <option>CSS</option>
                        <option>JavaScript</option>
                        <option>C#</option>
                    </select>
            </div>

            <h2 class="h3 fw-bold mt-5">13. size Attribute</h2>

            <p>
                The <code>size</code> attribute can control how many options
                are visible at once.
            </p>

            <pre><code>&lt;select name="course"
        size="3"&gt;

    &lt;option&gt;HTML&lt;/option&gt;
    &lt;option&gt;CSS&lt;/option&gt;
    &lt;option&gt;JavaScript&lt;/option&gt;
    &lt;option&gt;C#&lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">14. Select with Many Options</h2>

            <pre><code>&lt;select name="country"&gt;

    &lt;option value="india"&gt;
        India
    &lt;/option&gt;

    &lt;option value="usa"&gt;
        United States
    &lt;/option&gt;

    &lt;option value="uk"&gt;
        United Kingdom
    &lt;/option&gt;

    &lt;option value="canada"&gt;
        Canada
    &lt;/option&gt;

    &lt;option value="australia"&gt;
        Australia
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <h2 class="h3 fw-bold mt-5">15. optgroup Element</h2>

            <p>
                The <code>&lt;optgroup&gt;</code> element groups related
                options inside a dropdown.
            </p>

            <pre><code>&lt;select name="course"&gt;

    &lt;optgroup label="Frontend"&gt;

        &lt;option value="html"&gt;
            HTML
        &lt;/option&gt;

        &lt;option value="css"&gt;
            CSS
        &lt;/option&gt;

        &lt;option value="javascript"&gt;
            JavaScript
        &lt;/option&gt;

    &lt;/optgroup&gt;

    &lt;optgroup label="Backend"&gt;

        &lt;option value="csharp"&gt;
            C#
        &lt;/option&gt;

        &lt;option value="dotnet"&gt;
            .NET
        &lt;/option&gt;

    &lt;/optgroup&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
            <div class="example-box">

                    <label class="form-label">
                        Select Course:
                    </label>

                    <select class="form-select">
                        <optgroup label="Frontend">
                            <option value="html">HTML</option>
                            <option value="css">CSS</option>
                            <option value="javascript">JavaScript</option>
                        </optgroup>

                        <optgroup label="Backend">
                            <option value="csharp">C#</option>
                            <option value="dotnet">.NET</option>
                        </optgroup>
                    </select>
            </div>

            <h2 class="h3 fw-bold mt-5">16. Disabled optgroup</h2>

            <p>
                An entire option group can be disabled.
            </p>

            <pre><code>&lt;optgroup label="Advanced Courses"
          disabled&gt;

    &lt;option value="aspnet"&gt;
        ASP.NET Core
    &lt;/option&gt;

    &lt;option value="azure"&gt;
        Azure
    &lt;/option&gt;

&lt;/optgroup&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">17. Select with Label</h2>

            <p>
                A select control should have a clear label.
            </p>

            <pre><code>&lt;label for="city"&gt;
    Select City:
&lt;/label&gt;

&lt;select id="city"
        name="city"&gt;

    &lt;option value="pune"&gt;
        Pune
    &lt;/option&gt;

    &lt;option value="mumbai"&gt;
        Mumbai
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">18. Select with Form Submission</h2>

            <pre><code>&lt;form action="/register"
      method="post"&gt;

    &lt;label for="course"&gt;
        Course:
    &lt;/label&gt;

    &lt;select id="course"
            name="course"
            required&gt;

        &lt;option value=""
                disabled
                selected&gt;
            Select Course
        &lt;/option&gt;

        &lt;option value="html"&gt;
            HTML
        &lt;/option&gt;

        &lt;option value="css"&gt;
            CSS
        &lt;/option&gt;

        &lt;option value="javascript"&gt;
            JavaScript
        &lt;/option&gt;

    &lt;/select&gt;

    &lt;button type="submit"&gt;
        Register
    &lt;/button&gt;

&lt;/form&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">19. Multiple Select with Form Submission</h2>

            <p>
                When using <code>multiple</code>, multiple selected values can
                be submitted using an appropriate control name and server handling.
            </p>

            <pre><code>&lt;form action="/register"
      method="post"&gt;

    &lt;label for="skills"&gt;
        Skills:
    &lt;/label&gt;

    &lt;select id="skills"
            name="skills"
            multiple&gt;

        &lt;option value="html"&gt;
            HTML
        &lt;/option&gt;

        &lt;option value="css"&gt;
            CSS
        &lt;/option&gt;

        &lt;option value="javascript"&gt;
            JavaScript
        &lt;/option&gt;

        &lt;option value="csharp"&gt;
            C#
        &lt;/option&gt;

    &lt;/select&gt;

    &lt;button type="submit"&gt;
        Submit
    &lt;/button&gt;

&lt;/form&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">20. Selected Option with value</h2>

            <pre><code>&lt;select name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"
            selected&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2 class="h3 fw-bold mt-5">21. option Value Can Differ from Text</h2>

            <pre><code>&lt;option value="frontend-html"&gt;
    HTML Fundamentals
&lt;/option&gt;

&lt;option value="frontend-css"&gt;
    CSS Fundamentals
&lt;/option&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <p>
                The user sees the descriptive text, while the application
                receives the specified value.
            </p>

            <h2 class="h3 fw-bold mt-5">22. Grouping Courses</h2>

            <pre><code>&lt;select name="course"&gt;

    &lt;optgroup label="Web Development"&gt;

        &lt;option value="html"&gt;
            HTML
        &lt;/option&gt;

        &lt;option value="css"&gt;
            CSS
        &lt;/option&gt;

        &lt;option value="javascript"&gt;
            JavaScript
        &lt;/option&gt;

    &lt;/optgroup&gt;

    &lt;optgroup label="Programming"&gt;

        &lt;option value="csharp"&gt;
            C#
        &lt;/option&gt;

        &lt;option value="python"&gt;
            Python
        &lt;/option&gt;

        &lt;option value="java"&gt;
            Java
        &lt;/option&gt;

    &lt;/optgroup&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">23. Select Styling with CSS</h2>

            <pre><code>&lt;style&gt;

    .course-select {
        width: 100%;
        max-width: 400px;
        padding: 10px;
        border: 1px solid #ced4da;
        border-radius: 6px;
    }

&lt;/style&gt;

&lt;select
    class="course-select"
    name="course"&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">24. Disabled Select</h2>

            <p>
                The <code>disabled</code> attribute disables the entire
                select control.
            </p>

            <pre><code>&lt;select name="course"
        disabled&gt;

    &lt;option&gt;
        Course unavailable
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">25. Readonly Alternative</h2>

            <p>
                A standard HTML select does not provide a simple
                <code>readonly</code> attribute equivalent like text inputs do.
                When a selection should not change, application logic or a
                disabled/select-display pattern can be used according to the use case.
            </p>

            <h2 class="h3 fw-bold mt-5">26. Select with Required Validation</h2>

            <pre><code>&lt;form&gt;

    &lt;label for="level"&gt;
        Select Level:
    &lt;/label&gt;

    &lt;select id="level"
            name="level"
            required&gt;

        &lt;option value=""
                disabled
                selected&gt;
            Select Level
        &lt;/option&gt;

        &lt;option value="beginner"&gt;
            Beginner
        &lt;/option&gt;

        &lt;option value="intermediate"&gt;
            Intermediate
        &lt;/option&gt;

        &lt;option value="advanced"&gt;
            Advanced
        &lt;/option&gt;

    &lt;/select&gt;

    &lt;button type="submit"&gt;
        Continue
    &lt;/button&gt;

&lt;/form&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">27. Select with Multiple Attributes</h2>

            <pre><code>&lt;select
    id="skills"
    name="skills"
    multiple
    size="5"
    required&gt;

    &lt;option value="html"&gt;
        HTML
    &lt;/option&gt;

    &lt;option value="css"&gt;
        CSS
    &lt;/option&gt;

    &lt;option value="javascript"&gt;
        JavaScript
    &lt;/option&gt;

    &lt;option value="csharp"&gt;
        C#
    &lt;/option&gt;

    &lt;option value="sql"&gt;
        SQL
    &lt;/option&gt;

&lt;/select&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">28. Select for Country</h2>

            <pre><code>&lt;label for="country"&gt;
    Country:
&lt;/label&gt;

&lt;select id="country"
        name="country"
        required&gt;

    &lt;option value=""
            disabled
            selected&gt;
        Select Country
    &lt;/option&gt;

    &lt;option value="india"&gt;
        India
    &lt;/option&gt;

    &lt;option value="usa"&gt;
        United States
    &lt;/option&gt;

    &lt;option value="uk"&gt;
        United Kingdom
    &lt;/option&gt;

    &lt;option value="canada"&gt;
        Canada
    &lt;/option&gt;

&lt;/select&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <h2 class="h3 fw-bold mt-5">29. Select for Department</h2>

            <pre><code>&lt;label for="department"&gt;
    Department:
&lt;/label&gt;

&lt;select id="department"
        name="department"&gt;

    &lt;option value="development"&gt;
        Development
    &lt;/option&gt;

    &lt;option value="testing"&gt;
