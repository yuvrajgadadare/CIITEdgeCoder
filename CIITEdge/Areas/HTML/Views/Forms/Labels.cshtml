        &lt;br&gt;

        &lt;textarea
            id="message"
            name="message"
            rows="5"&gt;
        &lt;/textarea&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;button type="submit"&gt;
            Register
        &lt;/button&gt;

    &lt;/fieldset&gt;

&lt;/form&gt;</code></pre>

