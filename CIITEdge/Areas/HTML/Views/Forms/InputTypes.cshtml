            <h2 class="h3 fw-bold mt-5">42. Complete Practice Example</h2>

            <pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;HTML Input Types Example&lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Student Registration&lt;/h1&gt;

    &lt;form action="/register"
          method="post"
          enctype="multipart/form-data"&gt;

        &lt;label for="name"&gt;
            Full Name:
        &lt;/label&gt;

        &lt;input type="text"
               id="name"
               name="name"
               required&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="email"&gt;
            Email:
        &lt;/label&gt;

        &lt;input type="email"
               id="email"
               name="email"
               required&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="password"&gt;
            Password:
        &lt;/label&gt;

        &lt;input type="password"
               id="password"
               name="password"
               required&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="age"&gt;
            Age:
        &lt;/label&gt;

        &lt;input type="number"
               id="age"
               name="age"
               min="18"
               max="60"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="phone"&gt;
            Phone:
        &lt;/label&gt;

        &lt;input type="tel"
               id="phone"
               name="phone"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="website"&gt;
            Website:
        &lt;/label&gt;

        &lt;input type="url"
               id="website"
               name="website"
               placeholder="https://example.com"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="dob"&gt;
            Date of Birth:
        &lt;/label&gt;

        &lt;input type="date"
               id="dob"
               name="dob"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label&gt;
            Learning Mode:
        &lt;/label&gt;

        &lt;input type="radio"
               id="online"
               name="mode"
               value="online"&gt;

        &lt;label for="online"&gt;
            Online
        &lt;/label&gt;

        &lt;input type="radio"
               id="offline"
               name="mode"
               value="offline"&gt;

        &lt;label for="offline"&gt;
            Offline
        &lt;/label&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label&gt;
            Skills:
        &lt;/label&gt;

        &lt;input type="checkbox"
               id="html"
               name="skills"
               value="html"&gt;

        &lt;label for="html"&gt;
            HTML
        &lt;/label&gt;

        &lt;input type="checkbox"
               id="css"
               name="skills"
               value="css"&gt;

        &lt;label for="css"&gt;
            CSS
        &lt;/label&gt;

        &lt;input type="checkbox"
               id="javascript"
               name="skills"
               value="javascript"&gt;

        &lt;label for="javascript"&gt;
            JavaScript
        &lt;/label&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="color"&gt;
            Favorite Color:
        &lt;/label&gt;

        &lt;input type="color"
               id="color"
               name="color"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="resume"&gt;
            Upload Resume:
        &lt;/label&gt;

        &lt;input type="file"
               id="resume"
               name="resume"
               accept=".pdf,.doc,.docx"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;label for="experience"&gt;
            Experience:
        &lt;/label&gt;

        &lt;input type="range"
               id="experience"
               name="experience"
               min="0"
               max="10"
               value="0"&gt;

        &lt;br&gt;&lt;br&gt;

        &lt;input type="submit"
               value="Register"&gt;

        &lt;input type="reset"
               value="Reset"&gt;

    &lt;/form&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>


