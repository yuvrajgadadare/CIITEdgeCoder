@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Accessibility";
}

<style>
    .content-section {
        line-height: 1.8;
    }

        .content-section h2 {
            color: #212529 !important;
            font-weight: 700;
            margin-top: 24px;
            margin-bottom: 14px;
        }

        .content-section h3 {
            color: #374151;
            font-weight: 600;
            margin-top: 20px;
            margin-bottom: 12px;
        }

        .content-section p {
            color: #4b5563;
        }

    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .info-box {
        background: #f3f4ff;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 6px;
        margin: 18px 0;
    }

    .diagram-box {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 24px;
        background: #ffffff;
        margin: 20px 0;
    }

    .diagram-title {
        text-align: center;
        font-weight: 700;
        color: #212529;
        margin-bottom: 18px;
    }

    .access-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .flow-item {
        border: 1px solid #dee2e6;
        background: #f8f9fa;
        padding: 14px 18px;
        border-radius: 8px;
        text-align: center;
        min-width: 125px;
        font-weight: 600;
    }

    .flow-arrow {
        font-size: 22px;
        font-weight: 700;
        color: #212529;
    }

    .demo-box {
        border: 1px solid #dee2e6;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<main id="main-content" class="container py-5">
    <div class="row g-4">

        <!-- Left Sidebar -->
        <div class="col-lg-3">
            @Html.Partial("~/Areas/HTML/Views/Shared/HTMLTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 content-section">

            <h1 class="fw-bold mb-3">HTML Accessibility</h1>

            <p>
                Web accessibility means designing websites so that people with different
                abilities can use them effectively.
            </p>

            <p>
                Good HTML structure is one of the most important foundations of an
                accessible website.
            </p>

            <div class="info-box">
                <strong>Simple Idea:</strong>
                Accessibility means making your webpage usable by as many people as possible,
                including people who use keyboards, screen readers, magnification tools,
                or other assistive technologies.
            </div>

            <h2>1. Accessibility at a Glance</h2>

            <div class="diagram-box">

                <div class="diagram-title">
                    Accessible HTML
                </div>

                <div class="access-flow">

                    <div class="flow-item">
                        Semantic<br>HTML
                    </div>

                    <div class="flow-arrow">→</div>

                    <div class="flow-item">
                        Labels &amp;<br>Text
                    </div>

                    <div class="flow-arrow">→</div>

                    <div class="flow-item">
                        Keyboard<br>Access
                    </div>

                    <div class="flow-arrow">→</div>

                    <div class="flow-item">
                        Better<br>Accessibility
                    </div>

                </div>

            </div>

            <h2>2. Why is Accessibility Important?</h2>

            <p>
                Not every user interacts with a webpage in the same way.
                Some users may use a keyboard instead of a mouse, while others
                may rely on screen readers or other assistive technologies.
            </p>

            <p>
                Accessible HTML makes the structure and purpose of content clearer,
                which improves usability for a wider range of users.
            </p>

            <h2>3. Use Semantic HTML</h2>

            <p>
                Semantic elements describe the purpose of content.
                They are usually a better choice than using generic
                <code>&lt;div&gt;</code> elements everywhere.
            </p>

            <pre><code>&lt;header&gt;
    Website Header
&lt;/header&gt;

&lt;nav&gt;
    Navigation
&lt;/nav&gt;

&lt;main&gt;
    Main Content
&lt;/main&gt;

&lt;footer&gt;
    Footer
&lt;/footer&gt;</code></pre>

            <p>
                This gives the document a meaningful structure that can be understood
                more easily by users and assistive technologies.
            </p>

            <h2>4. Use Proper Headings</h2>

            <p>
                Headings organize content into a logical hierarchy.
                Use headings to describe topics rather than simply making text look large.
            </p>

            <pre><code>&lt;h1&gt;HTML Tutorial&lt;/h1&gt;

&lt;h2&gt;HTML Basics&lt;/h2&gt;

&lt;h3&gt;HTML Elements&lt;/h3&gt;

&lt;h3&gt;HTML Attributes&lt;/h3&gt;

&lt;h2&gt;HTML Forms&lt;/h2&gt;</code></pre>

            <p>
                A clear heading structure helps users understand the organization
                of the page.
            </p>

            <h2>5. Use Labels with Form Controls</h2>

            <p>
                Form fields should have clear labels so users know what information
                they are expected to enter.
            </p>

            <pre><code>&lt;label for="email"&gt;
    Email Address
&lt;/label&gt;

&lt;input
    type="email"
    id="email"
    name="email"&gt;</code></pre>

            <div class="info-box">
                The label's <code>for</code> attribute should match the input's
                <code>id</code>.
            </div>

            <h2>6. Provide Alternative Text for Images</h2>

            <p>
                The <code>alt</code> attribute provides a text alternative for an image.
            </p>

            <pre><code>&lt;img
    src="html-course.jpg"
    alt="HTML course lesson"&gt;</code></pre>

            <p>
                The alternative text should describe the image when the image
                communicates meaningful information.
            </p>

            <h3>Decorative Images</h3>

            <p>
                If an image is purely decorative and adds no useful information,
                an empty alternative text can be appropriate:
            </p>

            <pre><code>&lt;img
    src="decoration.png"
    alt=""&gt;</code></pre>

            <h2>7. Use Descriptive Link Text</h2>

            <p>
                Link text should give users an idea of where the link will take them.
            </p>

            <p>Prefer:</p>

            <pre><code>&lt;a href="/html-forms"&gt;
    Learn HTML Forms
&lt;/a&gt;</code></pre>

            <p>Instead of:</p>

            <pre><code>&lt;a href="/html-forms"&gt;
    Click Here
&lt;/a&gt;</code></pre>

            <h2>8. Keyboard Accessibility</h2>

            <p>
                Users should be able to navigate important interactive controls
                using the keyboard.
            </p>

            <p>
                Native HTML elements such as buttons, links, form controls,
                and form inputs already provide standard keyboard behavior.
            </p>

            <pre><code>&lt;button type="button"&gt;
    Open Menu
&lt;/button&gt;</code></pre>

            <div class="info-box">
                <strong>Best Practice:</strong>
                Prefer native HTML controls before creating custom interactive
                elements with JavaScript.
            </div>

            <h2>9. Button vs Div for Actions</h2>

            <p>
                A common accessibility mistake is using a generic element
                for something that should behave like a button.
            </p>

            <p>Prefer:</p>

            <pre><code>&lt;button type="button"&gt;
    Save
&lt;/button&gt;</code></pre>

            <p>
                A real button provides built-in semantics and keyboard behavior.
            </p>

            <h2>10. Language of the Document</h2>

            <p>
                The <code>lang</code> attribute identifies the primary language
                of the page.
            </p>

            <pre><code>&lt;html lang="en"&gt;</code></pre>

            <p>
                This information can help browsers and assistive technologies
                process the content correctly.
            </p>

            <h2>11. Accessible Tables</h2>

            <p>
                Tables should be used for tabular data, not simply for page layout.
                Header cells should clearly identify the data they describe.
            </p>

            <pre><code>&lt;table&gt;

    &lt;tr&gt;
        &lt;th&gt;Course&lt;/th&gt;
        &lt;th&gt;Duration&lt;/th&gt;
    &lt;/tr&gt;

    &lt;tr&gt;
        &lt;td&gt;HTML&lt;/td&gt;
        &lt;td&gt;2 Months&lt;/td&gt;
    &lt;/tr&gt;

&lt;/table&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>12. Accessible Navigation</h2>

            <p>
                Use the semantic <code>&lt;nav&gt;</code> element for important
                navigation areas.
            </p>

            <pre><code>&lt;nav aria-label="Main Navigation"&gt;

    &lt;a href="/"&gt;
        Home
    &lt;/a&gt;

    &lt;a href="/courses"&gt;
        Courses
    &lt;/a&gt;

    &lt;a href="/contact"&gt;
        Contact
    &lt;/a&gt;

&lt;/nav&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <p>
                When there are multiple navigation areas, descriptive labels
                can help distinguish them.
            </p>

            <h2>13. ARIA Basics</h2>

            <p>
                ARIA provides additional accessibility information when native HTML
                semantics do not fully describe a custom interface.
            </p>

            <pre><code>&lt;button
    aria-label="Close menu"&gt;

    X

&lt;/button&gt;</code></pre>

            <div class="info-box">
                <strong>Important:</strong>
                Native HTML should usually be your first choice.
                Use ARIA when additional semantic information is actually needed.
            </div>

            <h2>14. aria-label</h2>

            <p>
                The <code>aria-label</code> attribute gives an accessible name
                to an element when a visible text label is not sufficient.
            </p>

            <pre><code>&lt;button
    aria-label="Search"&gt;

    🔍

&lt;/button&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>15. Hidden Content and Accessibility</h2>

            <p>
                The <code>hidden</code> attribute tells the browser that an element
                is not currently relevant for display.
            </p>

            <pre><code>&lt;p hidden&gt;
    Additional content
&lt;/p&gt;</code></pre>

            <p>
                Do not hide important information simply to make a page look cleaner.
                Hidden content should have a real functional reason.
            </p>

            <h2>16. Focus and tabindex</h2>

            <p>
                Keyboard users need a predictable focus order.
                Native interactive elements normally participate in keyboard navigation
                without requiring custom tabindex values.
            </p>

            <pre><code>&lt;button tabindex="0"&gt;
    Submit
&lt;/button&gt;</code></pre>

            <p>
                Use custom tabindex values carefully because unnecessary changes
                can make keyboard navigation confusing.
            </p>

            <h2>17. Accessible Forms</h2>

            <p>
                A good accessible form should provide clear labels,
                appropriate input types, useful instructions, and understandable
                validation messages.
            </p>

            <pre><code>&lt;form&gt;

    &lt;label for="name"&gt;
        Full Name
    &lt;/label&gt;

    &lt;input
        type="text"
        id="name"
        name="name"
        required&gt;

    &lt;label for="email"&gt;
        Email
    &lt;/label&gt;

    &lt;input
        type="email"
        id="email"
        name="email"
        required&gt;

    &lt;button type="submit"&gt;
        Register
    &lt;/button&gt;

&lt;/form&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <h2>18. Accessibility and Color</h2>

            <p>
                Important information should not be communicated through color alone.
            </p>

            <p>
                For example, instead of using only red to indicate an error,
                provide text or another clear indicator as well.
            </p>

            <div class="demo-box">
                <p class="mb-2">
                    <strong>Error:</strong>
                    Please enter a valid email address.
                </p>
            </div>

            <h2>19. Accessibility Checklist</h2>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Area</th>
                            <th>Check</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>Structure</td>
                            <td>Use semantic HTML elements.</td>
                        </tr>

                        <tr>
                            <td>Headings</td>
                            <td>Use a logical heading hierarchy.</td>
                        </tr>

                        <tr>
                            <td>Images</td>
                            <td>Provide appropriate alt text.</td>
                        </tr>

                        <tr>
                            <td>Forms</td>
                            <td>Use labels and meaningful controls.</td>
                        </tr>

                        <tr>
                            <td>Navigation</td>
                            <td>Use descriptive link text.</td>
                        </tr>

                        <tr>
                            <td>Keyboard</td>
                            <td>Ensure important controls can be reached by keyboard.</td>
                        </tr>

                        <tr>
                            <td>Language</td>
                            <td>Set the correct document language.</td>
                        </tr>

                        <tr>
                            <td>Color</td>
                            <td>Do not use color as the only way to communicate meaning.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2>20. Common Mistakes</h2>

            <h3>Mistake 1: Using div instead of semantic controls</h3>

            <p>
                Do not create custom buttons from generic elements when a native
                <code>&lt;button&gt;</code> can perform the task.
            </p>

            <h3>Mistake 2: Missing image alt text</h3>

            <p>
                Meaningful images should have appropriate alternative text.
            </p>

            <h3>Mistake 3: Missing form labels</h3>

            <p>
                Users should be able to understand what each input field is for.
            </p>

            <h3>Mistake 4: Poor heading structure</h3>

            <p>
                Headings should organize the content logically instead of being
                chosen only for their visual size.
            </p>

            <h2>21. Best Practices</h2>

            <ul>
                <li>Start with semantic HTML.</li>
                <li>Use native interactive elements wherever possible.</li>
                <li>Provide meaningful labels and alternative text.</li>
                <li>Keep keyboard navigation logical.</li>
                <li>Use ARIA only when necessary.</li>
                <li>Do not communicate important information through color alone.</li>
                <li>Test pages using keyboard navigation and accessibility tools.</li>
            </ul>

            <h2>22. Practice Example</h2>

            <p>
                Create a simple accessible course page containing a heading,
                navigation, image, form, and semantic main content.
            </p>

            <pre><code>&lt;html lang="en"&gt;

&lt;body&gt;

    &lt;header&gt;

        &lt;h1&gt;
            HTML Course
        &lt;/h1&gt;

    &lt;/header&gt;

    &lt;nav aria-label="Main Navigation"&gt;

        &lt;a href="#"&gt;
            Home
        &lt;/a&gt;

        &lt;a href="#"&gt;
            Courses
        &lt;/a&gt;

    &lt;/nav&gt;

    &lt;main&gt;

        &lt;section&gt;

            &lt;h2&gt;
                Registration
            &lt;/h2&gt;

            &lt;form&gt;

                &lt;label for="email"&gt;
                    Email
                &lt;/label&gt;

                &lt;input
                    type="email"
                    id="email"
                    name="email"
                    required&gt;

                &lt;button type="submit"&gt;
                    Register
                &lt;/button&gt;

            &lt;/form&gt;

        &lt;/section&gt;

    &lt;/main&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
            <div class="alert alert-info mt-4">
                <h2 class="h4 fw-bold">Summary</h2>
                <p class="mb-0">
                    HTML accessibility means creating webpages that can be used by
                    people with different abilities and assistive technologies.
                    The strongest foundation is semantic HTML, proper headings,
                    meaningful labels, useful image alternative text, descriptive
                    links, keyboard-friendly controls, and clear page structure.
                    Use native HTML whenever possible and add ARIA only when
                    additional accessibility information is needed.
                </p>
            </div>

            <!-- Navigation -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Viewport", "AdvancedHTML", new { area = "HTML" })">
                    ← Previous: Viewport
                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("ARIABasics", "AdvancedHTML", new { area = "HTML" })">
                    Next: ARIA Basics →
                </a>
            </div>

        </div>
    </div>
</main>