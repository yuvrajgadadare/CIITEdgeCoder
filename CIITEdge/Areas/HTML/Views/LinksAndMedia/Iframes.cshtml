@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Iframes";
}

<style>
    pre {
        background-color: #212529 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        pre code {
            background: transparent !important;
            color: #fff !important;
        }

    .example-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        margin-top: 15px;
        background-color: #f8f9fa;
    }

    .output-box {
        border-left: 4px solid #0d6efd;
        background-color: #f8f9fa;
        padding: 15px;
        margin-top: 15px;
        border-radius: 5px;
    }

    .note-box {
        border-left: 4px solid #ffc107;
        background-color: #fff8e1;
        padding: 15px;
