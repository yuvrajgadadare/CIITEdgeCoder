@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Attributes";
}

<style>

    #html-attributes-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-attributes-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-attributes-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-attributes-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-attributes-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-attributes-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-attributes-page .table-responsive {
        margin-top: 15px;
    }

</style>


<main id="html-attributes-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Attributes
                </h1>

                <p class="lead">
                    Learn what HTML attributes are, how they are written,
                    and how they provide additional information to HTML elements.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What are HTML Attributes?
                </h2>

                <p>
                    HTML attributes provide additional information about an
                    HTML element.
                </p>

                <p>
                    Attributes are written inside the opening tag of an element.
                    They normally consist of an attribute name and an attribute value.
                </p>

                <div class="alert alert-info">

                    <strong>Basic Syntax:</strong>

                    <div class="mt-2">
                        <code>attribute="value"</code>
                    </div>

                </div>

            </div>


            <!-- BASIC SYNTAX -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Basic Attribute Syntax
                </h2>

                <pre><code>&lt;element attribute="value"&gt;
    Content
&lt;/element&gt;</code></pre>

                <h3 class="h5 fw-bold mt-4">
                    Example
                </h3>

                <pre><code>&lt;p id="intro"&gt;
    Welcome to HTML.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <div class="concept-box">

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th>Part</th>
                                    <th>Example</th>
                                    <th>Meaning</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>

                                    <td>
                                        Element
                                    </td>

                                    <td>
                                        <code>p</code>
                                    </td>

                                    <td>
                                        Paragraph element.
                                    </td>

                                </tr>

                                <tr>

                                    <td>
                                        Attribute Name
                                    </td>

                                    <td>
                                        <code>id</code>
                                    </td>

                                    <td>
                                        Defines the attribute.
                                    </td>

                                </tr>

                                <tr>

                                    <td>
                                        Attribute Value
                                    </td>

                                    <td>
                                        <code>"intro"</code>
                                    </td>

                                    <td>
                                        The value assigned to the attribute.
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ID ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The id Attribute
                </h2>

                <p>
                    The <code>id</code> attribute identifies a specific HTML
                    element with a unique value within the document.
                </p>

                <pre><code>&lt;h1 id="main-title"&gt;
    Welcome to CIIT Institute
&lt;/h1&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <p>
                    Here, <code>main-title</code> is the value of the
                    <code>id</code> attribute.
                </p>

                <div class="example-box">

                    <h2 id="main-title-example">
                        Welcome to CIIT Institute
                    </h2>

                </div>

                <div class="alert alert-warning mt-3">

                    <strong>Important:</strong>

                    An <code>id</code> is generally intended to identify
                    a specific element uniquely.

                </div>

            </div>


            <!-- CLASS ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The class Attribute
                </h2>

                <p>
                    The <code>class</code> attribute is used to assign one or
                    more class names to an HTML element.
                </p>

                <p>
                    Classes are commonly used with CSS and JavaScript.
                </p>

                <pre><code>&lt;p class="message"&gt;
    Welcome to HTML.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <p class="fw-bold text-primary mb-0">
                        Welcome to HTML.
                    </p>

                </div>

            </div>


            <!-- HREF ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The href Attribute
                </h2>

                <p>
                    The <code>href</code> attribute specifies the destination
                    of a hyperlink created using the <code>&lt;a&gt;</code> element.
                </p>

                <pre><code>&lt;a href="https://example.com"&gt;
    Visit Website
&lt;/a&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <a href="#">
                        Visit Website
                    </a>
                </div>

            </div>


            <!-- SRC ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The src Attribute
                </h2>

                <p>
                    The <code>src</code> attribute specifies the location or
                    source of external content such as images.
                </p>

                <pre><code>&lt;img src="image.jpg" alt="Sample Image"&gt;</code></pre>

                <p>
                    The browser uses the value of <code>src</code> to locate
                    the image resource.
                </p>

            </div>


            <!-- ALT ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The alt Attribute
                </h2>

                <p>
                    The <code>alt</code> attribute provides alternative text
                    for an image.
                </p>

                <pre><code>&lt;img src="student.jpg"
     alt="Student learning HTML"&gt;</code></pre>

                <div class="alert alert-success">

                    <strong>Best Practice:</strong>

                    Use meaningful alternative text for images to improve
                    accessibility and provide useful information when an
                    image cannot be displayed.

                </div>

            </div>


            <!-- TITLE ATTRIBUTE -->
           <div class="mb-4">

    <h2 class="h3 fw-bold">
        The title Attribute
    </h2>

    <p>
        The <code>title</code> attribute can provide additional
        advisory information about an HTML element.
    </p>

    <pre><code>&lt;p title="HTML Introduction"&gt;
    Learn HTML step-by-step.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

    <div class="example-box">

        <p title="HTML Introduction" class="title-hover-text">
            Hover over this text to see the title information.
        </p>

    </div>

</div>


            <!-- STYLE ATTRIBUTE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    The style Attribute
                </h2>

                <p>
                    The <code>style</code> attribute can be used to apply
                    inline CSS directly to an HTML element.
                </p>

                <pre><code>&lt;p style="color: blue;"&gt;
    This is a blue paragraph.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <div class="example-box">

                    <p style="color: blue;"
                       class="mb-0">

                        This is a blue paragraph.

                    </p>

                </div>

            </div>


            <!-- MULTIPLE ATTRIBUTES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Multiple Attributes
                </h2>

                <p>
                    An HTML element can contain more than one attribute.
                </p>

                <pre><code>&lt;img src="student.jpg"
     alt="Student"
     class="profile-image"
     id="studentPhoto"&gt;</code></pre>

                <p>
                    In this example, the image element contains multiple
                    attributes:
                </p>

                <ul>

                    <li class="mb-2">
                        <code>src</code>
                    </li>

                    <li class="mb-2">
                        <code>alt</code>
                    </li>

                    <li class="mb-2">
                        <code>class</code>
                    </li>

                    <li>
                        <code>id</code>
                    </li>

                </ul>

            </div>


            <!-- COMMON ATTRIBUTES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common HTML Attributes
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Attribute
                                </th>

                                <th>
                                    Used With
                                </th>

                                <th>
                                    Purpose
                                </th>

                                <th>
                                    Example
                                </th>

                            </tr>

                        </thead>

                        <tbody>


                            <tr>

                                <td>
                                    <code>id</code>
                                </td>

                                <td>
                                    Most HTML elements
                                </td>

                                <td>
                                    Identifies an element.
                                </td>

                                <td>
                                    <code>id="header"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>class</code>
                                </td>

                                <td>
                                    Most HTML elements
                                </td>

                                <td>
                                    Assigns class names.
                                </td>

                                <td>
                                    <code>class="box"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>href</code>
                                </td>

                                <td>
                                    <code>&lt;a&gt;</code>
                                </td>

                                <td>
                                    Defines a link destination.
                                </td>

                                <td>
                                    <code>href="page.html"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>src</code>
                                </td>

                                <td>
                                    Images and media elements
                                </td>

                                <td>
                                    Defines the source resource.
                                </td>

                                <td>
                                    <code>src="image.jpg"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>alt</code>
                                </td>

                                <td>
                                    <code>&lt;img&gt;</code>
                                </td>

                                <td>
                                    Defines alternative text.
                                </td>

                                <td>
                                    <code>alt="Logo"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>title</code>
                                </td>

                                <td>
                                    Most HTML elements
                                </td>

                                <td>
                                    Provides additional information.
                                </td>

                                <td>
                                    <code>title="Information"</code>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    <code>style</code>
                                </td>

                                <td>
                                    Most HTML elements
                                </td>

                                <td>
                                    Applies inline CSS.
                                </td>

                                <td>
                                    <code>style="color:red;"</code>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- BOOLEAN ATTRIBUTES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Boolean Attributes
                </h2>

                <p>
                    Some HTML attributes are boolean attributes. Their presence
                    represents a true state.
                </p>

                <pre><code>&lt;input type="checkbox" checked&gt;

&lt;input type="text" disabled&gt;</code></pre>

                <div class="row g-3">

                    <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                checked
                            </h5>

                            <p class="mb-0">
                                Indicates that a checkbox or similar control
                                is selected.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                disabled
                            </h5>

                            <p class="mb-0">
                                Indicates that a form control is disabled.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ATTRIBUTE RULES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Important Rules for Attributes
                </h2>

                <ul>

                    <li class="mb-2">
                        Attributes are written inside the opening tag.
                    </li>

                    <li class="mb-2">
                        Attribute names should be written correctly.
                    </li>

                    <li class="mb-2">
                        Attribute values are commonly placed inside quotes.
                    </li>

                    <li class="mb-2">
                        Multiple attributes are separated by spaces.
                    </li>

                    <li>
                        Different elements support different attributes.
                    </li>

                </ul>

            </div>


            <!-- COMPLETE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Complete Example
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;HTML Attributes Example&lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1 id="main-title"
        class="heading"&gt;

        CIIT Institute

    &lt;/h1&gt;

    &lt;p class="description"
       title="HTML Course"&gt;

        Learn HTML step-by-step.

    &lt;/p&gt;

    &lt;a href="https://example.com"
       title="Visit Website"&gt;

        Learn More

    &lt;/a&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>
            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a heading with an <code>id</code> attribute.
                    </li>

                    <li class="mb-2">
                        Add a paragraph with a <code>class</code> attribute.
                    </li>

                    <li class="mb-2">
                        Create a link using the <code>href</code> attribute.
                    </li>

                    <li class="mb-2">
                        Add an image using <code>src</code> and <code>alt</code>.
                    </li>

                    <li class="mb-2">
                        Add a <code>title</code> attribute to an element.
                    </li>

                    <li>
                        Add an inline <code>style</code> attribute to a paragraph.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML attributes provide additional information about HTML
                    elements. They are written inside opening tags and normally
                    use the format <code>attribute="value"</code>. Common
                    attributes include <code>id</code>, <code>class</code>,
                    <code>href</code>, <code>src</code>, <code>alt</code>,
                    <code>title</code>, and <code>style</code>.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("HTMLElements", "BasicHTML", new { area = "HTML" })">

                    ← Previous: HTML Elements

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Headings", "BasicHTML", new { area = "HTML" })">

                    Next: Headings →

                </a>

            </div>


        </section>

    </div>

</main>