@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "Basic HTML";
}

<style>

    #basic-html-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #basic-html-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #basic-html-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #basic-html-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #basic-html-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #basic-html-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

</style>


<main id="basic-html-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    Basic HTML
                </h1>

                <p class="lead">
                    Learn the basic HTML building blocks used to create and
                    structure web pages.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Introduction to Basic HTML
                </h2>

                <p>
                    After understanding the fundamentals of HTML, the next step
                    is to learn the basic elements used to build a web page.
                </p>

                <p>
                    HTML provides a collection of elements that allow developers
                    to organize content such as headings, paragraphs, links,
                    images, and other page components.
                </p>

                <div class="alert alert-info">

                    <strong>In this module:</strong>

                    You will learn HTML elements, attributes, headings,
                    paragraphs, comments, line breaks, and horizontal rules.

                </div>

            </div>


            <!-- BASIC HTML EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Simple HTML Example
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;Basic HTML Example&lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Welcome to CIIT Institute&lt;/h1&gt;

    &lt;p&gt;
        Learn HTML step-by-step.
    &lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <h3 class="h5 fw-bold mt-4">
                    Output
                </h3>

                <div class="example-box">

                    <h2>
                        Welcome to CIIT Institute
                    </h2>

                    <p class="mb-0">
                        Learn HTML step-by-step.
                    </p>

                </div>

            </div>


            <!-- HTML ELEMENTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Elements
                </h2>

                <p>
                    HTML elements are the basic building blocks of an HTML
                    document. They describe the content and structure of the page.
                </p>

                <pre><code>&lt;p&gt;This is a paragraph.&lt;/p&gt;</code></pre>

                <div class="row g-3 mt-2">

                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Opening Tag
                            </h5>

                            <p class="mb-0">
                                <code>&lt;p&gt;</code> starts the paragraph element.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Content
                            </h5>

                            <p class="mb-0">
                                The text between the tags is the element content.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                Closing Tag
                            </h5>

                            <p class="mb-0">
                                <code>&lt;/p&gt;</code> ends the paragraph element.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HTML ATTRIBUTES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Attributes
                </h2>

                <p>
                    Attributes provide additional information about an HTML
                    element. They are normally written inside the opening tag.
                </p>

                <pre><code>&lt;p id="intro"&gt;
    Welcome to CIIT Institute.
&lt;/p&gt;</code></pre>

                <div class="alert alert-warning">

                    <strong>Remember:</strong>

                    An attribute usually follows the format
                    <code>attribute="value"</code>.

                </div>

            </div>


            <!-- HEADINGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Headings
                </h2>

                <p>
                    HTML provides six heading levels from
                    <code>&lt;h1&gt;</code> to <code>&lt;h6&gt;</code>.
                </p>

                <pre><code>&lt;h1&gt;Main Heading&lt;/h1&gt;
&lt;h2&gt;Sub Heading&lt;/h2&gt;
&lt;h3&gt;Heading 3&lt;/h3&gt;
&lt;h4&gt;Heading 4&lt;/h4&gt;
&lt;h5&gt;Heading 5&lt;/h5&gt;
&lt;h6&gt;Heading 6&lt;/h6&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <h1 class="h2">
                        Main Heading
                    </h1>

                    <h2 class="h3">
                        Sub Heading
                    </h2>

                    <h3 class="h4">
                        Heading 3
                    </h3>

                    <h4 class="h5">
                        Heading 4
                    </h4>

                    <h5 class="h6">
                        Heading 5
                    </h5>

                    <h6>
                        Heading 6
                    </h6>

                </div>

            </div>


            <!-- PARAGRAPHS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Paragraphs
                </h2>

                <p>
                    The <code>&lt;p&gt;</code> element is used to create
                    paragraphs.
                </p>

                <pre><code>&lt;p&gt;
    HTML is easy to learn.
&lt;/p&gt;

&lt;p&gt;
    Start building your first web page.
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <p>
                        HTML is easy to learn.
                    </p>

                    <p class="mb-0">
                        Start building your first web page.
                    </p>

                </div>

            </div>


            <!-- COMMENTS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Comments
                </h2>

                <p>
                    Comments are written inside the HTML source code and are
                    ignored by the browser when displaying the page.
                </p>

                <pre><code>&lt;!-- This is an HTML comment --&gt;

&lt;h1&gt;Welcome to HTML&lt;/h1&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
                <div class="alert alert-success">

                    <strong>Use:</strong>

                    Comments are helpful for writing notes and improving
                    code readability.

                </div>

            </div>


            <!-- LINE BREAKS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Line Breaks
                </h2>

                <p>
                    The <code>&lt;br&gt;</code> element is used to insert
                    a line break.
                </p>

                <pre><code>&lt;p&gt;
    Hello&lt;br&gt;
    Welcome to HTML&lt;br&gt;
    Learn Web Development
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    Hello<br />
                    Welcome to HTML<br />
                    Learn Web Development

                </div>

            </div>


            <!-- HORIZONTAL RULE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Horizontal Rules
                </h2>

                <p>
                    The <code>&lt;hr&gt;</code> element is used to create a
                    thematic horizontal separation between sections.
                </p>

                <pre><code>&lt;h2&gt;HTML&lt;/h2&gt;

&lt;p&gt;
    Learn HTML step-by-step.
&lt;/p&gt;

&lt;hr&gt;

&lt;h2&gt;CSS&lt;/h2&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <h3>
                        HTML
                    </h3>

                    <p>
                        Learn HTML step-by-step.
                    </p>

                    <hr />

                    <h3>
                        CSS
                    </h3>

                </div>

            </div>


            <!-- TOPICS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Basic HTML Topics
                </h2>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                HTML Elements
                            </h5>

                            <p class="mb-0">
                                Understand the structure and types of
                                HTML elements.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                HTML Attributes
                            </h5>

                            <p class="mb-0">
                                Learn how attributes provide additional
                                information to elements.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Headings
                            </h5>

                            <p class="mb-0">
                                Learn how to create and organize headings
                                using HTML.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Paragraphs
                            </h5>

                            <p class="mb-0">
                                Learn how to create paragraphs and organize
                                text content.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Comments
                            </h5>

                            <p class="mb-0">
                                Learn how to add comments to HTML source code.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Line Breaks
                            </h5>

                            <p class="mb-0">
                                Learn how to move content to a new line.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Horizontal Rules
                            </h5>

                            <p class="mb-0">
                                Learn how to visually separate sections
                                of content.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create an HTML file named <code>index.html</code>.
                    </li>

                    <li class="mb-2">
                        Add an <code>&lt;h1&gt;</code> heading.
                    </li>

                    <li class="mb-2">
                        Add two paragraphs.
                    </li>

                    <li class="mb-2">
                        Add an HTML comment.
                    </li>

                    <li class="mb-2">
                        Use a <code>&lt;br&gt;</code> line break.
                    </li>

                    <li>
                        Use an <code>&lt;hr&gt;</code> between two sections.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    In Basic HTML, you will work with the fundamental elements
                    used to structure a web page. This module covers HTML
                    elements, attributes, headings, paragraphs, comments,
                    line breaks, and horizontal rules.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("HTMLvsCSSvsJavaScript", "Introduction", new { area = "HTML" })">

                    ← Previous: HTML vs CSS vs JavaScript

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("HTMLElements", "BasicHTML", new { area = "HTML" })">

                    Next: HTML Elements →

                </a>

            </div>


        </section>

    </div>

</main>