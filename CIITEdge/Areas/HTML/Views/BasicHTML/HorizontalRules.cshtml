@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Horizontal Rules";
}

<style>

    #html-horizontal-rules-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-horizontal-rules-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-horizontal-rules-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-horizontal-rules-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-horizontal-rules-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-horizontal-rules-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-horizontal-rules-page hr.demo-rule {
        border: 0;
        border-top: 2px solid #6f42c1;
        opacity: 1;
        margin: 20px 0;
    }

</style>


<main id="html-horizontal-rules-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Horizontal Rules
                </h1>

                <p class="lead">
                    Learn how to use the <code>&lt;hr&gt;</code> element to
                    create thematic breaks and visually separate sections
                    of content.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is an HTML Horizontal Rule?
                </h2>

                <p>
                    The HTML <code>&lt;hr&gt;</code> element represents a
                    thematic break between sections of content.
                </p>

                <p>
                    Browsers commonly display it as a horizontal line, making
                    it useful for visually separating related sections of
                    a document.
                </p>

                <div class="alert alert-info">

                    <strong>Basic Syntax:</strong>

                    <pre class="mb-0 mt-3"><code>&lt;hr&gt;</code></pre>

                </div>

            </div>


            <!-- SIMPLE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Simple Example
                </h2>

                <pre><code>&lt;h2&gt;HTML Course&lt;/h2&gt;

&lt;p&gt;
    Learn HTML step-by-step.
&lt;/p&gt;

&lt;hr&gt;

&lt;h2&gt;CSS Course&lt;/h2&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


                <h3 class="h5 fw-bold mt-4">
                    Output
                </h3>

                <div class="example-box">

                    <h3>
                        HTML Course
                    </h3>

                    <p>
                        Learn HTML step-by-step.
                    </p>

                    <hr class="demo-rule" />

                    <h3 class="mb-0">
                        CSS Course
                    </h3>

                </div>

            </div>


            <!-- VOID ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Is &lt;hr&gt; a Void Element?
                </h2>

                <p>
                    Yes. The <code>&lt;hr&gt;</code> element is a void element.
                    It does not contain content and does not need a closing tag.
                </p>

                <pre><code>&lt;hr&gt;</code></pre>

                <div class="alert alert-warning">

                    <strong>Important:</strong>

                    Do not use a normal closing tag such as
                    <code>&lt;/hr&gt;</code>.

                </div>

            </div>


            <!-- PURPOSE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Purpose of the &lt;hr&gt; Element
                </h2>

                <p>
                    The <code>&lt;hr&gt;</code> element can be used when there
                    is a meaningful change or separation between sections.
                </p>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Content Separation
                            </h5>

                            <p class="mb-0">
                                Separates one topic or section from another.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Thematic Break
                            </h5>

                            <p class="mb-0">
                                Represents a change in subject or section
                                within the document.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Visual Separation
                            </h5>

                            <p class="mb-0">
                                Browsers commonly render it as a horizontal
                                separator.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Document Organization
                            </h5>

                            <p class="mb-0">
                                Helps readers recognize transitions between
                                sections of content.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- MULTIPLE RULES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Multiple Horizontal Rules
                </h2>

                <p>
                    Multiple <code>&lt;hr&gt;</code> elements can be used
                    when separate sections need to be divided.
                </p>

                <pre><code>&lt;h2&gt;Introduction&lt;/h2&gt;

&lt;p&gt;
    Learn the basics of HTML.
&lt;/p&gt;

&lt;hr&gt;

&lt;h2&gt;HTML Elements&lt;/h2&gt;

&lt;p&gt;
    Learn about HTML elements.
&lt;/p&gt;

&lt;hr&gt;

&lt;h2&gt;HTML Attributes&lt;/h2&gt;

&lt;p&gt;
    Learn how attributes work.
&lt;/p&gt;</code></pre>



<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <h3>
                        Introduction
                    </h3>

                    <p>
                        Learn the basics of HTML.
                    </p>

                    <hr class="demo-rule" />

                    <h3>
                        HTML Elements
                    </h3>

                    <p>
                        Learn about HTML elements.
                    </p>

                    <hr class="demo-rule" />

                    <h3>
                        HTML Attributes
                    </h3>

                    <p class="mb-0">
                        Learn how attributes work.
                    </p>

                </div>

            </div>


            <!-- HR WITH HEADINGS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using &lt;hr&gt; with Headings
                </h2>

                <pre><code>&lt;h1&gt;Web Development&lt;/h1&gt;

&lt;p&gt;
    Learn web technologies.
&lt;/p&gt;

&lt;hr&gt;

&lt;h2&gt;HTML&lt;/h2&gt;

&lt;p&gt;
    Learn the structure of web pages.
&lt;/p&gt;</code></pre>

            </div>
            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <!-- HR WITH PARAGRAPHS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using &lt;hr&gt; with Paragraphs
                </h2>

                <pre><code>&lt;p&gt;
    HTML provides structure.
&lt;/p&gt;

&lt;hr&gt;

&lt;p&gt;
    CSS controls presentation.
&lt;/p&gt;

&lt;hr&gt;

&lt;p&gt;
    JavaScript adds behavior.
&lt;/p&gt;</code></pre>



<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p>
                        HTML provides structure.
                    </p>

                    <hr class="demo-rule" />

                    <p>
                        CSS controls presentation.
                    </p>

                    <hr class="demo-rule" />

                    <p class="mb-0">
                        JavaScript adds behavior.
                    </p>

                </div>

            </div>


            <!-- STYLING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Styling the Horizontal Rule with CSS
                </h2>

                <p>
                    CSS can be used to change the appearance of an
                    <code>&lt;hr&gt;</code> element.
                </p>

                <pre><code>&lt;hr class="custom-rule"&gt;

&lt;style&gt;

    .custom-rule {
        border: 0;
        border-top: 3px solid blue;
    }

&lt;/style&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <hr class="demo-rule" />

                    <p class="mb-0">
                        This horizontal rule is styled using CSS.
                    </p>

                </div>

            </div>


            <!-- DIFFERENT STYLES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Different Horizontal Rule Styles
                </h2>

                <p>
                    CSS can control the width, color, thickness, spacing,
                    and other visual properties of a horizontal rule.
                </p>

                <div class="example-box">

                    <p>
                        Solid Rule
                    </p>

                    <hr style="border: 0; border-top: 2px solid #6f42c1;" />

                    <p>
                        Dashed Rule
                    </p>

                    <hr style="border: 0; border-top: 2px dashed #2563eb;" />

                    <p>
                        Dotted Rule
                    </p>

                    <hr style="border: 0; border-top: 3px dotted #16a34a;" />

                </div>

            </div>


            <!-- HTML VS CSS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    HTML Structure vs CSS Styling
                </h2>

                <p>
                    HTML provides the semantic element, while CSS can control
                    how that element looks.
                </p>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Technology</th>
                                <th>Responsibility</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    HTML
                                </td>

                                <td>
                                    Defines the horizontal thematic break
                                    using <code>&lt;hr&gt;</code>.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    CSS
                                </td>

                                <td>
                                    Controls the visual appearance of the rule.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- WHEN TO USE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    When Should You Use &lt;hr&gt;?
                </h2>

                <ul>

                    <li class="mb-2">
                        When there is a meaningful thematic change in content.
                    </li>

                    <li class="mb-2">
                        When separate sections need to be visually distinguished.
                    </li>

                    <li class="mb-2">
                        When the document benefits from a clear section divider.
                    </li>

                    <li>
                        When the break has semantic meaning rather than being
                        used only for decorative spacing.
                    </li>

                </ul>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;hr&gt;</code> only to create empty space.
                    </li>

                    <li class="mb-2">
                        Trying to use <code>&lt;/hr&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Creating many unnecessary horizontal rules.
                    </li>

                    <li>
                        Using the element for decorative purposes when a CSS
                        border may be more appropriate.
                    </li>

                </ul>

            </div>


            <!-- COMPLETE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Complete Example
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;
        Horizontal Rule Example
    &lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;
        Web Development
    &lt;/h1&gt;

    &lt;p&gt;
        Learn the basics of web development.
    &lt;/p&gt;

    &lt;hr&gt;

    &lt;h2&gt;
        HTML
    &lt;/h2&gt;

    &lt;p&gt;
        HTML defines the structure of web pages.
    &lt;/p&gt;

    &lt;hr&gt;

    &lt;h2&gt;
        CSS
    &lt;/h2&gt;

    &lt;p&gt;
        CSS controls the visual presentation.
    &lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>
            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a page with three different sections.
                    </li>

                    <li class="mb-2">
                        Add a heading and paragraph to each section.
                    </li>

                    <li class="mb-2">
                        Use <code>&lt;hr&gt;</code> between the sections.
                    </li>

                    <li class="mb-2">
                        Use CSS to change the appearance of one horizontal rule.
                    </li>

                    <li>
                        Compare the result with and without the horizontal rules.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>&lt;hr&gt;</code> element represents a thematic
                    break between sections of HTML content. It is a void
                    element and does not require a closing tag. CSS can be
                    used to control its visual appearance, while the HTML
                    element provides the document structure.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("LineBreaks", "BasicHTML", new { area = "HTML" })">

                    ← Previous: Line Breaks

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Index", "Tags", new { area = "HTML" })">

                    Next: HTML Tags →

                </a>

            </div>


        </section>

    </div>

</main>