@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Headings";
}

<style>

    #html-headings-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-headings-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-headings-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-headings-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-headings-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-headings-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

</style>


<main id="html-headings-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Headings
                </h1>

                <p class="lead">
                    Learn how to use HTML headings from
                    <code>&lt;h1&gt;</code> to <code>&lt;h6&gt;</code>
                    to organize and structure web page content.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What are HTML Headings?
                </h2>

                <p>
                    HTML headings are used to define titles and section headings
                    on a web page.
                </p>

                <p>
                    HTML provides six heading levels, starting from
                    <code>&lt;h1&gt;</code> and going up to
                    <code>&lt;h6&gt;</code>.
                </p>

                <div class="alert alert-info">

                    <strong>Heading Levels:</strong>

                    <code>&lt;h1&gt;</code>,
                    <code>&lt;h2&gt;</code>,
                    <code>&lt;h3&gt;</code>,
                    <code>&lt;h4&gt;</code>,
                    <code>&lt;h5&gt;</code>,
                    <code>&lt;h6&gt;</code>

                </div>

            </div>


            <!-- ALL HEADING LEVELS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Six Levels of HTML Headings
                </h2>

                <pre><code>&lt;h1&gt;Heading 1&lt;/h1&gt;
&lt;h2&gt;Heading 2&lt;/h2&gt;
&lt;h3&gt;Heading 3&lt;/h3&gt;
&lt;h4&gt;Heading 4&lt;/h4&gt;
&lt;h5&gt;Heading 5&lt;/h5&gt;
&lt;h6&gt;Heading 6&lt;/h6&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <h1>Heading 1</h1>
                    <h2>Heading 2</h2>
                    <h3>Heading 3</h3>
                    <h4>Heading 4</h4>
                    <h5>Heading 5</h5>
                    <h6>Heading 6</h6>

                </div>

            </div>


            <!-- H1 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    1. &lt;h1&gt; - Main Heading
                </h2>

                <p>
                    The <code>&lt;h1&gt;</code> element is normally used for
                    the main heading of a page or the main topic of a document.
                </p>

                <pre><code>&lt;h1&gt;Introduction to HTML&lt;/h1&gt;</code></pre>

                <div class="example-box">

                    <h1>
                        Introduction to HTML
                    </h1>

                </div>

            </div>


            <!-- H2 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    2. &lt;h2&gt; - Section Heading
                </h2>

                <p>
                    The <code>&lt;h2&gt;</code> element is commonly used for
                    major sections under the main heading.
                </p>

                <pre><code>&lt;h2&gt;HTML Elements&lt;/h2&gt;</code></pre>

                <div class="example-box">

                    <h2>
                        HTML Elements
                    </h2>

                </div>

            </div>


            <!-- H3 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    3. &lt;h3&gt; - Subsection Heading
                </h2>

                <p>
                    The <code>&lt;h3&gt;</code> element can be used for
                    subsections within an <code>&lt;h2&gt;</code> section.
                </p>

                <pre><code>&lt;h3&gt;HTML Attributes&lt;/h3&gt;</code></pre>

                <div class="example-box">

                    <h3>
                        HTML Attributes
                    </h3>

                </div>

            </div>


            <!-- H4 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    4. &lt;h4&gt; - Smaller Section Heading
                </h2>

                <p>
                    The <code>&lt;h4&gt;</code> element is used for a deeper
                    subsection level when required.
                </p>

                <pre><code>&lt;h4&gt;Global Attributes&lt;/h4&gt;</code></pre>

                <div class="example-box">

                    <h4>
                        Global Attributes
                    </h4>

                </div>

            </div>


            <!-- H5 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    5. &lt;h5&gt; - Smaller Heading
                </h2>

                <p>
                    The <code>&lt;h5&gt;</code> element represents a lower-level
                    heading in the document hierarchy.
                </p>

                <pre><code>&lt;h5&gt;Additional Information&lt;/h5&gt;</code></pre>

                <div class="example-box">

                    <h5>
                        Additional Information
                    </h5>

                </div>

            </div>


            <!-- H6 -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    6. &lt;h6&gt; - Lowest Heading Level
                </h2>

                <p>
                    The <code>&lt;h6&gt;</code> element is the lowest of the
                    six standard HTML heading levels.
                </p>

                <pre><code>&lt;h6&gt;Smallest Heading Level&lt;/h6&gt;</code></pre>

                <div class="example-box">

                    <h6>
                        Smallest Heading Level
                    </h6>

                </div>

            </div>


            <!-- HEADING HIERARCHY -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Heading Hierarchy
                </h2>

                <p>
                    Headings should generally be organized in a logical hierarchy
                    so that users and assistive technologies can understand the
                    structure of the document.
                </p>

                <pre><code>&lt;h1&gt;Web Development&lt;/h1&gt;

    &lt;h2&gt;HTML&lt;/h2&gt;

        &lt;h3&gt;HTML Elements&lt;/h3&gt;

        &lt;h3&gt;HTML Attributes&lt;/h3&gt;

    &lt;h2&gt;CSS&lt;/h2&gt;

        &lt;h3&gt;Selectors&lt;/h3&gt;

        &lt;h3&gt;Properties&lt;/h3&gt;</code></pre>
        <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="concept-box">

                    <h1 class="h3">
                        Web Development
                    </h1>

                    <div class="ms-4">

                        <h2 class="h4">
                            HTML
                        </h2>

                        <div class="ms-4">

                            <h3 class="h5">
                                HTML Elements
                            </h3>

                            <h3 class="h5">
                                HTML Attributes
                            </h3>

                        </div>

                        <h2 class="h4">
                            CSS
                        </h2>

                        <div class="ms-4">

                            <h3 class="h5">
                                Selectors
                            </h3>

                            <h3 class="h5">
                                Properties
                            </h3>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HEADING AND SEO -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Headings and Page Structure
                </h2>

                <p>
                    Headings help organize content into meaningful sections.
                    A well-structured heading hierarchy makes a page easier
                    to understand and navigate.
                </p>

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Better Readability
                            </h5>

                            <p class="mb-0">
                                Headings break large amounts of content into
                                understandable sections.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Better Organization
                            </h5>

                            <p class="mb-0">
                                Headings create a logical structure for
                                different topics and subtopics.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Accessibility
                            </h5>

                            <p class="mb-0">
                                Assistive technologies can use headings to
                                help users navigate page sections.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Content Structure
                            </h5>

                            <p class="mb-0">
                                Headings clearly separate major sections
                                and subsections.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- COMMON MISTAKE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistake
                </h2>

                <p>
                    Headings should not be selected only because of their
                    visual size.
                </p>

                <p>
                    The heading level should represent the logical position
                    of the content in the document structure.
                </p>

                <div class="alert alert-warning">

                    <strong>Example:</strong>

                    Do not use <code>&lt;h4&gt;</code> simply because you want
                    smaller text. Use the appropriate CSS when visual size
                    needs to be changed.

                </div>

            </div>


            <!-- HEADING VS CSS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Heading Structure vs Visual Styling
                </h2>

                <p>
                    HTML headings define document structure, while CSS can
                    control their visual appearance.
                </p>

                <pre><code>&lt;h1 class="page-title"&gt;
    CIIT INSTITUTE ❤️
&lt;/h1&gt;

&lt;style&gt;

    .page-title {
        font-size: 32px;
        color: #4c1d95;
    }

&lt;/style&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

                <div class="example-box">

                    <h1 style="font-size: 32px; color: #4c1d95;">
                        CIIT INSTITUTE ❤️
                    </h1>

                </div>

            </div>


            <!-- COMPLETE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Complete Example
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;Heading Example&lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;Web Development&lt;/h1&gt;

    &lt;h2&gt;HTML&lt;/h2&gt;

    &lt;h3&gt;HTML Elements&lt;/h3&gt;

    &lt;p&gt;
        HTML elements are the building blocks of web pages.
    &lt;/p&gt;

    &lt;h3&gt;HTML Attributes&lt;/h3&gt;

    &lt;p&gt;
        Attributes provide additional information about elements.
    &lt;/p&gt;

    &lt;h2&gt;CSS&lt;/h2&gt;

    &lt;h3&gt;CSS Basics&lt;/h3&gt;

    &lt;p&gt;
        CSS controls the visual appearance of HTML content.
    &lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>
            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>

            <!-- QUICK REFERENCE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Heading Quick Reference
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Element
                                </th>

                                <th>
                                    Typical Use
                                </th>

                                <th>
                                    Example
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;h1&gt;</code>
                                </td>

                                <td>
                                    Main page or document heading
                                </td>

                                <td>
                                    <code>&lt;h1&gt;HTML Course&lt;/h1&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h2&gt;</code>
                                </td>

                                <td>
                                    Major section heading
                                </td>

                                <td>
                                    <code>&lt;h2&gt;HTML Basics&lt;/h2&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h3&gt;</code>
                                </td>

                                <td>
                                    Subsection heading
                                </td>

                                <td>
                                    <code>&lt;h3&gt;Elements&lt;/h3&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h4&gt;</code>
                                </td>

                                <td>
                                    Lower-level subsection
                                </td>

                                <td>
                                    <code>&lt;h4&gt;Details&lt;/h4&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h5&gt;</code>
                                </td>

                                <td>
                                    Lower-level heading
                                </td>

                                <td>
                                    <code>&lt;h5&gt;Additional Details&lt;/h5&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;h6&gt;</code>
                                </td>

                                <td>
                                    Lowest heading level
                                </td>

                                <td>
                                    <code>&lt;h6&gt;Notes&lt;/h6&gt;</code>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create an <code>&lt;h1&gt;</code> containing your website name.
                    </li>

                    <li class="mb-2">
                        Create an <code>&lt;h2&gt;</code> for a major section.
                    </li>

                    <li class="mb-2">
                        Add two <code>&lt;h3&gt;</code> subsections.
                    </li>

                    <li class="mb-2">
                        Add paragraphs under each subsection.
                    </li>

                    <li class="mb-2">
                        Organize the headings in a logical hierarchy.
                    </li>

                    <li>
                        Use CSS only when you need to change the visual appearance.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    HTML provides six heading levels from
                    <code>&lt;h1&gt;</code> to <code>&lt;h6&gt;</code>.
                    Headings help organize content into a logical hierarchy.
                    Use heading levels according to the structure of the content,
                    and use CSS to control visual styling.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("HTMLAttributes", "BasicHTML", new { area = "HTML" })">

                    ← Previous: HTML Attributes

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("Paragraphs", "BasicHTML", new { area = "HTML" })">

                    Next: Paragraphs →

                </a>

            </div>


        </section>

    </div>

</main>