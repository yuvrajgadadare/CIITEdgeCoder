@{
    Layout = "~/Areas/HTML/Views/Shared/HTMLLayout.cshtml";
    ViewData["Title"] = "HTML Line Breaks";
}

<style>

    #html-line-breaks-page pre {
        background-color: #212529 !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 16px !important;
        overflow-x: auto;
        margin-top: 12px;
    }

        #html-line-breaks-page pre code {
            background: transparent !important;
            color: #ffffff !important;
        }

    #html-line-breaks-page .concept-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
    }

    #html-line-breaks-page .info-card {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
    }

        #html-line-breaks-page .info-card h5 {
            color: #5b21b6;
            font-weight: 700;
            margin-bottom: 10px;
        }

    #html-line-breaks-page .example-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
    }

    #html-line-breaks-page .table-responsive {
        margin-top: 15px;
    }

</style>


<main id="html-line-breaks-page"
      class="container py-5">

    <div class="row g-4">


        <!-- LEFT SIDEBAR -->
        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/HTML/Views/Shared/HTMLTopics.cshtml"
            )

        </aside>


        <!-- MAIN CONTENT -->
        <section class="col-lg-9">


            <!-- PAGE TITLE -->
            <div class="mb-4">

                <h1 class="fw-bold">
                    HTML Line Breaks
                </h1>

                <p class="lead">
                    Learn how to create line breaks in HTML and understand
                    when to use the <code>&lt;br&gt;</code> element.
                </p>

            </div>


            <!-- INTRODUCTION -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    What is a Line Break?
                </h2>

                <p>
                    A line break moves the following content to a new line
                    without creating a new paragraph.
                </p>

                <p>
                    HTML provides the <code>&lt;br&gt;</code> element for
                    inserting a line break inside text or other content.
                </p>

                <div class="alert alert-info">

                    <strong>Basic Syntax:</strong>

                    <pre class="mb-0 mt-3"><code>&lt;br&gt;</code></pre>

                </div>

            </div>


            <!-- SIMPLE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Simple Example
                </h2>

                <pre><code>&lt;p&gt;
    Hello&lt;br&gt;
    Welcome to HTML
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


                <h3 class="h5 fw-bold mt-4">
                    Output
                </h3>

                <div class="example-box">

                    <p class="mb-0">
                        Hello<br />
                        Welcome to HTML
                    </p>

                </div>

            </div>


            <!-- MULTIPLE LINE BREAKS -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Multiple Line Breaks
                </h2>

                <p>
                    Multiple <code>&lt;br&gt;</code> elements can be used
                    when several separate line breaks are required.
                </p>

                <pre><code>&lt;p&gt;
    HTML&lt;br&gt;
    CSS&lt;br&gt;
    JavaScript
&lt;/p&gt;</code></pre>

<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        HTML<br />
                        CSS<br />
                        JavaScript
                    </p>

                </div>

            </div>


            <!-- BR INSIDE PARAGRAPH -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Using &lt;br&gt; Inside a Paragraph
                </h2>

                <p>
                    The <code>&lt;br&gt;</code> element is often used inside
                    a paragraph when content needs to continue on a new line.
                </p>

                <pre><code>&lt;p&gt;
    Welcome to CIIT Institute.&lt;br&gt;
    Learn HTML step-by-step.&lt;br&gt;
    Start your web development journey.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">
                        Welcome to CIIT Institute.<br />
                        Learn HTML step-by-step.<br />
                        Start your web development journey.
                    </p>

                </div>

            </div>


            <!-- ADDRESS EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Example: Address 👀🤓
                </h2>

                <p>
                    The <code>&lt;br&gt;</code> element can be useful when
                    separate lines are meaningful, such as an address.
                </p>

                <pre><code>&lt;address&gt;
    CIIT Institute&lt;br&gt;
    Hadapsar, Pune&lt;br&gt;
    Maharashtra, India
&lt;/address&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


                <h3 class="h5 fw-bold mt-4">
                    Output
                </h3>

                <div class="example-box">

                    <address class="mb-0">
                        CIIT Institute<br />
                        Hadapsar, Pune<br />
                        Maharashtra, India
                    </address>

                </div>

            </div>


            <!-- POETRY EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Line Breaks for Poetry or Lyrics
                </h2>

                <p>
                    Line breaks can also be useful where preserving individual
                    lines is part of the meaning of the content.
                </p>

                <pre><code>&lt;p&gt;
    Learn HTML every day.&lt;br&gt;
    Build websites step by step.&lt;br&gt;
    Practice and improve.&lt;br&gt;
    Keep learning.
&lt;/p&gt;</code></pre>
<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        Learn HTML every day.<br />
                        Build websites step by step.<br />
                        Practice and improve.<br />
                        Keep learning.
                    </p>

                </div>

            </div>


            <!-- BR VS P -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    &lt;br&gt; vs &lt;p&gt;
                </h2>

                <p>
                    The <code>&lt;br&gt;</code> and <code>&lt;p&gt;</code>
                    elements are not interchangeable.
                </p>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Element</th>
                                <th>Purpose</th>
                                <th>Example</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    <code>&lt;p&gt;</code>
                                </td>

                                <td>
                                    Defines a paragraph of content.
                                </td>

                                <td>
                                    <code>&lt;p&gt;Hello&lt;/p&gt;</code>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    <code>&lt;br&gt;</code>
                                </td>

                                <td>
                                    Inserts a line break within content.
                                </td>

                                <td>
                                    <code>Hello&lt;br&gt;World</code>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- BR IS VOID ELEMENT -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Is &lt;br&gt; a Container Element?
                </h2>

                <p>
                    No. The <code>&lt;br&gt;</code> element is a void element.
                    It does not contain content and does not require a closing tag.
                </p>

                <pre><code>&lt;br&gt;</code></pre>

                <div class="alert alert-warning">

                    <strong>Important:</strong>

                    Do not write a normal closing tag such as
                    <code>&lt;/br&gt;</code>.

                </div>

            </div>


            <!-- BR WITH TEXT FORMATTING -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Line Breaks with Formatted Text
                </h2>

                <pre><code>&lt;p&gt;
    Learn &lt;strong&gt;HTML&lt;/strong&gt;&lt;br&gt;
    Learn &lt;em&gt;CSS&lt;/em&gt;&lt;br&gt;
    Learn JavaScript
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>

                <div class="example-box">

                    <p class="mb-0">
                        Learn <strong>HTML</strong><br />
                        Learn <em>CSS</em><br />
                        Learn JavaScript
                    </p>

                </div>

            </div>


            <!-- BR WITH LINK -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Line Breaks with Links
                </h2>

                <pre><code>&lt;p&gt;
    &lt;a href="#"&gt;HTML Course&lt;/a&gt;&lt;br&gt;
    &lt;a href="#"&gt;CSS Course&lt;/a&gt;&lt;br&gt;
    &lt;a href="#"&gt;JavaScript Course&lt;/a&gt;
&lt;/p&gt;</code></pre>


<div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>
<h3 class="h5 fw-bold mt-4">
    Output
</h3>
                <div class="example-box">

                    <p class="mb-0">

                        <a href="#">
                            HTML Course
                        </a><br />

                        <a href="#">
                            CSS Course
                        </a><br />

                        <a href="#">
                            JavaScript Course
                        </a>

                    </p>

                </div>

            </div>


            <!-- WHEN TO USE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    When Should You Use &lt;br&gt;?
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Useful
                            </h5>

                            <ul class="mb-0">

                                <li>
                                    Addresses
                                </li>

                                <li>
                                    Short line-based content
                                </li>

                                <li>
                                    Content where line separation is meaningful
                                </li>

                                <li>
                                    Specific text formatting requirements
                                </li>

                            </ul>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-card">

                            <h5>
                                Avoid for Spacing
                            </h5>

                            <p class="mb-0">
                                Do not use repeated <code>&lt;br&gt;</code>
                                elements simply to create large amounts of
                                vertical spacing. CSS is generally more
                                appropriate for layout and spacing.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- COMMON MISTAKES -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Common Mistakes
                </h2>

                <ul>

                    <li class="mb-2">
                        Using <code>&lt;br&gt;</code> repeatedly for layout spacing.
                    </li>

                    <li class="mb-2">
                        Trying to use <code>&lt;/br&gt;</code> as a closing tag.
                    </li>

                    <li class="mb-2">
                        Using many line breaks instead of using proper HTML
                        structure and CSS.
                    </li>

                    <li>
                        Using a line break when a separate paragraph or section
                        would be more appropriate.
                    </li>

                </ul>

            </div>


            <!-- COMPLETE EXAMPLE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Complete Example
                </h2>

                <pre><code>&lt;!DOCTYPE html&gt;

&lt;html&gt;

&lt;head&gt;

    &lt;title&gt;
        Line Break Example
    &lt;/title&gt;

&lt;/head&gt;

&lt;body&gt;

    &lt;h1&gt;
        CIIT Institute
    &lt;/h1&gt;

    &lt;p&gt;
        Learn HTML.&lt;br&gt;
        Learn CSS.&lt;br&gt;
        Learn JavaScript.
    &lt;/p&gt;

    &lt;p&gt;
        Build websites.&lt;br&gt;
        Practice regularly.&lt;br&gt;
        Keep learning.
    &lt;/p&gt;

&lt;/body&gt;

&lt;/html&gt;</code></pre>

            </div>

            <div class="try-it-container">
    <button type="button"
            class="try-it-btn"
            onclick="tryHTML(this)">
        Try It
    </button>
</div>


            <!-- PRACTICE -->
            <div class="mb-4">

                <h2 class="h3 fw-bold">
                    Practice Exercise
                </h2>

                <ol>

                    <li class="mb-2">
                        Create a paragraph containing your name and details.
                    </li>

                    <li class="mb-2">
                        Put each detail on a new line using
                        <code>&lt;br&gt;</code>.
                    </li>

                    <li class="mb-2">
                        Create an address using line breaks.
                    </li>

                    <li class="mb-2">
                        Create three course links and place each link on
                        a separate line.
                    </li>

                    <li>
                        Compare the result of using multiple paragraphs
                        with using line breaks.
                    </li>

                </ol>

            </div>


            <!-- SUMMARY -->
            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>&lt;br&gt;</code> element inserts a line break
                    without creating a new paragraph. It is a void element
                    and does not require a closing tag. Line breaks are useful
                    when the separation of individual lines is meaningful,
                    while CSS should generally be used for layout and spacing.
                </p>

            </div>


            <!-- NAVIGATION -->
            <div class="d-flex justify-content-between mt-4">

                <a class="btn btn-outline-primary"
                   href="@Url.Action("Comments", "BasicHTML", new { area = "HTML" })">

                    ← Previous: Comments

                </a>

                <a class="btn btn-primary"
                   href="@Url.Action("HorizontalRules", "BasicHTML", new { area = "HTML" })">

                    Next: Horizontal Rules →

                </a>

            </div>


        </section>

    </div>

</main>