<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CIIT Institute | Learn CSS Step-by-Step</title>

    <script type="importmap"></script>

    <!-- ===================================================== -->
    <!-- BOOTSTRAP -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ===================================================== -->
    <!-- SITE CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- ===================================================== -->
    <!-- PROJECT CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/CIITEdge.styles.css"
          asp-append-version="true" />

    <!-- ===================================================== -->
    <!-- BOOTSTRAP JS -->
    <!-- ===================================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <style>

        /* ===================================================== */
        /* SAME THEME AS HTML / C# / CORE JAVA / PYTHON */
        /* ===================================================== */

        :root {
            --brand-purple: #4c1d95;
            --brand-purple-dark: #2e1065;
            --syntax-bg: #0f172a;
        }


        /* ===================================================== */
        /* HERO GRADIENT */
        /* ===================================================== */

        .bg-brand-gradient {
            background: linear-gradient(
                135deg,
                var(--brand-purple-dark) 0%,
                #312e81 100%
            );
        }


        /* ===================================================== */
        /* NAVBAR BRAND */
        /* ===================================================== */

        .navbar-brand span {
            color: #c084fc;
            font-weight: 900;
            letter-spacing: 0.05em;
        }


        /* ===================================================== */
        /* CODE BLOCK */
        /* ===================================================== */

        .code-block {
            background-color: var(--syntax-bg);
            color: #f1f5f9;
            padding: 1.5rem;
            border-radius: 0.5rem;
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.875rem;
            line-height: 1.6;
            position: relative;
            overflow-x: auto;
        }


        /* ===================================================== */
        /* CODE LANGUAGE TAG */
        /* ===================================================== */

        .code-lang-tag {
            position: absolute;
            top: 0.5rem;
            right: 1rem;
            font-size: 0.75rem;
            color: #64748b;
            user-select: none;
        }


        /* ===================================================== */
        /* CODE COLORS */
        /* ===================================================== */

        .keyword {
            color: #c084fc;
        }

        .class-name {
            color: #34d399;
        }

        .method-name {
            color: #fbbf24;
        }

        .string-lit {
            color: #fef08a;
        }


        /* ===================================================== */
        /* CODE EDITOR */
        /* ===================================================== */

        .editor-textarea {
            background-color: #1e1e1e !important;
            color: #d4d4d4 !important;
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.9rem;
            resize: vertical;
        }


        /* ===================================================== */
        /* TERMINAL OUTPUT */
        /* ===================================================== */

        .terminal-output {
            background-color: #000000;
            color: #f1f1f1;
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.85rem;
            min-height: 100px;
            white-space: pre-wrap;
        }


        /* ===================================================== */
        /* MOBILE */
        /* ===================================================== */

        @@media (max-width: 991.98px) {

            .navbar-nav {
                padding-top: 10px;
            }
        }

    </style>

</head>


<body class="bg-light text-dark">


    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->

    @Html.Partial("~/Views/Shared/Menus/MenusWithDropdown.cshtml")
    @Html.Partial("~/Views/Shared/Menus/ProgrammingMenus.cshtml")

    <!-- ===================================================== -->
    <!-- CSS HERO SECTION -->
    <!-- ===================================================== -->

    <header class="bg-brand-gradient text-white text-center py-5">

        <div class="container py-4">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <h1 class="display-4 fw-extrabold mb-3">

                        Master CSS From Scratch

                    </h1>

                    <p class="lead text-purple-100 mb-4 opacity-75">

                        Clear, interactive, and structured CSS lessons
                        designed for beginners.

                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main id="tutorials"
          class="container py-1">

        @RenderBody()

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="bg-dark text-muted text-center py-4 border-top border-secondary mt-5">

    </footer>


</body>

</html>