            color: #212529;
            font-weight: 700;
        }

        #css-pseudo-classes-page .content-section h2 {
            color: #212529;
            font-weight: 700;
        }

        #css-pseudo-classes-page .content-section p,
        #css-pseudo-classes-page .content-section li {
            color: #495057;
