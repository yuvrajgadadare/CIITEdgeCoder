        padding: 12px 22px;
        border-radius: 7px;
    }

        #css-pseudo-classes-page .active-button:active {
            background-color: #be123c;
        }

    /* First Child */
    #css-pseudo-classes-page .student-list li:first-child {
        color: #2563eb;
        font-weight: 700;
    }

    /* Last Child */
    #css-pseudo-classes-page .course-list li:last-child {
        color: #7c3aed;
        font-weight: 700;
    }

    /* Nth Child */
    #css-pseudo-classes-page .number-list li:nth-child(2) {
