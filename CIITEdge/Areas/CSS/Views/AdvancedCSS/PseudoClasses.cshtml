    }

    #css-pseudo-classes-page .checkbox-label {
        color: #495057;
        font-weight: 600;
    }

    /* Combined Button */
    #css-pseudo-classes-page .course-button {
        background-color: #2563eb;
        color: #ffffff;
        border: 0;
        padding: 12px 20px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
    }

        #css-pseudo-classes-page .course-button:hover {
            background-color: #7c3aed;
        }

        #css-pseudo-classes-page .course-button:active {
