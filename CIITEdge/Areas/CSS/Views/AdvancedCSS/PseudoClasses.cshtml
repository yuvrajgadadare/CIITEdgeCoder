        background-color: #fff8e1;
        border: 1px solid #ffd166;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 25px;
    }

        #css-pseudo-classes-page .note-box h3 {
            color: #92400e;
            font-weight: 700;
        }

        #css-pseudo-classes-page .note-box p {
            color: #78350f;
        }

    /* Summary */
    #css-pseudo-classes-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
