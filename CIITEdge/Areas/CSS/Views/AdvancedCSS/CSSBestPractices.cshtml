        object-fit: cover;
        display: block;
        border-radius: 12px;
        transition: transform 0.55s ease, filter 0.55s ease;
    }

        #css-best-practices-page .design-visual:hover .design-image,
        #css-best-practices-page .design-image:focus {
            transform: scale(1.07);
            filter: saturate(1.2) brightness(1.05);
