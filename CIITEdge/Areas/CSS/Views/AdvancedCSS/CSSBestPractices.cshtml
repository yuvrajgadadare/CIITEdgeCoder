    }

    #css-best-practices-page .do-card {
        background-color: #ecfdf5;
        border: 1px solid #86efac;
    }

    #css-best-practices-page .dont-card {
        background-color: #fff1f2;
        border: 1px solid #fda4af;
    }

    #css-best-practices-page .do-card h3 {
        color: #166534;
        font-weight: 700;
    }

    #css-best-practices-page .dont-card h3 {
        color: #be123c;
        font-weight: 700;
    }

    #css-best-practices-page .do-card li {
        color: #166534;
    }

    #css-best-practices-page .dont-card li {
        color: #9f1239;
    }

    /* Structure */
    #css-best-practices-page .structure-box {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin-top: 15px;
    }

    #css-best-practices-page .structure-item {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 16px;
        font-weight: 600;
        color: #212529;
    }

        #css-best-practices-page .structure-item span {
            display: inline-flex;
            width: 30px;
            height: 30px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: #2563eb;
            color: #ffffff;
            margin-right: 8px;
            font-size: 12px;
        }

    /* Benefits */
    #css-best-practices-page .benefit-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    #css-best-practices-page .benefit-card {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        text-align: center;
        transition: transform 0.3s ease;
    }

        #css-best-practices-page .benefit-card:hover {
            transform: translateY(-5px);
        }

        #css-best-practices-page .benefit-card strong {
            display: block;
            color: #2563eb;
            margin-bottom: 7px;
        }

        #css-best-practices-page .benefit-card span {
            color: #6c757d;
            font-size: 13px;
