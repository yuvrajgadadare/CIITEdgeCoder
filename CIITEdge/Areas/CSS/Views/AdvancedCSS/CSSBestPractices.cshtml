        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        text-align: center;
    }

        #css-best-practices-page .testing-card strong {
            display: block;
            color: #2563eb;
            margin-bottom: 6px;
        }

        #css-best-practices-page .testing-card span {
            font-size: 13px;
