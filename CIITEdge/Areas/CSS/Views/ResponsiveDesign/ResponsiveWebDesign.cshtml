@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Responsive Web Design";
}

<style>

    #responsive-web-design-page {
        color: #212529;
    }

        #responsive-web-design-page .content-section {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 30px;
        }

            #responsive-web-design-page .content-section > h1 {
                font-weight: 700;
                margin-bottom: 15px;
            }

            #responsive-web-design-page .content-section > h2 {
                font-weight: 700;
                margin-top: 35px;
                margin-bottom: 15px;
            }

            #responsive-web-design-page .content-section > h3 {
                font-weight: 600;
                margin-top: 25px;
                margin-bottom: 12px;
            }

            #responsive-web-design-page .content-section > p {
                line-height: 1.7;
            }

        #responsive-web-design-page .code-box {
            background-color: #212529;
            color: #f8f9fa;
            border-radius: 6px;
            padding: 18px;
            margin-top: 15px;
            overflow-x: auto;
        }

            #responsive-web-design-page .code-box pre {
                margin: 0;
                white-space: pre-wrap;
                font-family: Consolas, Monaco, monospace;
                font-size: 14px;
                line-height: 1.6;
            }

        #responsive-web-design-page .explanation-box {
            background-color: #f8f9fa;
            border-left: 4px solid #2563eb;
            border-radius: 4px;
            padding: 18px 20px;
            margin-top: 15px;
        }

            #responsive-web-design-page .explanation-box p:last-child {
                margin-bottom: 0;
            }

        #responsive-web-design-page .diagram-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 25px;
            margin-top: 15px;
        }

        #responsive-web-design-page .device-layout {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 25px;
            flex-wrap: wrap;
        }

        #responsive-web-design-page .device {
            border: 4px solid #212529;
            background-color: #ffffff;
            border-radius: 10px;
            padding: 12px;
            text-align: center;
        }

        #responsive-web-design-page .desktop-device {
            width: 300px;
            height: 190px;
        }

        #responsive-web-design-page .tablet-device {
            width: 220px;
            height: 160px;
        }

        #responsive-web-design-page .mobile-device {
            width: 120px;
            height: 180px;
        }

        #responsive-web-design-page .device-screen {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            height: 125px;
            margin-top: 10px;
        }

        #responsive-web-design-page .device-box {
            background-color: #2563eb;
            color: #ffffff;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        #responsive-web-design-page .tablet-device .device-screen {
            grid-template-columns: repeat(2, 1fr);
            height: 100px;
        }

        #responsive-web-design-page .mobile-device .device-screen {
            grid-template-columns: 1fr;
            height: 125px;
        }

        #responsive-web-design-page .browser-output {
            background-color: #ffffff;
            border: 1px solid #ced4da;
            border-radius: 6px;
            padding: 25px;
            margin-top: 15px;
        }

        #responsive-web-design-page .output-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 15px;
        }

        #responsive-web-design-page .output-item {
            background-color: lightblue;
            border: 2px solid blue;
            border-radius: 6px;
            padding: 25px 15px;
            text-align: center;
            font-weight: 700;
        }

        #responsive-web-design-page .output-header,
        #responsive-web-design-page .output-footer {
            grid-column: 1 / 3;
        }

        #responsive-web-design-page .property-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 18px;
            height: 100%;
            background-color: #ffffff;
        }

            #responsive-web-design-page .property-card h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #responsive-web-design-page .property-card p {
                line-height: 1.6;
                margin-bottom: 0;
            }

        #responsive-web-design-page .note-box {
            background-color: #fff3cd;
            border: 1px solid #ffecb5;
            border-radius: 6px;
            padding: 16px 18px;
            margin-top: 20px;
        }

        #responsive-web-design-page .summary-box {
            background-color: #e0f7fa;
            border: 1px solid #90e0ef;
            border-radius: 6px;
            padding: 18px 20px;
            margin-top: 30px;
        }

            #responsive-web-design-page .summary-box h2 {
                color: #075985;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #responsive-web-design-page .summary-box p {
                color: #075985;
                margin-bottom: 0;
                line-height: 1.6;
            }

    @@media (max-width: 991px) {

        #responsive-web-design-page .content-section {
            padding: 20px;
        }

        #responsive-web-design-page .output-layout {
            grid-template-columns: 1fr;
        }

        #responsive-web-design-page .output-header,
        #responsive-web-design-page .output-footer {
            grid-column: 1;
        }
    }

    @@media (max-width: 576px) {

        #responsive-web-design-page .desktop-device {
            width: 250px;
            height: 170px;
        }

        #responsive-web-design-page .tablet-device {
            width: 190px;
            height: 145px;
        }

        #responsive-web-design-page .mobile-device {
            width: 110px;
            height: 165px;
        }
    }

</style>


<div id="responsive-web-design-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- Title -->

                <h1>
                    Responsive Web Design
                </h1>

                <p>
                    Responsive Web Design is a web development
                    approach in which a website adapts its layout,
                    content, images, and other elements according to
                    the screen size and device.
                </p>

                <p>
                    A responsive website should provide a consistent
                    and usable experience on desktop computers,
                    tablets, and mobile devices.
                </p>


                <!-- What is RWD -->

                <h2>
                    What is Responsive Web Design?
                </h2>

                <div class="explanation-box">

                    <p>
                        Responsive Web Design means building a website
                        that can automatically adjust to different
                        screen sizes.
                    </p>

                    <p>
                        The same website can change its layout without
                        requiring a separate desktop and mobile version.
                    </p>

                </div>


                <!-- Diagram -->

                <h2>
                    Responsive Web Design Diagram
                </h2>

                <div class="diagram-box">

                    <div class="device-layout">


                        <!-- Desktop -->

                        <div class="device desktop-device">

                            <strong>
                                Desktop
                            </strong>

                            <div class="device-screen">

                                <div class="device-box">
                                    Header
                                </div>

                                <div class="device-box">
                                    Main
                                </div>

                                <div class="device-box">
                                    Sidebar
                                </div>

                            </div>

                        </div>


                        <!-- Tablet -->

                        <div class="device tablet-device">

                            <strong>
                                Tablet
                            </strong>

                            <div class="device-screen">

                                <div class="device-box">
                                    Header
                                </div>

                                <div class="device-box">
                                    Main
                                </div>

                                <div class="device-box">
                                    Sidebar
                                </div>

                            </div>

                        </div>


                        <!-- Mobile -->

                        <div class="device mobile-device">

                            <strong>
                                Mobile
                            </strong>

                            <div class="device-screen">

                                <div class="device-box">
                                    Header
                                </div>

                                <div class="device-box">
                                    Main
                                </div>

                                <div class="device-box">
                                    Sidebar
                                </div>

                            </div>

                        </div>

                    </div>

                    <p class="text-center mt-4 mb-0">
                        The layout adapts to the available screen size.
                    </p>

                </div>


                <!-- Responsive Layout -->

                <h2>
                    Responsive Layout
                </h2>

                <p>
                    A responsive layout uses flexible CSS techniques
                    so that elements can resize or rearrange when the
                    available screen space changes.
                </p>

                <div class="code-box">

                    <pre><code>.container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

@@media (max-width: 768px) {
    .container {
        grid-template-columns: 1fr;
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        On larger screens, the layout contains two
                        columns.
                    </p>

                    <p>
                        The first column uses
                        <strong>2fr</strong> and the second column
                        uses <strong>1fr</strong>.
                    </p>

                    <p>
                        When the screen width becomes
                        <strong>768px or smaller</strong>, the layout
                        changes to one column.
                    </p>

                </div>


                <!-- Flexible Width -->

                <h2>
                    Flexible Widths
                </h2>

                <p>
                    Percentage values can be used to create flexible
                    widths that adjust according to the parent
                    container.
                </p>

                <div class="code-box">

                    <pre><code>.container {
    width: 80%;
}

.content {
    width: 60%;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The container takes
                        <strong>80%</strong> of the available width.
                    </p>

                    <p>
                        The content element takes
                        <strong>60%</strong> of its parent width.
                    </p>

                </div>


                <!-- Responsive Grid -->

                <h2>
                    Responsive Grid
                </h2>

                <div class="code-box">

                    <pre><code>.cards {
    display: grid;
    grid-template-columns:
        repeat(3, 1fr);
    gap: 20px;
}

@@media (max-width: 768px) {
    .cards {
        grid-template-columns: 1fr;
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        Three equal columns are displayed on larger
                        screens.
                    </p>

                    <p>
                        At
                        <strong>768px</strong>
                        or below, the cards are displayed in a
                        single column.
                    </p>

                </div>


                <!-- Responsive Images -->

                <h2>
                    Responsive Images
                </h2>

                <p>
                    Images should be able to shrink according to the
                    width of their parent container.
                </p>

                <div class="code-box">

                    <pre><code>img {
    max-width: 100%;
    height: auto;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        <strong>max-width: 100%;</strong>
                        prevents the image from becoming wider than
                        its parent container.
                    </p>

                    <p>
                        <strong>height: auto;</strong>
                        maintains the image's original aspect ratio.
                    </p>

                </div>


                <!-- Responsive Typography -->

                <h2>
                    Responsive Typography
                </h2>

                <p>
                    Text should remain readable on different screen
                    sizes.
                </p>

                <div class="code-box">

                    <pre><code>h1 {
    font-size: 40px;
}

@@media (max-width: 768px) {
    h1 {
        font-size: 28px;
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        On larger screens, the heading size is
                        <strong>40px</strong>.
                    </p>

                    <p>
                        On screens up to
                        <strong>768px</strong>,
                        the heading size becomes
                        <strong>28px</strong>.
                    </p>

                </div>


                <!-- Navigation -->

                <h2>
                    Responsive Navigation
                </h2>

                <p>
                    Navigation menus may also need to change their
                    arrangement on smaller screens.
                </p>

                <div class="code-box">

                    <pre><code>.navigation {
    display: flex;
    gap: 20px;
}

@@media (max-width: 768px) {
    .navigation {
        flex-direction: column;
        gap: 10px;
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        On larger screens, navigation items are placed
                        horizontally.
                    </p>

                    <p>
                        On smaller screens, they are arranged
                        vertically.
                    </p>

                </div>


                <!-- Output -->

                <h2>
                    Output
                </h2>

                <div class="browser-output">

                    <div class="output-layout">

                        <div class="output-item output-header">
                            Header
                        </div>

                        <div class="output-item">
                            Main Content
                        </div>

                        <div class="output-item">
                            Sidebar
                        </div>

                        <div class="output-item output-footer">
                            Footer
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    On smaller screens, the main content and sidebar
                    can move into a single-column layout.
                </p>


                <!-- Important Techniques -->

                <h2>
                    Important Responsive Web Design Techniques
                </h2>

                <div class="row g-3">


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Flexible Layout
                            </h3>

                            <p>
                                Use flexible widths and layouts that
                                can adapt to available space.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Responsive Grid
                            </h3>

                            <p>
                                Use CSS Grid to rearrange content
                                according to screen size.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Responsive Images
                            </h3>

                            <p>
                                Allow images to scale within their
                                parent containers.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Media Queries
                            </h3>

                            <p>
                                Apply different CSS rules at different
                                screen widths.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Flexible Typography
                            </h3>

                            <p>
                                Adjust text sizes to maintain
                                readability on different devices.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Mobile Layout
                            </h3>

                            <p>
                                Rearrange content so that it remains
                                usable on smaller screens.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Real World -->

                <h2>
                    Real-World Uses
                </h2>

                <ul>

                    <li>
                        Business websites
                    </li>

                    <li>
                        E-commerce websites
                    </li>

                    <li>
                        Training institute websites
                    </li>

                    <li>
                        Portfolio websites
                    </li>

                    <li>
                        Blogs and news websites
                    </li>

                    <li>
                        Web applications
                    </li>

                </ul>


                <!-- Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    Responsive Web Design combines flexible layouts,
                    CSS Grid, Flexbox, media queries, responsive
                    images, and appropriate typography to make a
                    website usable across different screen sizes.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        Responsive Web Design allows a website to
                        adapt its layout and content to different
                        devices and screen sizes. Flexible layouts,
                        responsive Grid systems, media queries,
                        responsive images, typography, and navigation
                        techniques help create websites that remain
                        usable across desktops, tablets, and mobile
                        devices.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6 mb-2 mb-md-0">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Index", "ResponsiveDesign", new { area = "CSS" })">

                            ← Previous: Responsive Design

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("Viewport", "ResponsiveDesign", new { area = "CSS" })">

                            Next: Viewport →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>