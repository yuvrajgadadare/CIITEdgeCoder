        margin-top: 20px;
    }

        #css-breakpoints-page .note-box h3 {
            color: #92400e;
            font-weight: 700;
        }

        #css-breakpoints-page .note-box p {
            color: #78350f;
        }

    #css-breakpoints-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

        #css-breakpoints-page .summary-box h2 {
            color: #075985;
            font-weight: 700;
            margin-bottom: 10px;
        }

        #css-breakpoints-page .summary-box p {
            color: #075985;
            margin-bottom: 0;
            line-height: 1.6;
        }

    @@media (max-width: 991px) {

        #css-breakpoints-page .content-section {
            padding: 22px;
        }

        #css-breakpoints-page .breakpoint-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        #css-breakpoints-page .breakpoint-box {
            background-color: #7c3aed;
        }
    }

    @@media (max-width: 575px) {

        #css-breakpoints-page .content-section {
            padding: 16px;
        }

        #css-breakpoints-page .breakpoint-grid {
            grid-template-columns: 1fr;
        }

        #css-breakpoints-page .breakpoint-box {
            background-color: #0f766e;
        }

        #css-breakpoints-page .breakpoint-arrow {
            transform: rotate(90deg);
        }

        #css-breakpoints-page .breakpoint-card {
            width: 100%;
        }
    }

</style>