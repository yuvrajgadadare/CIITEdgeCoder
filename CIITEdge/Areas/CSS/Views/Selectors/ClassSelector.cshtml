@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Class Selector";
}

<style>
    .content-section > h1,
    .content-section > h2,
    .content-section > h3 {
        color: #212529;
        font-weight: 700;
    }

    .code-box {
        background: #0f172a;
        color: #f8fafc;
        padding: 20px;
        border-radius: 8px;
        overflow-x: auto;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.6;
    }

    .diagram-box {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        background: #f8f9fa;
        text-align: center;
    }

    .diagram-item {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        font-weight: 600;
    }

    .diagram-arrow {
        font-size: 28px;
        font-weight: 700;
        color: #6f42c1;
        margin: 8px 0;
    }

    .output-box {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
    }

    .example-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }
</style>


<main class="container py-5">

    <div class="row g-4">

        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9 content-section">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <h1 class="mb-3">
                Class Selector
            </h1>

            <p class="lead">
                A class selector is used to apply the same CSS styles
                to one or more HTML elements.
            </p>


            <!-- ================================================= -->
            <!-- WHAT IS CLASS SELECTOR -->
            <!-- ================================================= -->

            <h2>
                What is a Class Selector?
            </h2>

            <p>
                A class selector targets HTML elements that have a
                specific <code>class</code> attribute.
            </p>

            <p>
                In CSS, a class selector starts with a
                <strong>dot (.)</strong> followed by the class name.
            </p>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <h2>
                Class Selector Flow
            </h2>

            <div class="diagram-box">

                <div class="row justify-content-center">

                    <div class="col-md-4">

                        <div class="diagram-item">
                            HTML Element
                            <br />
                            <code>class="title"</code>
                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-4">

                        <div class="diagram-item">
                            CSS Class Selector
                            <br />
                            <code>.title</code>
                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-4">

                        <div class="diagram-item">
                            Applied CSS Style
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BASIC SYNTAX -->
            <!-- ================================================= -->

            <h2>
                Basic Syntax
            </h2>

            <div class="code-box mb-3">

                <pre style="margin:0;">.class-name {
    property: value;
}</pre>

            </div>

            <p>
                The dot <code>.</code> identifies the selector as a
                class selector.
            </p>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 1: Styling a Class
                </h2>

                <p>
                    The following CSS applies blue color to elements
                    having the <code>title</code> class.
                </p>

                <div class="code-box mb-3">

                    <pre style="margin:0;">.title {
    color: blue;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <h4 style="color: blue; margin: 0;">
                        Welcome CIIT Institute 🤓❤️..!
                    </h4>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 2: Class Used on Multiple Elements
                </h2>

                <p>
                    The same class can be applied to multiple HTML
                    elements.
                </p>

                <div class="code-box mb-3">

                    <pre style="margin:0;">.highlight {
    color: green;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <p style="color: green; margin-bottom: 8px;">
                        First paragraph
                    </p>

                    <p style="color: green; margin-bottom: 0;">
                        Second paragraph
                    </p>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 3: Class with Multiple CSS Properties
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">.box {
    background-color: lightblue;
    padding: 15px;
    border: 1px solid blue;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <div style="
                        background-color: lightblue;
                        padding: 15px;
                        border: 1px solid blue;
                        ">
                        This is a styled box.
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- IMPORTANT POINTS -->
            <!-- ================================================= -->

            <h2>
                Important Points
            </h2>

            <ul>

                <li class="mb-2">
                    A class selector starts with a dot
                    <code>.</code>.
                </li>

                <li class="mb-2">
                    The class name must match the HTML
                    <code>class</code> attribute.
                </li>

                <li class="mb-2">
                    The same class can be used on multiple elements.
                </li>

                <li class="mb-2">
                    One HTML element can have multiple classes.
                </li>

                <li>
                    Class selectors are commonly used for reusable
                    styles.
                </li>

            </ul>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    A class selector is used to style HTML elements
                    that share the same class name. It begins with
                    a dot followed by the class name and can be reused
                    across multiple HTML elements.
                </p>

            </div>

            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="topic-navigation mt-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("ElementSelector", "Selectors", new { area = "CSS" })">

                            ← Previous: Element Selector

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("IDSelector", "Selectors", new { area = "CSS" })">

                            Next: ID Selector →

                        </a>

                    </div>

                </div>

            </div>
        </section>

    </div>

</main>