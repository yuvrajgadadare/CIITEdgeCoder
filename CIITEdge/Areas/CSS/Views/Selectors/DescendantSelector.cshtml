@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Descendant Selector";
}

<style>

    .content-section > h1,
    .content-section > h2,
    .content-section > h3 {
        color: #212529;
        font-weight: 700;
    }

    .code-box {
        background: #0f172a;
        color: #f8fafc;
        padding: 20px;
        border-radius: 8px;
        overflow-x: auto;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.6;
    }

    .diagram-box {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        background: #f8f9fa;
        text-align: center;
    }

    .diagram-item {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        font-weight: 600;
    }

    .diagram-arrow {
        font-size: 28px;
        font-weight: 700;
        color: #6f42c1;
        margin: 8px 0;
    }

    .output-box {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
    }

    .example-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

</style>


<main class="container py-5">

    <div class="row g-4">

        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9 content-section">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <h1 class="mb-3">
                Descendant Selector
            </h1>

            <p class="lead">
                A descendant selector is used to select elements
                that are inside another HTML element.
            </p>


            <!-- ================================================= -->
            <!-- WHAT IS DESCENDANT SELECTOR -->
            <!-- ================================================= -->

            <h2>
                What is a Descendant Selector?
            </h2>

            <p>
                A descendant selector targets an element that exists
                anywhere inside another element.
            </p>

            <p>
                A space between two selectors is used to represent
                a descendant relationship.
            </p>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <h2>
                Descendant Selector Flow
            </h2>

            <div class="diagram-box">

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">

                            Parent Element

                            <br />

                            <code>.container</code>

                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">

                            Descendant Element

                            <br />

                            <code>.container p</code>

                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">
                            Applied CSS Style
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BASIC SYNTAX -->
            <!-- ================================================= -->

            <h2>
                Basic Syntax
            </h2>

            <div class="code-box mb-3">

                <pre style="margin:0;">parent descendant {
    property: value;
}</pre>

            </div>

            <p>
                The space between the parent and descendant selector
                indicates that the second element is inside the first.
            </p>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 1: Select Paragraphs Inside a Div
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">div p {
    color: blue;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <div>

                        <p style="color: blue; margin-bottom: 8px;">
                            This paragraph is inside the div.
                        </p>

                    </div>

                    <p style="margin-bottom: 0;">
                        This paragraph is outside the div.
                    </p>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 2: Select Headings Inside a Section
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">section h2 {
    color: green;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <section>

                        <h4 style="color: green; margin: 0;">
                            CSS Tutorial
                        </h4>

                    </section>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 3: Select Links Inside Navigation
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">nav a {
    color: red;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <nav>

                        <a href="#"
                           style="color: red;">
                            Home
                        </a>

                        <span class="mx-2">|</span>

                        <a href="#"
                           style="color: red;">
                            About
                        </a>

                    </nav>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- IMPORTANT POINTS -->
            <!-- ================================================= -->

            <h2>
                Important Points
            </h2>

            <ul>

                <li class="mb-2">
                    A space is used between the parent and descendant
                    selectors.
                </li>

                <li class="mb-2">
                    A descendant can be directly or indirectly inside
                    the parent element.
                </li>

                <li class="mb-2">
                    Descendant selectors can target multiple elements.
                </li>

                <li class="mb-2">
                    They are useful for styling elements within a
                    specific section of a page.
                </li>

                <li>
                    Descendant selectors do not require the child to be
                    a direct child.
                </li>

            </ul>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    A descendant selector selects elements that are
                    located inside another element. It uses a space
                    between selectors and can target both direct and
                    indirect descendants.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="topic-navigation mt-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("AttributeSelector", "Selectors", new { area = "CSS" })">

                            ← Previous: Attribute Selector

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("ChildSelector", "Selectors", new { area = "CSS" })">

                            Next: Child Selector →

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</main>