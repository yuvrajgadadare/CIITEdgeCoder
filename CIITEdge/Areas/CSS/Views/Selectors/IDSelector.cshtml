@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "ID Selector";
}

<style>

    .content-section > h1,
    .content-section > h2,
    .content-section > h3 {
        color: #212529;
        font-weight: 700;
    }

    .code-box {
        background: #0f172a;
        color: #f8fafc;
        padding: 20px;
        border-radius: 8px;
        overflow-x: auto;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.6;
    }

    .diagram-box {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        background: #f8f9fa;
        text-align: center;
    }

    .diagram-item {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        font-weight: 600;
    }

    .diagram-arrow {
        font-size: 28px;
        font-weight: 700;
        color: #6f42c1;
        margin: 8px 0;
    }

    .output-box {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
    }

    .example-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

</style>


<main class="container py-5">

    <div class="row g-4">

        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9 content-section">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <h1 class="mb-3">
                ID Selector
            </h1>

            <p class="lead">
                An ID selector is used to apply CSS styles to a
                specific HTML element that has a unique ID.
            </p>


            <!-- ================================================= -->
            <!-- WHAT IS ID SELECTOR -->
            <!-- ================================================= -->

            <h2>
                What is an ID Selector?
            </h2>

            <p>
                An ID selector targets an HTML element using its
                <code>id</code> attribute.
            </p>

            <p>
                In CSS, an ID selector starts with a
                <strong>hash symbol (#)</strong> followed by the ID name.
            </p>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <h2>
                ID Selector Flow
            </h2>

            <div class="diagram-box">

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">

                            HTML Element

                            <br />

                            <code>id="heading"</code>

                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">

                            CSS ID Selector

                            <br />

                            <code>#heading</code>

                        </div>

                    </div>

                </div>

                <div class="diagram-arrow">
                    ↓
                </div>

                <div class="row justify-content-center">

                    <div class="col-md-5">

                        <div class="diagram-item">
                            Applied CSS Style
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BASIC SYNTAX -->
            <!-- ================================================= -->

            <h2>
                Basic Syntax
            </h2>

            <div class="code-box mb-3">

                <pre style="margin:0;">#id-name {
    property: value;
}</pre>

            </div>

            <p>
                The <code>#</code> symbol identifies the selector
                as an ID selector.
            </p>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 1: Styling an ID
                </h2>

                <p>
                    The following CSS changes the color of an element
                    having the ID <code>heading</code>.
                </p>

                <div class="code-box mb-3">

                    <pre style="margin:0;">#heading {
    color: blue;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <h4 style="color: blue; margin: 0;">
                        Welcome to CSS
                    </h4>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 2: Multiple CSS Properties
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">#main-title {
    color: red;
    font-size: 28px;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <h4 style="
                        color: red;
                        font-size: 28px;
                        margin: 0;
                        ">
                        CSS Tutorial
                    </h4>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="example-card">

                <h2>
                    Example 3: Styling a Specific Element
                </h2>

                <div class="code-box mb-3">

                    <pre style="margin:0;">#box {
    background-color: lightblue;
    padding: 15px;
    border: 1px solid blue;
}</pre>

                </div>

                <h3 class="h5">
                    Output
                </h3>

                <div class="output-box">

                    <div style="
                        background-color: lightblue;
                        padding: 15px;
                        border: 1px solid blue;
                        ">
                        This is a specific element.
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- IMPORTANT POINTS -->
            <!-- ================================================= -->

            <h2>
                Important Points
            </h2>

            <ul>

                <li class="mb-2">
                    An ID selector starts with the
                    <code>#</code> symbol.
                </li>

                <li class="mb-2">
                    The ID name must match the HTML
                    <code>id</code> attribute.
                </li>

                <li class="mb-2">
                    An ID is normally used for a specific element.
                </li>

                <li class="mb-2">
                    ID names should be unique within a page.
                </li>

                <li>
                    ID selectors are useful when a specific element
                    needs individual styling.
                </li>

            </ul>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="alert alert-info mt-4">

                <h2 class="h4 fw-bold">
                    Summary
                </h2>

                <p class="mb-0">
                    An ID selector targets a specific HTML element
                    using its unique ID. It starts with the
                    <code>#</code> symbol followed by the ID name.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="topic-navigation mt-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("ClassSelector", "Selectors", new { area = "CSS" })">

                            ← Previous: Class Selector

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("AttributeSelector", "Selectors", new { area = "CSS" })">

                            Next: Attribute Selector →

                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

</main>