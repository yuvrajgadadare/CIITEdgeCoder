@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Background Color";
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    #css-background-color-page {
        color: #212529;
    }


        #css-background-color-page > .row h1,
        #css-background-color-page > .row h2,
        #css-background-color-page > .row h3 {
            color: #212529;
            font-weight: 700;
        }


        /* =========================================================
           CODE BOX
           ========================================================= */

        #css-background-color-page .code-box {
            background-color: #0f172a;
            color: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            overflow-x: auto;
            margin-bottom: 24px;
        }


            #css-background-color-page .code-box pre {
                margin: 0;
                color: #f8fafc;
                font-family: Consolas, Monaco, monospace;
                font-size: 14px;
                line-height: 1.7;
            }


        /* =========================================================
           DIAGRAM
           ========================================================= */

        #css-background-color-page .diagram-container {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }


        #css-background-color-page .diagram-box {
            background-color: #ffffff;
            border: 2px solid #6f42c1;
            border-radius: 10px;
            padding: 18px;
            text-align: center;
            height: 100%;
        }


            #css-background-color-page .diagram-box h5 {
                color: #5b21b6;
                font-weight: 700;
                margin-bottom: 8px;
            }


            #css-background-color-page .diagram-box p {
                color: #495057;
                font-size: 14px;
                margin-bottom: 0;
            }


        #css-background-color-page .diagram-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: 700;
            color: #6f42c1;
        }


        /* =========================================================
           OUTPUT
           ========================================================= */

        #css-background-color-page .output-box {
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }


        #css-background-color-page .browser-window {
            border: 1px solid #ced4da;
            border-radius: 8px;
            overflow: hidden;
            background-color: #ffffff;
        }


        #css-background-color-page .browser-header {
            background-color: #e9ecef;
            padding: 8px 12px;
            border-bottom: 1px solid #ced4da;
            font-size: 13px;
            color: #495057;
        }


        #css-background-color-page .browser-content {
            padding: 25px;
            background-color: #ffffff;
            min-height: 100px;
        }


        /* =========================================================
           DEMO CARDS
           ========================================================= */

        #css-background-color-page .demo-card {
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            height: 100%;
        }


        /* =========================================================
           SUMMARY
           ========================================================= */

        #css-background-color-page .summary-box {
            background-color: #eaf4ff;
            border-left: 5px solid #2563eb;
            border-radius: 8px;
            padding: 20px;
            margin-top: 30px;
        }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        #css-background-color-page .diagram-arrow {
            transform: rotate(90deg);
            margin: 5px 0;
        }
    }

</style>


<main id="css-background-color-page"
      class="container py-5">

    <div class="row g-4">


        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9">


            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h1 class="fw-bold">
                    Background Color
                </h1>

                <p class="lead">
                    Learn how to change the background color
                    of HTML elements using CSS.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- INTRODUCTION -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3">
                    What is Background Color?
                </h2>

                <p>
                    The <code>background-color</code> property
                    is used to set the background color of
                    an HTML element.
                </p>

                <p>
                    It can be applied to elements such as
                    <code>div</code>, <code>section</code>,
                    <code>body</code>, <code>header</code>,
                    and many others.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="diagram-container">

                <h2 class="h4 mb-4">
                    How Background Color Works
                </h2>


                <div class="row g-3 align-items-center">


                    <div class="col-md-3">

                        <div class="diagram-box">

                            <h5>
                                HTML Element
                            </h5>

                            <p>
                                div
                            </p>

                        </div>

                    </div>


                    <div class="col-md-1 diagram-arrow">
                        →
                    </div>


                    <div class="col-md-4">

                        <div class="diagram-box">

                            <h5>
                                CSS Property
                            </h5>

                            <p>
                                background-color
                            </p>

                        </div>

                    </div>


                    <div class="col-md-1 diagram-arrow">
                        →
                    </div>


                    <div class="col-md-3">

                        <div class="diagram-box">

                            <h5>
                                Browser
                            </h5>

                            <p>
                                Colored background
                            </p>

                        </div>

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 1: Light Blue Background
                </h2>

                <p>
                    We can use a color name such as
                    <code>lightblue</code>.
                </p>


                <div class="code-box">

                    <pre><code>div {
    background-color: lightblue;
    padding: 20px;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>


                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>


                        <div class="browser-content">

                            <div style="
                                background-color: lightblue;
                                padding: 20px;
                                border-radius: 6px;
                                ">

                                This div has a light blue
                                background color.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 2: HEX Background Color
                </h2>

                <p>
                    Background colors can also be defined
                    using HEX values.
                </p>


                <div class="code-box">

                    <pre><code>div {
    background-color: #e0f2fe;
    padding: 20px;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>


                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>


                        <div class="browser-content">

                            <div style="
                                background-color: #e0f2fe;
                                padding: 20px;
                                border-radius: 6px;
                                ">

                                This div uses a HEX
                                background color.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 3: RGB Background Color
                </h2>

                <p>
                    RGB values can also be used to define
                    a background color.
                </p>


                <div class="code-box">

                    <pre><code>div {
    background-color: rgb(220, 252, 231);
    padding: 20px;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>


                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>


                        <div class="browser-content">

                            <div style="
                                background-color: rgb(220, 252, 231);
                                padding: 20px;
                                border-radius: 6px;
                                ">

                                This div uses an RGB
                                background color.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 4: Background Color for a Section
                </h2>

                <p>
                    We can apply a background color to a complete
                    section of a webpage.
                </p>


                <div class="code-box">

                    <pre><code>section {
    background-color: #f3e8ff;
    padding: 30px;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>


                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>


                        <div class="browser-content">

                            <section style="
                                background-color: #f3e8ff;
                                padding: 30px;
                                border-radius: 6px;
                                ">

                                <h3 style="
                                    color: #212529;
                                    margin-bottom: 10px;
                                    ">

                                    CIIT Training Institute

                                </h3>


                                <p style="
                                    margin-bottom: 0;
                                    ">

                                    Learn Full Stack Development
                                    step by step.

                                </p>

                            </section>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- DIFFERENT COLOR FORMATS -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Background Color Formats
                </h2>

                <p>
                    CSS supports different ways to specify
                    background colors.
                </p>


                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Format
                                </th>

                                <th>
                                    Example
                                </th>

                                <th>
                                    Meaning
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <tr>

                                <td>
                                    Color Name
                                </td>

                                <td>
                                    <code>lightblue</code>
                                </td>

                                <td>
                                    Uses a predefined CSS color name.
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    HEX
                                </td>

                                <td>
                                    <code>#e0f2fe</code>
                                </td>

                                <td>
                                    Uses hexadecimal color notation.
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    RGB
                                </td>

                                <td>
                                    <code>rgb(220, 252, 231)</code>
                                </td>

                                <td>
                                    Uses red, green and blue values.
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    RGBA
                                </td>

                                <td>
                                    <code>rgba(59, 130, 246, 0.5)</code>
                                </td>

                                <td>
                                    Adds transparency to the color.
                                </td>

                            </tr>


                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- PROPERTY EXPLANATION -->
            <!-- ================================================= -->

            <div class="row g-3 mb-5">


                <div class="col-md-6">

                    <div class="demo-card">

                        <h5 class="fw-bold">
                            background-color
                        </h5>

                        <p>
                            Defines the background color
                            of an HTML element.
                        </p>

                        <code>
                            background-color: lightblue;
                        </code>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="demo-card">

                        <h5 class="fw-bold">
                            padding
                        </h5>

                        <p>
                            Adds space between the content
                            and the background area.
                        </p>

                        <code>
                            padding: 20px;
                        </code>

                    </div>

                </div>


            </div>


            <!-- ================================================= -->
            <!-- BEGINNER TIP -->
            <!-- ================================================= -->

            <div class="alert alert-info">

                <strong>
                    Beginner Tip:
                </strong>

                <p class="mb-0 mt-2">

                    The
                    <code>background-color</code>
                    property changes the area behind the
                    content of an element. The content itself
                    remains inside that colored area.

                </p>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>


                <ul class="mb-0">

                    <li>
                        <code>background-color</code>
                        changes the background color of an element.
                    </li>

                    <li>
                        CSS supports color names, HEX, RGB and RGBA.
                    </li>

                    <li>
                        <code>padding</code> can be used to create
                        space inside the colored area.
                    </li>

                    <li>
                        Background colors can be applied to
                        divs, sections, headers, body and other elements.
                    </li>

                </ul>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="topic-navigation mt-4">

                <div class="row g-3">


                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("ColorValues", "ColorsBackgrounds", new { area = "CSS" })">

                            ← Previous: Color Values

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("BackgroundImage", "ColorsBackgrounds", new { area = "CSS" })">

                            Next: Background Image →

                        </a>

                    </div>


                </div>

            </div>


        </section>

    </div>

</main>