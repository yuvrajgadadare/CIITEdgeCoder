@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Background Image";
}

<div class="container-fluid py-4" id="css-background-image-page">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/CSS/Views/Shared/CSSTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- Page Title -->
            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Background Image
                </h1>

                <p class="lead">
                    CSS allows you to add an image as the background of an HTML element
                    using the <strong>background-image</strong> property.
                </p>

                <p>
                    You can also control the background image using properties such as
                    <strong>background-size</strong>,
                    <strong>background-position</strong>, and
                    <strong>background-repeat</strong>.
                </p>

            </div>

            <!-- Diagram -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        Background Image Flow
                    </h4>

                    <div class="background-diagram">

                        <div class="diagram-box">
                            HTML Element
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            CSS Background Image
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Browser
                        </div>

                    </div>

                </div>
            </div>


            <!-- Example 1 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: CIIT Training Institute Logo
                    </h4>

                    <p>
                        The CIIT Training Institute logo is used as a CSS background image.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://ciitinstitute.com/assets/mainlogo.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #ffffff;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="background-output ciit-background">
                        <div class="output-label">
                            CIIT Training Institute
                        </div>
                    </div>

                    <p class="mt-3 mb-0">
                        Here, the CIIT logo is displayed as the background image.
                    </p>

                </div>

            </div>


            <!-- Example 2 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Background Size
                    </h4>

                    <p>
                        The <strong>background-size</strong> property controls how the
                        background image fits inside the element.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="background-output coding-background">
                        <div class="image-overlay-content">
                            <h3>Web Development</h3>
                            <p>
                                Background image using
                                <strong>background-size: cover</strong>.
                            </p>
                        </div>
                    </div>

                    <p class="mt-3 mb-0">
                        <strong>cover</strong> makes the image cover the complete element.
                    </p>

                </div>

            </div>


            <!-- Example 3 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Background Position
                    </h4>

                    <p>
                        The <strong>background-position</strong> property controls where
                        the background image is placed.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="background-output position-background">
                        <div class="image-overlay-content">
                            <h3>Learning Technology</h3>
                            <p>
                                Background image positioned at
                                <strong>right center</strong>.
                            </p>
                        </div>
                    </div>

                    <p class="mt-3 mb-0">
                        <strong>right center</strong> places the background image toward
                        the right side and vertically centers it.
                    </p>

                </div>

            </div>


            <!-- Properties Table -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Background Image Properties
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">
                                <tr>
                                    <th>Property</th>
                                    <th>Purpose</th>
                                    <th>Example</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td><code>background-image</code></td>
                                    <td>Adds an image as the background</td>
                                    <td><code>url("image.jpg")</code></td>
                                </tr>

                                <tr>
                                    <td><code>background-size</code></td>
                                    <td>Controls image size</td>
                                    <td><code>cover</code></td>
                                </tr>

                                <tr>
                                    <td><code>background-position</code></td>
                                    <td>Controls image position</td>
                                    <td><code>center</code></td>
                                </tr>

                                <tr>
                                    <td><code>background-repeat</code></td>
                                    <td>Controls image repetition</td>
                                    <td><code>no-repeat</code></td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- Simple Explanation -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>background-image</strong>
                            → Adds an image to the background.
                        </p>

                        <p>
                            <strong>background-size</strong>
                            → Controls how large the image appears.
                        </p>

                        <p>
                            <strong>background-position</strong>
                            → Controls where the image appears.
                        </p>

                        <p class="mb-0">
                            <strong>background-repeat</strong>
                            → Controls whether the image repeats.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Summary -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Summary
                    </h4>

                    <ul class="mb-0">

                        <li>
                            Use <code>background-image</code> to add a background image.
                        </li>

                        <li>
                            Use <code>background-size</code> to control image size.
                        </li>

                        <li>
                            Use <code>background-position</code> to control image position.
                        </li>

                        <li>
                            Use <code>background-repeat</code> to control image repetition.
                        </li>

                    </ul>

                </div>

            </div>


            <!-- Navigation -->
            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("BackgroundColor", "ColorsBackgrounds", new { area = "CSS" })">

                        ← Previous: Background Color

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("BackgroundRepeat", "ColorsBackgrounds", new { area = "CSS" })">

                        Next: Background Repeat →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    #css-background-image-page .content-section h1,
    #css-background-image-page .content-section h2,
    #css-background-image-page .content-section h3,
    #css-background-image-page .content-section h4 {
        color: #212529;
    }

    #css-background-image-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-background-image-page .code-box code {
            color: #f8f9fa;
        }

    #css-background-image-page .background-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-background-image-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-background-image-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }

    #css-background-image-page .background-output {
        min-height: 280px;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /*
            Example 1
            Exact values used in the CSS code above.
        */
    #css-background-image-page .ciit-background {
        background-image: url("https://ciitinstitute.com/assets/mainlogo.png");
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #ffffff;
        min-height: 280px;
    }

    /*
            Example 2
            Exact values used in the CSS code above.
        */
    #css-background-image-page .coding-background {
        background-image: url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 280px;
    }

    /*
            Example 3
            Exact values used in the CSS code above.
        */
    #css-background-image-page .position-background {
        background-image: url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80");
        background-size: cover;
        background-position: right center;
        background-repeat: no-repeat;
        min-height: 280px;
    }

    #css-background-image-page .output-label {
        background: rgba(255, 255, 255, 0.92);
        padding: 12px 20px;
        border-radius: 6px;
        font-weight: 700;
        color: #212529;
    }

    #css-background-image-page .image-overlay-content {
        background: rgba(0, 0, 0, 0.65);
        color: #ffffff;
        padding: 20px 25px;
        border-radius: 8px;
        text-align: center;
        max-width: 430px;
    }

        #css-background-image-page .image-overlay-content h3 {
            color: #ffffff;
            margin-bottom: 8px;
        }

        #css-background-image-page .image-overlay-content p {
            margin-bottom: 0;
        }

    #css-background-image-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-background-image-page .explanation-box p {
            margin-bottom: 10px;
        }

    #css-background-image-page code {
        color: #b02a37;
    }

    #css-background-image-page .code-box code {
        color: #f8f9fa;
    }

    @@media (max-width: 767px) {

        #css-background-image-page .background-diagram {
            flex-direction: column;
        }

        #css-background-image-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-background-image-page .code-box {
            font-size: 13px;
        }

        #css-background-image-page .background-output {
            min-height: 230px;
        }
    }

</style>