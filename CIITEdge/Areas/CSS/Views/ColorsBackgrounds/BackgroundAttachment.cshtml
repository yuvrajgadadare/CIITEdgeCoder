@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Background Attachment";
}

<div class="container-fluid py-4" id="css-background-attachment-page">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @Html.Partial("~/Areas/CSS/Views/Shared/CSSTopics.cshtml")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- Page Title -->
            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Background Attachment
                </h1>

                <p class="lead">
                    The <strong>background-attachment</strong> property controls
                    whether a background image scrolls with the page or stays fixed.
                </p>

                <p>
                    The most commonly used values are
                    <strong>scroll</strong> and <strong>fixed</strong>.
                </p>

            </div>


            <!-- Diagram -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        Background Attachment Flow
                    </h4>

                    <div class="attachment-diagram">

                        <div class="diagram-box">
                            Background Image
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            background-attachment
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Scrolling Behavior
                        </div>

                    </div>

                </div>

            </div>


            <!-- Example 1 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Scroll
                    </h4>

                    <p>
                        The <strong>scroll</strong> value makes the background image
                        move along with the element when the page is scrolled.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");
    background-attachment: scroll;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="attachment-output scroll-demo">

                        <div class="output-content">
                            <h3>Background Scroll</h3>
                            <p>
                                The background image scrolls with the element.
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Example 2 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Fixed
                    </h4>

                    <p>
                        The <strong>fixed</strong> value keeps the background image
                        fixed relative to the viewport while the page content scrolls.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");
    background-attachment: fixed;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="attachment-output fixed-demo">

                        <div class="output-content">
                            <h3>Background Fixed</h3>
                            <p>
                                The background image stays fixed while content scrolls.
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Example 3 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Local
                    </h4>

                    <p>
                        The <strong>local</strong> value allows the background image
                        to scroll with the element's content.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>div {
    background-image: url("https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");
    background-attachment: local;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 280px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="attachment-output local-demo">

                        <div class="output-content">
                            <h3>Background Local</h3>
                            <p>
                                The background scrolls with the element's content.
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Comparison Table -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Background Attachment Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">
                                <tr>
                                    <th>Value</th>
                                    <th>Behavior</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>scroll</code>
                                    </td>
                                    <td>
                                        Background image scrolls with the element.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>fixed</code>
                                    </td>
                                    <td>
                                        Background image stays fixed relative to the viewport.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>local</code>
                                    </td>
                                    <td>
                                        Background image scrolls with the element's content.
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- Simple Explanation -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>scroll</strong>
                            → Background moves when the page scrolls.
                        </p>

                        <p>
                            <strong>fixed</strong>
                            → Background stays fixed while the page content moves.
                        </p>

                        <p class="mb-0">
                            <strong>local</strong>
                            → Background scrolls with the element's content.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Summary -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Summary
                    </h4>

                    <ul class="mb-0">

                        <li>
                            Use <code>background-attachment</code> to control
                            background scrolling behavior.
                        </li>

                        <li>
                            <code>scroll</code> moves the background with the page.
                        </li>

                        <li>
                            <code>fixed</code> keeps the background fixed.
                        </li>

                        <li>
                            <code>local</code> scrolls the background with element content.
                        </li>

                    </ul>

                </div>

            </div>


            <!-- Navigation -->
            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("BackgroundRepeat", "ColorsBackgrounds", new { area = "CSS" })">

                        ← Previous: Background Repeat

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("MultipleBackgrounds", "ColorsBackgrounds", new { area = "CSS" })">

                        Next: Multiple Backgrounds →

                    </a>

                </div>

            </div>
        </div>

    </div>

</div>


<style>

    #css-background-attachment-page .content-section h1,
    #css-background-attachment-page .content-section h2,
    #css-background-attachment-page .content-section h3,
    #css-background-attachment-page .content-section h4 {
        color: #212529;
    }

    #css-background-attachment-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-background-attachment-page .code-box code {
            color: #f8f9fa;
        }

    #css-background-attachment-page .attachment-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-background-attachment-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-background-attachment-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }

    #css-background-attachment-page .attachment-output {
        min-height: 280px;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #css-background-attachment-page .scroll-demo {
        background-image: url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80");
        background-attachment: scroll;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 280px;
    }

    #css-background-attachment-page .fixed-demo {
        background-image: url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80");
        background-attachment: fixed;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 280px;
    }

    #css-background-attachment-page .local-demo {
        background-image: url("https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80");
        background-attachment: local;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 280px;
    }

    #css-background-attachment-page .output-content {
        background: rgba(0, 0, 0, 0.68);
        color: #ffffff;
        padding: 20px 25px;
        border-radius: 8px;
        text-align: center;
        max-width: 430px;
    }

        #css-background-attachment-page .output-content h3 {
            color: #ffffff;
            margin-bottom: 8px;
        }

        #css-background-attachment-page .output-content p {
            margin-bottom: 0;
        }

    #css-background-attachment-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-background-attachment-page .explanation-box p {
            margin-bottom: 10px;
        }

    #css-background-attachment-page code {
        color: #b02a37;
    }

    #css-background-attachment-page .code-box code {
        color: #f8f9fa;
    }

    @@media (max-width: 767px) {

        #css-background-attachment-page .attachment-diagram {
            flex-direction: column;
        }

        #css-background-attachment-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-background-attachment-page .code-box {
            font-size: 13px;
        }

        #css-background-attachment-page .attachment-output {
            min-height: 230px;
        }
    }

</style>