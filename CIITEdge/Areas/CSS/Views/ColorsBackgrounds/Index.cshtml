@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Colors & Backgrounds";
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    #css-colors-backgrounds-page {
        color: #212529;
    }


        /* =========================================================
           PAGE HEADINGS
           ========================================================= */

        #css-colors-backgrounds-page > .row h1,
        #css-colors-backgrounds-page > .row h2,
        #css-colors-backgrounds-page > .row h3 {
            color: #212529;
            font-weight: 700;
        }


        /* =========================================================
           CODE BOX
           ========================================================= */

        #css-colors-backgrounds-page .code-box {
            background-color: #0f172a;
            color: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            overflow-x: auto;
            margin-bottom: 24px;
        }

            #css-colors-backgrounds-page .code-box pre {
                margin: 0;
                color: #f8fafc;
                font-family: Consolas, Monaco, monospace;
                font-size: 14px;
                line-height: 1.7;
            }


        /* =========================================================
           DIAGRAM
           ========================================================= */

        #css-colors-backgrounds-page .diagram-container {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

        #css-colors-backgrounds-page .diagram-box {
            background-color: #ffffff;
            border: 2px solid #6f42c1;
            border-radius: 10px;
            padding: 18px;
            text-align: center;
            height: 100%;
        }

            #css-colors-backgrounds-page .diagram-box h5 {
                color: #5b21b6;
                font-weight: 700;
                margin-bottom: 8px;
            }

            #css-colors-backgrounds-page .diagram-box p {
                color: #495057;
                margin-bottom: 0;
                font-size: 14px;
            }

        #css-colors-backgrounds-page .diagram-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: 700;
            color: #6f42c1;
        }


        /* =========================================================
           OUTPUT BOX
           ========================================================= */

        #css-colors-backgrounds-page .output-box {
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 28px;
        }


        /* =========================================================
           BROWSER OUTPUT
           ========================================================= */

        #css-colors-backgrounds-page .browser-window {
            border: 1px solid #ced4da;
            border-radius: 8px;
            overflow: hidden;
            background-color: #ffffff;
        }

        #css-colors-backgrounds-page .browser-header {
            background-color: #e9ecef;
            padding: 8px 12px;
            border-bottom: 1px solid #ced4da;
            font-size: 13px;
            color: #495057;
        }

        #css-colors-backgrounds-page .browser-content {
            padding: 25px;
            background-color: #ffffff;
            min-height: 90px;
        }


        /* =========================================================
           BACKGROUND IMAGE DEMO
           ========================================================= */

        #css-colors-backgrounds-page .background-image-demo {
            min-height: 280px;
            background-image: url("https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }


            /* Dark overlay only for readability.
           The actual background image remains the online image
           specified in the CSS code above. */

            #css-colors-backgrounds-page .background-image-demo::before {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0, 0, 0, 0.35);
            }

        #css-colors-backgrounds-page .background-image-content {
            position: relative;
            z-index: 1;
            text-align: center;
            color: #ffffff;
        }

            #css-colors-backgrounds-page .background-image-content h3 {
                color: #ffffff;
                font-weight: 700;
                margin-bottom: 8px;
            }

            #css-colors-backgrounds-page .background-image-content p {
                color: #ffffff;
                margin-bottom: 0;
            }


        /* =========================================================
           INFO CARDS
           ========================================================= */

        #css-colors-backgrounds-page .info-card {
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            height: 100%;
        }

            #css-colors-backgrounds-page .info-card h5 {
                color: #5b21b6;
                font-weight: 700;
                margin-bottom: 10px;
            }


        /* =========================================================
           COLOR VALUE TABLE
           ========================================================= */

        #css-colors-backgrounds-page .color-sample {
            display: inline-block;
            width: 22px;
            height: 22px;
            border-radius: 4px;
            vertical-align: middle;
            margin-right: 8px;
            border: 1px solid #ced4da;
        }


        /* =========================================================
           SUMMARY
           ========================================================= */

        #css-colors-backgrounds-page .summary-box {
            background-color: #eaf4ff;
            border-left: 5px solid #2563eb;
            border-radius: 8px;
            padding: 20px;
            margin-top: 30px;
        }

</style>


<main id="css-colors-backgrounds-page"
      class="container py-5">

    <div class="row g-4">


        <!-- ================================================= -->
        <!-- LEFT SIDEBAR -->
        <!-- ================================================= -->

        <aside class="col-lg-3">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </aside>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <section class="col-lg-9">


            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h1 class="fw-bold">
                    Colors &amp; Backgrounds
                </h1>

                <p class="lead">
                    Learn how CSS is used to change text colors,
                    background colors, and background images.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- INTRODUCTION -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h2 class="h3">
                    What are Colors &amp; Backgrounds?
                </h2>

                <p>
                    CSS provides properties that allow us to control
                    the appearance of elements on a web page.
                </p>

                <p>
                    We can change text colors, background colors,
                    and even place images behind content using CSS.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="diagram-container">

                <h2 class="h4 mb-4">
                    How CSS Colors &amp; Backgrounds Work
                </h2>

                <div class="row g-3 align-items-center">

                    <div class="col-md-3">

                        <div class="diagram-box">

                            <h5>HTML Element</h5>

                            <p>
                                h1, p, div, section
                            </p>

                        </div>

                    </div>


                    <div class="col-md-1 diagram-arrow">

                        →

                    </div>


                    <div class="col-md-4">

                        <div class="diagram-box">

                            <h5>CSS Styling</h5>

                            <p>
                                color<br />
                                background-color<br />
                                background-image
                            </p>

                        </div>

                    </div>


                    <div class="col-md-1 diagram-arrow">

                        →

                    </div>


                    <div class="col-md-3">

                        <div class="diagram-box">

                            <h5>Styled Web Page</h5>

                            <p>
                                Colors and images
                                appear in browser
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 1: Text Color
                </h2>

                <p>
                    The <code>color</code> property changes the
                    color of text.
                </p>


                <div class="code-box">

                    <pre><code>h1 {
    color: blue;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>

                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>

                        <div class="browser-content">

                            <h1 style="color: blue; margin: 0;">
                                WELCOME TO CIIT TRAINING INSTITUTE ❤
                            </h1>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 2: Background Color
                </h2>

                <p>
                    The <code>background-color</code> property
                    changes the background color of an element.
                </p>


                <div class="code-box">

                    <pre><code>div {
    background-color: lightblue;
    padding: 20px;
}</code></pre>

                </div>


                <h3 class="h5 mb-3">
                    Output
                </h3>

                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>

                        <div class="browser-content">

                            <div style="
                                background-color: lightblue;
                                padding: 20px;
                                border-radius: 6px;
                                ">

                                This is a div with a
                                light blue background.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COLOR VALUES -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    CSS Color Values
                </h2>

                <p>
                    CSS supports different ways of specifying colors.
                </p>


                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Color Format
                                </th>

                                <th>
                                    Example
                                </th>

                                <th>
                                    Description
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    Color Name
                                </td>

                                <td>
                                    <code>red</code>
                                </td>

                                <td>
                                    Uses a predefined CSS color name.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    HEX
                                </td>

                                <td>
                                    <code>#ff0000</code>
                                </td>

                                <td>
                                    Six-digit hexadecimal color value.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    RGB
                                </td>

                                <td>
                                    <code>rgb(255, 0, 0)</code>
                                </td>

                                <td>
                                    Defines red, green and blue values.
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    RGBA
                                </td>

                                <td>
                                    <code>rgba(255, 0, 0, 0.5)</code>
                                </td>

                                <td>
                                    RGB color with transparency.
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 - BACKGROUND IMAGE -->
            <!-- ================================================= -->

            <div class="mb-5">

                <h2 class="h4">
                    Example 3: Background Image
                </h2>

                <p>
                    The
                    <code>background-image</code>
                    property places an image behind the content
                    of an element.
                </p>

                <p>
                    In this example, the image is loaded directly
                    from an online image URL.
                </p>


                <!-- CODE -->

                <div class="code-box">

                    <pre><code>div {
    background-image: url("https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&amp;fit=crop&amp;w=1200&amp;q=80");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    min-height: 280px;
}</code></pre>

                </div>


                <!-- OUTPUT -->

                <h3 class="h5 mb-3">
                    Output
                </h3>


                <div class="output-box">

                    <div class="browser-window">

                        <div class="browser-header">
                            Browser Output
                        </div>

                        <div class="browser-content p-0">

                            <div class="background-image-demo">

                                <div class="background-image-content">

                                    <h3>
                                        CSS Background Image
                                    </h3>

                                    <p>
                                        The image is displayed
                                        behind this content.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- SIMPLE EXPLANATION -->

                <div class="row g-3 mt-2">

                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                background-image
                            </h5>

                            <p class="mb-0">

                                Specifies the image that should
                                appear as the background.

                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                background-size
                            </h5>

                            <p class="mb-0">

                                <code>cover</code> makes the image
                                cover the complete element.

                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="info-card">

                            <h5>
                                background-position
                            </h5>

                            <p class="mb-0">

                                <code>center</code> keeps the image
                                centered inside the element.

                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- IMPORTANT NOTE -->
            <!-- ================================================= -->

            <div class="alert alert-info">

                <strong>Beginner Tip:</strong>

                <p class="mb-0 mt-2">

                    The
                    <code>background-image</code>
                    property does not place an image as normal
                    content. Instead, it displays the image
                    behind the content of the element.

                </p>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    CSS colors and backgrounds allow you to control the visual
                    appearance of HTML elements. You can change text colors,
                    apply background colors, add background images, control
                    image size and position, and create visually attractive
                    web pages.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="topic-navigation mt-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("PseudoElementSelector", "Selectors", new { area = "CSS" })">

                            ← Previous: Pseudo-Element Selector

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("ColorValues", "ColorsBackgrounds", new { area = "CSS" })">

                            Next: Color Values →

                        </a>

                    </div>

                </div>

            </div>


        </section>

    </div>

</main>