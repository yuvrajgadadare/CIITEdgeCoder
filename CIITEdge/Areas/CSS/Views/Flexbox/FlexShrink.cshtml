@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Flex Shrink";
}

<style>

    #css-flex-shrink-page {
        color: #212529;
    }

    #css-flex-shrink-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-flex-shrink-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-flex-shrink-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-flex-shrink-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-flex-shrink-page .content-section > p {
        line-height: 1.7;
    }

    /* Code */

    #css-flex-shrink-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-flex-shrink-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* Explanation */

    #css-flex-shrink-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-flex-shrink-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* Diagram */

    #css-flex-shrink-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-flex-shrink-page .diagram-container {
        display: flex;
        gap: 10px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
        overflow: hidden;
    }

    #css-flex-shrink-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        padding: 18px;
        border-radius: 6px;
        text-align: center;
        font-weight: 700;
        flex-shrink: 1;
        flex-basis: 220px;
    }

    #css-flex-shrink-page .diagram-item.no-shrink {
        flex-shrink: 0;
    }

    /* Output */

    #css-flex-shrink-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-flex-shrink-page .output-container {
        display: flex;
        gap: 10px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
        overflow: hidden;
    }

    #css-flex-shrink-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        padding: 20px;
        text-align: center;
        font-weight: 700;
        flex-basis: 220px;
    }

    #css-flex-shrink-page .shrink-1 {
        flex-shrink: 1;
    }

    #css-flex-shrink-page .shrink-2 {
        flex-shrink: 2;
    }

    #css-flex-shrink-page .shrink-0 {
        flex-shrink: 0;
    }

    /* Property Cards */

    #css-flex-shrink-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-flex-shrink-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-flex-shrink-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Note */

    #css-flex-shrink-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* Summary */

    #css-flex-shrink-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-flex-shrink-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-flex-shrink-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

</style>


<div id="css-flex-shrink-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Flex Shrink
                </h1>

                <p>
                    The CSS <strong>flex-shrink</strong> property
                    controls how much a Flex Item is allowed to
                    shrink when the Flex Container does not have
                    enough space.
                </p>

                <p>
                    It is especially useful for responsive layouts
                    where several Flex Items need to fit inside a
                    limited amount of horizontal or vertical space.
                </p>


                <!-- What Is Flex Shrink -->

                <h2>
                    What Is Flex Shrink?
                </h2>

                <div class="explanation-box">

                    <p>
                        <strong>flex-shrink</strong> defines the
                        shrink factor of a Flex Item.
                    </p>

                    <p>
                        When the total size of Flex Items is larger
                        than the available space in the Flex
                        Container, the browser can reduce the size
                        of the items according to their shrink
                        factors.
                    </p>

                    <p>
                        The default value of
                        <strong>flex-shrink</strong> is
                        <strong>1</strong>.
                    </p>

                </div>


                <!-- Syntax -->

                <h2>
                    Syntax
                </h2>

                <div class="code-box">

<pre><code>.item {
    flex-shrink: number;
}</code></pre>

                </div>


                <!-- Default -->

                <h2>
                    Default Value
                </h2>

                <div class="code-box">

<pre><code>.item {
    flex-shrink: 1;
}</code></pre>

                </div>

                <p class="mt-3">
                    A value of <strong>1</strong> means the Flex Item
                    is allowed to shrink when the container does not
                    have enough space.
                </p>


                <!-- Diagram -->

                <h2>
                    Flex Shrink Diagram
                </h2>

                <div class="diagram-box">

                    <div class="diagram-container">

                        <div class="diagram-item">
                            Item 1
                        </div>

                        <div class="diagram-item">
                            Item 2
                        </div>

                        <div class="diagram-item">
                            Item 3
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        When the Flex Items require more space than
                        the container provides, shrink factors
                        determine how the items reduce their size.
                    </p>

                </div>


                <!-- Example 1 -->

                <h2>
                    Example 1: flex-shrink: 1
                </h2>

                <p>
                    When Flex Items have
                    <strong>flex-shrink: 1</strong>, they are allowed
                    to become smaller when the available space is
                    insufficient.
                </p>

                <div class="code-box">

<pre><code>.item {
    flex-basis: 220px;
    flex-shrink: 1;
}</code></pre>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item shrink-1">
                            Item 1
                        </div>

                        <div class="output-item shrink-1">
                            Item 2
                        </div>

                        <div class="output-item shrink-1">
                            Item 3
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    The container has limited space, so the items
                    are allowed to shrink from their
                    <strong>220px</strong> basis.
                </p>


                <!-- Example 2 -->

                <h2>
                    Example 2: flex-shrink: 0
                </h2>

                <p>
                    A value of <strong>0</strong> prevents a Flex Item
                    from shrinking.
                </p>

                <div class="code-box">

<pre><code>.item {
    flex-basis: 220px;
    flex-shrink: 0;
}</code></pre>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item shrink-0">
                            Item 1
                        </div>

                        <div class="output-item shrink-0">
                            Item 2
                        </div>

                        <div class="output-item shrink-0">
                            Item 3
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    Because the shrink factor is
                    <strong>0</strong>, the items do not shrink
                    from their <strong>220px</strong> basis.
                    The container therefore needs to handle the
                    extra content, such as through overflow or
                    responsive wrapping.
                </p>


                <!-- Example 3 -->

                <h2>
                    Example 3: Different Shrink Factors
                </h2>

                <p>
                    Different shrink values allow different Flex Items
                    to participate in shrinking at different rates.
                </p>

                <div class="code-box">

<pre><code>.item1 {
    flex-basis: 220px;
    flex-shrink: 1;
}

.item2 {
    flex-basis: 220px;
    flex-shrink: 2;
}

.item3 {
    flex-basis: 220px;
    flex-shrink: 1;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        Item 1 has a shrink factor of
                        <strong>1</strong>.
                    </p>

                    <p>
                        Item 2 has a shrink factor of
                        <strong>2</strong>.
                    </p>

                    <p>
                        Item 3 has a shrink factor of
                        <strong>1</strong>.
                    </p>

                    <p>
                        The second item therefore has a higher
                        shrink factor than the other two items.
                    </p>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item shrink-1">
                            Shrink 1
                        </div>

                        <div class="output-item shrink-2">
                            Shrink 2
                        </div>

                        <div class="output-item shrink-1">
                            Shrink 1
                        </div>

                    </div>

                </div>


                <!-- Values -->

                <h2>
                    Flex Shrink Values
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Value</th>
                                <th>Meaning</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>0</strong>
                                </td>

                                <td>
                                    The item does not shrink.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>1</strong>
                                </td>

                                <td>
                                    The item is allowed to shrink.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>2</strong>
                                </td>

                                <td>
                                    The item has a higher shrink
                                    factor than an item with value 1.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>3</strong>
                                </td>

                                <td>
                                    The item has an even higher
                                    shrink factor.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- How It Works -->

                <h2>
                    How Flex Shrink Works
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 1
                            </h3>

                            <p>
                                The browser determines whether the
                                Flex Items require more space than
                                the container provides.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 2
                            </h3>

                            <p>
                                The browser considers the
                                flex-shrink values of the items.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 3
                            </h3>

                            <p>
                                The items are reduced according to
                                their shrink factors and their
                                available space.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Flex Grow vs Flex Shrink -->

                <h2>
                    Flex Grow vs Flex Shrink
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Property</th>
                                <th>Purpose</th>
                                <th>Used When</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>flex-grow</strong>
                                </td>

                                <td>
                                    Controls how an item uses
                                    extra available space.
                                </td>

                                <td>
                                    Extra space is available.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>flex-shrink</strong>
                                </td>

                                <td>
                                    Controls how an item reduces
                                    its size.
                                </td>

                                <td>
                                    Available space is insufficient.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Flex Shrink and Flex Basis -->

                <h2>
                    Flex Shrink with Flex Basis
                </h2>

                <p>
                    <strong>flex-basis</strong> defines the initial
                    main-axis size of a Flex Item, while
                    <strong>flex-shrink</strong> controls whether
                    that size can be reduced when there is not enough
                    space.
                </p>

                <div class="code-box">

<pre><code>.course-card {
    flex-basis: 300px;
    flex-shrink: 1;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The preferred starting size is
                        <strong>300px</strong>.
                    </p>

                    <p>
                        Because <strong>flex-shrink: 1</strong> is
                        used, the card can become smaller when the
                        container cannot provide 300px of space.
                    </p>

                </div>


                <!-- Real World -->

                <h2>
                    Example 🌍
                </h2>

                <p>
                    Flex Shrink is commonly useful for responsive
                    navigation bars, dashboards, cards, product
                    layouts, and course sections.
                </p>

                <div class="code-box">

<pre><code>.course-card {
    flex-basis: 280px;
    flex-shrink: 1;
}

.fixed-card {
    flex-basis: 280px;
    flex-shrink: 0;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The first course card can become smaller
                        when space is limited.
                    </p>

                    <p>
                        The second card keeps its preferred size
                        because its shrink factor is
                        <strong>0</strong>.
                    </p>

                </div>


                <!-- Important Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    The default value of
                    <strong>flex-shrink</strong> is
                    <strong>1</strong>. Setting
                    <strong>flex-shrink: 0</strong> prevents an item
                    from shrinking. The actual final size of a Flex
                    Item also depends on other Flexbox properties,
                    available container space, and the item's content.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        The <strong>flex-shrink</strong> property
                        controls how Flex Items reduce their size
                        when the Flex Container does not have enough
                        available space. Its default value is
                        <strong>1</strong>. A value of
                        <strong>0</strong> prevents shrinking, while
                        higher values create a higher shrink factor
                        relative to other Flex Items.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("FlexGrow", "Flexbox", new { area = "CSS" })">

                            ← Previous: Flex Grow

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("FlexBasis", "Flexbox", new { area = "CSS" })">

                            Next: Flex Basis →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>