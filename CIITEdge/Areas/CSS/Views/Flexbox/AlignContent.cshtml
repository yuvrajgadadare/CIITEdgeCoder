                <!-- ================================================= -->
                <!-- IMPORTANT NOTE -->
                <!-- ================================================= -->

                <div class="note-box">

                    <strong>Important:</strong>

                    <strong>align-content</strong> works with multiple
                    Flex Lines. To create multiple lines, the Flex
                    Container generally needs
                    <strong>flex-wrap: wrap;</strong>. If there is
                    only one Flex Line, use
                    <strong>align-items</strong> for cross-axis
                    alignment of the items.

                </div>


                <!-- ================================================= -->
