                        <div style="
                            background-color:lightblue;
                            border:2px solid blue;
                            padding:18px;
                            width:30%;
                            text-align:center;
                            font-weight:700;
                        ">
                            CSS
                        </div>

                        <div style="
                            background-color:lightblue;
                            border:2px solid blue;
                            padding:18px;
                            width:30%;
