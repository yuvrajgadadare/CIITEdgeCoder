@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Align Content";
}

<style>

    #css-align-content-page {
        color: #212529;
    }

    #css-align-content-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-align-content-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-align-content-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-align-content-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-align-content-page .content-section > p {
        line-height: 1.7;
    }

    /* ================================================= */
    /* CODE */
    /* ================================================= */

    #css-align-content-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-align-content-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* ================================================= */
    /* EXPLANATION */
    /* ================================================= */

    #css-align-content-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-align-content-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* ================================================= */
    /* DIAGRAM */
    /* ================================================= */

    #css-align-content-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-align-content-page .diagram-container {
        display: flex;
        flex-wrap: wrap;
        align-content: space-between;
        gap: 10px;
        height: 260px;
        padding: 15px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-align-content-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        padding: 15px 22px;
        border-radius: 6px;
        font-weight: 700;
        width: 30%;
        text-align: center;
    }

    /* ================================================= */
    /* OUTPUT */
    /* ================================================= */

    #css-align-content-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-align-content-page .output-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        height: 260px;
        padding: 15px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-align-content-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        padding: 18px;
        width: 30%;
        text-align: center;
        font-weight: 700;
    }

    /* ================================================= */
    /* PROPERTY CARDS */
    /* ================================================= */

    #css-align-content-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-align-content-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-align-content-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* ================================================= */
    /* NOTE */
    /* ================================================= */

    #css-align-content-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* ================================================= */
    /* SUMMARY */
    /* ================================================= */

    #css-align-content-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-align-content-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-align-content-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
