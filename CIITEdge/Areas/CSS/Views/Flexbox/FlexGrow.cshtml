@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Flex Grow";
}

<style>

    #css-flex-grow-page {
        color: #212529;
    }

    #css-flex-grow-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-flex-grow-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-flex-grow-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-flex-grow-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-flex-grow-page .content-section > p {
        line-height: 1.7;
    }

    /* Code */

    #css-flex-grow-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-flex-grow-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* Explanation */

    #css-flex-grow-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-flex-grow-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* Diagram */

    #css-flex-grow-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-flex-grow-page .diagram-container {
        display: flex;
        gap: 12px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-flex-grow-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        padding: 18px;
        border-radius: 6px;
        text-align: center;
        font-weight: 700;
    }

    #css-flex-grow-page .diagram-item.small {
        flex-grow: 1;
    }

    #css-flex-grow-page .diagram-item.large {
        flex-grow: 2;
    }

    /* Output */

    #css-flex-grow-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-flex-grow-page .output-container {
        display: flex;
        gap: 12px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-flex-grow-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        padding: 20px;
        text-align: center;
        font-weight: 700;
    }

    #css-flex-grow-page .grow-1 {
        flex-grow: 1;
    }

    #css-flex-grow-page .grow-2 {
        flex-grow: 2;
    }

    #css-flex-grow-page .grow-3 {
        flex-grow: 3;
    }

    /* Property Cards */

    #css-flex-grow-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-flex-grow-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-flex-grow-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Note */

    #css-flex-grow-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* Summary */

    #css-flex-grow-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-flex-grow-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-flex-grow-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

</style>


<div id="css-flex-grow-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Flex Grow
                </h1>

                <p>
                    The CSS <strong>flex-grow</strong> property
                    controls how much a Flex Item can grow when
                    there is extra available space inside the
                    Flex Container.
                </p>

                <p>
                    It is useful when you want Flex Items to
                    automatically share the remaining space
                    according to specific proportions.
                </p>


                <!-- What is Flex Grow -->

                <h2>
                    What Is Flex Grow?
                </h2>

                <div class="explanation-box">

                    <p>
                        <strong>flex-grow</strong> defines the
                        growth factor of a Flex Item.
                    </p>

                    <p>
                        When extra space is available inside the
                        Flex Container, the browser distributes
                        that space among Flex Items based on their
                        <strong>flex-grow</strong> values.
                    </p>

                    <p>
                        The default value is
                        <strong>0</strong>.
                    </p>

                </div>


                <!-- Syntax -->

                <h2>
                    Syntax
                </h2>

                <div class="code-box">

<pre><code>.item {
    flex-grow: number;
}</code></pre>

                </div>


                <!-- Default -->

                <h2>
                    Default Value
                </h2>

                <div class="code-box">

<pre><code>.item {
    flex-grow: 0;
}</code></pre>

                </div>

                <p class="mt-3">
                    A value of <strong>0</strong> means the Flex Item
                    will not grow to consume extra available space.
                </p>


                <!-- Diagram -->

                <h2>
                    Flex Grow Diagram
                </h2>

                <div class="diagram-box">

                    <div class="diagram-container">

                        <div class="diagram-item small">
                            Grow: 1
                        </div>

                        <div class="diagram-item large">
                            Grow: 2
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        The item with flex-grow: 2 receives twice
                        the growth space of the item with flex-grow: 1.
                    </p>

                </div>


                <!-- Example 1 -->

                <h2>
                    Example 1: flex-grow: 1
                </h2>

                <p>
                    When multiple Flex Items have
                    <strong>flex-grow: 1</strong>, they can share
                    the available extra space equally.
                </p>

                <div class="code-box">

<pre><code>.item {
    flex-grow: 1;
}</code></pre>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item grow-1">
                            Item 1
                        </div>

                        <div class="output-item grow-1">
                            Item 2
                        </div>

                        <div class="output-item grow-1">
                            Item 3
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    Since all three items have the same growth
                    factor, the available extra space is distributed
                    equally among them.
                </p>


                <!-- Example 2 -->

                <h2>
                    Example 2: Different Flex Grow Values
                </h2>

                <p>
                    Different <strong>flex-grow</strong> values create
                    different proportions of the available space.
                </p>

                <div class="code-box">

<pre><code>.item1 {
    flex-grow: 1;
}

.item2 {
    flex-grow: 2;
}

.item3 {
    flex-grow: 1;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The total growth factor is:
                    </p>

                    <p>
                        <strong>1 + 2 + 1 = 4</strong>
                    </p>

                    <p>
                        Therefore, Item 2 receives twice as much
                        of the available growth space as Item 1
                        and Item 3.
                    </p>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item grow-1">
                            Item 1
                        </div>

                        <div class="output-item grow-2">
                            Item 2
                        </div>

                        <div class="output-item grow-1">
                            Item 3
                        </div>

                    </div>

                </div>


                <!-- Example 3 -->

                <h2>
                    Example 3: Three Different Growth Factors
                </h2>

                <div class="code-box">

<pre><code>.small {
    flex-grow: 1;
}

.medium {
    flex-grow: 2;
}

.large {
    flex-grow: 3;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The growth factors are
                        <strong>1 : 2 : 3</strong>.
                    </p>

                    <p>
                        The third item receives the largest share
                        of the available extra space.
                    </p>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-container">

                        <div class="output-item grow-1">
                            Grow 1
                        </div>

                        <div class="output-item grow-2">
                            Grow 2
                        </div>

                        <div class="output-item grow-3">
                            Grow 3
                        </div>

                    </div>

                </div>


                <!-- How It Works -->

                <h2>
                    How Flex Grow Works
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 1
                            </h3>

                            <p>
                                The browser identifies the available
                                extra space inside the Flex Container.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 2
                            </h3>

                            <p>
                                The browser calculates the total
                                flex-grow factors of the Flex Items.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Step 3
                            </h3>

                            <p>
                                The extra space is distributed
                                according to those growth factors.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Values -->

                <h2>
                    Flex Grow Values
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Value</th>
                                <th>Meaning</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>0</strong>
                                </td>

                                <td>
                                    The item does not grow.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>1</strong>
                                </td>

                                <td>
                                    The item receives one share
                                    of the available growth space.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>2</strong>
                                </td>

                                <td>
                                    The item receives two shares
                                    of the available growth space.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>3</strong>
                                </td>

                                <td>
                                    The item receives three shares
                                    of the available growth space.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Real World -->

                <h2>
                    Example 🌍
                </h2>

                <p>
                    Flex Grow is useful when creating responsive
                    layouts such as navigation bars, dashboards,
                    pricing cards, and course cards.
                </p>

                <div class="code-box">

<pre><code>.course {
    flex-grow: 1;
}

.featured-course {
    flex-grow: 2;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The normal course cards can share available
                        space equally, while the featured course can
                        receive twice the growth share.
                    </p>

                </div>


                <!-- Flex Grow vs Width -->

                <h2>
                    Flex Grow vs Width
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Property</th>
                                <th>Purpose</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>width</strong>
                                </td>

                                <td>
                                    Defines the preferred width
                                    of an element.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>flex-grow</strong>
                                </td>

                                <td>
                                    Controls how the item uses
                                    available extra space.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Important Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    <strong>flex-grow</strong> works when the Flex
                    Container has extra available space along its
                    main axis. The default value is
                    <strong>0</strong>. A higher growth factor means
                    the item receives a larger share of the available
                    growth space.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        The <strong>flex-grow</strong> property controls
                        how Flex Items use extra available space.
                        Its default value is <strong>0</strong>.
                        When multiple items have positive growth
                        factors, the available space is distributed
                        according to their relative
                        <strong>flex-grow</strong> values.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Order", "Flexbox", new { area = "CSS" })">

                            ← Previous: Order

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("FlexShrink", "Flexbox", new { area = "CSS" })">

                            Next: Flex Shrink →

                        </a>

                    </div>

                </div>
                    
            </div>

        </div>

    </div>

</div>