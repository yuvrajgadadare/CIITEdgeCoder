@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Font Size";
}

<div class="container-fluid py-4" id="css-font-size-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Font Size
                </h1>

                <p class="lead">
                    The <strong>font-size</strong> property is used
                    to control the size of text on a web page.
                </p>

                <p>
                    Font size can be specified using units such as
                    <strong>px</strong>, <strong>em</strong>,
                    <strong>rem</strong>, and percentages.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Font Size Works
                    </h4>

                    <div class="font-size-diagram">

                        <div class="diagram-box">
                            Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            font-size
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Sized Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Font Size in Pixels
                    </h4>

                    <p>
                        The <strong>px</strong> unit defines a specific
                        font size in pixels.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    font-size: 30px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="font-size: 30px; margin: 0;">
                            Welcome to CIIT Training Institute
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Font Size Using em
                    </h4>

                    <p>
                        The <strong>em</strong> unit is relative to
                        the font size of the parent element.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-size: 1.5em;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-size: 1.5em; margin: 0;">
                            Learn CSS at CIIT Training Institute.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Font Size Using rem
                    </h4>

                    <p>
                        The <strong>rem</strong> unit is relative to
                        the root HTML font size.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-size: 1.25rem;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-size: 1.25rem; margin: 0;">
                            CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Different Font Sizes
                    </h4>

                    <p>
                        Different HTML elements can use different
                        font sizes.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h1 {
    font-size: 36px;
}

h2 {
    font-size: 28px;
}

p {
    font-size: 18px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output font-size-multiple">

                        <h1 style="font-size: 36px; margin: 0 0 10px 0;">
                            CIIT Training Institute
                        </h1>

                        <h2 style="font-size: 28px; margin: 0 0 10px 0;">
                            CSS Training
                        </h2>

                        <p style="font-size: 18px; margin: 0;">
                            Learn CSS step by step.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON UNITS -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Font Size Units
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Unit</th>
                                    <th>Example</th>
                                    <th>Description</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>px</code>
                                    </td>

                                    <td>
                                        <code>20px</code>
                                    </td>

                                    <td>
                                        Fixed pixel size
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>em</code>
                                    </td>

                                    <td>
                                        <code>1.5em</code>
                                    </td>

                                    <td>
                                        Relative to the parent font size
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>rem</code>
                                    </td>

                                    <td>
                                        <code>1.25rem</code>
                                    </td>

                                    <td>
                                        Relative to the root font size
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>%</code>
                                    </td>

                                    <td>
                                        <code>120%</code>
                                    </td>

                                    <td>
                                        Percentage-based size
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>30px</strong>
                            → Sets the text size to 30 pixels.
                        </p>

                        <p>
                            <strong>1.5em</strong>
                            → Sets the size relative to the parent element.
                        </p>

                        <p>
                            <strong>1.25rem</strong>
                            → Sets the size relative to the root element.
                        </p>

                        <p class="mb-0">
                            Choosing the right unit helps create readable
                            and responsive web pages.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>font-size</code> property controls the
                    size of text. Common units include
                    <code>px</code>, <code>em</code>,
                    <code>rem</code>, and percentages.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("FontFamily", "TextFonts", new { area = "CSS" })">

                        ← Previous: Font Family

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("FontStyle", "TextFonts", new { area = "CSS" })">

                        Next: Font Style →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-font-size-page .content-section h1,
    #css-font-size-page .content-section h2,
    #css-font-size-page .content-section h3,
    #css-font-size-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-font-size-page .font-size-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-font-size-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-font-size-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-font-size-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-font-size-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-font-size-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }

    #css-font-size-page .font-size-multiple {
        display: block;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-font-size-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-font-size-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-font-size-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-font-size-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-font-size-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-font-size-page code {
        color: #b02a37;
    }

    #css-font-size-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-font-size-page .font-size-diagram {
            flex-direction: column;
        }

        #css-font-size-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-font-size-page .diagram-box {
            width: 100%;
        }

        #css-font-size-page .code-box {
            font-size: 13px;
        }

    }

</style>