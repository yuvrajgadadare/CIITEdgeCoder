@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Shadow";
}

<div class="container-fluid py-4" id="css-text-shadow-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Shadow
                </h1>

                <p class="lead">
                    The <strong>text-shadow</strong> property is used
                    to add a shadow effect behind text.
                </p>

                <p>
                    You can control the horizontal position, vertical
                    position, blur, and color of the shadow.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Shadow Works
                    </h4>

                    <div class="shadow-diagram">

                        <div class="diagram-box">
                            Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            text-shadow
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Shadow Effect
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Basic Text Shadow
                    </h4>

                    <p>
                        The <strong>text-shadow</strong> property
                        can create a simple shadow behind text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    text-shadow: 2px 2px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="text-shadow: 2px 2px; margin: 0;">
                            CIIT Training Institute
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Shadow With Color
                    </h4>

                    <p>
                        A color can be added to the shadow using
                        the fourth value.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    text-shadow: 2px 2px blue;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="text-shadow: 2px 2px blue; margin: 0;">
                            Learn CSS at CIIT
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Shadow With Blur
                    </h4>

                    <p>
                        The third value controls the blur radius
                        of the shadow.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    text-shadow: 2px 2px 5px gray;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="text-shadow: 2px 2px 5px gray; margin: 0;">
                            CIIT Training
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Soft Text Shadow
                    </h4>

                    <p>
                        A larger blur value creates a softer
                        and smoother shadow effect.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    text-shadow: 2px 2px 8px gray;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="text-shadow: 2px 2px 8px gray; margin: 0;">
                            Welcome to CIIT
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- TEXT SHADOW SYNTAX -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Text Shadow Syntax
                    </h4>

                    <pre class="code-box"><code>text-shadow: horizontal vertical blur color;</code></pre>

                    <div class="table-responsive mt-4">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Purpose</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>horizontal</code>
                                    </td>

                                    <td>
                                        Controls the horizontal position
                                        of the shadow
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>vertical</code>
                                    </td>

                                    <td>
                                        Controls the vertical position
                                        of the shadow
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>blur</code>
                                    </td>

                                    <td>
                                        Controls how soft the shadow appears
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>color</code>
                                    </td>

                                    <td>
                                        Defines the shadow color
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>2px 2px</strong>
                            → Moves the shadow 2px horizontally and vertically.
                        </p>

                        <p>
                            <strong>2px 2px blue</strong>
                            → Adds a blue shadow.
                        </p>

                        <p>
                            <strong>2px 2px 5px gray</strong>
                            → Adds a gray shadow with 5px blur.
                        </p>

                        <p class="mb-0">
                            A higher blur value makes the shadow softer.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>text-shadow</code> property adds a shadow
                    effect to text. It can control the shadow's
                    horizontal position, vertical position, blur,
                    and color.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextSpacing", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Spacing

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("FontFamily", "TextFonts", new { area = "CSS" })">

                        Next: Font Family →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-shadow-page .content-section h1,
    #css-text-shadow-page .content-section h2,
    #css-text-shadow-page .content-section h3,
    #css-text-shadow-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-shadow-page .shadow-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-shadow-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-shadow-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-shadow-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-text-shadow-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-shadow-page .browser-output {
        min-height: 110px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-shadow-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-text-shadow-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-shadow-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-text-shadow-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-text-shadow-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-shadow-page code {
        color: #b02a37;
    }

    #css-text-shadow-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-shadow-page .shadow-diagram {
            flex-direction: column;
        }

        #css-text-shadow-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-shadow-page .diagram-box {
            width: 100%;
        }

        #css-text-shadow-page .code-box {
            font-size: 13px;
        }

    }

</style>