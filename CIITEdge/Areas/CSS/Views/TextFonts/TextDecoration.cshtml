@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Decoration";
}

<div class="container-fluid py-4" id="css-text-decoration-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Decoration
                </h1>

                <p class="lead">
                    The <strong>text-decoration</strong> property is
                    used to add or remove decorative lines from text.
                </p>

                <p>
                    Common values include
                    <strong>underline</strong>,
                    <strong>overline</strong>,
                    <strong>line-through</strong>, and
                    <strong>none</strong>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Decoration Works
                    </h4>

                    <div class="decoration-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            text-decoration
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Decorated Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Underline
                    </h4>

                    <p>
                        The <strong>underline</strong> value adds a
                        line below the text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-decoration: underline;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-decoration: underline; margin: 0;">
                            This text is underlined.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Overline
                    </h4>

                    <p>
                        The <strong>overline</strong> value adds a
                        line above the text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-decoration: overline;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-decoration: overline; margin: 0;">
                            This text has an overline.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Line Through
                    </h4>

                    <p>
                        The <strong>line-through</strong> value
                        draws a line through the text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-decoration: line-through;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-decoration: line-through; margin: 0;">
                            This text has a line through it.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Remove Decoration
                    </h4>

                    <p>
                        The <strong>none</strong> value removes
                        text decoration.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>a {
    text-decoration: none;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <a href="#"
                           style="text-decoration: none; color: #0d6efd;"
                           onclick="return false;">
                            Link Without Underline
                        </a>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 5 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 5: Colored Underline
                    </h4>

                    <p>
                        You can also specify the decoration color
                        using <strong>text-decoration-color</strong>.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-decoration-line: underline;
    text-decoration-color: red;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-decoration-line: underline;
                            text-decoration-color: red;
                            margin: 0;">
                            Red Underlined Text
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Text Decoration Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Effect</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>underline</code>
                                    </td>

                                    <td>
                                        Adds a line below the text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>overline</code>
                                    </td>

                                    <td>
                                        Adds a line above the text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>line-through</code>
                                    </td>

                                    <td>
                                        Draws a line through the text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>none</code>
                                    </td>

                                    <td>
                                        Removes text decoration
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>underline</strong>
                            → Adds a line below the text.
                        </p>

                        <p>
                            <strong>overline</strong>
                            → Adds a line above the text.
                        </p>

                        <p>
                            <strong>line-through</strong>
                            → Draws a line through the text.
                        </p>

                        <p class="mb-0">
                            <strong>none</strong>
                            → Removes the text decoration.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>text-decoration</code> property controls
                    decorative lines on text. Common values are
                    <code>underline</code>, <code>overline</code>,
                    <code>line-through</code>, and <code>none</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextAlignment", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Alignment

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextTransformation", "TextFonts", new { area = "CSS" })">

                        Next: Text Transformation →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-decoration-page .content-section h1,
    #css-text-decoration-page .content-section h2,
    #css-text-decoration-page .content-section h3,
    #css-text-decoration-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-decoration-page .decoration-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-decoration-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-decoration-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-decoration-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-text-decoration-page .code-box code {
            color: #f8f9fa;
        }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-decoration-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-decoration-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-text-decoration-page .explanation-box p {
            margin-bottom: 10px;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-decoration-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

        #css-text-decoration-page .summary-box h2 {
            color: #075985;
            font-weight: 700;
            margin-bottom: 10px;
        }

        #css-text-decoration-page .summary-box p {
            color: #075985;
            margin-bottom: 0;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-decoration-page code {
        color: #b02a37;
    }

    #css-text-decoration-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-decoration-page .decoration-diagram {
            flex-direction: column;
        }

        #css-text-decoration-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-decoration-page .diagram-box {
            width: 100%;
        }

        #css-text-decoration-page .code-box {
            font-size: 13px;
        }
    }

</style>