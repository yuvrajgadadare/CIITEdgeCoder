@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text & Fonts";
}

<div class="container-fluid py-4" id="css-text-fonts-page">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- PAGE TITLE -->
            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text &amp; Fonts
                </h1>

                <p class="lead">
                    CSS provides properties to control the appearance,
                    alignment, size, spacing, and font style of text.
                </p>

                <p>
                    With CSS, we can make text easier to read and create
                    attractive and well-structured web pages.
                </p>

            </div>


            <!-- DIAGRAM -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How CSS Text &amp; Fonts Work
                    </h4>

                    <div class="text-diagram">

                        <div class="diagram-box">
                            HTML Text
                            <small>
                                Heading / Paragraph
                            </small>
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            CSS Text &amp; Font Properties
                            <small>
                                color / font-size / alignment
                            </small>
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Styled Text
                            <small>
                                Browser Output
                            </small>
                        </div>

                    </div>

                </div>

            </div>


            <!-- EXAMPLE 1 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Text Color
                    </h4>

                    <p>
                        The <code>color</code> property changes the color
                        of text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h1 {
    color: blue;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h1 style="color: blue; margin: 0;">
                            WELCOME TO CIIT TRAINING INSTITUTE 🌍    
                        </h1>

                    </div>

                </div>

            </div>


            <!-- EXAMPLE 2 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Font Size
                    </h4>

                    <p>
                        The <code>font-size</code> property controls
                        the size of text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    font-size: 32px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="font-size: 32px; margin: 0;">
                            Learn CSS
                        </h2>

                    </div>

                </div>

            </div>


            <!-- EXAMPLE 3 -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Text Alignment
                    </h4>

                    <p>
                        The <code>text-align</code> property controls
                        the horizontal alignment of text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-align: center;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-align: center; margin: 0;">
                            CSS makes text easy to organize.
                        </p>

                    </div>

                </div>

            </div>


            <!-- COMMON PROPERTIES -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Text &amp; Font Properties
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Property</th>
                                    <th>Purpose</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>color</code>
                                    </td>

                                    <td>
                                        Changes the text color.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>font-family</code>
                                    </td>

                                    <td>
                                        Specifies the font type.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>font-size</code>
                                    </td>

                                    <td>
                                        Controls the size of text.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>font-weight</code>
                                    </td>

                                    <td>
                                        Controls how bold the text appears.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>text-align</code>
                                    </td>

                                    <td>
                                        Controls text alignment.
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>text-decoration</code>
                                    </td>

                                    <td>
                                        Adds underline, overline, or line-through.
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- SIMPLE EXPLANATION -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>color</strong>
                            → Changes the text color.
                        </p>

                        <p>
                            <strong>font-size</strong>
                            → Changes the text size.
                        </p>

                        <p>
                            <strong>font-family</strong>
                            → Changes the font style.
                        </p>

                        <p>
                            <strong>font-weight</strong>
                            → Makes text normal or bold.
                        </p>

                        <p class="mb-0">
                            <strong>text-align</strong>
                            → Aligns text left, center, right, or justify.
                        </p>

                    </div>

                </div>

            </div>


            <!-- SUMMARY -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Summary
                    </h4>

                    <ul class="mb-0">

                        <li>
                            CSS can control the appearance of text.
                        </li>

                        <li>
                            Use <code>color</code> to change text color.
                        </li>

                        <li>
                            Use <code>font-size</code> to change text size.
                        </li>

                        <li>
                            Use <code>font-family</code> to select a font.
                        </li>

                        <li>
                            Use <code>text-align</code> to align text.
                        </li>

                    </ul>

                </div>

            </div>


            <!-- NAVIGATION -->
            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("MultipleBackgrounds", "ColorsBackgrounds", new { area = "CSS" })">

                        ← Previous: Multiple Backgrounds

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextColor", "TextFonts", new { area = "CSS" })">

                        Next: Text Color →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    #css-text-fonts-page .content-section h1,
    #css-text-fonts-page .content-section h2,
    #css-text-fonts-page .content-section h3,
    #css-text-fonts-page .content-section h4 {
        color: #212529;
    }


    /* CODE */
    #css-text-fonts-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-text-fonts-page .code-box code {
            color: #f8f9fa;
        }


    /* DIAGRAM */
    #css-text-fonts-page .text-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-fonts-page .diagram-box {
        padding: 18px 22px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 700;
        text-align: center;
        min-width: 170px;
    }

        #css-text-fonts-page .diagram-box small {
            display: block;
            margin-top: 6px;
            color: #6c757d;
            font-weight: 400;
        }

    #css-text-fonts-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* OUTPUT */
    #css-text-fonts-page .browser-output {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        min-height: 100px;
        display: flex;
        align-items: center;
    }


    /* EXPLANATION */
    #css-text-fonts-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-text-fonts-page .explanation-box p {
            margin-bottom: 10px;
        } 


    #css-text-fonts-page code {
        color: #b02a37;
    }

    #css-text-fonts-page .code-box code {
        color: #f8f9fa;
    }


    @@media (max-width: 767px) {

        #css-text-fonts-page .text-diagram {
            flex-direction: column;
        }

        #css-text-fonts-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-fonts-page .code-box {
            font-size: 13px;
        }

        #css-text-fonts-page .diagram-box {
            width: 100%;
        }
    }

</style>