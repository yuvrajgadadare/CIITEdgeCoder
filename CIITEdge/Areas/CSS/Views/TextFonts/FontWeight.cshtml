@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Font Weight";
}

<div class="container-fluid py-4" id="css-font-weight-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Font Weight
                </h1>

                <p class="lead">
                    The <strong>font-weight</strong> property is used
                    to control how thick or bold text appears.
                </p>

                <p>
                    You can use values such as
                    <strong>normal</strong>, <strong>bold</strong>,
                    or numeric values such as <strong>400</strong>
                    and <strong>700</strong>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Font Weight Works
                    </h4>

                    <div class="font-weight-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            font-weight
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Text Thickness
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Normal Weight
                    </h4>

                    <p>
                        The <strong>normal</strong> value displays
                        text with normal thickness.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-weight: normal;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-weight: normal; margin: 0;">
                            Welcome to CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Bold Weight
                    </h4>

                    <p>
                        The <strong>bold</strong> value makes text
                        thicker and more prominent.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-weight: bold;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-weight: bold; margin: 0;">
                            Learn CSS at CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Numeric Weight
                    </h4>

                    <p>
                        Numeric values can be used to specify the
                        exact font weight.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    font-weight: 700;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="font-weight: 700; margin: 0;">
                            CIIT Training Institute
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Different Font Weights
                    </h4>

                    <p>
                        Different elements can use different
                        numeric font weights.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>.light {
    font-weight: 300;
}

.normal {
    font-weight: 400;
}

.medium {
    font-weight: 500;
}

.bold {
    font-weight: 700;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output font-weight-multiple">

                        <p style="font-weight: 300; margin: 0 0 8px 0;">
                            300 - Light Text
                        </p>

                        <p style="font-weight: 400; margin: 0 0 8px 0;">
                            400 - Normal Text
                        </p>

                        <p style="font-weight: 500; margin: 0 0 8px 0;">
                            500 - Medium Text
                        </p>

                        <p style="font-weight: 700; margin: 0;">
                            700 - Bold Text
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FONT WEIGHT VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Font Weight Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Description</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>300</code>
                                    </td>

                                    <td>
                                        Light text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>400</code>
                                    </td>

                                    <td>
                                        Normal text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>500</code>
                                    </td>

                                    <td>
                                        Medium text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>600</code>
                                    </td>

                                    <td>
                                        Semi-bold text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>700</code>
                                    </td>

                                    <td>
                                        Bold text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>900</code>
                                    </td>

                                    <td>
                                        Extra bold text
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>font-weight: normal;</strong>
                            → Displays normal text thickness.
                        </p>

                        <p>
                            <strong>font-weight: bold;</strong>
                            → Makes text bold.
                        </p>

                        <p>
                            <strong>font-weight: 400;</strong>
                            → Represents normal font weight.
                        </p>

                        <p class="mb-0">
                            <strong>font-weight: 700;</strong>
                            → Represents bold font weight.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>font-weight</code> property controls
                    the thickness of text. Common values include
                    <code>normal</code>, <code>bold</code>, and
                    numeric values such as <code>400</code> and
                    <code>700</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("FontStyle", "TextFonts", new { area = "CSS" })">

                        ← Previous: Font Style

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("WebFonts", "TextFonts", new { area = "CSS" })">

                        Next: Web Fonts →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-font-weight-page .content-section h1,
    #css-font-weight-page .content-section h2,
    #css-font-weight-page .content-section h3,
    #css-font-weight-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-font-weight-page .font-weight-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-font-weight-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-font-weight-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-font-weight-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-font-weight-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-font-weight-page .browser-output {
        min-height: 110px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }

    #css-font-weight-page .font-weight-multiple {
        display: block;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-font-weight-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-font-weight-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-font-weight-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-font-weight-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-font-weight-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-font-weight-page code {
        color: #b02a37;
    }

    #css-font-weight-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-font-weight-page .font-weight-diagram {
            flex-direction: column;
        }

        #css-font-weight-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-font-weight-page .diagram-box {
            width: 100%;
        }

        #css-font-weight-page .code-box {
            font-size: 13px;
        }

    }

</style>