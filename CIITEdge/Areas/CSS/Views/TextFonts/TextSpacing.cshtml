@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Spacing";
}

<div class="container-fluid py-4" id="css-text-spacing-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Spacing
                </h1>

                <p class="lead">
                    CSS provides different properties to control
                    the spacing between letters, words, and lines
                    of text.
                </p>

                <p>
                    The commonly used text spacing properties are
                    <strong>letter-spacing</strong>,
                    <strong>word-spacing</strong>,
                    <strong>line-height</strong>, and
                    <strong>text-indent</strong>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Spacing Works
                    </h4>

                    <div class="spacing-diagram">

                        <div class="diagram-box">
                            Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Spacing Properties
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Better Readability
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Letter Spacing
                    </h4>

                    <p>
                        The <strong>letter-spacing</strong> property
                        controls the space between individual letters.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    letter-spacing: 4px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="letter-spacing: 4px; margin: 0;">
                            CIIT TRAINING
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Word Spacing
                    </h4>

                    <p>
                        The <strong>word-spacing</strong> property
                        controls the space between words.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    word-spacing: 12px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="word-spacing: 12px; margin: 0;">
                            Welcome to CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Line Height
                    </h4>

                    <p>
                        The <strong>line-height</strong> property
                        controls the vertical space between lines
                        of text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    line-height: 2;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="line-height: 2; margin: 0;">
                            CIIT Training Institute provides practical
                            training for students and professionals.
                            Learn programming and development skills
                            step by step.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Text Indent
                    </h4>

                    <p>
                        The <strong>text-indent</strong> property
                        adds space before the first line of text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-indent: 40px;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-indent: 40px; margin: 0;">
                            CIIT Training Institute provides practical
                            and structured training designed to build
                            real-world technical skills.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON PROPERTIES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Text Spacing Properties
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Property</th>
                                    <th>Purpose</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>letter-spacing</code>
                                    </td>

                                    <td>
                                        Controls space between letters
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>word-spacing</code>
                                    </td>

                                    <td>
                                        Controls space between words
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>line-height</code>
                                    </td>

                                    <td>
                                        Controls vertical space between lines
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>text-indent</code>
                                    </td>

                                    <td>
                                        Adds indentation to the first line
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>letter-spacing</strong>
                            → Controls the space between letters.
                        </p>

                        <p>
                            <strong>word-spacing</strong>
                            → Controls the space between words.
                        </p>

                        <p>
                            <strong>line-height</strong>
                            → Controls the space between lines.
                        </p>

                        <p class="mb-0">
                            <strong>text-indent</strong>
                            → Adds space before the first line.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    CSS text spacing properties control the space
                    between letters, words, and lines of text.
                    Common properties include
                    <code>letter-spacing</code>,
                    <code>word-spacing</code>,
                    <code>line-height</code>, and
                    <code>text-indent</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextTransformation", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Transformation

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextShadow", "TextFonts", new { area = "CSS" })">

                        Next: Text Shadow →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-spacing-page .content-section h1,
    #css-text-spacing-page .content-section h2,
    #css-text-spacing-page .content-section h3,
    #css-text-spacing-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-spacing-page .spacing-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-spacing-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-spacing-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-spacing-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-text-spacing-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-spacing-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-spacing-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-text-spacing-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-spacing-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-text-spacing-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-text-spacing-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-spacing-page code {
        color: #b02a37;
    }

    #css-text-spacing-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-spacing-page .spacing-diagram {
            flex-direction: column;
        }

        #css-text-spacing-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-spacing-page .diagram-box {
            width: 100%;
        }

        #css-text-spacing-page .code-box {
            font-size: 13px;
        }

    }

</style>