@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Font Style";
}

<div class="container-fluid py-4" id="css-font-style-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Font Style
                </h1>

                <p class="lead">
                    The <strong>font-style</strong> property is used
                    to specify the style of text.
                </p>

                <p>
                    Common values include <strong>normal</strong>,
                    <strong>italic</strong>, and
                    <strong>oblique</strong>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Font Style Works
                    </h4>

                    <div class="font-style-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            font-style
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Styled Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Normal
                    </h4>

                    <p>
                        The <strong>normal</strong> value displays
                        text in its regular style.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-style: normal;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-style: normal; margin: 0;">
                            Welcome to CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Italic
                    </h4>

                    <p>
                        The <strong>italic</strong> value displays
                        text in an italic style.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-style: italic;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-style: italic; margin: 0;">
                            Learn CSS at CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Oblique
                    </h4>

                    <p>
                        The <strong>oblique</strong> value displays
                        text in a slanted style.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-style: oblique;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-style: oblique; margin: 0;">
                            CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Different Font Styles
                    </h4>

                    <p>
                        Different elements can use different
                        font styles.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>.normal-text {
    font-style: normal;
}

.italic-text {
    font-style: italic;
}

.oblique-text {
    font-style: oblique;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output font-style-multiple">

                        <p style="font-style: normal; margin: 0 0 10px 0;">
                            Normal Text - CIIT Training Institute
                        </p>

                        <p style="font-style: italic; margin: 0 0 10px 0;">
                            Italic Text - CIIT Training Institute
                        </p>

                        <p style="font-style: oblique; margin: 0;">
                            Oblique Text - CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Font Style Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Effect</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>normal</code>
                                    </td>

                                    <td>
                                        Displays text in normal style
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>italic</code>
                                    </td>

                                    <td>
                                        Displays text in italic style
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>oblique</code>
                                    </td>

                                    <td>
                                        Displays text in a slanted style
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>normal</strong>
                            → Displays regular text.
                        </p>

                        <p>
                            <strong>italic</strong>
                            → Displays slanted italic text.
                        </p>

                        <p class="mb-0">
                            <strong>oblique</strong>
                            → Displays text in an oblique style.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>font-style</code> property controls the
                    style of text. The main values are
                    <code>normal</code>, <code>italic</code>, and
                    <code>oblique</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("FontSize", "TextFonts", new { area = "CSS" })">

                        ← Previous: Font Size

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("FontWeight", "TextFonts", new { area = "CSS" })">

                        Next: Font Weight →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-font-style-page .content-section h1,
    #css-font-style-page .content-section h2,
    #css-font-style-page .content-section h3,
    #css-font-style-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-font-style-page .font-style-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-font-style-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-font-style-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-font-style-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-font-style-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-font-style-page .browser-output {
        min-height: 110px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }

    #css-font-style-page .font-style-multiple {
        display: block;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-font-style-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-font-style-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-font-style-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-font-style-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-font-style-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-font-style-page code {
        color: #b02a37;
    }

    #css-font-style-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-font-style-page .font-style-diagram {
            flex-direction: column;
        }

        #css-font-style-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-font-style-page .diagram-box {
            width: 100%;
        }

        #css-font-style-page .code-box {
            font-size: 13px;
        }

    }

</style>