@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Transformation";
}

<div class="container-fluid py-4" id="css-text-transformation-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Transformation
                </h1>

                <p class="lead">
                    The <strong>text-transform</strong> property is
                    used to change the capitalization of text.
                </p>

                <p>
                    It can convert text to uppercase, lowercase,
                    capitalize each word, or display the text normally.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Transformation Works
                    </h4>

                    <div class="transformation-diagram">

                        <div class="diagram-box">
                            Original Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            text-transform
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Transformed Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Uppercase
                    </h4>

                    <p>
                        The <strong>uppercase</strong> value converts
                        all letters to capital letters.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-transform: uppercase;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-transform: uppercase; margin: 0;">
                            welcome to css
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Lowercase
                    </h4>

                    <p>
                        The <strong>lowercase</strong> value converts
                        all letters to lowercase.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-transform: lowercase;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-transform: lowercase; margin: 0;">
                            WELCOME TO CSS
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Capitalize
                    </h4>

                    <p>
                        The <strong>capitalize</strong> value makes
                        the first letter of each word uppercase.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-transform: capitalize;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-transform: capitalize; margin: 0;">
                            learn css step by step
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: None
                    </h4>

                    <p>
                        The <strong>none</strong> value keeps the
                        original capitalization of the text.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-transform: none;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-transform: none; margin: 0;">
                            CSS Text Example
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Text Transform Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Effect</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>uppercase</code>
                                    </td>

                                    <td>
                                        Converts all letters to uppercase
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>lowercase</code>
                                    </td>

                                    <td>
                                        Converts all letters to lowercase
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>capitalize</code>
                                    </td>

                                    <td>
                                        Capitalizes the first letter of each word
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>none</code>
                                    </td>

                                    <td>
                                        Keeps the original text capitalization
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>uppercase</strong>
                            → Converts all letters to capital letters.
                        </p>

                        <p>
                            <strong>lowercase</strong>
                            → Converts all letters to small letters.
                        </p>

                        <p>
                            <strong>capitalize</strong>
                            → Makes the first letter of each word uppercase.
                        </p>

                        <p class="mb-0">
                            <strong>none</strong>
                            → Keeps the original capitalization.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>text-transform</code> property controls
                    the capitalization of text. Common values are
                    <code>uppercase</code>, <code>lowercase</code>,
                    <code>capitalize</code>, and <code>none</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextDecoration", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Decoration

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextSpacing", "TextFonts", new { area = "CSS" })">

                        Next: Text Spacing →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-transformation-page .content-section h1,
    #css-text-transformation-page .content-section h2,
    #css-text-transformation-page .content-section h3,
    #css-text-transformation-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-transformation-page .transformation-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-transformation-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-transformation-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-transformation-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-text-transformation-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-transformation-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-transformation-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-text-transformation-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-transformation-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-text-transformation-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-text-transformation-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-transformation-page code {
        color: #b02a37;
    }

    #css-text-transformation-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-transformation-page .transformation-diagram {
            flex-direction: column;
        }

        #css-text-transformation-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-transformation-page .diagram-box {
            width: 100%;
        }

        #css-text-transformation-page .code-box {
            font-size: 13px;
        }

    }

</style>