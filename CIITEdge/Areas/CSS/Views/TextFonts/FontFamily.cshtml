@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Font Family";
}

<div class="container-fluid py-4" id="css-font-family-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Font Family
                </h1>

                <p class="lead">
                    The <strong>font-family</strong> property is used
                    to specify the typeface used for text on a web page.
                </p>

                <p>
                    You can specify one font family or provide multiple
                    fallback fonts in case the preferred font is not available.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Font Family Works
                    </h4>

                    <div class="font-family-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            font-family
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Selected Font
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Arial Font
                    </h4>

                    <p>
                        The <strong>Arial</strong> font can be applied
                        using the <code>font-family</code> property.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    font-family: Arial;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="font-family: Arial; margin: 0;">
                            Welcome to CIIT Training Institute
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Georgia Font
                    </h4>

                    <p>
                        The <strong>Georgia</strong> font gives text
                        a serif-style appearance.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-family: Georgia;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-family: Georgia; margin: 0;">
                            Learn CSS at CIIT Training Institute.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Multiple Font Families
                    </h4>

                    <p>
                        Multiple fonts can be specified as fallback
                        options. The browser uses the first available font.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-family: Arial, Helvetica, sans-serif;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-family: Arial, Helvetica, sans-serif; margin: 0;">
                            CIIT Training Institute - Learn. Practice. Grow.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Sans-Serif Font
                    </h4>

                    <p>
                        A generic font family such as
                        <strong>sans-serif</strong> can be used as
                        a final fallback.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    font-family: sans-serif;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="font-family: sans-serif; margin: 0;">
                            Welcome to CIIT Training Institute
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FONT FAMILY TYPES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Font Families
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Font Family</th>
                                    <th>Type</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>Arial</code>
                                    </td>

                                    <td>
                                        Sans-serif
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>Georgia</code>
                                    </td>

                                    <td>
                                        Serif
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>"Times New Roman"</code>
                                    </td>

                                    <td>
                                        Serif
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>Verdana</code>
                                    </td>

                                    <td>
                                        Sans-serif
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>sans-serif</code>
                                    </td>

                                    <td>
                                        Generic sans-serif family
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>serif</code>
                                    </td>

                                    <td>
                                        Generic serif family
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>font-family: Arial;</strong>
                            → Uses Arial for the text.
                        </p>

                        <p>
                            <strong>font-family: Georgia;</strong>
                            → Uses Georgia for the text.
                        </p>

                        <p>
                            <strong>Arial, Helvetica, sans-serif</strong>
                            → Provides fallback font choices.
                        </p>

                        <p class="mb-0">
                            The browser uses the first available font
                            from the specified list.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>font-family</code> property specifies
                    the typeface used for text. You can define a single
                    font or provide multiple fallback fonts to ensure
                    consistent text rendering.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextShadow", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Shadow

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("FontSize", "TextFonts", new { area = "CSS" })">

                        Next: Font Size →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-font-family-page .content-section h1,
    #css-font-family-page .content-section h2,
    #css-font-family-page .content-section h3,
    #css-font-family-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-font-family-page .font-family-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-font-family-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-font-family-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-font-family-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-font-family-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-font-family-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-font-family-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

    #css-font-family-page .explanation-box p {
        margin-bottom: 10px;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-font-family-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-font-family-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-font-family-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-font-family-page code {
        color: #b02a37;
    }

    #css-font-family-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-font-family-page .font-family-diagram {
            flex-direction: column;
        }

        #css-font-family-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-font-family-page .diagram-box {
            width: 100%;
        }

        #css-font-family-page .code-box {
            font-size: 13px;
        }

    }

</style>