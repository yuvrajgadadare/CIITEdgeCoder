@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Alignment";
}

<div class="container-fluid py-4" id="css-text-alignment-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Alignment
                </h1>

                <p class="lead">
                    The <strong>text-align</strong> property is used
                    to control the horizontal alignment of text
                    inside an HTML element.
                </p>

                <p>
                    Common values include
                    <strong>left</strong>, <strong>center</strong>,
                    <strong>right</strong>, and
                    <strong>justify</strong>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Alignment Works
                    </h4>

                    <div class="alignment-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            text-align
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Aligned Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Left Alignment
                    </h4>

                    <p>
                        The <strong>left</strong> value aligns text
                        to the left side of the element.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-align: left;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-align: left; margin: 0;">
                            This text is aligned to the left.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Center Alignment
                    </h4>

                    <p>
                        The <strong>center</strong> value places text
                        in the center of the element.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    text-align: center;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="text-align: center; margin: 0;">
                            Center Aligned Heading
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: Right Alignment
                    </h4>

                    <p>
                        The <strong>right</strong> value aligns text
                        to the right side of the element.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-align: right;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-align: right; margin: 0;">
                            This text is aligned to the right.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Justify Alignment
                    </h4>

                    <p>
                        The <strong>justify</strong> value stretches
                        text so that each line has a similar width.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    text-align: justify;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="text-align: justify; margin: 0;">
                            CSS is used to style web pages. The
                            text-align property controls the horizontal
                            alignment of text inside an element.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMMON VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common Text Alignment Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Value</th>
                                    <th>Description</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        <code>left</code>
                                    </td>

                                    <td>
                                        Aligns text to the left
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>center</code>
                                    </td>

                                    <td>
                                        Centers the text
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>right</code>
                                    </td>

                                    <td>
                                        Aligns text to the right
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <code>justify</code>
                                    </td>

                                    <td>
                                        Stretches text across the available width
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>text-align: left;</strong>
                            → Text moves to the left.
                        </p>

                        <p>
                            <strong>text-align: center;</strong>
                            → Text appears in the center.
                        </p>

                        <p>
                            <strong>text-align: right;</strong>
                            → Text moves to the right.
                        </p>

                        <p class="mb-0">
                            <strong>text-align: justify;</strong>
                            → Text is distributed across the available width.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>text-align</code> property controls the
                    horizontal alignment of text. Common values are
                    <code>left</code>, <code>center</code>,
                    <code>right</code>, and <code>justify</code>.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("TextColor", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text Color

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextDecoration", "TextFonts", new { area = "CSS" })">

                        Next: Text Decoration →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-alignment-page .content-section h1,
    #css-text-alignment-page .content-section h2,
    #css-text-alignment-page .content-section h3,
    #css-text-alignment-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-alignment-page .alignment-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-alignment-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-alignment-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-alignment-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-text-alignment-page .code-box code {
            color: #f8f9fa;
        }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-alignment-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-alignment-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-text-alignment-page .explanation-box p {
            margin-bottom: 10px;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-alignment-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

        #css-text-alignment-page .summary-box h2 {
            color: #075985;
            font-weight: 700;
            margin-bottom: 10px;
        }

        #css-text-alignment-page .summary-box p {
            color: #075985;
            margin-bottom: 0;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-alignment-page code {
        color: #b02a37;
    }

    #css-text-alignment-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-alignment-page .alignment-diagram {
            flex-direction: column;
        }

        #css-text-alignment-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-alignment-page .diagram-box {
            width: 100%;
        }

        #css-text-alignment-page .code-box {
            font-size: 13px;
        }
    }

</style>