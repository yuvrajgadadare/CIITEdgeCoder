@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "Text Color";
}

<div class="container-fluid py-4" id="css-text-color-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="content-section mb-4">

                <h1 class="fw-bold mb-3">
                    Text Color
                </h1>

                <p class="lead">
                    The <strong>color</strong> property is used to
                    change the color of text on a web page.
                </p>

                <p>
                    You can use color names, hexadecimal values,
                    RGB values, and other CSS color values.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- DIAGRAM -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        How Text Color Works
                    </h4>

                    <div class="text-color-diagram">

                        <div class="diagram-box">
                            HTML Text
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            color: blue;
                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-box">
                            Colored Text
                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 1 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 1: Color Name
                    </h4>

                    <p>
                        CSS allows you to use predefined color names
                        such as <code>blue</code>, <code>red</code>,
                        and <code>green</code>.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h1 {
    color: blue;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h1 style="color: blue; margin: 0;">
                            WELCOME TO CIIT TRAINING INSTITUTE🤓
                        </h1>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 2 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 2: Hexadecimal Color
                    </h4>

                    <p>
                        You can also specify a color using a
                        hexadecimal value.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h2 {
    color: #ff0000;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <h2 style="color: #ff0000; margin: 0;">
                            CSS Tutorial
                        </h2>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 3 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 3: RGB Color
                    </h4>

                    <p>
                        RGB values can be used to define colors
                        using red, green, and blue values.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>p {
    color: rgb(0, 128, 0);
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output">

                        <p style="color: rgb(0, 128, 0); margin: 0;">
                            Learn CSS step by step.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EXAMPLE 4 -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold">
                        Example 4: Multiple Text Colors
                    </h4>

                    <p>
                        Different HTML elements can have different
                        text colors.
                    </p>

                    <h6 class="fw-bold mt-3">
                        CSS Code
                    </h6>

                    <pre class="code-box"><code>h3 {
    color: purple;
}

p {
    color: orange;
}</code></pre>

                    <h6 class="fw-bold mt-4">
                        Output
                    </h6>

                    <div class="browser-output text-color-multiple">

                        <h3 style="color: purple; margin: 0 0 10px 0;">
                            CSS Colors
                        </h3>

                        <p style="color: orange; margin: 0;">
                            Different elements can use different colors.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COLOR VALUES -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Common CSS Color Values
                    </h4>

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>Type</th>
                                    <th>Example</th>
                                    <th>Description</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>
                                        Color Name
                                    </td>

                                    <td>
                                        <code>blue</code>
                                    </td>

                                    <td>
                                        Uses a predefined CSS color name
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        Hexadecimal
                                    </td>

                                    <td>
                                        <code>#ff0000</code>
                                    </td>

                                    <td>
                                        Uses a hexadecimal color value
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        RGB
                                    </td>

                                    <td>
                                        <code>rgb(0, 128, 0)</code>
                                    </td>

                                    <td>
                                        Uses red, green, and blue values
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIMPLE EXPLANATION -->
            <!-- ================================================= -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Simple Explanation
                    </h4>

                    <div class="explanation-box">

                        <p>
                            <strong>color: blue;</strong>
                            → Makes the text blue.
                        </p>

                        <p>
                            <strong>color: #ff0000;</strong>
                            → Makes the text red.
                        </p>

                        <p>
                            <strong>color: rgb(0, 128, 0);</strong>
                            → Makes the text green.
                        </p>

                        <p class="mb-0">
                            The <strong>color</strong> property changes
                            only the text color of an element.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="summary-box">

                <h2 class="h4">
                    Summary
                </h2>

                <p class="mb-0">
                    The <code>color</code> property is used to change
                    the color of text. CSS supports color names,
                    hexadecimal values, RGB values, and many other
                    color formats.
                </p>

            </div>


            <!-- ================================================= -->
            <!-- NAVIGATION -->
            <!-- ================================================= -->

            <div class="row g-3 mt-4 mb-5">

                <div class="col-md-6">

                    <a class="btn btn-outline-secondary w-100"
                       href="@Url.Action("Index", "TextFonts", new { area = "CSS" })">

                        ← Previous: Text &amp; Fonts

                    </a>

                </div>

                <div class="col-md-6">

                    <a class="btn btn-primary w-100"
                       href="@Url.Action("TextAlignment", "TextFonts", new { area = "CSS" })">

                        Next: Text Alignment →

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* PAGE HEADINGS */
    /* ========================================================= */

    #css-text-color-page .content-section h1,
    #css-text-color-page .content-section h2,
    #css-text-color-page .content-section h3,
    #css-text-color-page .content-section h4 {
        color: #212529;
    }


    /* ========================================================= */
    /* DIAGRAM */
    /* ========================================================= */

    #css-text-color-page .text-color-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    #css-text-color-page .diagram-box {
        padding: 16px 22px;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    #css-text-color-page .diagram-arrow {
        font-size: 26px;
        font-weight: 700;
        color: #2563eb;
    }


    /* ========================================================= */
    /* CODE */
    /* ========================================================= */

    #css-text-color-page .code-box {
        background: #212529;
        color: #f8f9fa;
        padding: 18px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 0;
    }

        #css-text-color-page .code-box code {
            color: #f8f9fa;
        }


    /* ========================================================= */
    /* OUTPUT */
    /* ========================================================= */

    #css-text-color-page .browser-output {
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
    }

    #css-text-color-page .text-color-multiple {
        display: block;
    }


    /* ========================================================= */
    /* EXPLANATION */
    /* ========================================================= */

    #css-text-color-page .explanation-box {
        background: #f8f9fa;
        border-left: 4px solid #2563eb;
        padding: 18px 20px;
        border-radius: 6px;
    }

        #css-text-color-page .explanation-box p {
            margin-bottom: 10px;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    #css-text-color-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

        #css-text-color-page .summary-box h2 {
            color: #075985;
            font-weight: 700;
            margin-bottom: 10px;
        }

        #css-text-color-page .summary-box p {
            color: #075985;
            margin-bottom: 0;
            line-height: 1.6;
        }


    /* ========================================================= */
    /* INLINE CODE */
    /* ========================================================= */

    #css-text-color-page code {
        color: #b02a37;
    }

    #css-text-color-page .code-box code {
        color: #f8f9fa;
    }


    /* ========================================================= */
    /* MOBILE */
    /* ========================================================= */

    @@media (max-width: 767px) {

        #css-text-color-page .text-color-diagram {
            flex-direction: column;
        }

        #css-text-color-page .diagram-arrow {
            transform: rotate(90deg);
        }

        #css-text-color-page .diagram-box {
            width: 100%;
        }

        #css-text-color-page .code-box {
            font-size: 13px;
        }
    }

</style>