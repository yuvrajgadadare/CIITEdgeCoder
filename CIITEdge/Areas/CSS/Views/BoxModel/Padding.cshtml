@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Padding";
}

<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    #css-padding-page {
        color: #212529;
    }

        #css-padding-page .content-section {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 30px;
        }

            #css-padding-page .content-section > h1 {
                font-weight: 700;
                margin-bottom: 15px;
            }

            #css-padding-page .content-section > h2 {
                font-weight: 700;
                margin-top: 35px;
                margin-bottom: 15px;
            }

            #css-padding-page .content-section > h3 {
                font-weight: 600;
                margin-top: 25px;
                margin-bottom: 12px;
            }

            #css-padding-page .content-section > p {
                line-height: 1.7;
            }


        /* ================================================= */
        /* CODE */
        /* ================================================= */

        #css-padding-page .code-box {
            background-color: #212529;
            color: #f8f9fa;
            border-radius: 6px;
            padding: 18px;
            margin-top: 15px;
            overflow-x: auto;
        }

            #css-padding-page .code-box pre {
                margin: 0;
                white-space: pre-wrap;
            }


        /* ================================================= */
        /* DIAGRAM */
        /* ================================================= */

        #css-padding-page .diagram-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 30px;
            margin-top: 15px;
            text-align: center;
        }

        #css-padding-page .padding-diagram-border {
            display: inline-block;
            background-color: #fff3cd;
            border: 5px solid #2563eb;
            padding: 30px;
        }

        #css-padding-page .padding-diagram-content {
            background-color: #bfdbfe;
            border: 1px solid #1d4ed8;
            padding: 20px;
            font-weight: 700;
        }

        #css-padding-page .padding-label {
            color: #1d4ed8;
            font-weight: 700;
            margin-bottom: 12px;
        }


        /* ================================================= */
        /* EXPLANATION */
        /* ================================================= */

        #css-padding-page .explanation-box {
            background-color: #f8f9fa;
            border-left: 4px solid #2563eb;
            border-radius: 4px;
            padding: 18px 20px;
            margin-top: 15px;
        }

            #css-padding-page .explanation-box p:last-child {
                margin-bottom: 0;
            }


        /* ================================================= */
        /* OUTPUT */
        /* ================================================= */

        #css-padding-page .browser-output {
            background-color: #ffffff;
            border: 1px solid #ced4da;
            border-radius: 6px;
            padding: 25px;
            margin-top: 15px;
            overflow-x: auto;
        }

        #css-padding-page .output-box-basic {
            background-color: lightblue;
            border: 2px solid blue;
            padding: 20px;
            text-align: center;
        }

        #css-padding-page .output-box-four {
            background-color: lightgreen;
            border: 2px solid green;
            padding-top: 10px;
            padding-right: 20px;
            padding-bottom: 30px;
            padding-left: 40px;
        }

        #css-padding-page .output-box-shorthand {
            background-color: lightyellow;
            border: 2px solid orange;
            padding: 10px 20px 30px 40px;
        }

        #css-padding-page .output-box-two-value {
            background-color: #e9d5ff;
            border: 2px solid purple;
            padding: 15px 30px;
            text-align: center;
        }


        /* ================================================= */
        /* PROPERTY CARDS */
        /* ================================================= */

        #css-padding-page .property-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 18px;
            height: 100%;
            background-color: #ffffff;
        }

            #css-padding-page .property-card h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #css-padding-page .property-card p {
                margin-bottom: 0;
                line-height: 1.6;
            }


        /* ================================================= */
        /* SUMMARY */
        /* ================================================= */

        #css-padding-page .summary-box {
            background-color: #e0f7fa;
            border: 1px solid #90e0ef;
            border-radius: 6px;
            padding: 18px 20px;
            margin-top: 30px;
        }

            #css-padding-page .summary-box h2 {
                color: #075985;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #css-padding-page .summary-box p {
                color: #075985;
                margin-bottom: 0;
                line-height: 1.6;
            }


    /* ================================================= */
    /* RESPONSIVE */
    /* ================================================= */

    @@media (max-width: 767px) {

        #css-padding-page .content-section {
            padding: 20px;
        }

        #css-padding-page .padding-diagram-border {
            padding: 20px;
        }
    }

</style>


<div id="css-padding-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <h1>
                    CSS Padding
                </h1>

                <p>
                    CSS <strong>padding</strong> is used to create space
                    between the content of an HTML element and its border.
                </p>

                <p>
                    Padding is inside the element. It makes the content
                    more comfortable to read and prevents the content
                    from touching the border directly.
                </p>


                <!-- ================================================= -->
                <!-- BASIC SYNTAX -->
                <!-- ================================================= -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

                    <pre><code>selector {
    padding: value;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- DIAGRAM -->
                <!-- ================================================= -->

                <h2>
                    Padding Diagram
                </h2>

                <div class="diagram-box">

                    <div class="padding-label">
                        Padding creates space around the content
                    </div>

                    <div class="padding-diagram-border">

                        <div class="padding-diagram-content">
                            Content
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SIMPLE EXPLANATION -->
                <!-- ================================================= -->

                <h2>
                    Simple Explanation
                </h2>

                <div class="explanation-box">

                    <p>
                        Think of padding as the <strong>inner space</strong>
                        of an element.
                    </p>

                    <p>
                        If your content is directly touching the border,
                        the design can look crowded.
                    </p>

                    <p>
                        By adding padding, you create space between the
                        content and the border.
                    </p>

                    <p>
                        <strong>Padding is inside the border.</strong>
                        Margin, which you will learn next, is outside
                        the border.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 1 -->
                <!-- ================================================= -->

                <h2>
                    Example 1: Basic Padding
                </h2>

                <p>
                    The following example adds <strong>20px</strong> of
                    padding on all four sides of the element.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    background-color: lightblue;
    border: 2px solid blue;
    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-box-basic">

                        CIIT Training Institute

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 2 -->
                <!-- ================================================= -->

                <h2>
                    Example 2: Padding on Individual Sides
                </h2>

                <p>
                    CSS allows you to control padding separately for
                    the top, right, bottom, and left sides.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    background-color: lightgreen;
    border: 2px solid green;

    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 30px;
    padding-left: 40px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-box-four">

                        <strong>CIIT Training Institute</strong>

                        <p class="mb-0 mt-2">
                            Different padding values are applied
                            to each side.
                        </p>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 3 -->
                <!-- ================================================= -->

                <h2>
                    Example 3: Padding Shorthand
                </h2>

                <p>
                    Instead of writing four separate properties,
                    you can use the padding shorthand property.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    background-color: lightyellow;
    border: 2px solid orange;
    padding: 10px 20px 30px 40px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-box-shorthand">

                        <strong>CIIT Training Institute</strong>

                        <p class="mb-0 mt-2">
                            Padding shorthand controls all four sides.
                        </p>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SHORTHAND RULE -->
                <!-- ================================================= -->

                <h2>
                    Padding Shorthand Rule
                </h2>

                <p>
                    When four values are provided, CSS follows the
                    clockwise direction:
                </p>

                <div class="diagram-box">

                    <div class="row g-3 text-center">

                        <div class="col-md-3">
                            <strong>Top</strong>
                            <br />
                            10px
                        </div>

                        <div class="col-md-3">
                            <strong>Right</strong>
                            <br />
                            20px
                        </div>

                        <div class="col-md-3">
                            <strong>Bottom</strong>
                            <br />
                            30px
                        </div>

                        <div class="col-md-3">
                            <strong>Left</strong>
                            <br />
                            40px
                        </div>

                    </div>

                </div>


                <div class="code-box">

                    <pre><code>padding: 10px 20px 30px 40px;

/*
Top    = 10px
Right  = 20px
Bottom = 30px
Left   = 40px
*/</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- TWO VALUE SHORTHAND -->
                <!-- ================================================= -->

                <h2>
                    Two-Value Padding
                </h2>

                <p>
                    When two values are used, the first value applies
                    to the top and bottom, while the second value applies
                    to the left and right.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    background-color: #e9d5ff;
    border: 2px solid purple;
    padding: 15px 30px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-box-two-value">

                        CIIT Training Institute

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PADDING PROPERTIES -->
                <!-- ================================================= -->

                <h2>
                    Padding Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                padding-top
                            </h3>

                            <p>
                                Controls the space between the content
                                and the top border.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                padding-right
                            </h3>

                            <p>
                                Controls the space between the content
                                and the right border.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                padding-bottom
                            </h3>

                            <p>
                                Controls the space between the content
                                and the bottom border.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                padding-left
                            </h3>

                            <p>
                                Controls the space between the content
                                and the left border.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PADDING VS MARGIN -->
                <!-- ================================================= -->

                <h2>
                    Padding vs Margin
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Padding</th>
                                <th>Margin</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>Space inside the border.</td>
                                <td>Space outside the border.</td>
                            </tr>

                            <tr>
                                <td>Creates space around content.</td>
                                <td>Creates space between elements.</td>
                            </tr>

                            <tr>
                                <td>Part of the element's box.</td>
                                <td>Outside the element's box.</td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p class="mb-0">
                        CSS padding creates space between an element's
                        content and its border. Padding can be applied
                        to all four sides using the shorthand property
                        or controlled individually using padding-top,
                        padding-right, padding-bottom, and padding-left.
                        Remember: padding is inside the border, while
                        margin creates space outside the border.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- NAVIGATION -->
                <!-- ================================================= -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("WidthAndHeight", "BoxModel", new { area = "CSS" })">

                            ← Previous: Width & Height

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("Margin", "BoxModel", new { area = "CSS" })">

                            Next: Margin →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>