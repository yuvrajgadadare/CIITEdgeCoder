@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Width and Height";
}

<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    #css-width-height-page {
        color: #212529;
    }

        #css-width-height-page .content-section {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 30px;
        }

            #css-width-height-page .content-section > h1 {
                font-weight: 700;
                margin-bottom: 15px;
            }

            #css-width-height-page .content-section > h2 {
                font-weight: 700;
                margin-top: 35px;
                margin-bottom: 15px;
            }

            #css-width-height-page .content-section > h3 {
                font-weight: 600;
                margin-top: 25px;
                margin-bottom: 12px;
            }

            #css-width-height-page .content-section > p {
                line-height: 1.7;
            }


        /* ================================================= */
        /* CODE BOX */
        /* ================================================= */

        #css-width-height-page .code-box {
            background-color: #212529;
            color: #f8f9fa;
            border-radius: 6px;
            padding: 18px;
            margin-top: 15px;
            overflow-x: auto;
        }

            #css-width-height-page .code-box pre {
                margin: 0;
                white-space: pre-wrap;
            }


        /* ================================================= */
        /* DIAGRAM */
        /* ================================================= */

        #css-width-height-page .diagram-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 30px;
            margin-top: 15px;
            text-align: center;
        }

        #css-width-height-page .dimension-box {
            width: 280px;
            height: 140px;
            background-color: #dbeafe;
            border: 3px solid #2563eb;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            font-weight: 700;
        }

        #css-width-height-page .width-label {
            position: absolute;
            top: -30px;
            left: 0;
            width: 100%;
            color: #1d4ed8;
            font-weight: 700;
        }

        #css-width-height-page .height-label {
            position: absolute;
            right: -85px;
            top: 50%;
            transform: translateY(-50%);
            color: #1d4ed8;
            font-weight: 700;
        }


        /* ================================================= */
        /* EXPLANATION BOX */
        /* ================================================= */

        #css-width-height-page .explanation-box {
            background-color: #f8f9fa;
            border-left: 4px solid #2563eb;
            border-radius: 4px;
            padding: 18px 20px;
            margin-top: 15px;
        }

            #css-width-height-page .explanation-box p:last-child {
                margin-bottom: 0;
            }


        /* ================================================= */
        /* OUTPUT */
        /* ================================================= */

        #css-width-height-page .browser-output {
            background-color: #ffffff;
            border: 1px solid #ced4da;
            border-radius: 6px;
            padding: 25px;
            margin-top: 15px;
            overflow-x: auto;
        }

        #css-width-height-page .demo-box-one {
            width: 300px;
            height: 120px;
            background-color: lightblue;
            border: 2px solid blue;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #css-width-height-page .demo-box-two {
            width: 50%;
            height: 100px;
            background-color: lightgreen;
            border: 2px solid green;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #css-width-height-page .demo-box-three {
            width: 400px;
            min-height: 120px;
            background-color: lightyellow;
            border: 2px solid orange;
            padding: 15px;
        }


        /* ================================================= */
        /* PROPERTY CARDS */
        /* ================================================= */

        #css-width-height-page .property-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 18px;
            height: 100%;
            background-color: #ffffff;
        }

            #css-width-height-page .property-card h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #css-width-height-page .property-card p {
                margin-bottom: 0;
                line-height: 1.6;
            }


        /* ================================================= */
        /* NOTE */
        /* ================================================= */

        #css-width-height-page .note-box {
            background-color: #fff3cd;
            border: 1px solid #ffecb5;
            border-radius: 6px;
            padding: 16px 18px;
            margin-top: 20px;
        }


        /* ================================================= */
        /* SUMMARY */
        /* ================================================= */

        #css-width-height-page .summary-box {
            background-color: #e0f7fa;
            border: 1px solid #90e0ef;
            border-radius: 6px;
            padding: 18px 20px;
            margin-top: 30px;
        }

            #css-width-height-page .summary-box h2 {
                color: #075985;
                font-weight: 700;
                margin-bottom: 10px;
            }

            #css-width-height-page .summary-box p {
                color: #075985;
                margin-bottom: 0;
                line-height: 1.6;
            }


    /* ================================================= */
    /* RESPONSIVE */
    /* ================================================= */

    @@media (max-width: 767px) {

        #css-width-height-page .content-section {
            padding: 20px;
        }

        #css-width-height-page .dimension-box {
            width: 220px;
        }

        #css-width-height-page .height-label {
            position: static;
            transform: none;
            margin-top: 10px;
        }

        #css-width-height-page .demo-box-one,
        #css-width-height-page .demo-box-three {
            max-width: 100%;
        }
    }

</style>


<div id="css-width-height-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- ================================================= -->
                <!-- INTRODUCTION -->
                <!-- ================================================= -->

                <h1>
                    CSS Width & Height
                </h1>

                <p>
                    The CSS <strong>width</strong> and <strong>height</strong>
                    properties are used to control the size of HTML elements.
                </p>

                <p>
                    Width controls how wide an element is, while height controls
                    how tall an element is. These properties are commonly used
                    with divs, images, containers, cards, buttons, forms, and
                    other page elements.
                </p>


                <!-- ================================================= -->
                <!-- CODE -->
                <!-- ================================================= -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

                    <pre><code>selector {
    width: value;
    height: value;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- DIAGRAM -->
                <!-- ================================================= -->

                <h2>
                    Width & Height Diagram
                </h2>

                <div class="diagram-box">

                    <div class="dimension-box">

                        <div class="width-label">
                            ← Width: 280px →
                        </div>

                        CSS Element

                        <div class="height-label">
                            Height: 140px
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SIMPLE EXPLANATION -->
                <!-- ================================================= -->

                <h2>
                    Simple Explanation
                </h2>

                <div class="explanation-box">

                    <p>
                        Imagine an HTML element as a rectangular box.
                    </p>

                    <p>
                        <strong>Width</strong> controls the horizontal size
                        of the box.
                    </p>

                    <p>
                        <strong>Height</strong> controls the vertical size
                        of the box.
                    </p>

                    <p>
                        For example, if a box has a width of
                        <strong>300px</strong> and a height of
                        <strong>120px</strong>, the browser creates a box
                        that is 300 pixels wide and 120 pixels tall.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 1 -->
                <!-- ================================================= -->

                <h2>
                    Example 1: Width and Height in Pixels
                </h2>

                <p>
                    Pixels are commonly used when you want to give an element
                    a specific size.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    width: 300px;
    height: 120px;
    background-color: lightblue;
    border: 2px solid blue;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="demo-box-one">
                        CIIT Training Institute
                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 2 -->
                <!-- ================================================= -->

                <h2>
                    Example 2: Width Using Percentage
                </h2>

                <p>
                    Percentage values allow an element to use a portion of
                    the available width of its parent container.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    width: 50%;
    height: 100px;
    background-color: lightgreen;
    border: 2px solid green;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="demo-box-two">
                        50% Width
                    </div>

                </div>

                <div class="explanation-box">

                    <p>
                        Here, the element uses
                        <strong>50% of the available width</strong>
                        of its parent container.
                    </p>

                    <p>
                        This is useful when creating responsive layouts
                        because the width can change according to the
                        size of the parent element.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 3 -->
                <!-- ================================================= -->

                <h2>
                    Example 3: Using min-height
                </h2>

                <p>
                    Sometimes the amount of content inside an element can
                    change. In that situation, using
                    <strong>min-height</strong> can be more flexible than
                    using a fixed height.
                </p>

                <div class="code-box">

                    <pre><code>.box {
    width: 400px;
    min-height: 120px;
    background-color: lightyellow;
    border: 2px solid orange;
    padding: 15px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="demo-box-three">

                        <strong>CIIT Training Institute</strong>

                        <p class="mb-0 mt-2">
                            This box has a minimum height of 120px.
                            If more content is added, the box can grow
                            automatically.
                        </p>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- WIDTH PROPERTIES -->
                <!-- ================================================= -->

                <h2>
                    Width Related Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                width
                            </h3>

                            <p>
                                Sets the normal width of an element.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                min-width
                            </h3>

                            <p>
                                Defines the minimum width an element
                                can have.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                max-width
                            </h3>

                            <p>
                                Defines the maximum width an element
                                can have.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- HEIGHT PROPERTIES -->
                <!-- ================================================= -->

                <h2>
                    Height Related Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                height
                            </h3>

                            <p>
                                Sets the normal height of an element.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                min-height
                            </h3>

                            <p>
                                Defines the minimum height an element
                                can have.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                max-height
                            </h3>

                            <p>
                                Defines the maximum height an element
                                can have.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- COMMON VALUES -->
                <!-- ================================================= -->

                <h2>
                    Common Width and Height Values
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Value</th>
                                <th>Example</th>
                                <th>Description</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>px</td>
                                <td>width: 300px;</td>
                                <td>
                                    Sets a fixed size in pixels.
                                </td>
                            </tr>

                            <tr>
                                <td>%</td>
                                <td>width: 50%;</td>
                                <td>
                                    Uses a percentage of the parent
                                    element.
                                </td>
                            </tr>

                            <tr>
                                <td>auto</td>
                                <td>width: auto;</td>
                                <td>
                                    Lets the browser calculate the size.
                                </td>
                            </tr>

                            <tr>
                                <td>vw</td>
                                <td>width: 50vw;</td>
                                <td>
                                    Uses a percentage of the viewport width.
                                </td>
                            </tr>

                            <tr>
                                <td>vh</td>
                                <td>height: 50vh;</td>
                                <td>
                                    Uses a percentage of the viewport height.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- IMPORTANT NOTE -->
                <!-- ================================================= -->

                <div class="note-box">

                    <strong>Important:</strong>

                    The final visible size of an element can also be affected
                    by padding and border. Later, you will learn how the
                    <strong>box-sizing</strong> property helps control this
                    behavior.

                </div>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p class="mb-0">
                        CSS width controls the horizontal size of an element,
                        while height controls its vertical size. Values such
                        as pixels, percentages, auto, vw, and vh can be used.
                        The min-width, max-width, min-height, and max-height
                        properties provide additional control when building
                        flexible and responsive layouts.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- NAVIGATION -->
                <!-- ================================================= -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Index", "BoxModel", new { area = "CSS" })">

                            ← Previous: CSS Box Model

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("Padding", "BoxModel", new { area = "CSS" })">

                            Next: Padding →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>