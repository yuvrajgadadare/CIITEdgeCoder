@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Box Sizing";
}

<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    #css-box-sizing-page {
        color: #212529;
    }

    #css-box-sizing-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-box-sizing-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-box-sizing-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-box-sizing-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-box-sizing-page .content-section > p {
        line-height: 1.7;
    }


    /* ================================================= */
    /* CODE */
    /* ================================================= */

    #css-box-sizing-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-box-sizing-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }


    /* ================================================= */
    /* DIAGRAM */
    /* ================================================= */

    #css-box-sizing-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 30px;
        margin-top: 15px;
        text-align: center;
    }

    #css-box-sizing-page .diagram-content-box {
        width: 220px;
        background-color: #dbeafe;
        border: 8px solid #2563eb;
        padding: 20px;
        margin: 20px auto;
        box-sizing: content-box;
    }

    #css-box-sizing-page .diagram-border-box {
        width: 220px;
        background-color: #dcfce7;
        border: 8px solid #16a34a;
        padding: 20px;
        margin: 20px auto;
        box-sizing: border-box;
    }

    #css-box-sizing-page .diagram-label {
        font-weight: 700;
        margin-bottom: 10px;
    }


    /* ================================================= */
    /* EXPLANATION */
    /* ================================================= */

    #css-box-sizing-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-box-sizing-page .explanation-box p:last-child {
        margin-bottom: 0;
    }


    /* ================================================= */
    /* OUTPUT */
    /* ================================================= */

    #css-box-sizing-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-box-sizing-page .output-content-box {
        width: 300px;
        height: 150px;
        padding: 20px;
        border: 5px solid blue;
        background-color: lightblue;
        box-sizing: content-box;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    #css-box-sizing-page .output-border-box {
        width: 300px;
        height: 150px;
        padding: 20px;
        border: 5px solid green;
        background-color: lightgreen;
        box-sizing: border-box;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    #css-box-sizing-page .output-comparison {
        width: 300px;
        height: 120px;
        padding: 20px;
        border: 5px solid purple;
        background-color: #e9d5ff;
        box-sizing: border-box;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }


    /* ================================================= */
    /* PROPERTY CARDS */
    /* ================================================= */

    #css-box-sizing-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-box-sizing-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-box-sizing-page .property-card p {
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* NOTE */
    /* ================================================= */

    #css-box-sizing-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }


    /* ================================================= */
    /* SUMMARY */
    /* ================================================= */

    #css-box-sizing-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-box-sizing-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-box-sizing-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* RESPONSIVE */
    /* ================================================= */

    @@media (max-width: 767px) {

        #css-box-sizing-page .content-section {
            padding: 20px;
        }

        #css-box-sizing-page .output-content-box,
        #css-box-sizing-page .output-border-box,
        #css-box-sizing-page .output-comparison {
            width: 100%;
        }

    }

</style>


<div id="css-box-sizing-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <h1>
                    CSS Box Sizing
                </h1>

                <p>
                    The CSS <strong>box-sizing</strong> property controls
                    how the total width and height of an element are
                    calculated.
                </p>

                <p>
                    This property becomes especially important when an
                    element has a defined width or height together with
                    padding and borders.
                </p>


                <!-- ================================================= -->
                <!-- BASIC SYNTAX -->
                <!-- ================================================= -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>selector {
    box-sizing: value;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- MAIN VALUES -->
                <!-- ================================================= -->

                <h2>
                    Main Box Sizing Values
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                content-box
                            </h3>

                            <p>
                                The width and height apply to the content
                                area. Padding and border are added outside
                                the specified width and height.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                border-box
                            </h3>

                            <p>
                                The specified width and height include
                                the content, padding, and border.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- DIAGRAM -->
                <!-- ================================================= -->

                <h2>
                    Box Sizing Diagram
                </h2>

                <div class="diagram-box">

                    <div class="diagram-label">
                        content-box
                    </div>

                    <div class="diagram-content-box">

                        Width = 220px

                        <br />

                        Padding + Border are added outside

                    </div>


                    <div class="diagram-label">
                        border-box
                    </div>

                    <div class="diagram-border-box">

                        Width = 220px

                        <br />

                        Padding + Border are included

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SIMPLE EXPLANATION -->
                <!-- ================================================= -->

                <h2>
                    Simple Explanation
                </h2>

                <div class="explanation-box">

                    <p>
                        Suppose you create a box with
                        <strong>width: 300px</strong>.
                    </p>

                    <p>
                        If you use <strong>content-box</strong>, the
                        300px represents only the content width.
                        Padding and border are then added to that size.
                    </p>

                    <p>
                        If you use <strong>border-box</strong>, the
                        complete width remains 300px. The content,
                        padding, and border fit inside that 300px.
                    </p>

                    <p>
                        This makes <strong>border-box</strong> very useful
                        when you want predictable element dimensions.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 1 -->
                <!-- ================================================= -->

                <h2>
                    Example 1: content-box
                </h2>

                <p>
                    With <strong>content-box</strong>, the specified
                    width and height apply only to the content area.
                </p>

                <div class="code-box">

<pre><code>.box {
    width: 300px;
    height: 150px;
    padding: 20px;
    border: 5px solid blue;
    background-color: lightblue;

    box-sizing: content-box;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-content-box">

                        Content Box

                    </div>

                </div>


                <div class="explanation-box">

                    <p>
                        The specified width is
                        <strong>300px</strong>.
                    </p>

                    <p>
                        Padding adds <strong>40px</strong> horizontally
                        and the border adds <strong>10px</strong>
                        horizontally.
                    </p>

                    <p>
                        Therefore, the total horizontal size becomes
                        <strong>350px</strong>.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 2 -->
                <!-- ================================================= -->

                <h2>
                    Example 2: border-box
                </h2>

                <p>
                    With <strong>border-box</strong>, the specified
                    width and height include the padding and border.
                </p>

                <div class="code-box">

<pre><code>.box {
    width: 300px;
    height: 150px;
    padding: 20px;
    border: 5px solid green;
    background-color: lightgreen;

    box-sizing: border-box;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-border-box">

                        Border Box

                    </div>

                </div>


                <div class="explanation-box">

                    <p>
                        The complete width remains
                        <strong>300px</strong>.
                    </p>

                    <p>
                        The padding and border are included inside the
                        specified width.
                    </p>

                    <p>
                        This means the outer size does not increase
                        when padding or border is added.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- COMPARISON -->
                <!-- ================================================= -->

                <h2>
                    content-box vs border-box
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Feature</th>
                                <th>content-box</th>
                                <th>border-box</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>Width includes content</td>
                                <td>Yes</td>
                                <td>Yes</td>
                            </tr>

                            <tr>
                                <td>Width includes padding</td>
                                <td>No</td>
                                <td>Yes</td>
                            </tr>

                            <tr>
                                <td>Width includes border</td>
                                <td>No</td>
                                <td>Yes</td>
                            </tr>

                            <tr>
                                <td>Outer size remains predictable</td>
                                <td>No</td>
                                <td>Yes</td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- PRACTICAL EXAMPLE -->
                <!-- ================================================= -->

                <h2>
                    Practical Example
                </h2>

                <p>
                    The <strong>border-box</strong> model is commonly
                    useful when creating cards, forms, navigation
                    components, and responsive layouts.
                </p>

                <div class="code-box">

<pre><code>* {
    box-sizing: border-box;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        This rule applies <strong>border-box</strong>
                        sizing to all elements.
                    </p>

                    <p>
                        It helps make width calculations easier because
                        padding and borders are included inside the
                        declared width and height.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- IMPORTANT NOTE -->
                <!-- ================================================= -->

                <div class="note-box">

                    <strong>Important:</strong>

                    The default value of the
                    <strong>box-sizing</strong> property is
                    <strong>content-box</strong>.

                    The <strong>border-box</strong> value is often useful
                    when you want the declared width and height to include
                    padding and border.

                </div>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p class="mb-0">
                        The CSS box-sizing property controls how an
                        element's width and height are calculated.
                        With content-box, padding and border are added
                        outside the declared dimensions. With border-box,
                        padding and border are included within the
                        declared dimensions. Understanding this difference
                        is important when creating predictable layouts.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- NAVIGATION -->
                <!-- ================================================= -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("BorderRadius", "BoxModel", new { area = "CSS" })">

                            ← Previous: Border Radius

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("BoxShadow", "BoxModel", new { area = "CSS" })">

                            Next: Box Shadow →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>