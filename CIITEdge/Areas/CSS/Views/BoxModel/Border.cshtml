@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Border";
}

<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    #css-border-page {
        color: #212529;
    }

    #css-border-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-border-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-border-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-border-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-border-page .content-section > p {
        line-height: 1.7;
    }


    /* ================================================= */
    /* CODE */
    /* ================================================= */

    #css-border-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-border-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }


    /* ================================================= */
    /* DIAGRAM */
    /* ================================================= */

    #css-border-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 30px;
        margin-top: 15px;
        text-align: center;
    }

    #css-border-page .border-diagram {
        display: inline-block;
        background-color: #dbeafe;
        border: 8px solid #2563eb;
        padding: 30px 50px;
        font-weight: 700;
    }

    #css-border-page .border-label {
        color: #1d4ed8;
        font-weight: 700;
        margin-bottom: 15px;
    }


    /* ================================================= */
    /* EXPLANATION */
    /* ================================================= */

    #css-border-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-border-page .explanation-box p:last-child {
        margin-bottom: 0;
    }


    /* ================================================= */
    /* OUTPUT */
    /* ================================================= */

    #css-border-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-border-page .output-basic {
        background-color: lightblue;
        border: 4px solid blue;
        padding: 20px;
        text-align: center;
    }

    #css-border-page .output-dashed {
        background-color: lightgreen;
        border: 3px dashed green;
        padding: 20px;
        text-align: center;
    }

    #css-border-page .output-dotted {
        background-color: lightyellow;
        border: 3px dotted orange;
        padding: 20px;
        text-align: center;
    }

    #css-border-page .output-individual {
        background-color: #e9d5ff;
        border-top: 5px solid purple;
        border-right: 5px solid blue;
        border-bottom: 5px solid green;
        border-left: 5px solid red;
        padding: 20px;
        text-align: center;
    }

    #css-border-page .output-shorthand {
        background-color: #d1fae5;
        border: 2px solid #047857;
        padding: 20px;
        text-align: center;
    }


    /* ================================================= */
    /* PROPERTY CARDS */
    /* ================================================= */

    #css-border-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-border-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-border-page .property-card p {
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* NOTE */
    /* ================================================= */

    #css-border-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }


    /* ================================================= */
    /* SUMMARY */
    /* ================================================= */

    #css-border-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-border-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-border-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* RESPONSIVE */
    /* ================================================= */

    @@media (max-width: 767px) {

        #css-border-page .content-section {
            padding: 20px;
        }

        #css-border-page .border-diagram {
            padding: 25px;
        }

    }

</style>


<div id="css-border-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <h1>
                    CSS Border
                </h1>

                <p>
                    CSS <strong>border</strong> is used to create a visible
                    boundary around an HTML element.
                </p>

                <p>
                    A border appears between the element's
                    <strong>padding</strong> and <strong>margin</strong>.
                    It can be customized using different styles, widths,
                    and colors.
                </p>


                <!-- ================================================= -->
                <!-- BASIC SYNTAX -->
                <!-- ================================================= -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>selector {
    border: width style color;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- DIAGRAM -->
                <!-- ================================================= -->

                <h2>
                    Border Diagram
                </h2>

                <div class="diagram-box">

                    <div class="border-label">
                        Border = Visible Boundary Around the Element
                    </div>

                    <div class="border-diagram">

                        CIIT Training Institute

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SIMPLE EXPLANATION -->
                <!-- ================================================= -->

                <h2>
                    Simple Explanation
                </h2>

                <div class="explanation-box">

                    <p>
                        Think of an HTML element as a box.
                    </p>

                    <p>
                        The <strong>content</strong> is inside the box,
                        padding creates space around the content, and
                        the <strong>border</strong> creates a visible line
                        around that area.
                    </p>

                    <p>
                        You can control three main things about a border:
                        <strong>width, style, and color.</strong>
                    </p>

                    <p>
                        For example,
                        <strong>4px solid blue</strong> means a 4-pixel
                        solid border with blue color.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 1 -->
                <!-- ================================================= -->

                <h2>
                    Example 1: Solid Border
                </h2>

                <p>
                    The <strong>solid</strong> border creates a continuous
                    line around the element.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: lightblue;
    border: 4px solid blue;
    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-basic">

                        CIIT Training Institute

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 2 -->
                <!-- ================================================= -->

                <h2>
                    Example 2: Dashed Border
                </h2>

                <p>
                    The <strong>dashed</strong> style creates a border
                    made of short lines.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: lightgreen;
    border: 3px dashed green;
    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-dashed">

                        Dashed Border Example

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 3 -->
                <!-- ================================================= -->

                <h2>
                    Example 3: Dotted Border
                </h2>

                <p>
                    The <strong>dotted</strong> style creates a border
                    made of dots.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: lightyellow;
    border: 3px dotted orange;
    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-dotted">

                        Dotted Border Example

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BORDER PROPERTIES -->
                <!-- ================================================= -->

                <h2>
                    Border Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                border-width
                            </h3>

                            <p>
                                Controls how thick the border is.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                border-style
                            </h3>

                            <p>
                                Defines the appearance of the border,
                                such as solid, dashed, or dotted.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                border-color
                            </h3>

                            <p>
                                Controls the color of the border.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 4 -->
                <!-- ================================================= -->

                <h2>
                    Example 4: Border on Individual Sides
                </h2>

                <p>
                    You can apply different borders to the top, right,
                    bottom, and left sides of an element.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: #e9d5ff;

    border-top: 5px solid purple;
    border-right: 5px solid blue;
    border-bottom: 5px solid green;
    border-left: 5px solid red;

    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-individual">

                        Different Border Sides

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BORDER SHORTHAND -->
                <!-- ================================================= -->

                <h2>
                    Border Shorthand
                </h2>

                <p>
                    Instead of writing border width, style, and color
                    separately, you can combine them into one property.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: #d1fae5;
    border: 2px solid #047857;
    padding: 20px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-shorthand">

                        Border Shorthand Example

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- COMMON BORDER STYLES -->
                <!-- ================================================= -->

                <h2>
                    Common Border Styles
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Style</th>
                                <th>Description</th>
                                <th>Example</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>solid</td>
                                <td>A continuous line.</td>
                                <td>border: 2px solid blue;</td>
                            </tr>

                            <tr>
                                <td>dashed</td>
                                <td>A border made of short lines.</td>
                                <td>border: 2px dashed green;</td>
                            </tr>

                            <tr>
                                <td>dotted</td>
                                <td>A border made of dots.</td>
                                <td>border: 2px dotted red;</td>
                            </tr>

                            <tr>
                                <td>double</td>
                                <td>A double-line border.</td>
                                <td>border: 4px double purple;</td>
                            </tr>

                            <tr>
                                <td>none</td>
                                <td>No visible border.</td>
                                <td>border: none;</td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- BORDER WIDTH -->
                <!-- ================================================= -->

                <h2>
                    Border Width
                </h2>

                <p>
                    The border width controls the thickness of the border.
                    You can use values such as pixels or predefined
                    keywords.
                </p>

                <div class="code-box">

<pre><code>.box {
    border-width: 5px;
    border-style: solid;
    border-color: blue;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- BORDER COLOR -->
                <!-- ================================================= -->

                <h2>
                    Border Color
                </h2>

                <p>
                    The border color can be specified using color names,
                    HEX values, RGB values, and other CSS color formats.
                </p>

                <div class="code-box">

<pre><code>.box {
    border: 3px solid #2563eb;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- IMPORTANT NOTE -->
                <!-- ================================================= -->

                <div class="note-box">

                    <strong>Important:</strong>

                    A border normally needs a border style such as
                    <strong>solid</strong>, <strong>dashed</strong>,
                    or <strong>dotted</strong> to become visible.
                    A common shorthand format is:

                    <strong>border: width style color;</strong>

                </div>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p class="mb-0">
                        CSS border creates a visible boundary around an
                        HTML element. You can control its width, style,
                        and color. Borders can be applied to all four
                        sides together or individually using
                        border-top, border-right, border-bottom, and
                        border-left.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- NAVIGATION -->
                <!-- ================================================= -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Margin", "BoxModel", new { area = "CSS" })">

                            ← Previous: Margin

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("BorderRadius", "BoxModel", new { area = "CSS" })">

                            Next: Border Radius →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>