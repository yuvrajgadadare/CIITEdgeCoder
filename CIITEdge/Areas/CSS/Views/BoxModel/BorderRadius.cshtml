@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Border Radius";
}

<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    #css-border-radius-page {
        color: #212529;
    }

    #css-border-radius-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-border-radius-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-border-radius-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-border-radius-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-border-radius-page .content-section > p {
        line-height: 1.7;
    }


    /* ================================================= */
    /* CODE */
    /* ================================================= */

    #css-border-radius-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-border-radius-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }


    /* ================================================= */
    /* DIAGRAM */
    /* ================================================= */

    #css-border-radius-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 30px;
        margin-top: 15px;
        text-align: center;
    }

    #css-border-radius-page .radius-diagram {
        width: 260px;
        height: 130px;
        margin: 25px auto;
        background-color: #dbeafe;
        border: 5px solid #2563eb;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    #css-border-radius-page .radius-label {
        color: #1d4ed8;
        font-weight: 700;
    }


    /* ================================================= */
    /* EXPLANATION */
    /* ================================================= */

    #css-border-radius-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-border-radius-page .explanation-box p:last-child {
        margin-bottom: 0;
    }


    /* ================================================= */
    /* OUTPUT */
    /* ================================================= */

    #css-border-radius-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-border-radius-page .output-small {
        background-color: lightblue;
        border: 3px solid blue;
        border-radius: 10px;
        padding: 25px;
        text-align: center;
    }

    #css-border-radius-page .output-large {
        background-color: lightgreen;
        border: 3px solid green;
        border-radius: 30px;
        padding: 25px;
        text-align: center;
    }

    #css-border-radius-page .output-pill {
        background-color: lightyellow;
        border: 3px solid orange;
        border-radius: 50px;
        padding: 15px 35px;
        text-align: center;
    }

    #css-border-radius-page .output-circle {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        background-color: #e9d5ff;
        border: 3px solid purple;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    #css-border-radius-page .output-individual {
        background-color: #d1fae5;

        border-top-left-radius: 30px;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 40px;
        border-bottom-left-radius: 5px;

        border: 3px solid #047857;
        padding: 25px;
        text-align: center;
    }


    /* ================================================= */
    /* PROPERTY CARDS */
    /* ================================================= */

    #css-border-radius-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-border-radius-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-border-radius-page .property-card p {
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* NOTE */
    /* ================================================= */

    #css-border-radius-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }


    /* ================================================= */
    /* SUMMARY */
    /* ================================================= */

    #css-border-radius-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-border-radius-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-border-radius-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* ================================================= */
    /* RESPONSIVE */
    /* ================================================= */

    @@media (max-width: 767px) {

        #css-border-radius-page .content-section {
            padding: 20px;
        }

        #css-border-radius-page .radius-diagram {
            width: 220px;
            height: 120px;
        }

    }

</style>


<div id="css-border-radius-page">

    <div class="row">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-9">

            <div class="content-section">


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <h1>
                    CSS Border Radius
                </h1>

                <p>
                    The CSS <strong>border-radius</strong> property is used
                    to make the corners of an HTML element rounded.
                </p>

                <p>
                    By default, most rectangular elements have sharp
                    corners. With <strong>border-radius</strong>, you can
                    create slightly rounded corners, highly rounded cards,
                    pill-shaped elements, or even circles.
                </p>


                <!-- ================================================= -->
                <!-- BASIC SYNTAX -->
                <!-- ================================================= -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>selector {
    border-radius: value;
}</code></pre>

                </div>


                <!-- ================================================= -->
                <!-- DIAGRAM -->
                <!-- ================================================= -->

                <h2>
                    Border Radius Diagram
                </h2>

                <div class="diagram-box">

                    <div class="radius-label">
                        Rounded Corners
                    </div>

                    <div class="radius-diagram">

                        CSS Box

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SIMPLE EXPLANATION -->
                <!-- ================================================= -->

                <h2>
                    Simple Explanation
                </h2>

                <div class="explanation-box">

                    <p>
                        Think about a normal rectangular box with four
                        sharp corners.
                    </p>

                    <p>
                        The <strong>border-radius</strong> property
                        changes those sharp corners into rounded corners.
                    </p>

                    <p>
                        A small value creates a small curve, while a larger
                        value creates a more rounded corner.
                    </p>

                    <p>
                        For example,
                        <strong>border-radius: 10px;</strong> creates
                        slightly rounded corners.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 1 -->
                <!-- ================================================= -->

                <h2>
                    Example 1: Small Rounded Corners
                </h2>

                <p>
                    A value of <strong>10px</strong> creates slightly
                    rounded corners.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: lightblue;
    border: 3px solid blue;
    border-radius: 10px;
    padding: 25px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-small">

                        CIIT Training Institute

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 2 -->
                <!-- ================================================= -->

                <h2>
                    Example 2: Larger Rounded Corners
                </h2>

                <p>
                    Increasing the value creates more rounded corners.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: lightgreen;
    border: 3px solid green;
    border-radius: 30px;
    padding: 25px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-large">

                        Rounded CIIT Card

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 3 -->
                <!-- ================================================= -->

                <h2>
                    Example 3: Pill Shape
                </h2>

                <p>
                    A large border-radius value can be used to create
                    pill-shaped buttons or labels.
                </p>

                <div class="code-box">

<pre><code>.button {
    background-color: lightyellow;
    border: 3px solid orange;
    border-radius: 50px;
    padding: 15px 35px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-pill">

                        Learn CSS

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- EXAMPLE 4 -->
                <!-- ================================================= -->

                <h2>
                    Example 4: Circle
                </h2>

                <p>
                    When an element has equal width and height,
                    <strong>border-radius: 50%</strong> can turn it
                    into a circle.
                </p>

                <div class="code-box">

<pre><code>.circle {
    width: 150px;
    height: 150px;
    background-color: #e9d5ff;
    border: 3px solid purple;
    border-radius: 50%;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-circle">

                        CIIT

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- INDIVIDUAL CORNERS -->
                <!-- ================================================= -->

                <h2>
                    Example 5: Individual Corners
                </h2>

                <p>
                    CSS also allows you to control each corner separately.
                </p>

                <div class="code-box">

<pre><code>.box {
    background-color: #d1fae5;

    border-top-left-radius: 30px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 5px;

    border: 3px solid #047857;
    padding: 25px;
}</code></pre>

                </div>


                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-individual">

                        Different Corner Radius

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- INDIVIDUAL PROPERTIES -->
                <!-- ================================================= -->

                <h2>
                    Individual Border Radius Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                border-top-left-radius
                            </h3>

                            <p>
                                Controls the top-left corner.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                border-top-right-radius
                            </h3>

                            <p>
                                Controls the top-right corner.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                border-bottom-right-radius
                            </h3>

                            <p>
                                Controls the bottom-right corner.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                border-bottom-left-radius
                            </h3>

                            <p>
                                Controls the bottom-left corner.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- COMMON VALUES -->
                <!-- ================================================= -->

                <h2>
                    Common Border Radius Values
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Value</th>
                                <th>Typical Use</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>0</td>
                                <td>Sharp corners.</td>
                            </tr>

                            <tr>
                                <td>5px</td>
                                <td>Slightly rounded corners.</td>
                            </tr>

                            <tr>
                                <td>10px</td>
                                <td>Common card and container radius.</td>
                            </tr>

                            <tr>
                                <td>25px</td>
                                <td>Clearly rounded corners.</td>
                            </tr>

                            <tr>
                                <td>50%</td>
                                <td>Useful for creating circles.</td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- IMPORTANT NOTE -->
                <!-- ================================================= -->

                <div class="note-box">

                    <strong>Important:</strong>

                    For a perfect circle using
                    <strong>border-radius: 50%</strong>, the element
                    should normally have equal width and height.

                </div>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p class="mb-0">
                        The CSS border-radius property is used to create
                        rounded corners. Small values create slightly
                        rounded corners, larger values create highly
                        rounded shapes, and 50% can be used to create
                        circles when width and height are equal. Individual
                        corners can also be controlled separately.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- NAVIGATION -->
                <!-- ================================================= -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Border", "BoxModel", new { area = "CSS" })">

                            ← Previous: Border

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("BoxSizing", "BoxModel", new { area = "CSS" })">

                            Next: Box Sizing →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>