@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Grid Row";
}

<style>

    #css-grid-row-page {
        color: #212529;
    }

    #css-grid-row-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-grid-row-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-grid-row-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-grid-row-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-grid-row-page .content-section > p {
        line-height: 1.7;
    }

    #css-grid-row-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-grid-row-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.6;
    }

    #css-grid-row-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-grid-row-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    #css-grid-row-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-row-page .grid-diagram {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 80px);
        gap: 10px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-row-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 700;
    }

    #css-grid-row-page .highlight-row {
        background-color: #f97316;
        border: 3px solid #c2410c;
    }

    #css-grid-row-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-row-page .output-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 90px);
        gap: 15px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-row-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 700;
    }

    #css-grid-row-page .output-highlight {
        background-color: orange;
        border: 2px solid darkorange;
    }

    #css-grid-row-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-grid-row-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-row-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-grid-row-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    #css-grid-row-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-grid-row-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-row-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

    @@media (max-width: 991px) {

        #css-grid-row-page .content-section {
            padding: 20px;
        }

        #css-grid-row-page .grid-diagram,
        #css-grid-row-page .output-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto;
        }

    }

</style>


<div id="css-grid-row-page">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->
        <div class="col-lg-9">

            <div class="content-section">

                <h1>
                    CSS Grid Row
                </h1>

                <p>
                    CSS Grid allows you to control the vertical
                    position and size of Grid items using rows.
                    The <strong>grid-row</strong> property defines
                    where a Grid item starts and ends across the
                    Grid rows.
                </p>


                <!-- What is Grid Row -->

                <h2>
                    What is grid-row?
                </h2>

                <div class="explanation-box">

                    <p>
                        The <strong>grid-row</strong> property is
                        used to position a Grid item vertically.
                    </p>

                    <p>
                        It specifies the starting and ending
                        row lines of an item.
                    </p>

                </div>


                <!-- Basic Syntax -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>.item {
    grid-row: 1 / 3;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The item starts at
                        <strong>row line 1</strong>
                        and ends at
                        <strong>row line 3</strong>.
                    </p>

                    <p>
                        Therefore, the item spans across
                        <strong>2 rows</strong>.
                    </p>

                </div>


                <!-- Row Lines -->

                <h2>
                    Understanding Grid Row Lines
                </h2>

                <p>
                    Grid rows are separated by horizontal row
                    lines. These lines are used to position
                    Grid items vertically.
                </p>

                <div class="diagram-box">

                    <div class="grid-diagram">

                        <div class="diagram-item">
                            Row 1
                        </div>

                        <div class="diagram-item">
                            Row 1
                        </div>

                        <div class="diagram-item">
                            Row 1
                        </div>

                        <div class="diagram-item highlight-row">
                            Row 2
                        </div>

                        <div class="diagram-item highlight-row">
                            Row 2
                        </div>

                        <div class="diagram-item highlight-row">
                            Row 2
                        </div>

                        <div class="diagram-item">
                            Row 3
                        </div>

                        <div class="diagram-item">
                            Row 3
                        </div>

                        <div class="diagram-item">
                            Row 3
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        A three-row Grid has four horizontal row lines.
                    </p>

                </div>


                <!-- Row Start -->

                <h2>
                    grid-row-start
                </h2>

                <div class="code-box">

<pre><code>.item {
    grid-row-start: 2;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The item starts at
                        <strong>row line 2</strong>.
                    </p>

                    <p>
                        When an ending position is not specified,
                        the browser determines the remaining
                        placement automatically.
                    </p>

                </div>


                <!-- Row End -->

                <h2>
                    grid-row-end
                </h2>

                <div class="code-box">

<pre><code>.item {
    grid-row-end: 4;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The item ends at
                        <strong>row line 4</strong>.
                    </p>

                </div>


                <!-- Start and End -->

                <h2>
                    Using grid-row-start and grid-row-end
                </h2>

                <div class="code-box">

<pre><code>.item {
    grid-row-start: 1;
    grid-row-end: 3;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The item starts at row line
                        <strong>1</strong>
                        and ends at row line
                        <strong>3</strong>.
                    </p>

                    <p>
                        Therefore, it occupies
                        <strong>2 rows</strong>.
                    </p>

                </div>


                <!-- Shorthand -->

                <h2>
                    grid-row Shorthand
                </h2>

                <div class="code-box">

<pre><code>.item {
    grid-row: 1 / 3;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The shorthand combines:
                    </p>

<pre><code>grid-row-start: 1;
grid-row-end: 3;</code></pre>

                    <p>
                        The item spans from row line
                        <strong>1</strong>
                        to row line
                        <strong>3</strong>.
                    </p>

                </div>


                <!-- Span -->

                <h2>
                    Using span
                </h2>

                <p>
                    The <strong>span</strong> keyword allows an
                    item to occupy a specific number of rows.
                </p>

                <div class="code-box">

<pre><code>.item {
    grid-row: span 2;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The item occupies
                        <strong>2 rows</strong>.
                    </p>

                    <p>
                        Its starting position is determined by
                        the Grid's automatic placement.
                    </p>

                </div>


                <!-- Practical Example -->

                <h2>
                    Practical Example
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 90px);
    gap: 15px;
}

.sidebar {
    grid-row: 1 / 4;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The Grid contains three rows.
                    </p>

                    <p>
                        The sidebar starts at row line
                        <strong>1</strong>
                        and ends at row line
                        <strong>4</strong>.
                    </p>

                    <p>
                        Therefore, the sidebar spans across all
                        <strong>3 rows</strong>.
                    </p>

                </div>


                <!-- Output -->

                <h2>
                    Output
                </h2>

                <div class="browser-output">

                    <div class="output-grid">

                        <div class="output-item output-highlight">
                            Sidebar
                        </div>

                        <div class="output-item">
                            Content 1
                        </div>

                        <div class="output-item">
                            Content 2
                        </div>

                        <div class="output-item">
                            Content 3
                        </div>

                        <div class="output-item">
                            Content 4
                        </div>

                        <div class="output-item">
                            Content 5
                        </div>

                        <div class="output-item">
                            Content 6
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    The <strong>Sidebar</strong> spans all three
                    rows because the code uses
                    <strong>grid-row: 1 / 4;</strong>.
                </p>


                <!-- Difference -->

                <h2>
                    grid-row vs grid-column
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                grid-row
                            </h3>

                            <p>
                                Controls the vertical placement
                                and size of a Grid item across rows.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                grid-column
                            </h3>

                            <p>
                                Controls the horizontal placement
                                and size of a Grid item across columns.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Important Properties -->

                <h2>
                    Important Grid Row Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                grid-row
                            </h3>

                            <p>
                                Shorthand property used to define
                                the starting and ending row lines.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                grid-row-start
                            </h3>

                            <p>
                                Defines the starting row line
                                of a Grid item.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                grid-row-end
                            </h3>

                            <p>
                                Defines the ending row line
                                of a Grid item.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Real World Uses -->

                <h2>
                    Real-World Uses
                </h2>

                <ul>

                    <li>
                        Dashboard sidebars
                    </li>

                    <li>
                        Website layouts
                    </li>

                    <li>
                        Navigation panels
                    </li>

                    <li>
                        Admin dashboards
                    </li>

                    <li>
                        Content sections
                    </li>

                    <li>
                        Full-height cards
                    </li>

                </ul>


                <!-- Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    The values in
                    <strong>grid-row</strong>
                    refer to Grid row lines. For example,
                    <strong>grid-row: 1 / 4;</strong>
                    spans three Grid rows.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        The <strong>grid-row</strong> property controls
                        the vertical placement of a Grid item.
                        It can define the starting and ending row
                        lines of an item. The
                        <strong>grid-row-start</strong> and
                        <strong>grid-row-end</strong> properties
                        provide separate control, while
                        <strong>grid-row</strong> provides a shorthand
                        way to define both values.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6 mb-2 mb-md-0">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("GridColumn", "Grid", new { area = "CSS" })">

                            ← Previous: Grid Column

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("GridArea", "Grid", new { area = "CSS" })">

                            Next: Grid Area →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>