@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Grid";
}

<style>

    #css-grid-page {
        color: #212529;
    }

    #css-grid-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-grid-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-grid-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-grid-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-grid-page .content-section > p {
        line-height: 1.7;
    }

    /* Code */

    #css-grid-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-grid-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* Explanation */

    #css-grid-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-grid-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* Diagram */

    #css-grid-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-page .grid-diagram {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        padding: 20px;
        border-radius: 6px;
        text-align: center;
        font-weight: 700;
    }

    /* Output */

    #css-grid-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-page .output-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        padding: 25px;
        text-align: center;
        font-weight: 700;
    }

    /* Property Cards */

    #css-grid-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-grid-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Note */

    #css-grid-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* Summary */

    #css-grid-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-grid-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

</style>


<div id="css-grid-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Grid
                </h1>

                <p>
                    CSS Grid is a powerful layout system used to
                    create two-dimensional web layouts using
                    rows and columns.
                </p>

                <p>
                    Unlike Flexbox, which is primarily designed
                    around one dimension at a time, CSS Grid allows
                    developers to control both rows and columns
                    together.
                </p>


                <!-- What Is Grid -->

                <h2>
                    What Is CSS Grid?
                </h2>

                <div class="explanation-box">

                    <p>
                        CSS Grid provides a structured way to arrange
                        elements into rows and columns.
                    </p>

                    <p>
                        A Grid layout consists of a
                        <strong>Grid Container</strong> and
                        <strong>Grid Items</strong>.
                    </p>

                    <p>
                        The Grid Container defines the overall layout,
                        while its direct children become Grid Items.
                    </p>

                </div>


                <!-- Basic Syntax -->

                <h2>
                    Basic Grid Syntax
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
}</code></pre>

                </div>

                <p class="mt-3">
                    Setting <strong>display: grid;</strong> turns an
                    element into a Grid Container.
                </p>


                <!-- Diagram -->

                <h2>
                    CSS Grid Structure
                </h2>

                <div class="diagram-box">

                    <div class="grid-diagram">

                        <div class="diagram-item">
                            Item 1
                        </div>

                        <div class="diagram-item">
                            Item 2
                        </div>

                        <div class="diagram-item">
                            Item 3
                        </div>

                        <div class="diagram-item">
                            Item 4
                        </div>

                        <div class="diagram-item">
                            Item 5
                        </div>

                        <div class="diagram-item">
                            Item 6
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        CSS Grid organizes elements into rows and columns.
                    </p>

                </div>


                <!-- Rows and Columns -->

                <h2>
                    Rows and Columns
                </h2>

                <p>
                    A Grid layout is built using horizontal
                    <strong>rows</strong> and vertical
                    <strong>columns</strong>.
                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Rows
                            </h3>

                            <p>
                                Rows arrange Grid Items horizontally
                                from top to bottom.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Columns
                            </h3>

                            <p>
                                Columns arrange Grid Items vertically
                                from left to right.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Example 1 -->

                <h2>
                    Example 1: Three Equal Columns
                </h2>

                <div class="code-box">

<pre><code>.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
}</code></pre>

                </div>

                <p class="mt-3">
                    The <strong>1fr 1fr 1fr</strong> value creates
                    three equal columns.
                </p>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-grid">

                        <div class="output-item">
                            Item 1
                        </div>

                        <div class="output-item">
                            Item 2
                        </div>

                        <div class="output-item">
                            Item 3
                        </div>

                        <div class="output-item">
                            Item 4
                        </div>

                        <div class="output-item">
                            Item 5
                        </div>

                        <div class="output-item">
                            Item 6
                        </div>

                    </div>

                </div>


                <!-- FR Unit -->

                <h2>
                    Understanding the fr Unit
                </h2>

                <p>
                    The <strong>fr</strong> unit represents a
                    fraction of the available space inside the
                    Grid Container.
                </p>

                <div class="code-box">

<pre><code>.grid-container {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The available space is divided into
                        <strong>4 fractions</strong>.
                    </p>

                    <p>
                        The first column receives 1 fraction,
                        the second receives 2 fractions, and
                        the third receives 1 fraction.
                    </p>

                    <p>
                        Therefore, the proportional layout is:
                        <strong>1 : 2 : 1</strong>.
                    </p>

                </div>


                <!-- Grid Gap -->

                <h2>
                    Grid Gap
                </h2>

                <p>
                    The <strong>gap</strong> property creates space
                    between Grid Items.
                </p>

                <div class="code-box">

<pre><code>.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        <strong>gap: 20px;</strong> creates a
                        20-pixel gap between the Grid Items.
                    </p>

                </div>


                <!-- Repeat -->

                <h2>
                    Using repeat()
                </h2>

                <p>
                    The <strong>repeat()</strong> function makes
                    repeated Grid column or row definitions easier
                    to write.
                </p>

                <div class="code-box">

<pre><code>.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}</code></pre>

                </div>

                <p class="mt-3">
                    This is equivalent to:
                </p>

                <div class="code-box">

<pre><code>.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
}</code></pre>

                </div>


                <!-- Important Properties -->

                <h2>
                    Important CSS Grid Properties
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Property</th>
                                <th>Purpose</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>display</strong>
                                </td>

                                <td>
                                    Creates a Grid Container.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-template-columns</strong>
                                </td>

                                <td>
                                    Defines the Grid columns.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-template-rows</strong>
                                </td>

                                <td>
                                    Defines the Grid rows.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>gap</strong>
                                </td>

                                <td>
                                    Creates spacing between
                                    Grid Items.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-column</strong>
                                </td>

                                <td>
                                    Controls the column position
                                    or span of a Grid Item.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-row</strong>
                                </td>

                                <td>
                                    Controls the row position
                                    or span of a Grid Item.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Grid Container and Items -->

                <h2>
                    Grid Container and Grid Items
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Grid Container
                            </h3>

                            <p>
                                The parent element with
                                <strong>display: grid;</strong>
                                becomes the Grid Container.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Grid Items
                            </h3>

                            <p>
                                The direct children of the Grid
                                Container become Grid Items.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Grid vs Flexbox -->

                <h2>
                    CSS Grid vs Flexbox
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Feature</th>
                                <th>Flexbox</th>
                                <th>Grid</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    Layout
                                </td>

                                <td>
                                    One-dimensional
                                </td>

                                <td>
                                    Two-dimensional
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Main Focus
                                </td>

                                <td>
                                    Row or column
                                </td>

                                <td>
                                    Rows and columns
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Common Use
                                </td>

                                <td>
                                    Navigation and alignment
                                </td>

                                <td>
                                    Page and card layouts
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Real World -->

                <h2>
                    Example 🤓🌍
                </h2>

                <p>
                    CSS Grid is commonly used for dashboards,
                    course cards, product galleries, image
                    galleries, and complete webpage layouts.
                </p>

                <div class="code-box">

<pre><code>.course-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.course-card {
    padding: 20px;
    border: 1px solid #2563eb;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        This creates a three-column course layout
                        with 20 pixels of space between the cards.
                    </p>

                </div>


                <!-- Advantages -->

                <h2>
                    Advantages of CSS Grid
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Two-Dimensional Layout
                            </h3>

                            <p>
                                Grid can control rows and columns
                                together.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Responsive Design
                            </h3>

                            <p>
                                Grid makes it easier to create
                                layouts that adapt to screen sizes.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Precise Control
                            </h3>

                            <p>
                                Developers can control the position
                                and size of Grid Items precisely.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    CSS Grid is especially useful when a layout
                    requires control over both rows and columns.
                    Flexbox and Grid can also be used together
                    in the same webpage.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        CSS Grid is a two-dimensional layout system
                        based on rows and columns. The parent element
                        becomes a Grid Container using
                        <strong>display: grid;</strong>. Properties
                        such as <strong>grid-template-columns</strong>,
                        <strong>grid-template-rows</strong>,
                        <strong>gap</strong>, and the
                        <strong>fr</strong> unit provide flexible
                        control over modern web layouts.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("FlexBasis", "Flexbox", new { area = "CSS" })">

                            ← Previous: Flex Basis

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("GridContainer", "Grid", new { area = "CSS" })">

                            Next: Grid Container →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>