@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Grid Rows & Columns";
}

<style>

    #css-grid-rows-columns-page {
        color: #212529;
    }

    #css-grid-rows-columns-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-grid-rows-columns-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-grid-rows-columns-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-grid-rows-columns-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-grid-rows-columns-page .content-section > p {
        line-height: 1.7;
    }

    /* Code */

    #css-grid-rows-columns-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-grid-rows-columns-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* Explanation */

    #css-grid-rows-columns-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-grid-rows-columns-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* Diagram */

    #css-grid-rows-columns-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-rows-columns-page .grid-diagram {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 90px);
        gap: 10px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-rows-columns-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    /* Output */

    #css-grid-rows-columns-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-rows-columns-page .output-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 100px);
        gap: 15px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-rows-columns-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 700;
    }

    /* Property Cards */

    #css-grid-rows-columns-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-grid-rows-columns-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-rows-columns-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Note */

    #css-grid-rows-columns-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* Summary */

    #css-grid-rows-columns-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-grid-rows-columns-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-rows-columns-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

</style>


<div id="css-grid-rows-columns-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Grid Rows &amp; Columns
                </h1>

                <p>
                    CSS Grid layouts are organized using horizontal
                    <strong>rows</strong> and vertical
                    <strong>columns</strong>.
                </p>

                <p>
                    Rows control the vertical structure of the Grid,
                    while columns control its horizontal structure.
                    Together, they form the basic structure of a
                    two-dimensional Grid layout.
                </p>


                <!-- Rows -->

                <h2>
                    What Are Grid Rows?
                </h2>

                <div class="explanation-box">

                    <p>
                        A <strong>Grid Row</strong> is a horizontal
                        track inside a Grid Container.
                    </p>

                    <p>
                        Rows are defined using the
                        <strong>grid-template-rows</strong> property.
                    </p>

                </div>


                <!-- Columns -->

                <h2>
                    What Are Grid Columns?
                </h2>

                <div class="explanation-box">

                    <p>
                        A <strong>Grid Column</strong> is a vertical
                        track inside a Grid Container.
                    </p>

                    <p>
                        Columns are defined using the
                        <strong>grid-template-columns</strong>
                        property.
                    </p>

                </div>


                <!-- Syntax -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 100px 100px;
}</code></pre>

                </div>


                <!-- Diagram -->

                <h2>
                    Rows and Columns Diagram
                </h2>

                <div class="diagram-box">

                    <div class="grid-diagram">

                        <div class="diagram-item">
                            Row 1<br />Column 1
                        </div>

                        <div class="diagram-item">
                            Row 1<br />Column 2
                        </div>

                        <div class="diagram-item">
                            Row 1<br />Column 3
                        </div>

                        <div class="diagram-item">
                            Row 2<br />Column 1
                        </div>

                        <div class="diagram-item">
                            Row 2<br />Column 2
                        </div>

                        <div class="diagram-item">
                            Row 2<br />Column 3
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        2 rows × 3 columns = 6 Grid cells
                    </p>

                </div>


                <!-- Example 1 -->

                <h2>
                    Example 1: Creating Three Columns
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The Grid Container creates three equal
                        columns.
                    </p>

                    <p>
                        The <strong>1fr 1fr 1fr</strong> values divide
                        the available horizontal space into three
                        equal parts.
                    </p>

                </div>


                <!-- Example 2 -->

                <h2>
                    Example 2: Creating Two Rows
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-rows: 100px 100px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        Two Grid Rows are created, and each row has
                        a height of <strong>100px</strong>.
                    </p>

                </div>


                <!-- Combined Output -->

                <h2>
                    Output
                </h2>

                <div class="browser-output">

                    <div class="output-grid">

                        <div class="output-item">
                            Row 1<br />Column 1
                        </div>

                        <div class="output-item">
                            Row 1<br />Column 2
                        </div>

                        <div class="output-item">
                            Row 1<br />Column 3
                        </div>

                        <div class="output-item">
                            Row 2<br />Column 1
                        </div>

                        <div class="output-item">
                            Row 2<br />Column 2
                        </div>

                        <div class="output-item">
                            Row 2<br />Column 3
                        </div>

                    </div>

                </div>


                <!-- Different Column Sizes -->

                <h2>
                    Different Column Sizes
                </h2>

                <p>
                    Columns do not have to be equal. Different
                    values can be used to create different
                    column sizes.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The available space is divided into
                        <strong>4 fractions</strong>.
                    </p>

                    <p>
                        The first column receives 1 fraction,
                        the second receives 2 fractions, and
                        the third receives 1 fraction.
                    </p>

                    <p>
                        The resulting proportion is:
                        <strong>1 : 2 : 1</strong>.
                    </p>

                </div>


                <!-- Different Row Sizes -->

                <h2>
                    Different Row Sizes
                </h2>

                <p>
                    Rows can also have different heights.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-rows: 80px 150px 100px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The first row has a height of
                        <strong>80px</strong>.
                    </p>

                    <p>
                        The second row has a height of
                        <strong>150px</strong>.
                    </p>

                    <p>
                        The third row has a height of
                        <strong>100px</strong>.
                    </p>

                </div>


                <!-- Repeat -->

                <h2>
                    Using repeat()
                </h2>

                <p>
                    The <strong>repeat()</strong> function can be
                    used to create repeated rows or columns.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 100px);
}</code></pre>

                </div>

                <p class="mt-3">
                    This creates three equal columns and two rows
                    of 100 pixels each.
                </p>


                <!-- Auto -->

                <h2>
                    Using auto for Rows and Columns
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: 200px auto 200px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The first and third columns are fixed at
                        <strong>200px</strong>.
                    </p>

                    <p>
                        The middle column uses the remaining
                        available space.
                    </p>

                </div>


                <!-- Important Properties -->

                <h2>
                    Rows and Columns Properties
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                grid-template-columns
                            </h3>

                            <p>
                                Defines the number and size of
                                Grid columns.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                grid-template-rows
                            </h3>

                            <p>
                                Defines the number and size of
                                Grid rows.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Grid Cell -->

                <h2>
                    Grid Cell
                </h2>

                <p>
                    The intersection of one Grid Row and one Grid
                    Column creates a <strong>Grid Cell</strong>.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 100px 100px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        Two columns multiplied by two rows create
                        <strong>four Grid Cells</strong>.
                    </p>

                </div>


                <!-- Real World -->

                <h2>
                    Example 🤓🌍
                </h2>  

                <p>
                    A dashboard can use different rows and columns
                    to organize statistics, charts, and information
                    cards.
                </p>

                <div class="code-box">

<pre><code>.dashboard {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 120px 250px;
    gap: 20px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The dashboard has two columns with a
                        <strong>2 : 1</strong> proportion.
                    </p>

                    <p>
                        It also defines two rows with heights of
                        <strong>120px</strong> and
                        <strong>250px</strong>.
                    </p>

                </div>


                <!-- Comparison -->

                <h2>
                    Rows vs Columns
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Feature</th>
                                <th>Rows</th>
                                <th>Columns</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    Direction
                                </td>

                                <td>
                                    Horizontal
                                </td>

                                <td>
                                    Vertical
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Property
                                </td>

                                <td>
                                    grid-template-rows
                                </td>

                                <td>
                                    grid-template-columns
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Controls
                                </td>

                                <td>
                                    Row height
                                </td>

                                <td>
                                    Column width
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    CSS Grid uses both rows and columns to create a
                    two-dimensional layout. Use
                    <strong>grid-template-columns</strong> for the
                    column structure and
                    <strong>grid-template-rows</strong> for the row
                    structure.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        CSS Grid uses <strong>rows</strong> and
                        <strong>columns</strong> to create structured
                        two-dimensional layouts.
                        <strong>grid-template-columns</strong>
                        controls column sizes, while
                        <strong>grid-template-rows</strong>
                        controls row sizes. Values such as
                        <strong>px</strong>, <strong>fr</strong>,
                        <strong>%</strong>, <strong>auto</strong>,
                        and <strong>repeat()</strong> can be used
                        to create flexible Grid structures.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("GridContainer", "Grid", new { area = "CSS" })">

                            ← Previous: Grid Container

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("GridTemplateColumns", "Grid", new { area = "CSS" })">

                            Next: Grid Template Columns →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>