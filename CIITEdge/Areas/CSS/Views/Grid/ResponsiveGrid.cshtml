@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Responsive Grid";
}

<style>

    #css-responsive-grid-page {
        color: #212529;
    }

    #css-responsive-grid-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-responsive-grid-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-responsive-grid-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-responsive-grid-page .content-section > p {
        line-height: 1.7;
    }

    #css-responsive-grid-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-responsive-grid-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        line-height: 1.6;
    }

    #css-responsive-grid-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-responsive-grid-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    #css-responsive-grid-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-responsive-grid-page .responsive-demo {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        padding: 20px;
        background-color: #dbeafe;
        border: 2px dashed #2563eb;
    }

    #css-responsive-grid-page .demo-card {
        min-height: 90px;
        background-color: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 700;
        padding: 15px;
    }

    #css-responsive-grid-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-responsive-grid-page .output-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        padding: 20px;
        background-color: #dbeafe;
        border: 2px solid #2563eb;
    }

    #css-responsive-grid-page .output-card {
        min-height: 90px;
        background-color: lightblue;
        border: 2px solid blue;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 700;
    }

    #css-responsive-grid-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-responsive-grid-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-responsive-grid-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    #css-responsive-grid-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    #css-responsive-grid-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-responsive-grid-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-responsive-grid-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

    /* Responsive Grid */

    @@media (max-width: 991px) {

        #css-responsive-grid-page .content-section {
            padding: 20px;
        }

        #css-responsive-grid-page .responsive-demo,
        #css-responsive-grid-page .output-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @@media (max-width: 576px) {

        #css-responsive-grid-page .responsive-demo,
        #css-responsive-grid-page .output-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


<div id="css-responsive-grid-page">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->
        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Responsive Grid
                </h1>

                <p>
                    A responsive Grid automatically adjusts the number
                    and size of columns according to the available
                    screen width.
                </p>

                <p>
                    This allows the same Grid layout to work properly
                    on desktops, tablets, and mobile devices.
                </p>


                <!-- What is Responsive Grid -->

                <h2>
                    What is a Responsive Grid?
                </h2>

                <div class="explanation-box">

                    <p>
                        A responsive Grid changes its layout based on
                        the available screen size.
                    </p>

                    <p>
                        For example, a desktop can display three
                        columns, a tablet can display two columns,
                        and a mobile phone can display one column.
                    </p>

                </div>


                <!-- Basic Example -->

                <h2>
                    Basic Responsive Grid
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

@@media (max-width: 991px) {
    .container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 576px) {
    .container {
        grid-template-columns: 1fr;
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        On large screens, the Grid contains
                        <strong>3 columns</strong>.
                    </p>

                    <p>
                        At a maximum width of
                        <strong>991px</strong>, the Grid changes to
                        <strong>2 columns</strong>.
                    </p>

                    <p>
                        At a maximum width of
                        <strong>576px</strong>, the Grid changes to
                        <strong>1 column</strong>.
                    </p>

                </div>


                <!-- Diagram -->

                <h2>
                    Responsive Grid Diagram
                </h2>

                <div class="diagram-box">

                    <h3>
                        Desktop
                    </h3>

                    <div class="responsive-demo">

                        <div class="demo-card">
                            Card 1
                        </div>

                        <div class="demo-card">
                            Card 2
                        </div>

                        <div class="demo-card">
                            Card 3
                        </div>

                    </div>

                    <p class="text-center mt-3">
                        3 columns
                    </p>


                    <h3>
                        Tablet
                    </h3>

                    <div class="responsive-demo"
                         style="grid-template-columns: repeat(2, 1fr);">

                        <div class="demo-card">
                            Card 1
                        </div>

                        <div class="demo-card">
                            Card 2
                        </div>

                        <div class="demo-card">
                            Card 3
                        </div>

                    </div>

                    <p class="text-center mt-3">
                        2 columns
                    </p>


                    <h3>
                        Mobile
                    </h3>

                    <div class="responsive-demo"
                         style="grid-template-columns: 1fr;">

                        <div class="demo-card">
                            Card 1
                        </div>

                        <div class="demo-card">
                            Card 2
                        </div>

                        <div class="demo-card">
                            Card 3
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        1 column
                    </p>

                </div>


                <!-- Media Queries -->

                <h2>
                    Using Media Queries
                </h2>

                <p>
                    Media queries allow CSS Grid to change its
                    structure at specific screen widths.
                </p>

                <div class="code-box">

<pre><code>@@media (max-width: 991px) {
    .container {
        grid-template-columns: repeat(2, 1fr);
    }
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        This rule is applied when the screen width
                        becomes <strong>991px or smaller</strong>.
                    </p>

                    <p>
                        The Grid changes to two equal columns.
                    </p>

                </div>


                <!-- minmax -->

                <h2>
                    Responsive Grid with minmax()
                </h2>

                <p>
                    The <strong>minmax()</strong> function allows a
                    Grid column to have a minimum and maximum size.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(200px, 1fr));
    gap: 15px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        Each column has a minimum width of
                        <strong>200px</strong>.
                    </p>

                    <p>
                        The columns can grow up to
                        <strong>1fr</strong>
                        of the available space.
                    </p>

                </div>


                <!-- auto-fit -->

                <h2>
                    Responsive Grid with auto-fit
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        <strong>auto-fit</strong> automatically fits
                        as many columns as possible into the available
                        width.
                    </p>

                    <p>
                        When the screen becomes smaller, the number
                        of columns automatically decreases.
                    </p>

                </div>


                <!-- auto-fill -->

                <h2>
                    Responsive Grid with auto-fill
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns:
        repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        <strong>auto-fill</strong> creates as many
                        possible Grid tracks based on the available
                        space and minimum column size.
                    </p>

                </div>


                <!-- Practical Example -->

                <h2>
                    Practical Responsive Card Layout
                </h2>

                <div class="code-box">

<pre><code>.course-container {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.course-card {
    padding: 20px;
    border: 1px solid #ddd;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The Grid automatically creates as many
                        columns as can fit.
                    </p>

                    <p>
                        Each card has a minimum width of
                        <strong>220px</strong>.
                    </p>

                    <p>
                        This technique is useful for course cards,
                        product cards, portfolio items, and dashboards.
                    </p>

                </div>


                <!-- Output -->

                <h2>
                    Output
                </h2>

                <div class="browser-output">

                    <div class="output-grid">

                        <div class="output-card">
                            Course 1
                        </div>

                        <div class="output-card">
                            Course 2
                        </div>

                        <div class="output-card">
                            Course 3
                        </div>

                        <div class="output-card">
                            Course 4
                        </div>

                        <div class="output-card">
                            Course 5
                        </div>

                        <div class="output-card">
                            Course 6
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    The cards automatically rearrange into fewer
                    columns when the available screen width becomes
                    smaller.
                </p>


                <!-- Properties -->

                <h2>
                    Important Responsive Grid Techniques
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Media Queries
                            </h3>

                            <p>
                                Change the Grid structure at specific
                                screen widths.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                minmax()
                            </h3>

                            <p>
                                Defines minimum and maximum sizes
                                for Grid tracks.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                auto-fit
                            </h3>

                            <p>
                                Automatically fits available Grid
                                columns into the container.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                auto-fill
                            </h3>

                            <p>
                                Automatically creates possible Grid
                                tracks based on available space.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                fr Unit
                            </h3>

                            <p>
                                Divides available Grid space into
                                flexible fractions.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Flexible Layout
                            </h3>

                            <p>
                                Allows the same layout to work across
                                different screen sizes.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Real World -->

                <h2>
                    Real-World Uses
                </h2>

                <ul>

                    <li>
                        Course cards
                    </li>

                    <li>
                        Product grids
                    </li>

                    <li>
                        Portfolio layouts
                    </li>

                    <li>
                        Image galleries
                    </li>

                    <li>
                        Admin dashboards
                    </li>

                    <li>
                        Blog cards
                    </li>

                </ul>


                <!-- Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    A responsive Grid should adapt to the available
                    screen width without requiring horizontal
                    scrolling. Combining Grid with
                    <strong>minmax()</strong>,
                    <strong>auto-fit</strong>,
                    <strong>auto-fill</strong>, and media queries
                    makes responsive layouts easier to build.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        CSS Responsive Grid allows a layout to adapt
                        automatically to different screen sizes.
                        Media queries can change the number of columns
                        at specific breakpoints, while
                        <strong>minmax()</strong>,
                        <strong>auto-fit</strong>, and
                        <strong>auto-fill</strong> can create flexible
                        Grid layouts. Responsive Grid is especially
                        useful for cards, dashboards, galleries, and
                        modern website layouts.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6 mb-2 mb-md-0">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("GridAlignment", "Grid", new { area = "CSS" })">

                            ← Previous: Grid Alignment

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("Index", "ResponsiveDesign", new { area = "CSS" })">

                            Next: Responsive Design →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>