@{
    Layout = "~/Areas/CSS/Views/Shared/CSSLayout.cshtml";
    ViewData["Title"] = "CSS Grid Container";
}

<style>

    #css-grid-container-page {
        color: #212529;
    }

    #css-grid-container-page .content-section {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
    }

    #css-grid-container-page .content-section > h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    #css-grid-container-page .content-section > h2 {
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }

    #css-grid-container-page .content-section > h3 {
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 12px;
    }

    #css-grid-container-page .content-section > p {
        line-height: 1.7;
    }

    /* Code */

    #css-grid-container-page .code-box {
        background-color: #212529;
        color: #f8f9fa;
        border-radius: 6px;
        padding: 18px;
        margin-top: 15px;
        overflow-x: auto;
    }

    #css-grid-container-page .code-box pre {
        margin: 0;
        white-space: pre-wrap;
    }

    /* Explanation */

    #css-grid-container-page .explanation-box {
        background-color: #f8f9fa;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        padding: 18px 20px;
        margin-top: 15px;
    }

    #css-grid-container-page .explanation-box p:last-child {
        margin-bottom: 0;
    }

    /* Diagram */

    #css-grid-container-page .diagram-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-container-page .grid-diagram {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding: 20px;
        border: 2px dashed #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-container-page .diagram-item {
        background-color: #2563eb;
        color: #ffffff;
        padding: 20px;
        border-radius: 6px;
        text-align: center;
        font-weight: 700;
    }

    /* Output */

    #css-grid-container-page .browser-output {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 25px;
        margin-top: 15px;
    }

    #css-grid-container-page .output-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        padding: 20px;
        border: 2px solid #2563eb;
        background-color: #dbeafe;
    }

    #css-grid-container-page .output-item {
        background-color: lightblue;
        border: 2px solid blue;
        padding: 25px;
        text-align: center;
        font-weight: 700;
    }

    /* Property Cards */

    #css-grid-container-page .property-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        height: 100%;
        background-color: #ffffff;
    }

    #css-grid-container-page .property-card h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-container-page .property-card p {
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Note */

    #css-grid-container-page .note-box {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 16px 18px;
        margin-top: 20px;
    }

    /* Summary */

    #css-grid-container-page .summary-box {
        background-color: #e0f7fa;
        border: 1px solid #90e0ef;
        border-radius: 6px;
        padding: 18px 20px;
        margin-top: 30px;
    }

    #css-grid-container-page .summary-box h2 {
        color: #075985;
        font-weight: 700;
        margin-bottom: 10px;
    }

    #css-grid-container-page .summary-box p {
        color: #075985;
        margin-bottom: 0;
        line-height: 1.6;
    }

</style>


<div id="css-grid-container-page">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-lg-3 mb-4">

            @Html.Partial(
                "~/Areas/CSS/Views/Shared/CSSTopics.cshtml"
            )

        </div>


        <!-- Main Content -->

        <div class="col-lg-9">

            <div class="content-section">

                <!-- Title -->

                <h1>
                    CSS Grid Container
                </h1>

                <p>
                    A CSS Grid Container is an element that becomes
                    a Grid Container when the
                    <strong>display</strong> property is set to
                    <strong>grid</strong>.
                </p>

                <p>
                    Once an element becomes a Grid Container, its
                    direct child elements become Grid Items and can
                    be arranged into rows and columns.
                </p>


                <!-- What Is Grid Container -->

                <h2>
                    What Is a Grid Container?
                </h2>

                <div class="explanation-box">

                    <p>
                        The parent element that contains Grid Items
                        is called the <strong>Grid Container</strong>.
                    </p>

                    <p>
                        CSS Grid is activated using:
                        <strong>display: grid;</strong>
                    </p>

                    <p>
                        The direct children of this element
                        automatically become Grid Items.
                    </p>

                </div>


                <!-- Basic Syntax -->

                <h2>
                    Basic Syntax
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
}</code></pre>

                </div>


                <!-- Structure Diagram -->

                <h2>
                    Grid Container Structure
                </h2>

                <div class="diagram-box">

                    <div class="grid-diagram">

                        <div class="diagram-item">
                            Grid Item 1
                        </div>

                        <div class="diagram-item">
                            Grid Item 2
                        </div>

                        <div class="diagram-item">
                            Grid Item 3
                        </div>

                        <div class="diagram-item">
                            Grid Item 4
                        </div>

                        <div class="diagram-item">
                            Grid Item 5
                        </div>

                        <div class="diagram-item">
                            Grid Item 6
                        </div>

                    </div>

                    <p class="text-center mt-3 mb-0">
                        Parent element = Grid Container |
                        Direct children = Grid Items
                    </p>

                </div>


                <!-- Example 1 -->

                <h2>
                    Example 1: Creating a Grid Container
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The <strong>display: grid;</strong> declaration
                        changes the layout behavior of the parent
                        element.
                    </p>

                    <p>
                        Its direct children are now treated as
                        Grid Items.
                    </p>

                </div>


                <!-- Example 2 -->

                <h2>
                    Example 2: Grid Container with Columns
                </h2>

                <p>
                    A Grid Container can define the number and size
                    of columns using
                    <strong>grid-template-columns</strong>.
                </p>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}</code></pre>

                </div>

                <h3>
                    Output
                </h3>

                <div class="browser-output">

                    <div class="output-grid">

                        <div class="output-item">
                            Item 1
                        </div>

                        <div class="output-item">
                            Item 2
                        </div>

                        <div class="output-item">
                            Item 3
                        </div>

                        <div class="output-item">
                            Item 4
                        </div>

                        <div class="output-item">
                            Item 5
                        </div>

                        <div class="output-item">
                            Item 6
                        </div>

                    </div>

                </div>

                <p class="mt-3">
                    The Grid Container creates three equal columns.
                    Additional items automatically move to the
                    next row.
                </p>


                <!-- Grid Items -->

                <h2>
                    Grid Container and Grid Items
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Grid Container
                            </h3>

                            <p>
                                The parent element with
                                <strong>display: grid;</strong>.
                                It controls the overall Grid layout.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="property-card">

                            <h3>
                                Grid Items
                            </h3>

                            <p>
                                The direct children of the Grid
                                Container. They are placed inside
                                Grid rows and columns.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Important Container Properties -->

                <h2>
                    Important Grid Container Properties
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Property</th>
                                <th>Purpose</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>display</strong>
                                </td>

                                <td>
                                    Creates the Grid Container.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-template-columns</strong>
                                </td>

                                <td>
                                    Defines the Grid columns.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>grid-template-rows</strong>
                                </td>

                                <td>
                                    Defines the Grid rows.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>gap</strong>
                                </td>

                                <td>
                                    Creates spacing between
                                    Grid Items.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>justify-items</strong>
                                </td>

                                <td>
                                    Controls horizontal alignment
                                    of Grid Items inside their cells.
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>align-items</strong>
                                </td>

                                <td>
                                    Controls vertical alignment
                                    of Grid Items inside their cells.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Gap -->

                <h2>
                    Adding Space Between Grid Items
                </h2>

                <div class="code-box">

<pre><code>.container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The <strong>gap: 20px;</strong> property creates
                        20 pixels of space between the Grid Items.
                    </p>

                </div>


                <!-- Container vs Item -->

                <h2>
                    Container Properties vs Item Properties
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>
                                <th>Container</th>
                                <th>Item</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    display: grid;
                                </td>

                                <td>
                                    grid-column
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    grid-template-columns
                                </td>

                                <td>
                                    grid-row
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    grid-template-rows
                                </td>

                                <td>
                                    grid-area
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    gap
                                </td>

                                <td>
                                    align-self
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- Real World -->

                <h2>
                    Example 🤓🌍
                </h2>

                <p>
                    A course listing page can use a Grid Container
                    to display multiple course cards in a structured
                    layout.
                </p>

                <div class="code-box">

<pre><code>.courses {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.course-card {
    padding: 20px;
    border: 1px solid #2563eb;
}</code></pre>

                </div>

                <div class="explanation-box">

                    <p>
                        The <strong>.courses</strong> element becomes
                        the Grid Container.
                    </p>

                    <p>
                        Each <strong>.course-card</strong> becomes
                        a Grid Item.
                    </p>

                    <p>
                        Three equal columns are created with a
                        20-pixel gap between the cards.
                    </p>

                </div>


                <!-- Advantages -->

                <h2>
                    Advantages of a Grid Container
                </h2>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Structured Layout
                            </h3>

                            <p>
                                Rows and columns provide a clear
                                structure for page layouts.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Flexible Sizing
                            </h3>

                            <p>
                                Grid tracks can use flexible units
                                such as <strong>fr</strong>.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="property-card">

                            <h3>
                                Responsive Layouts
                            </h3>

                            <p>
                                Grid can be combined with media
                                queries for responsive designs.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Important Note -->

                <div class="note-box">

                    <strong>Important:</strong>

                    Only the direct children of a Grid Container
                    automatically become Grid Items. Nested elements
                    inside those children do not automatically become
                    Grid Items of the outer container.

                </div>


                <!-- Summary -->

                <div class="summary-box">

                    <h2 class="h4">
                        Summary
                    </h2>

                    <p>
                        A <strong>Grid Container</strong> is created
                        using <strong>display: grid;</strong>. Its
                        direct children become Grid Items. Container
                        properties such as
                        <strong>grid-template-columns</strong>,
                        <strong>grid-template-rows</strong>, and
                        <strong>gap</strong> control the overall
                        Grid structure and spacing.
                    </p>

                </div>


                <!-- Navigation -->

                <div class="row mt-5">

                    <div class="col-md-6">

                        <a class="btn btn-outline-secondary w-100"
                           href="@Url.Action("Index", "Grid", new { area = "CSS" })">

                            ← Previous: CSS Grid

                        </a>

                    </div>

                    <div class="col-md-6">

                        <a class="btn btn-primary w-100"
                           href="@Url.Action("GridRowsAndColumns", "Grid", new { area = "CSS" })">

                            Next: Grid Rows &amp; Columns →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>