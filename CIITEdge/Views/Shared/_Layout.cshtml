

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        CIIT Stack Lab - Build the Stack. Automate the Ops. Scale the Intellect
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">


    <!-- Google Fonts -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>


    <style>

            :root {

                --bs-body-font-family: 'Plus Jakarta Sans', sans-serif;

                --ciit-primary: #2563eb;

                --ciit-secondary: #0f172a;

                --ciit-accent: #06b6d4;

            }


            .code-font {

                font-family: 'Fira Code', monospace;

            }


            /* =========================================================
               TOP BAR
               ========================================================= */

            .top-bar {

                background-color: var(--ciit-secondary);

                font-size: 0.85rem;

            }


            /* =========================================================
               HERO SECTION
               ========================================================= */

            .hero-section {

                background: linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #e0f2fe 100%
                );

                padding: 4rem 0;

            }


            /* =========================================================
               CODE WINDOW
               ========================================================= */

            .code-window {

                background-color: #1e293b;

                border-radius: 12px;

                overflow: hidden;

                box-shadow:
                    0 20px 25px -5px rgba(0, 0, 0, 0.2);

            }


            .code-window-header {

                background-color: #0f172a;

                padding: 10px 15px;

                display: flex;

                align-items: center;

            }


            .dot {

                height: 12px;

                width: 12px;

                border-radius: 50%;

                display: inline-block;

                margin-right: 6px;

            }


            /* =========================================================
               TECH CARDS
               ========================================================= */

            .course-card {

                transition:
                    transform 0.3s ease,
                    box-shadow 0.3s ease;

                border: 1px solid #e2e8f0;

            }


            .course-card:hover {

                transform: translateY(-8px);

                box-shadow:
                    0 12px 24px rgba(37, 99, 235, 0.12) !important;

                border-color: var(--ciit-primary);

            }


            .tech-icon {

                width: 48px;

                height: 48px;

                display: flex;

                align-items: center;

                justify-content: center;

                border-radius: 10px;

                font-size: 1.5rem;

            }


            /* =========================================================
               FEATURE SECTION
               ========================================================= */

            .feature-icon-box {

                width: 60px;

                height: 60px;

                border-radius: 50%;

                background: rgba(37, 99, 235, 0.1);

                color: var(--ciit-primary);

                display: flex;

                align-items: center;

                justify-content: center;

                font-size: 1.5rem;

                margin: 0 auto 1rem auto;

            }


            /* =========================================================
               COMPILER PREVIEW
               ========================================================= */

            .compiler-section {

                background-color: #0f172a;

                color: #ffffff;

            }


            /* =========================================================
               ROADMAP
               ========================================================= */

            .roadmap-hero {

                background:
                    linear-gradient(
                        135deg,
                        #0f172a 0%,
                        #1e293b 100%
                    );

                color: white;

                padding: 4rem 0 3rem 0;

            }


            /* =========================================================
               LEARNING PATH
               ========================================================= */

            .timeline {

                position: relative;

                padding-left: 2rem;

                border-left: 3px solid #e2e8f0;

            }


            .timeline-item {

                position: relative;

                margin-bottom: 2.5rem;

            }


            .timeline-item:last-child {

                margin-bottom: 0;

            }


            .timeline-badge {

                position: absolute;

                left: -2.85rem;

                top: 0;

                width: 36px;

                height: 36px;

                border-radius: 50%;

                background-color: var(--ciit-primary);

                color: white;

                display: flex;

                align-items: center;

                justify-content: center;

                font-weight: 700;

                font-size: 0.9rem;

                border: 3px solid #ffffff;

                box-shadow:
                    0 0 0 3px rgba(37, 99, 235, 0.2);

            }


            .timeline-badge.complete {

                background-color: #10b981;

            }


            .roadmap-card {

                border: 1px solid #e2e8f0;

                transition: all 0.3s ease;

            }


            .roadmap-card:hover {

                border-color: var(--ciit-primary);

                box-shadow:
                    0 10px 25px -5px rgba(37, 99, 235, 0.1);

            }


            /* =========================================================
               CODE FONT
               ========================================================= */

            .code-font {

                font-family: 'Fira Code', monospace;

            }


            /* =========================================================
               COMPILER HEADER
               ========================================================= */

            .compiler-header {

                background-color: #0b0f19;

                border-bottom: 1px solid #334155;

                padding: 0.6rem 1.5rem;

            }


            /* =========================================================
               WORKSPACE
               ========================================================= */

            .workspace-container {

                display: flex;

                flex: 1;

                overflow: hidden;

            }


            /* =========================================================
               TASK SIDEBAR
               ========================================================= */

            .task-sidebar {

                width: 320px;

                background-color: #111827;

                border-right: 1px solid #334155;

                overflow-y: auto;

            }


            /* =========================================================
               MAIN CODE AREA
               ========================================================= */

            .editor-container {

                flex: 1;

                display: flex;

                flex-direction: column;

                background-color: var(--ciit-editor-bg);

            }


            .editor-header {

                background-color: #0f172a;

                border-bottom: 1px solid #334155;

                padding: 0.5rem 1rem;

            }


            .code-input-area {

                flex: 1;

                background-color: var(--ciit-editor-bg);

                color: #f8fafc;

                border: none;

                outline: none;

                resize: none;

                padding: 1rem;

                font-size: 0.95rem;

                line-height: 1.6;

            }


            /* =========================================================
               TERMINAL
               ========================================================= */

            .terminal-container {

                height: 220px;

                background-color: var(--ciit-terminal-bg);

                border-top: 1px solid #334155;

                display: flex;

                flex-direction: column;

            }


            .terminal-header {

                background-color: #0f172a;

                padding: 0.4rem 1rem;

                font-size: 0.85rem;

                border-bottom: 1px solid #1e293b;

            }


            .terminal-output {

                flex: 1;

                padding: 1rem;

                overflow-y: auto;

                font-size: 0.9rem;

                color: #38bdf8;

            }


            /* =========================================================
               FULL STACK JAVA TOPICS NAVBAR
               ========================================================= */

            .fullstack-java-topics {

                width: 100%;

                background: #ffffff;

                border-bottom: 1px solid #e5e7eb;

                box-shadow:
                    0 2px 8px rgba(15, 23, 42, 0.04);

            }


            .fullstack-java-topics-inner {

                display: flex;

                align-items: center;

                width: 100%;

                height: 54px;

            }


            .fullstack-java-topics-title {

                flex: 0 0 auto;

                padding: 0 24px;

                font-size: 15px;

                font-weight: 700;

                color: #172033;

                border-right: 1px solid #e5e7eb;

                height: 100%;

                display: flex;

                align-items: center;

            }


            .fullstack-java-topic-scroll {

                flex: 1;

                overflow-x: auto;

                overflow-y: hidden;

                white-space: nowrap;

                scrollbar-width: none;

                scroll-behavior: smooth;

            }


            .fullstack-java-topic-scroll::-webkit-scrollbar {

                display: none;

            }


            .fullstack-java-topic-list {

                display: inline-flex;

                align-items: center;

                min-width: max-content;

            }


            .fullstack-java-topic-link {

                display: inline-flex;

                align-items: center;

                height: 54px;

                padding: 0 17px;

                color: #374151;

                text-decoration: none;

                font-size: 14px;

                font-weight: 500;

                transition: all 0.2s ease;

            }


            .fullstack-java-topic-link:hover {

                color: #2563eb;

                background: #f8fafc;

            }


            .fullstack-java-topic-link.active {

                color: #2563eb;

                font-weight: 700;

            }


            .fullstack-java-topic-arrow {

                width: 42px;

                height: 54px;

                flex: 0 0 42px;

                border: none;

                background: #ffffff;

                color: #475569;

                font-size: 25px;

                display: flex;

                align-items: center;

                justify-content: center;

                cursor: pointer;

                transition: all 0.2s ease;

            }


            .fullstack-java-topic-arrow:hover {

                background: #f1f5f9;

                color: #2563eb;

            }


            /* =========================================================
               RESPONSIVE
               ========================================================= */

            @Html.Raw("@")media (max-width: 992px) {

                body {

                    overflow: auto;

                    height: auto;

                }


                .workspace-container {

                    flex-direction: column;

                }


                .task-sidebar {

                    width: 100%;

                    height: auto;

                }


                .editor-container {

                    min-height: 400px;

                }


                .terminal-container {

                    height: 200px;

                }


                .fullstack-java-topics-title {

                    padding: 0 15px;

                    font-size: 14px;

                }


                .fullstack-java-topic-link {

                    padding: 0 13px;

                    font-size: 13px;

                }

            }


            /* =========================================================
               FOOTER
               ========================================================= */

            footer {

                background-color: #0b0f19;

            }

    </style>

</head>


<body>


    <!-- =========================================================
         MAIN CIIT NAVBAR
         THIS WILL REMAIN SAME
         ========================================================= -->
    @Html.Partial("~/Views/Shared/Menus/MenusWithDropdown.cshtml")


    <!-- =========================================================
         TOPICS NAVIGATION
         ========================================================= -->
    @{
        var currentArea =
            ViewContext.RouteData.Values["area"]?.ToString();

        var isFullStackJava =
            string.Equals(
                currentArea,
                "FullStackJava",
                StringComparison.OrdinalIgnoreCase
            );
    }


    @if (isFullStackJava)
    {

        <!-- =====================================================
             FULL STACK JAVA TOPICS
             ONLY FOR FULL STACK JAVA AREA
             ===================================================== -->

        <nav class="fullstack-java-topics"
             aria-label="Full Stack Java Topics">

            <div class="fullstack-java-topics-inner">

                <!-- LEFT ARROW -->

                <button type="button"
                        class="fullstack-java-topic-arrow"
                        id="fullStackJavaPrev"
                        aria-label="Previous topics">

                    &#8249;

                </button>


                <!-- TOPICS TITLE -->

                <div class="fullstack-java-topics-title">

                    Topics

                </div>


                <!-- TOPICS SCROLL -->

                <div class="fullstack-java-topic-scroll"
                     id="fullStackJavaTopicScroll">

                    <div class="fullstack-java-topic-list">


                        <!-- FULL STACK JAVA -->

                        <a href="/FullStackJava/FullStackJava"
                           class="fullstack-java-topic-link">

                            Full Stack Java

                        </a>


                        <!-- CORE JAVA -->

                        <a href="/FullStackJava/CoreJava"
                           class="fullstack-java-topic-link">

                            Core Java

                        </a>


                        <!-- OOP -->

                        <a href="/FullStackJava/OOP"
                           class="fullstack-java-topic-link">

                            OOP

                        </a>


                        <!-- COLLECTIONS -->

                        <a href="/FullStackJava/Collections"
                           class="fullstack-java-topic-link">

                            Collections

                        </a>


                        <!-- JDBC -->

                        <a href="/FullStackJava/JDBC"
                           class="fullstack-java-topic-link">

                            JDBC

                        </a>


                        <!-- MYSQL -->

                        <a href="/FullStackJava/MySQL"
                           class="fullstack-java-topic-link">

                            MySQL

                        </a>


                        <!-- ORACLE SQL / PL SQL -->

                        <a href="/FullStackJava/OracleSQLPLSQL"
                           class="fullstack-java-topic-link">

                            Oracle SQL &amp; PL/SQL

                        </a>


                        <!-- SERVLET / JSP -->

                        <a href="/FullStackJava/ServletJSP"
                           class="fullstack-java-topic-link">

                            Servlet &amp; JSP

                        </a>


                        <!-- HIBERNATE -->

                        <a href="/FullStackJava/Hibernate"
                           class="fullstack-java-topic-link">

                            Hibernate

                        </a>


                        <!-- SPRING -->

                        <a href="/FullStackJava/Spring"
                           class="fullstack-java-topic-link">

                            Spring

                        </a>


                        <!-- SPRING BOOT -->

                        <a href="/FullStackJava/SpringBoot"
                           class="fullstack-java-topic-link">

                            Spring Boot

                        </a>


                        <!-- MICROSERVICES -->

                        <a href="/FullStackJava/Microservices"
                           class="fullstack-java-topic-link">

                            Microservices

                        </a>


                        <!-- JPA -->

                        <a href="/FullStackJava/JPA"
                           class="fullstack-java-topic-link">

                            JPA

                        </a>


                        <!-- REST API -->

                        <a href="/FullStackJava/RESTAPI"
                           class="fullstack-java-topic-link">

                            REST API

                        </a>


                    </div>

                </div>


                <!-- RIGHT ARROW -->

                <button type="button"
                        class="fullstack-java-topic-arrow"
                        id="fullStackJavaNext"
                        aria-label="Next topics">

                    &#8250;

                </button>

            </div>

        </nav>

    }
    else
    {

        <!-- =====================================================
             NORMAL CIIT TOPICS
             HOME PAGE AND OTHER AREAS
             ===================================================== -->

        @Html.Partial("~/Views/Shared/Menus/ProgrammingMenus.cshtml")

    }


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->
    @RenderBody()


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="text-white pt-5 pb-3">

        <div class="container">

            <div class="row g-4 mb-4">


                <!-- =================================================
                     ABOUT CIIT
                     ================================================= -->

                <div class="col-lg-4">

                    <h3 class="fw-bold text-primary mb-3">

                        CIIT
                        <span class="text-info">
                            eTutorial
                        </span>

                    </h3>


                    <p class="text-secondary small">

                        CIIT Training Institute is dedicated to
                        delivering high-quality programming tutorials,
                        practical guides, and certification courses
                        to empower aspiring developers.

                    </p>


                    <!-- SOCIAL MEDIA -->

                    <div class="d-flex gap-3 text-secondary">


                        <!-- INSTAGRAM -->

                        <a href="https://www.instagram.com/ciittraininginstitute?stkn=MWxtZnY0dmoycTl6cA=="
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-white fs-5"
                           title="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>


                        <!-- FACEBOOK -->

                        <a href="https://www.facebook.com/share/1BxB28HDir/"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-white fs-5"
                           title="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>


                        <!-- LINKEDIN -->

                        <a href="https://www.linkedin.com/in/ciit-training-institute-207496392?utm_source=share_via&utm_content=profile&utm_medium=member_android"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-white fs-5"
                           title="LinkedIn">

                            <i class="bi bi-linkedin"></i>

                        </a>


                        <!-- YOUTUBE -->

                        <a href="https://youtube.com/@@ciittraininginstitute?si=Iz9gehSPTES5nf8P"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-white fs-5"
                           title="YouTube">

                            <i class="bi bi-youtube"></i>

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     TUTORIALS
                     ================================================= -->

                <div class="col-6 col-lg-2">

                    <h6 class="fw-bold mb-3 text-light">

                        Tutorials

                    </h6>


                    <ul class="list-unstyled text-secondary small">

                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Core Java

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Python

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                JavaScript

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                C# (.NET)

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Angular

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                TypeScript

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- =================================================
                     RESOURCES
                     ================================================= -->

                <div class="col-6 col-lg-2">

                    <h6 class="fw-bold mb-3 text-light">

                        Resources

                    </h6>


                    <ul class="list-unstyled text-secondary small">

                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Online Compilers

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Interview Questions

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Developer Roadmaps

                            </a>

                        </li>


                        <li class="mb-2">

                            <a href="#"
                               class="text-decoration-none text-secondary">

                                Cheat Sheets

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- =================================================
                     NEWSLETTER
                     ================================================= -->

                <div class="col-lg-4">

                    <h6 class="fw-bold mb-3 text-light">

                        Subscribe to Weekly Newsletter

                    </h6>


                    <p class="text-secondary small">

                        Get new tutorials, practice exercises,
                        and tech tips in your inbox.

                    </p>


                    <div class="input-group mb-3">

                        <input type="email"
                               class="form-control"
                               placeholder="Enter your email">


                        <button class="btn btn-primary fw-bold"
                                type="button">

                            Subscribe

                        </button>

                    </div>

                </div>

            </div>


            <hr class="border-secondary">


            <!-- =================================================
                 FOOTER BOTTOM
                 ================================================= -->

            <div class="d-flex flex-column flex-sm-row
                justify-content-between
                align-items-center
                text-secondary small">


                <p class="m-0">

                    © 2026 CIIT Training Institute.
                    All Rights Reserved.

                </p>


                <div>

                    <a href="#"
                       class="text-secondary text-decoration-none me-3">

                        Privacy Policy

                    </a>


                    <a href="#"
                       class="text-secondary text-decoration-none">

                        Terms of Service

                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- =========================================================
         FULL STACK JAVA TOPICS SCROLL SCRIPT
         ========================================================= -->

    <script>

            document.addEventListener("DOMContentLoaded", function () {

                const topicsContainer =
                    document.getElementById("fullStackJavaTopicScroll");

                const previousButton =
                    document.getElementById("fullStackJavaPrev");

                const nextButton =
                    document.getElementById("fullStackJavaNext");


                if (topicsContainer &&
                    previousButton &&
                    nextButton) {


                    previousButton.addEventListener(
                        "click",
                        function () {

                            topicsContainer.scrollBy({

                                left: -350,

                                behavior: "smooth"

                            });

                        }
                    );


                    nextButton.addEventListener(
                        "click",
                        function () {

                            topicsContainer.scrollBy({

                                left: 350,

                                behavior: "smooth"

                            });

                        }
                    );

                }

            });

    </script>


    <!-- Bootstrap JS Bundle -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>