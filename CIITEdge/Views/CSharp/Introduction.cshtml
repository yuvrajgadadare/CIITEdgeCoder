 
@{
}
 
    <!-- Navigation Header -->
   

    <!-- Main Content Layout -->
    <main id="tutorials" class="container py-5">
        <div class="row g-4">
            
            <!-- Sidebar Navigation -->
            <aside class="col-lg-3">
              @Html.Partial("~/Views/Shared/CSharp/CSharpTopics.cshtml")
            </aside>

            <!-- Reading Content Area -->
            <section class="col-lg-9">
                <div class="card shadow-sm p-4 p-md-5 mb-4">
                    <span class="text-uppercase tracking-widest text-primary fw-bold small">Module 1: Lesson 3</span>
                    <h2 class="h1 fw-bold text-dark mt-1 mb-4">Your First C# Program</h2>
                    
                    <p class="text-muted mb-4">The core entry point of your executable code framework is always the <code class="bg-light border px-1.5 py-0.5 rounded text-danger font-monospace small">Main</code> method. Modify and execute code safely below inside our active compiler workspace framework:</p>

                    <!-- Syntax Highlighted Explanation Reference Layout Block -->
                    <div class="code-block mb-4 shadow-sm">
                        <div class="code-lang-tag">Static Code Layout Reference</div>
                        <span class="keyword">using</span> System;<br><br>
                        <span class="keyword">class</span> <span class="class-name">Program</span><br>
                        {<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">static</span> <span class="keyword">void</span> <span class="method-name">Main</span>()<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;{<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="class-name">Console</span>.<span class="method-name">WriteLine</span>(<span class="string-lit">"Hello, World!"</span>);<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;}<br>
                        }
                    </div>
             
                    <!-- Live Code Editor Component -->
                    <div id="playground" class="p-4 bg-light border rounded-3 mt-5">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="fw-bold text-dark mb-0">💻 Interactive Code Editor</h5>
                            <span class="badge bg-secondary font-monospace">C# (.NET)</span>
                        </div>
                        <p class="small text-muted mb-3">Feel free to change the message string inside the quotes and run it to watch your results update instantly.</p>
                        
                        <!-- Writeable Text Area -->
                  
                        <textarea id="csharpEditor" class="form-control editor-textarea p-3 mb-3 shadow-inner" rows="9" placeholder="Write your C# code here...">using System;
                        class Program 
                        {
                            static void Main() 
                            {
                                Console.WriteLine("Hello from C# Academy Workspace!");
        
                                int total = 5 + 10;
                                Console.WriteLine("Calculation Sample Result: " + total);
                            }
                        }</textarea>
               
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <button id="runBtn" class="btn btn-success px-4 fw-bold shadow-sm" onclick="runCode()">Run Code</button>
                            <span id="compilerStatus" class="font-monospace text-muted small">Status: Ready to execute</span>
                        </div>

                        <!-- Simulated Output Terminal Dashboard -->
                        <h6 class="fw-bold text-dark mb-1">Terminal Output Console:</h6>
                        <pre id="terminalOutput" class="terminal-output p-3 rounded shadow-inner border border-dark">Click "Run Code" above to check execution output logs...</pre>
                    </div>

                </div>
            </section>

        </div>
    </main>

 
    <script>
        function copyCode() {
            // Get the text content from the <code> element
            var codeText = document.getElementById("csharpEditor").value;
            var button = document.getElementById("copyBtn");

            // Write text to clipboard via browser api
            navigator.clipboard.writeText(codeText).then(function() {
                // Visual feedback to user
                button.innerHTML = "✓ Copied!";
                button.classList.replace("btn-outline-secondary", "btn-success");
                button.classList.replace("text-white-50", "text-white");

                // Reset button state after 2 seconds
                setTimeout(function() {
                    button.innerHTML = "📋 Copy";
                    button.classList.replace("btn-success", "btn-outline-secondary");
                    button.classList.replace("text-white", "text-white-50");
                }, 2000);
            }).catch(function(err) {
                console.error("Could not copy text: ", err);
            });
        }
    </script>
 