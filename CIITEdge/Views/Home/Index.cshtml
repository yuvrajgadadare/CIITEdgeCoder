    <script>

    document.addEventListener("DOMContentLoaded", function() {

        /* =====================================================
           TOPICS HORIZONTAL SCROLL
           ===================================================== */

        const topicsScroll =
            document.getElementById("topicsScroll");

        const prevButton =
            document.getElementById("topicsPrev");

        const nextButton =
            document.getElementById("topicsNext");



        if (topicsScroll && prevButton && nextButton) {

            const scrollAmount = 350;


            prevButton.addEventListener("click", function() {

                topicsScroll.scrollBy({
                    left: -scrollAmount,
                    behavior: "smooth"
                });

            });


            nextButton.addEventListener("click", function() {

                topicsScroll.scrollBy({
                    left: scrollAmount,
                    behavior: "smooth"
                });

            });


            /* Mouse wheel */

            topicsScroll.addEventListener("wheel", function(event) {

                if (
                    Math.abs(event.deltaY) >
                    Math.abs(event.deltaX)
                ) {

                    event.preventDefault();

                    topicsScroll.scrollLeft += event.deltaY;

                }

            }, { passive: false });


            /* Mouse drag */

            let isDragging = false;

            let startX = 0;

            let startScrollLeft = 0;


            topicsScroll.addEventListener(
                "mousedown",
                function(event) {

                    isDragging = true;

                    topicsScroll.classList.add("dragging");

                    startX =
                        event.pageX -
                        topicsScroll.offsetLeft;

                    startScrollLeft =
                        topicsScroll.scrollLeft;

                }
            );


            topicsScroll.addEventListener(
                "mouseleave",
                function() {

                    isDragging = false;


                    topicsScroll.classList.remove("dragging");

                }
            );


            topicsScroll.addEventListener(
                "mouseup",
                function() {

                    isDragging = false;

                    topicsScroll.classList.remove("dragging");

                }
            );


            topicsScroll.addEventListener(
                "mousemove",
                function(event) {

                    if (!isDragging) {
                        return;
                    }

                    event.preventDefault();

                    const x =
                        event.pageX -
                        topicsScroll.offsetLeft;

                    const walk =
                        (x - startX) * 1.5;


                    topicsScroll.scrollLeft =
                        startScrollLeft - walk;

                }
            );


                Active topic

            const currentPath =
                window.location.pathname.toLowerCase();

            const topicLinks =
                document.querySelectorAll(".topic-link");


            topicLinks.forEach(function(link) {

                const linkPath =
                    new URL(
                        link.href,
                        window.location.origin
                    )
                        .pathname
                        .toLowerCase();


                if (
                    currentPath === linkPath ||
                    currentPath.startsWith(linkPath)
                ) {

                    link.classList.add("active");

                }

            });

        }


        /* =====================================================
           HERO IMAGE AUTO SLIDER
           ===================================================== */

        const slides =
            document.querySelectorAll(".hero-slide");

        const dots =
            document.querySelectorAll(".slider-dot");

        let currentSlide = 0;


        function showSlide(index) {

            slides.forEach(function(slide) {

                slide.classList.remove("active");

            });


            dots.forEach(function(dot) {

                dot.classList.remove("active");

            });


            slides[index].classList.add("active");

            dots[index].classList.add("active");

        }


        if (slides.length > 0) {

            setInterval(function() {

                currentSlide++;

                if (currentSlide >= slides.length) {

                    currentSlide = 0;

                }

                showSlide(currentSlide);

            }, 4000);


            dots.forEach(function(dot, index) {

                dot.addEventListener("click", function() {

                    currentSlide = index;

                    showSlide(currentSlide);

                });

            });


        }

    });

</script>