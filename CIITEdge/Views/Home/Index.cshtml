@{
    ViewData["Title"] = "CIIT Stack Lab";
}

<!-- =========================================================
     CIIT STACK LAB - HOME PAGE
     ========================================================= -->

<style>

    <!-- =========================================================
    TOPICS NAVBAR
    ========================================================= -->
    .ciit-topics-bar {
        width: 100%;
        background: #ffffff;
        border-top: 1px solid #eef1f5;
        border-bottom: 1px solid #e5e9ef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        position: relative;
        z-index: 100;
    }

    .topics-wrapper {
        width: 100%;
        display: flex;
        align-items: center;
        min-height: 62px;
        padding: 0 14px;
    }

    .topics-title {
        flex: 0 0 auto;
        padding: 0 22px 0 8px;
        margin-right: 4px;
        height: 34px;
        display: flex;
        align-items: center;
        border-right: 1px solid #e1e5eb;
        font-size: 17px;
        font-weight: 700;
        color: #172033;
        white-space: nowrap;
    }

    .topics-arrow {
        flex: 0 0 38px;
        width: 38px;
        height: 42px;
        border: 0;
        background: #ffffff;
        color: #1769ff;
        font-size: 26px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        z-index: 5;
    }

        .topics-arrow:hover {
            background: #f1f6ff;
            color: #0758e8;
            border-radius: 8px;
        }

    .topics-scroll-container {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        position: relative;
    }

    .topics-scroll {
        display: flex;
        align-items: center;
        gap: 4px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        white-space: nowrap;
        scrollbar-width: none;
        padding: 8px 4px;
        cursor: grab;
    }

        .topics-scroll::-webkit-scrollbar {
            display: none;
        }

        .topics-scroll.dragging {
            cursor: grabbing;
            scroll-behavior: auto;
        }

    .topic-link {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 42px;
        padding: 0 15px;
        border-radius: 8px;
        text-decoration: none;
        color: #4d596b;
        font-size: 15px;
        font-weight: 500;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .topic-link:hover {
            color: #1264f5;
            background: #f2f6ff;
            text-decoration: none;
        }

        .topic-link.active {
            color: #1264f5;
            background: #edf4ff;
            font-weight: 700;
        }


    /* =========================================================
               HERO SECTION
               ========================================================= */

    .hero-section {
        background: linear-gradient(135deg, #eef8ff 0%, #ffffff 100%);
        padding: 70px 0;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .hero-title {
        font-size: 4rem;
        line-height: 1.05;
        letter-spacing: -2px;
    }

    .hero-description {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #64748b;
    }


    /* =========================================================
               HERO IMAGE SLIDER
               ========================================================= */

    .hero-slider {
        position: relative;
        width: 100%;
        height: 500px;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(15,23,42,0.18);
        background: #111827;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.7s ease;
    }

        .hero-slide.active {
            opacity: 1;
        }

        .hero-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(2,6,23,0.92), rgba(2,6,23,0.15) );
    }

    .hero-slide-content {
        position: absolute;
        left: 35px;
        right: 35px;
        bottom: 35px;
        color: white;
        z-index: 2;
    }

        .hero-slide-content .category {
            display: inline-block;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.25);
            backdrop-filter: blur(8px);
            padding: 7px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .hero-slide-content h2 {
            font-size: 2.3rem;
            font-weight: 800;
            margin: 0 0 6px;
        }

        .hero-slide-content p {
            margin: 0;
            color: #e2e8f0;
            font-size: 15px;
        }

    .slider-dots {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 7px;
        z-index: 5;
    }

    .slider-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.45);
        cursor: pointer;
    }

        .slider-dot.active {
            background: #ffffff;
        }


    /* =========================================================
               STATS
               ========================================================= */

    .stats-row {
        border-top: 1px solid #dce5ef;
        padding-top: 18px;
    }


    /* =========================================================
               TUTORIAL SECTION
               ========================================================= */

    .tutorials-section {
        background: #ffffff;
    }

    .tutorial-heading {
        max-width: 750px;
        margin: auto;
    }

        .tutorial-heading h2 {
            font-size: 2.3rem;
            font-weight: 800;
            color: #172033;
        }

        .tutorial-heading p {
            font-size: 1.05rem;
        }


    /* =========================================================
               TECHNOLOGY CARDS
               ========================================================= */

    .technology-card {
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        padding: 22px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(15,23,42,0.03);
    }

        .technology-card:hover {
            transform: translateY(-7px);
            border-color: #7daeff;
            box-shadow: 0 18px 35px rgba(37,99,235,0.12);
        }

    .technology-logo-box {
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .technology-logo {
        width: 65px;
        height: 65px;
        object-fit: contain;
    }

    .technology-card h4 {
        font-weight: 800;
        color: #172033;
        margin-bottom: 8px;
    }

    .technology-card p {
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
        min-height: 48px;
    }

    .start-tutorial-btn {
        width: 100%;
        border: 1px solid #1769ff;
        color: #1769ff;
        background: #ffffff;
        font-weight: 700;
        padding: 10px 15px;
        border-radius: 9px;
        text-decoration: none;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        transition: all 0.2s ease;
    }

        .start-tutorial-btn:hover {
            background: #1769ff;
            color: #ffffff;
            text-decoration: none;
        }


    /* =========================================================
               WHY CIIT
               ========================================================= */

    .feature-icon-box {
        width: 60px;
        height: 60px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #e9f1ff;
        color: #1769ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }


    /* =========================================================
               COMPILER
               ========================================================= */

    .compiler-section {
        background: #10182c;
        color: #ffffff;
    }

    .compiler-code {
        background: #0b1220;
        border: 1px solid #334155;
        border-radius: 15px;
        padding: 25px;
    }

    .code-font {
        font-family: Consolas, Monaco, "Courier New", monospace;
    }


    /* =========================================================
               MOBILE
               ========================================================= */

    @@media (max-width: 992px) {

        .hero-title {
            font-size: 3rem;
        }

        .hero-slider {
            height: 430px;
        }
    }

    @@media (max-width: 768px) {

        .topics-wrapper {
            min-height: 56px;
            padding: 0 6px;
        }

        .topics-title {
            padding-right: 12px;
            padding-left: 4px;
            font-size: 15px;
        }

        .topics-arrow {
            flex-basis: 30px;
            width: 30px;
            font-size: 22px;
        }

        .topic-link {
            height: 38px;
            padding: 0 12px;
            font-size: 14px;
        }

        .hero-section {
            padding: 45px 0;
        }

        .hero-title {
            font-size: 2.5rem;
        }

        .hero-slider {
            height: 360px;
        }

        .hero-slide-content h2 {
            font-size: 1.8rem;
        }
    }

</style>


